<roblox version="4"><Item class="Folder" referent="CF0"><Properties><string name="Name">ChronoV3Toolkit</string></Properties><Item class="ModuleScript" referent="CF1"><Properties><string name="Name">Core</string><ProtectedString name="Source">--!strict
-- Chrono V3: server historical contact evidence. No automatic gameplay/network side effects.
local Guard=require(script.Guard)
local Contract=require(script.Contract)
local History=require(script.History)
local Shapes=require(script.Shapes)
local Types=require(script.Types)
local API={Shapes=Shapes,Version="3.1.0"}
-- Optional explanation helper. It never changes the result or runs a hit check.
function API.Explain(reason: (string | {reason: string})?): Types.Explanation return require(script.Help).Explain(reason) end
local Methods={} Methods.__index=Methods
local private=setmetatable({}, {__mode="k"})
local function session(self)
	local s=assert(private[self],"This Chrono instance was destroyed, or the call used the wrong object.")
	assert(not s.inCallback,"Do not call Chrono again from inside a position or rule function. Return its data first.")
	return s
end
local function call(s,callback,...)
	s.inCallback=true
	local out=table.pack(Contract.Call(callback,...))
	s.inCallback=false
	return table.unpack(out,1,out.n)
end
local function bounded(n,lo,hi) return Guard.Number(n) and n&gt;=lo and n&lt;=hi end
local function name(n) return type(n)=="string" and #n&gt;0 and #n&lt;=64 end
local function frozenResult(ok,reason,fields)
	local out=fields or {} out.ok=ok out.reason=reason
	if not out.contacts then out.contacts=table.freeze({}) end
	return table.freeze(out)
end
local function failure(s,reason,fields)
	s.stats.rejected+=1 s.stats.lastRejection=reason
	return frozenResult(false,reason,fields)
end
local function fresh(s)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return nil,"clock_fault" end
	if not s.time then return nil,"capture_required" end
	if now&lt;s.time-1e-6 then return nil,"clock_reversed" end
	if now-s.time&gt;s.maxGap then return nil,"capture_stale" end
	return now
end
function API.new(options: Types.Options?): Types.Service
	assert(game:GetService("RunService"):IsServer(),"Chrono V3 runs on the server")
	local o=options or {}
	local seconds,rate,gap=o.seconds or 0.6,o.rate or 60,o.maxGap or 0.075
	assert(bounded(seconds,0.05,10) and bounded(rate,1,240) and bounded(gap,0.001,1),"Use seconds=0.05 to 10, rate=1 to 240, and maxGap=0.001 to 1. These control saved-position storage.")
	assert(bounded(o.maxRewind or 0,0,seconds),"maxRewind must be zero or a positive number no greater than seconds (the time you keep past positions).")
	assert(o.clock==nil or type(o.clock)=="function","clock must be a function that returns server time in seconds, or leave it unset.")
	assert(o.resolveRewind==nil or type(o.resolveRewind)=="function","resolveRewind must be a function that returns an approved earlier-time delay, or leave it unset.")
	assert(o.world==nil or type(o.world)=="function","world must be an obstacle-check function, or leave it unset.")
	local self=setmetatable({},Methods)
	private[self]={clock=o.clock or function() return workspace:GetServerTimeNow() end,
		seconds=seconds,capacity=math.ceil(rate*seconds)+2,maxGap=gap,maxRewind=o.maxRewind or 0,
		resolveRewind=o.resolveRewind,world=o.world,actors={},actions={},actionCount=0,roster=0,
		stats={captures=0,queries=0,accepted=0,rejected=0,contacts=0,providerFaults=0,lastRejection="none"}}
	return self :: any -- Public method types help Studio autocomplete; checks above still run.
end
function Methods:Track(id,binding)
	local s=session(self)
	assert(name(id) and type(binding)=="table" and name(binding.kind),"Track needs short text id and kind names. Example: id='player-12', kind='player'.")
	assert(not s.actors[id],"This id is already tracked. Call Untrack before deliberately registering a replacement.")
	assert(type(binding.capture)=="function","Track needs capture=function(time) ... end to supply the object's position, hitboxes and game values.")
	assert(bounded(binding.maxSpeed,0,4096) and bounded(binding.maxRadius,0.001,512),"Set maxSpeed from 0 to 4096 studs/second and maxRadius from 0.001 to 512 studs. They must describe your allowed movement and hitbox extent.")
	local trust=binding.trust or "unverified"
	assert(trust=="unverified" or trust=="serverValidated" or trust=="serverSimulated","Use trust='unverified', 'serverValidated' or 'serverSimulated'. Choose a trusted label only after your server actually checks or calculates the data.")
	local count=0 for _ in s.actors do count+=1 end assert(count&lt;256,"This instance already tracks 256 objects. Remove objects no longer needed before adding another.")
	s.actors[id]={id=id,kind=binding.kind,capture=binding.capture,trust=trust,status="awaiting_capture",faults=0,
		history=History.new({seconds=s.seconds,capacity=s.capacity,maxGap=s.maxGap,maxSpeed=binding.maxSpeed,maxRadius=binding.maxRadius})}
	s.roster+=1
end
function Methods:Untrack(id)
	local s=session(self) if not s.actors[id] then return false end
	s.actors[id]=nil s.roster+=1 return true
end
function Methods:Discontinuity(id,reason)
	local s=session(self) local actor=assert(s.actors[id],"actor not tracked")
	local ok,now=call(s,s.clock) assert(ok and Guard.Number(now),"clock fault")
	actor.history:Break(math.max(now,s.time or now)) actor.status=reason or "discontinuity" actor.quarantined=false
end
-- Invoke after your authoritative simulation. All providers must describe the same instant.
-- An optional timestamp supports a fixed-step server simulation using this clock domain.
function Methods:Capture(time)
	local s=session(self)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return frozenResult(false,"clock_fault") end
	time=time or now
	if not Guard.Number(time) or time&gt;now+1e-6 or now-time&gt;s.maxGap then return frozenResult(false,"invalid_capture_time") end
	if s.time and time&lt;=s.time then return frozenResult(false,"non_monotonic") end
	s.time=time s.stats.captures+=1
	local faults={}
	for id,actor in s.actors do
		if actor.quarantined then table.insert(faults,table.freeze({id=id,reason="quarantined"})) continue end
		local called,snapshot=call(s,actor.capture,time)
		local pushed,reason=false,"provider_fault"
		if called then
			-- Validation itself can encounter an erroneous table metamethod from an adapter.
			local validated,accepted,why=call(s,function() return actor.history:Push(time,snapshot) end)
			pushed=validated and accepted==true
			reason=if validated then why else "invalid_snapshot"
		end
		if not pushed then
			actor.history:Break(time) actor.faults+=1 s.stats.providerFaults+=1
			actor.status=reason actor.quarantined=true table.insert(faults,table.freeze({id=id,reason=reason}))
		else actor.status="captured" end
	end
	for token,action in s.actions do
		if time&gt;action.started+action.close or action.roster~=s.roster then s.actions[token]=nil s.actionCount-=1 end
	end
	return frozenResult(#faults==0,if #faults==0 then "captured" else "capture_fault",{time=time,faults=table.freeze(faults)})
end
-- Call only after your existing server move/action service authorizes the action.
-- No client-facing RemoteEvent is created. Context is consumed only by YOUR timing resolver.
function Methods:BeginAction(actorId,profile,approvedContext)
	local s=session(self) local now,err=fresh(s)
	if not now then return nil,err end
	local actor=s.actors[actorId] if not actor then return nil,"actor_missing" end
	if actor.trust=="unverified" then return nil,"unverified_source" end
	if type(profile)~="table" then return nil,"invalid_profile" end
	local shape=Shapes.Copy(profile.shape)
	local opening,closing=profile.opens or 0,profile.closes or 0.25
	if not shape or not bounded(opening,0,10) or not bounded(closing,opening,10)
		or not bounded(profile.maxReach or 32,0,4096) or Shapes.Reach(shape)&gt;(profile.maxReach or 32)
		or not Guard.Integer(profile.maxTargets or 1,1,256) then return nil,"invalid_profile" end
	if profile.eligible~=nil and type(profile.eligible)~="function" then return nil,"invalid_profile" end
	if profile.world~=nil and type(profile.world)~="boolean" then return nil,"invalid_profile" end
	if profile.world and (not s.world or shape.kind~="sweep") then return nil,"world_provider_or_shape" end
	if type(profile.targets)~="table" then return nil,"target_kinds_required" end
	local kinds,count={},0
	for _,kind in profile.targets do
		if not name(kind) then return nil,"invalid_target_kind" end kinds[kind]=true count+=1
	end
	if count==0 or count&gt;32 then return nil,"target_kinds_required" end
	local rewind=0
	if s.resolveRewind then
		local resolved,value=call(s,s.resolveRewind,actorId,approvedContext,s.time)
		if not resolved or not bounded(value,0,s.maxRewind) then return nil,"rewind_rejected" end rewind=value
	end
	local source,reason=actor.history:Sample(s.time-rewind,now)
	if not source then return nil,"source_"..reason end
	local actorActions=0 for _,a in s.actions do if a.actor==actorId then actorActions+=1 end end
	if s.actionCount&gt;=512 or actorActions&gt;=4 then return nil,"action_capacity" end
	local token=table.freeze({})
	s.actions[token]={actor=actorId,epoch=actor.history.epoch,roster=s.roster,started=s.time,
		open=opening,close=closing,shape=shape,kinds=table.freeze(kinds),eligible=profile.eligible,
		world=profile.world==true,maxTargets=profile.maxTargets or 1,rewind=rewind,hit={},totalHits=0}
	s.actionCount+=1
	return token
end
function Methods:EndAction(token)
	local s=session(self) if not s.actions[token] then return false end
	s.actions[token]=nil s.actionCount-=1 return true
end
function Methods:Query(token)
	local s=session(self) s.stats.queries+=1
	local action=s.actions[token] if not action then return failure(s,"invalid_action") end
	local now,err=fresh(s) if not now then return failure(s,err) end
	if action.roster~=s.roster then return failure(s,"roster_changed") end
	local actor=s.actors[action.actor]
	if not actor or actor.history.epoch~=action.epoch then return failure(s,"source_epoch_changed") end
	local elapsed=s.time-action.started
	if elapsed&lt;action.open then return failure(s,"not_active") end
	if elapsed&gt;action.close then return failure(s,"action_expired") end
	if action.lastTime==s.time then return failure(s,"duplicate_query") end
	if action.totalHits&gt;=action.maxTargets then return failure(s,"action_spent") end
	local time=s.time-action.rewind
	local source,reason=actor.history:Sample(time,now)
	if not source then return failure(s,"source_"..reason) end
	local transformed,query=Contract.Call(Shapes.At,action.shape,source.root)
	if not transformed then return failure(s,"shape_out_of_bounds") end
	local fraction=1 local blocked=false
	if action.world then
		local called,cover=call(s,s.world,time,now,query)
		if not called or type(cover)~="table" or cover.covered~=true or type(cover.blocked)~="boolean"
			or not bounded(cover.fraction,0,1) then return failure(s,"world_unknown") end
		blocked=cover.blocked fraction=if blocked then cover.fraction else 1
	end
	local contacts={}
	for id,target in s.actors do
		if id==action.actor or not action.kinds[target.kind] or action.hit[id] then continue end
		-- A missing target can hide a closer contact. Never return a partial success.
		if target.trust=="unverified" then return failure(s,"unverified_target",{actor=id}) end
		local snapshot,why=target.history:Sample(time,now)
		if not snapshot then return failure(s,"target_"..why,{actor=id}) end
		if action.eligible then
			local called,allowed=call(s,action.eligible,source.state,snapshot.state,id,target.kind)
			if not called or type(allowed)~="boolean" then return failure(s,"rules_fault",{actor=id}) end
			if not allowed then continue end
		end
		local best,zoneName=nil,nil
		for zone,volume in snapshot.zones do
			local t=Shapes.Intersect(query,volume)
			-- Cover wins exact ties. With no cover callback, include sweep endpoint tangency.
			if t and (t&lt;fraction or (not blocked and t&lt;=fraction)) and (not best or t&lt;best or (t==best and zone&lt;zoneName)) then best=t zoneName=zone end
		end
		if best then
			local distance=if query.kind=="sweep" then (query.finish-query.start).Magnitude*best else 0
			table.insert(contacts,table.freeze({id=id,kind=target.kind,zone=zoneName,distance=distance,fraction=best,
				time=time,epoch=snapshot.epoch,state=snapshot.state,root=snapshot.root}))
		end
	end
	table.sort(contacts,function(a,b) if a.fraction~=b.fraction then return a.fraction&lt;b.fraction end return a.id&lt;b.id end)
	while #contacts&gt;action.maxTargets-action.totalHits do table.remove(contacts) end
	-- Commit duplicate suppression only after every relevant provider/rule/world check passed.
	for _,contact in contacts do action.hit[contact.id]=true end
	action.totalHits+=#contacts action.lastTime=s.time
	s.stats.accepted+=1 s.stats.contacts+=#contacts
	return frozenResult(true,"covered",{time=time,capturedAt=s.time,rewind=action.rewind,source=source,
		contacts=table.freeze(contacts),shape=query})
end
function Methods:Inspect()
	local s=session(self) local actors={}
	for id,a in s.actors do
		local row=a.history:Latest()
		table.insert(actors,table.freeze({id=id,kind=a.kind,declaredTrust=a.trust,status=a.status,
			captured=row~=nil,latest=if row then row.time else nil,epoch=a.history.epoch,faults=a.faults}))
	end
	table.sort(actors,function(a,b) return a.id&lt;b.id end)
	return table.freeze({version=API.Version,time=s.time,actors=table.freeze(actors),activeActions=s.actionCount,
		stats=table.freeze(table.clone(s.stats)),worldEnabled=s.world~=nil,maxRewind=s.maxRewind})
end
function Methods:Destroy() session(self) private[self]=nil end
return table.freeze(API)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF2"><Properties><string name="Name">Contract</string><ProtectedString name="Source">--!strict
-- These guards contain yielding adapters. They cannot preempt an infinite CPU loop.
local Guard = require(script.Parent.Guard)
local Contract = {}
function Contract.Call(callback, ...)
	if type(callback) ~= "function" then return false, "callback_missing" end
	local thread = coroutine.create(callback)
	local result = table.pack(coroutine.resume(thread, ...))
	if not result[1] then return false, tostring(result[2]) end
	if coroutine.status(thread) ~= "dead" then
		coroutine.close(thread)
		return false, "callback_yielded"
	end
	return true, table.unpack(result, 2, result.n)
end
function Contract.State(state)
	if type(state) ~= "table" then return nil end
	local result, count = {}, 0
	for key, value in state do
		count += 1
		if count &gt; 32 or type(key) ~= "string" or #key &gt; 64 then return nil end
		if type(value) == "number" then
			if not Guard.Number(value) or math.abs(value) &gt; 1e12 then return nil end
		elseif type(value) == "string" then
			if #value &gt; 128 then return nil end
		elseif type(value) ~= "boolean" then return nil end
		result[key] = value
	end
	return table.freeze(result)
end
function Contract.SameState(a, b)
	for k, v in a do if b[k] ~= v then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end
return table.freeze(Contract)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF3"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
local Guard = require(script.Parent.Guard)
local Geometry = {}
local EPSILON = 1e-9

function Geometry.SegmentDistanceSquared(start: Vector3,finish: Vector3,point: Vector3): number
	local delta=finish-start
	local lengthSquared=delta:Dot(delta)
	local alpha=if lengthSquared&gt;1e-12 then math.clamp((point-start):Dot(delta)/lengthSquared,0,1) else 0
	local offset=point-(start+delta*alpha)
	return offset:Dot(offset)
end

function Geometry.RayOBB(origin: Vector3, direction: Vector3, length: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(origin) or not Guard.Unit(direction) or not Guard.Number(length) or length &lt; 0
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local o, d, half = frame:PointToObjectSpace(origin), frame:VectorToObjectSpace(direction), size * 0.5
	local enter, leave = 0, length
	for _, axis in {"X", "Y", "Z"} do
		local start, delta, extent = o[axis], d[axis], half[axis]
		if math.abs(delta) &lt; EPSILON then
			if math.abs(start) &gt; extent then return nil end
		else
			local a, b = (-extent - start) / delta, (extent - start) / delta
			if a &gt; b then a, b = b, a end
			enter, leave = math.max(enter, a), math.min(leave, b)
			if enter &gt; leave then return nil end
		end
	end
	return enter
end

-- Exact moving sphere vs a stationary OBB, including rounded edges/corners.
-- Split the ray at box-plane crossings; point-to-box distance is quadratic on each interval.
function Geometry.SphereSweepOBB(start: Vector3, finish: Vector3, radius: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(start) or not Guard.Vector(finish) or not Guard.Number(radius) or radius &lt; 0 or radius &gt; 32
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local origin = frame:PointToObjectSpace(start)
	local delta = frame:VectorToObjectSpace(finish - start)
	local half = size * 0.5
	local cuts = {0, 1}
	for _, axis in {"X", "Y", "Z"} do
		if math.abs(delta[axis]) &gt; EPSILON then
			for _, sign in {-1, 1} do
				local t = (sign * half[axis] - origin[axis]) / delta[axis]
				if t &gt; 0 and t &lt; 1 then table.insert(cuts, t) end
			end
		end
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local lower, upper = cuts[i], cuts[i + 1]
		local midpoint = (lower + upper) * 0.5
		local a, b, c = 0, 0, -radius * radius
		for _, axis in {"X", "Y", "Z"} do
			local p = origin[axis] + delta[axis] * midpoint
			if math.abs(p) &gt; half[axis] then
				local offset = origin[axis] - (if p &gt; 0 then half[axis] else -half[axis])
				a += delta[axis] * delta[axis]
				b += 2 * delta[axis] * offset
				c += offset * offset
			end
		end
		if (a * lower + b) * lower + c &lt;= EPSILON then return lower end
		if a &gt; EPSILON then
			local discriminant = b * b - 4 * a * c
			if discriminant &gt;= -EPSILON then
				local root = (-b - math.sqrt(math.max(discriminant, 0))) / (2 * a)
				if root &gt;= lower - EPSILON and root &lt;= upper + EPSILON then return math.clamp(root, lower, upper) end
			end
		end
	end
	return nil
end

return table.freeze(Geometry)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF4"><Properties><string name="Name">Guard</string><ProtectedString name="Source">--!strict
local Guard = {}

function Guard.Number(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Guard.Integer(value: any, minimum: number, maximum: number): boolean
	return Guard.Number(value) and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end

function Guard.Vector(value: any, limit: number?): boolean
	if typeof(value) ~= "Vector3" then return false end
	local bound = limit or 1e7
	return Guard.Number(value.X) and Guard.Number(value.Y) and Guard.Number(value.Z)
		and math.abs(value.X) &lt;= bound and math.abs(value.Y) &lt;= bound and math.abs(value.Z) &lt;= bound
end

function Guard.Frame(value: any, limit: number?): boolean
	if typeof(value) ~= "CFrame" or not Guard.Vector(value.Position, limit) then return false end
	for _, component in {value:GetComponents()} do
		if not Guard.Number(component) then return false end
	end
	-- CFrame.new accepts explicit matrix entries. Reject scaled/sheared/reflected matrices.
	local x,y,z=value.RightVector,value.UpVector,value.ZVector
	return math.abs(x.Magnitude-1)&lt;1e-4 and math.abs(y.Magnitude-1)&lt;1e-4
		and math.abs(z.Magnitude-1)&lt;1e-4 and math.abs(x:Dot(y))&lt;1e-4
		and math.abs(y:Dot(z))&lt;1e-4 and math.abs(z:Dot(x))&lt;1e-4
		and x:Cross(y):Dot(z)&gt;0.9999
end

function Guard.Size(value: any, maximum: number?): boolean
	return Guard.Vector(value, maximum or 512) and value.X &gt; 0 and value.Y &gt; 0 and value.Z &gt; 0
end

function Guard.Unit(value: any): boolean
	return Guard.Vector(value, 1.01) and math.abs(value.Magnitude - 1) &lt;= 0.001
end

return table.freeze(Guard)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF5"><Properties><string name="Name">Help</string><ProtectedString name="Source">-- Help text only. Looking up a message never changes a hit check or trusts a position.
local Help={}
local terms={
	{"authoritative","Server decides","The server makes or checks the value used to decide a hit. A player cannot make a position valid just by sending it.","A tackle uses a position your server movement code has checked."},
	{"server","Server","The computer running the shared game rules for all players. In Studio Play, you can switch between the server and a player's client.","The server decides who gets the ball."},
	{"client","Client","One player's running copy of the game. It handles input, the camera and what that player sees.","A LocalScript reads the tackle button."},
	{"history","Saved past positions","A short list of earlier positions, hitboxes and game values, with the time of each record. Chrono keeps these in memory and later removes old records.","Keep the last 0.6 seconds so a check can use an earlier position."},
	{"snapshot","One saved record","The position, hitboxes and game values of one object at one time.","At time 10.2, the ball was here and the player was on team 2."},
	{"actor","Tracked object","Anything Chrono checks: a player, a ball, an NPC or another game object. It does not have to be a character.","Register the football as kind ball."},
	{"provider","Function that supplies data","A function you write. Chrono calls it to get an object's position, hitboxes and game values.","Read a ball position calculated by your server and return a sphere around it."},
	{"adapter","Connection to your game code","A small piece of code that connects Chrono calls to the scripts your game already uses. Bindings is the generated module for these connections.","When your move script accepts a tackle, start a Chrono action."},
	{"bindings","Connections to your game code","The functions that connect your players, moves and rules to Chrono. The setup creates a Bindings module for you to edit.","Call Bindings.Track when your game adds a player."},
	{"callback","Function given to another function","A function Chrono calls when it needs data or a rule result. The function must finish without task.wait or waiting for an event.","eligible = function(source, target) return source.team ~= target.team end"},
	{"root","Reference position","The main position and direction from which an object's hitboxes are measured. It is a CFrame value; it need not be a part named HumanoidRootPart.","For a ball, its center can be the root."},
	{"cframe","Position and direction (CFrame)","A Roblox value that stores both where something is and which way it faces.","CFrame.new(0, 0, -3) places a local hitbox 3 studs in front."},
	{"local space","Relative to an object","Measure a shape from the object's reference position and facing direction. It moves with that object.","A tackle box stays 3 studs in front of the player."},
	{"world space","Position in the map","Measure a shape in the map's coordinate system, rather than from one object.","A provider returns the ball hitbox at the ball's map position."},
	{"state","Game values saved with a position","Small values your hit rules need at that time. Use true/false, numbers or short text. Do not put Instances or nested tables here.","{active=true, team=2, invulnerable=false}"},
	{"eligible","Allowed by your game rules","A target can count only if the rules you supply allow it. Your game must also check its current rules before applying the result.","A teammate or an invulnerable player may be excluded."},
	{"hitbox","Shape used to check contact","An invisible shape your gameplay uses to decide whether a move reaches an object. It may be simpler than the visible model.","A sphere can represent a football."},
	{"capsule","Cylinder with round ends","A shape like a cylinder with a half-sphere at each end. Height includes both round ends and must be at least twice the radius.","A simple body hitbox can have radius 1.5 and total height 5 studs."},
	{"radius","Center-to-edge distance","The distance from the center of a ball or circular part to its edge. Diameter is twice this value.","Radius 1.5 means a ball is 3 studs wide."},
	{"ray","Line check","A line from a start point to an end point. It has no thickness.","A straight instant-shot check can use a ray."},
	{"sweep","Shape checked along a path","Check a ball all along a straight line, rather than only at its final position. Other objects are held at the one saved time being checked.","A thick straight attack can use a swept sphere."},
	{"interpolation","Estimate between saved positions","If the requested time lies between two records, Chrono estimates a position between them. It refuses to guess across a large gap or an uncertain change.","Records at 10.0 and 10.05 can estimate a pose at 10.025."},
	{"coverage","Enough saved data for the requested time","Chrono has suitable records around that time and its time, change and shape checks pass. This does not prove your supplied positions were honest.","A covered check with zero contacts means a checked miss."},
	{"rewind","Check an earlier position","Use saved records from before the latest update. This is off by default and needs a timing rule supplied by your server.","Your approved timing rule may allow checking 0.08 seconds earlier."},
	{"lag compensation","Use earlier data to account for delay","A game policy that can let an input use an earlier position because messages took time to travel. Chrono does not choose a fair time automatically.","Decide how much delay your game allows before rejecting an old request."},
	{"latency","Message travel delay","The time a message takes to travel. Ping usually measures a round trip, not one direction.","50 ms each way adds about 100 ms to a round trip."},
	{"epoch","Position-record version","A number that changes when tracking is reset. Older records cannot silently be used after that reset.","A respawn starts a new version of the player's position records."},
	{"discontinuity","Approved tracking reset","A real change where earlier positions must no longer connect to later ones. Your game reports it with Discontinuity after approving the change.","Teleport, respawn, or a change in who simulates an object."},
	{"quarantine","Pause one object's recording","Chrono stops using an object's records after its data function fails or returns bad data. Fix the cause, report the approved reset, then record again.","Do not reset tracking repeatedly just to hide a faulty data function."},
	{"network ownership","Who calculates Roblox physics","Roblox can let a player's client calculate an object's physics. Reading that result on the server alone does not prove it was a legal move.","Your server still needs to check player movement used to decide competitive hits."},
	{"stud","Roblox distance unit","A unit for size and distance in Roblox Studio.","A default Part is 4 studs wide along its X axis."},
	{"hz","Updates per second (Hz)","How often something is updated each second. Chrono's rate setting sizes its storage; your script still calls Capture.","60 Hz means 60 updates in one second."},
	{"handle","Move reference returned by Chrono","The value BeginAction returns after it accepts a move. Keep it and pass it to Query and EndAction. Do not create your own table as a replacement.","local move, reason = chrono:BeginAction(playerId, profile)"},
	{"capture","Save one update","Capture asks each registered object's data function for a position record. Your game calls it after all participating objects finish the same server update.","chrono:Capture()"},
	{"query","Check a move","Query checks the move reference you kept from BeginAction. It returns allowed contacts or a reason explaining why the check could not complete.","local result = chrono:Query(move)"},
	{"profile","Settings for one move","A plain Luau table describing the shape, target types, timing, target limit and rules for a move.","The generated Actions.Contact table is one profile."},
	{"contact","One returned target","A tracked object whose saved hitbox touched the move's shape and passed the supplied rules. Your game still decides whether to apply its current result.","result.contacts[1].id is the first returned object id."},
	{"active window","Time when the move may hit","The time from opens to closes, counted after your server starts the move.","opens=0.12 and closes=0.35 allow checks from 120 to 350 ms after the start."},
	{"id","One object's name in your code","A stable short text label for a particular registered object. Keep it unique while that object is tracked.","player-12 is an id; player is its kind."},
	{"kind","Group name for similar objects","A short text label for an object type. A move's targets list uses these labels to choose which groups to check.","Register a ball with kind='ball'; use targets={'ball'} to check that group."},
	{"unverified","Data not approved for hits","The default label for positions whose server-side calculation or validation has not been established. Chrono refuses gameplay checks that need them.","Selecting a Part in Studio creates only an unverified reference."},
	{"serverSimulated","Data calculated by your server","Use this trust label only when your own server code actually calculates the positions used for hit checks.","A server-owned ball simulation supplies its position."},
	{"serverValidated","Data checked by your server","Use this trust label only after your server actually verifies the supplied positions and hitboxes against the rules your game requires.","Your existing movement checks reject impossible client moves before their data reaches Chrono."},
	{"ModuleScript","A reusable code file","A Roblox code file that returns a value when another script calls require on it. Installing the generated main module does not automatically connect it to your game.","local startChrono = require(game.ServerScriptService.ChronoV3Integration)"},
	{"boolean","True or false","A value with only two choices. Useful for saved rules such as whether a player is active or invulnerable.","state = {active=true, invulnerable=false}"},
	{"hitscan","Instant line check","Check a straight line immediately. There is no simulated bullet flying along that path over later frames.","The Instant line check preset creates a ray-shaped query."},
	{"source","Object doing the move","The registered object whose saved position and facing direction place the move's hitbox.","The tackling player is the source; the player or ball being checked is a target."},
	{"target","Object the move may touch","A registered object of a kind listed in the move's targets. Its saved hitbox is checked against the move.","A kick can target the ball kind."},
	{"jitter","Changing message delay","Messages do not all take the same time to arrive. This makes updates arrive at uneven intervals.","Studio's Network Simulator can add different jitter in each direction."},
	{"packet loss","Dropped network packets","Some small pieces of network data do not arrive. Reliable messages can be resent, which adds delay; unreliable updates may stay missing.","0.5% means half of one percent, not 50%."},
}
for _,entry in terms do table.freeze(entry) end
Help.Terms=table.freeze(terms)
local messages={
	captured={"Positions saved","The supplied positions passed the recording checks.","Continue updating the game, then call Capture again after the next update."},
	covered={"Hitbox check completed","There was enough saved data for this check. Zero returned contacts means nothing was touched.","Use the returned contacts only after checking your game's current rules."},
	capture_required={"No positions saved yet","Chrono needs a recorded starting position before it can start a move.","Register your objects with Track. Call Capture once before accepting move requests, then after each game update."},
	capture_stale={"Positions are not recent enough","The game has not saved a recent enough update for this check.","Call Capture after every required server update. Check for stopped loops or functions that wait."},
	clock_fault={"The time function failed","The clock did not return a usable number.","Use the default clock, or return time in seconds from one consistent server clock."},
	clock_reversed={"Time moved backwards","The clock is earlier than the latest saved update.","Use the same server clock for saving positions and checking moves. Do not mix different clocks."},
	invalid_capture_time={"Cannot record this time","The supplied time is too far behind the clock, in the future, or not a valid number.","Use Capture() with its default time first. For a fixed-step simulation, pass a recent server time in the same clock system."},
	non_monotonic={"This update is not newer","Chrono already saved this time or a later time.","Record once per simulation step, in increasing time order. Do not record the same step twice."},
	actor_missing={"Object is not registered","The move's source id was not found.","Call Track for this id before starting the move. Keep the same id spelling in both calls."},
	unverified_source={"The move's position is not approved","The object's data is marked unverified, so it cannot be used to decide gameplay.","Connect data your server actually calculates or validates. Only then choose the matching trust label. Changing the label alone does not validate movement."},
	unverified_target={"A target's position is not approved","One object of a target kind is marked unverified. Chrono refuses a partial result.","Supply checked data for that target kind, or correct which kinds the move should check. Selected Studio references stay unverified."},
	invalid_profile={"Move settings are not usable","A shape, distance limit, active time, target count or rule function is invalid.","Check the Actions module. Times must be ordered, dimensions positive, and maxReach large enough for the full shape."},
	target_kinds_required={"Choose which object types to check","The move needs at least one target kind.","Set targets to a list such as {\"player\", \"ball\"}. Use the kind names passed to Track."},
	invalid_target_kind={"An object type name is invalid","A target kind must be a short nonempty string.","Use the same short kind names in Track and the move's targets list."},
	world_provider_or_shape={"The obstacle check is not connected","world=true needs an obstacle-data function and a ray or moving-ball query.","Connect the world function for a sweep. For an overlap move, implement your game's obstruction rule. Do not disable an obstacle rule just to make a failed check pass."},
	rewind_rejected={"The earlier check time was refused","Your server timing function failed or requested more time than allowed.","Return a delay between zero and maxRewind from your server timing rule. Check request age and never trust a client's time without validation."},
	action_capacity={"Too many moves are still open","This object or service has reached its limit for open move references.","Call EndAction when a move ends or is cancelled. Continue Capture so old moves are removed."},
	invalid_action={"The move reference is no longer valid","It was ended, removed, expired, or was not created by this Chrono instance.","Keep the value BeginAction returns. Start a new move only after your server accepts a new move request."},
	roster_changed={"The tracked object list changed","An object was added or removed after this move started. This version cancels older move references for safety.","End the old move. Let your game decide whether a new move can start after the next saved update."},
	source_epoch_changed={"The moving object was reset","A teleport, respawn or data error changed its position-record version.","End the old move. Fix data errors if present, save the new position, then let your server authorize another move."},
	not_active={"It is too early for this move to hit","The move's hit period has not started yet.","Keep saving positions. Query again during opens to closes, or correct those times in Actions."},
	action_expired={"The move's hit period has ended","This move can no longer return a contact.","Call EndAction. Start a new move only when your game authorizes one."},
	duplicate_query={"This update was already checked","This move already completed a check using the latest saved update.","Wait for your game's next update and Capture before querying this move again. Do not apply the same result twice."},
	action_spent={"The move reached its contact limit","It already returned the total number of targets allowed for this move.","End this move or wait for its normal cancellation. Change maxTargets only if your game is meant to allow more contacts."},
	shape_out_of_bounds={"The hitbox is outside the supported range","The shape could not be placed safely at the recorded root position.","Check its position, size and distance from the root. Very large map coordinates also need a precision review."},
	world_unknown={"Obstacle data is missing or uncertain","The optional obstacle function could not prove what was clear or blocked at this time.","Check your world function and its saved obstacle data. It must report covered, blocked and fraction. Include a check for starting inside an obstacle."},
	rules_fault={"The target rule function failed","eligible must finish immediately and return exactly true or false.","Check the function in Actions. Remove waiting calls and fix its errors. Save needed rule values in the snapshot state."},
	capture_fault={"Some positions were not saved","One or more object functions failed or returned unusable data. See the faults list for object ids and reasons.","Explain each item in result.faults. Fix its cause, then report an approved tracking reset for that object."},
	provider_fault={"The position function failed","The function given to Track threw an error or tried to wait.","Check that function for errors. Return root, zones and state immediately. Do not use task.wait or wait for events inside it."},
	quarantined={"Recording for this object is paused","An earlier position function failed. Chrono keeps refusing it until you deliberately reset tracking.","Find and fix the first error. Then call Discontinuity for that object and Capture again. Do not reset every frame."},
	invalid_snapshot={"The position record is not usable","The supplied table or a value it contains could not be read safely.","Return a plain table with root=CFrame, zones={...}, and optional flat state={...}. Check the data function for errors."},
	invalid_state={"Saved game values are not usable","State must contain only true/false values, finite numbers or short text, with string keys.","Save values such as team=2 and active=true. Do not save Instances, nested tables or NaN numbers in state."},
	invalid_zones={"The hitbox list is not usable","There are too many zones or a zone name is invalid.","Return 1 to 32 named shapes. Zone names must be strings up to 64 bytes."},
	invalid_zone={"One hitbox is not usable","A target zone must be a valid box, sphere or capsule.","Build it with Core.Shapes.Box, Sphere or Capsule. Check frame, size, radius and height."},
	empty_zones={"The object has no hitbox","At least one target shape is required in each saved record.","Return a named hitbox in zones, such as zones={Body=S.Sphere(frame,1)}."},
	zone_out_of_bounds={"A hitbox is too far from its object","Its root-to-shape distance plus full outside extent exceeds maxRadius.","Check the world-space hitbox position. Increase maxRadius only to match the real maximum extent your game allows."},
	speed_bound={"The object moved farther than allowed","The root travelled farther than maxSpeed allows between saved updates.","Check your movement data and speed setting. For a game-approved teleport, explicitly reset tracking. Do not raise the limit to accept unexplained movement."},
	empty={"No position records are available","There is no usable record for this object yet.","Track it, supply a valid position function and call Capture before querying it."},
	too_old={"The requested position was not kept","The requested time is before the oldest stored record.","Use a more recent approved time. Check seconds, rate, capture frequency and how long messages are delayed."},
	not_recorded={"That time has not been recorded","The requested time is later than this object's latest saved position.","Check provider faults and simulation order. Capture the shared game update before querying it."},
	expired={"The requested time is too old","The requested time exceeds the configured age limit.","Reject or retry according to your game rules. Only increase the age limit after choosing a fair delay policy."},
	future={"The requested time is in the future","The requested position is later than the server's current clock.","Use a consistent server clock and validate any client-reported times."},
	invalid_time={"The time value is not usable","A time is not a finite number.","Pass time in seconds from the same server clock used by Capture."},
	epoch_changed={"Earlier position records were reset","The requested exact record belongs to an older tracking version.","Do not use records from before a teleport, respawn or approved reset. Capture the new state before a new move."},
	discontinuity={"The requested time crosses a reset","Chrono cannot connect records across a teleport, respawn or tracking failure.","Use a time wholly within the current tracking version. Do not guess a path through the reset."},
	sample_gap={"Saved positions are too far apart","There is too much missing time between the two records needed for this check.","Check capture frequency and stalled updates. Refuse the uncertain check rather than treating it as a miss or a hit."},
	state_boundary={"A game value changed between records","For example, invulnerability changed between the two saved times. Chrono cannot prove its value at the requested time.","Record transitions at their actual server time. Expect uncertain in-between requests to be refused."},
	geometry_boundary={"A hitbox changed between records","A zone was added, removed, resized or changed shape between those times.","Record shape changes at their actual time. Do not interpolate a different shape through the change."},
}
for _,entry in messages do table.freeze(entry) end
Help.Messages=table.freeze(messages)
function Help.Explain(value)
	local code=if type(value)=="table" then value.reason else value
	if type(code)~="string" then code="unknown" end
	local key,subject=code,nil
	if code:sub(1,7)=="source_" and messages[code]==nil then key=code:sub(8) subject="Object doing the move"
	elseif code:sub(1,7)=="target_" and messages[code]==nil then key=code:sub(8) subject="Possible target" end
	local entry=messages[key]
	return table.freeze({code=code,known=entry~=nil,subject=subject,
		title=if entry then entry[1] else "More information is needed",
		meaning=if entry then entry[2] else "This message is not in the built-in help list. Keep the original code when reporting it.",
		fix=if entry then entry[3] else "Check Studio Output and the documentation. Include the original message and a small example when asking for help."})
end
function Help.FindTerms(query)
	local result={} local q=string.lower(if type(query)=="string" then query else "")
	for _,entry in terms do if q=="" or (string.lower(table.concat(entry," "))):find(q,1,true) then table.insert(result,entry) end end
	return result
end
return table.freeze(Help)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF6"><Properties><string name="Name">History</string><ProtectedString name="Source">--!strict
local Guard=require(script.Parent.Guard)
local Contract=require(script.Parent.Contract)
local Shapes=require(script.Parent.Shapes)
local H={} H.__index=H
function H.new(options)
	return setmetatable({rows=table.create(options.capacity),head=1,count=0,capacity=options.capacity,
		epoch=1,maxAge=options.seconds,maxGap=options.maxGap,maxSpeed=options.maxSpeed,
		maxRadius=options.maxRadius,boundary=-math.huge},H)
end
function H:_at(i) return self.rows[(self.head+i-2)%self.capacity+1] end
function H:Latest() return if self.count&gt;0 then self:_at(self.count) else nil end
function H:Break(time)
	self.epoch+=1 self.boundary=time
end
function H:Push(time,snapshot)
	if type(snapshot)~="table" or not Guard.Frame(snapshot.root) or type(snapshot.zones)~="table" then return false,"invalid_snapshot" end
	local state=Contract.State(snapshot.state or {})
	if not state then return false,"invalid_state" end
	local zones,count={},0
	for name,shape in snapshot.zones do
		count+=1
		if count&gt;32 or type(name)~="string" or #name&gt;64 then return false,"invalid_zones" end
		local zone=Shapes.Copy(shape,true)
		if not zone then return false,"invalid_zone" end
		if (zone.frame.Position-snapshot.root.Position).Magnitude+Shapes.Radius(zone)&gt;self.maxRadius+1e-5 then return false,"zone_out_of_bounds" end
		zones[name]=zone
	end
	if count==0 then return false,"empty_zones" end
	local latest=self:Latest()
	if time&lt;self.boundary or (latest and time&lt;=latest.time) then return false,"non_monotonic" end
	if latest and latest.epoch==self.epoch and (snapshot.root.Position-latest.root.Position).Magnitude&gt;self.maxSpeed*(time-latest.time)+1e-4 then return false,"speed_bound" end
	local row=table.freeze({time=time,root=snapshot.root,zones=table.freeze(zones),state=state,epoch=self.epoch})
	if self.count&lt;self.capacity then self.count+=1 self.rows[(self.head+self.count-2)%self.capacity+1]=row
	else self.rows[self.head]=row self.head=self.head%self.capacity+1 end
	return true
end
function H:Sample(time,now)
	if not Guard.Number(time) or not Guard.Number(now) then return nil,"invalid_time" end
	if time&gt;now+1e-6 then return nil,"future" end
	if now-time&gt;self.maxAge then return nil,"expired" end
	if self.count==0 then return nil,"empty" end
	if time&lt;self:_at(1).time then return nil,"too_old" end
	if time&gt;self:Latest().time then return nil,"not_recorded" end
	local low,high=1,self.count
	while low&lt;=high do local mid=(low+high)//2 if self:_at(mid).time&lt;time then low=mid+1 else high=mid-1 end end
	local after=self:_at(low)
	if after.time==time then
		if after.epoch~=self.epoch then return nil,"epoch_changed" end
		return after
	end
	local before=self:_at(low-1)
	if before.epoch~=after.epoch or after.epoch~=self.epoch then return nil,"discontinuity" end
	if after.time-before.time&gt;self.maxGap then return nil,"sample_gap" end
	if not Contract.SameState(before.state,after.state) then return nil,"state_boundary" end
	local alpha=(time-before.time)/(after.time-before.time)
	local zones={}
	for name,zone in before.zones do
		local nextZone=after.zones[name]
		if not nextZone or not Shapes.SameDimensions(zone,nextZone) then return nil,"geometry_boundary" end
		zones[name]=Shapes.Lerp(zone,nextZone,alpha)
	end
	for name in after.zones do if not before.zones[name] then return nil,"geometry_boundary" end end
	return table.freeze({time=time,root=before.root:Lerp(after.root,alpha),state=before.state,
		zones=table.freeze(zones),epoch=before.epoch})
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF7"><Properties><string name="Name">Shapes</string><ProtectedString name="Source">--!strict
-- Geometry uses studs, seconds, world CFrames, and closed volumes (tangency counts).
local Guard = require(script.Parent.Guard)
local G = require(script.Parent.Geometry)
local S = {}
local EPS = 1e-7
local function positive(v, maximum)
	return Guard.Number(v) and v &gt; 0 and v &lt;= maximum
end
function S.Copy(s, targetOnly)
	if type(s) ~= "table" then return nil end
	if s.kind == "box" and Guard.Frame(s.frame) and Guard.Size(s.size, 512) then
		return table.freeze({kind="box", frame=s.frame, size=s.size})
	elseif s.kind == "sphere" and Guard.Frame(s.frame) and positive(s.radius,32) then
		return table.freeze({kind="sphere", frame=s.frame, radius=s.radius})
	elseif s.kind == "capsule" and Guard.Frame(s.frame) and positive(s.radius,32)
		and positive(s.height,512) and s.height &gt;= s.radius*2 then
		return table.freeze({kind="capsule", frame=s.frame, radius=s.radius, height=s.height})
	elseif not targetOnly and s.kind == "sweep" and Guard.Vector(s.start) and Guard.Vector(s.finish)
		and Guard.Number(s.radius) and s.radius &gt;= 0 and s.radius &lt;= 32
		and (s.finish-s.start).Magnitude &lt;= 4096 then
		return table.freeze({kind="sweep", start=s.start, finish=s.finish, radius=s.radius})
	end
	return nil
end
local function checked(s) return assert(S.Copy(s), "invalid Chrono shape") end
function S.Box(frame, size) return checked({kind="box",frame=frame,size=size}) end
function S.Sphere(frame, radius) return checked({kind="sphere",frame=frame,radius=radius}) end
function S.Capsule(frame, radius, height) return checked({kind="capsule",frame=frame,radius=radius,height=height}) end
function S.Sweep(start, finish, radius) return checked({kind="sweep",start=start,finish=finish,radius=radius}) end
function S.Ray(start, finish) return S.Sweep(start,finish,0) end
function S.At(shape, frame)
	assert(Guard.Frame(frame), "invalid reference frame")
	local out = table.clone(shape)
	if out.kind == "sweep" then
		out.start, out.finish = frame:PointToWorldSpace(out.start), frame:PointToWorldSpace(out.finish)
	else out.frame = frame*out.frame end
	return checked(out)
end
function S.Radius(s)
	if s.kind == "box" then return s.size.Magnitude*0.5 end
	if s.kind == "capsule" then return s.height*0.5 end
	return s.radius
end
function S.Reach(s)
	if s.kind == "sweep" then return math.max(s.start.Magnitude,s.finish.Magnitude)+s.radius end
	return s.frame.Position.Magnitude+S.Radius(s)
end
function S.SameDimensions(a,b)
	return a.kind==b.kind and a.size==b.size and a.radius==b.radius and a.height==b.height
end
function S.Lerp(a,b,alpha)
	local out=table.clone(a) out.frame=a.frame:Lerp(b.frame,alpha)
	return table.freeze(out)
end
local function ends(c)
	local offset=c.frame.UpVector*(c.height*0.5-c.radius)
	return c.frame.Position-offset,c.frame.Position+offset
end
-- Closest distance between two closed segments, including zero length segments.
local function segmentPair(p1,q1,p2,q2)
	local d1,d2,r=q1-p1,q2-p2,p1-p2
	local a,e,f=d1:Dot(d1),d2:Dot(d2),d2:Dot(r)
	local s,t=0,0
	if a&lt;=1e-12 and e&lt;=1e-12 then return r:Dot(r) end
	if a&lt;=1e-12 then t=math.clamp(f/e,0,1)
	else
		local c=d1:Dot(r)
		if e&lt;=1e-12 then s=math.clamp(-c/a,0,1)
		else
			local b=d1:Dot(d2) local denominator=a*e-b*b
			if denominator&gt;1e-12 then s=math.clamp((b*f-c*e)/denominator,0,1) end
			t=(b*s+f)/e
			if t&lt;0 then t=0 s=math.clamp(-c/a,0,1)
			elseif t&gt;1 then t=1 s=math.clamp((b-c)/a,0,1) end
		end
	end
	local delta=r+d1*s-d2*t
	return delta:Dot(delta)
end
local function raySphere(p,q,center,radius)
	local d,m=q-p,p-center
	local a,c=d:Dot(d),m:Dot(m)-radius*radius
	if c&lt;=EPS then return 0 end
	if a&lt;1e-12 then return nil end
	local b=m:Dot(d) local h=b*b-a*c
	if h&lt;0 then return nil end
	local t=(-b-math.sqrt(h))/a
	if t&gt;=0 and t&lt;=1 then return t end
	return nil
end
-- Point swept against a capsule. Split where projection onto its axis clamps.
-- On each piece, squared distance to the segment is a quadratic in t.
local function rayCapsule(p,q,a,b,radius)
	local axis,d,m=b-a,q-p,p-a
	local length2=axis:Dot(axis)
	if length2&lt;1e-12 then return raySphere(p,q,a,radius) end
	local u0,du=m:Dot(axis)/length2,d:Dot(axis)/length2
	local cuts={0,1}
	if math.abs(du)&gt;1e-12 then
		for _,u in {0,1} do local t=(u-u0)/du if t&gt;0 and t&lt;1 then table.insert(cuts,t) end end
	end
	table.sort(cuts)
	for i=1,#cuts-1 do
		local lower,upper=cuts[i],cuts[i+1]
		local u=u0+du*(lower+upper)*0.5
		local v,w
		if u&lt;0 then v,w=m,d elseif u&gt;1 then v,w=p-b,d
		else v,w=m-axis*u0,d-axis*du end
		local aa,bb,cc=w:Dot(w),2*v:Dot(w),v:Dot(v)-radius*radius
		if (aa*lower+bb)*lower+cc&lt;=EPS then return lower end
		if aa&gt;1e-12 then
			local discriminant=bb*bb-4*aa*cc
			if discriminant&gt;=0 then
				local t=(-bb-math.sqrt(discriminant))/(2*aa)
				if t&gt;=lower-EPS and t&lt;=upper+EPS then return math.clamp(t,lower,upper) end
			end
		end
	end
	return nil
end
local function boxBox(a,b)
	local aa={a.frame.RightVector,a.frame.UpVector,a.frame.ZVector}
	local ba={b.frame.RightVector,b.frame.UpVector,b.frame.ZVector}
	local axes={aa[1],aa[2],aa[3],ba[1],ba[2],ba[3]}
	for _,u in aa do for _,v in ba do table.insert(axes,u:Cross(v)) end end
	local halfA,halfB=a.size*0.5,b.size*0.5
	local dimsA,dimsB={halfA.X,halfA.Y,halfA.Z},{halfB.X,halfB.Y,halfB.Z}
	local delta=b.frame.Position-a.frame.Position
	for _,axis in axes do
		if axis.Magnitude&gt;1e-7 then
			axis=axis.Unit local ra,rb=0,0
			for i=1,3 do ra+=dimsA[i]*math.abs(axis:Dot(aa[i])) rb+=dimsB[i]*math.abs(axis:Dot(ba[i])) end
			if math.abs(delta:Dot(axis))&gt;ra+rb+EPS then return false end
		end
	end
	return true
end
-- Returns the first travel fraction for a sweep, or zero for volume overlap.
-- This is exact for supplied primitives at one time; it is not continuous actor motion.
function S.Intersect(a,b)
	if a.kind=="sweep" then
		if b.kind=="box" then return G.SphereSweepOBB(a.start,a.finish,a.radius,b.frame,b.size) end
		if b.kind=="sphere" then return raySphere(a.start,a.finish,b.frame.Position,a.radius+b.radius) end
		local p,q=ends(b) return rayCapsule(a.start,a.finish,p,q,a.radius+b.radius)
	end
	local hit=false
	if a.kind=="box" and b.kind=="box" then hit=boxBox(a,b)
	elseif a.kind=="sphere" and b.kind=="sphere" then
		hit=(a.frame.Position-b.frame.Position).Magnitude&lt;=a.radius+b.radius+EPS
	elseif a.kind=="capsule" and b.kind=="capsule" then
		local p,q=ends(a) local r,s=ends(b)
		hit=segmentPair(p,q,r,s)&lt;=(a.radius+b.radius)^2+EPS
	elseif a.kind=="box" or b.kind=="box" then
		local box,other=if a.kind=="box" then a else b,if a.kind=="box" then b else a
		local p,q=other.frame.Position,other.frame.Position
		if other.kind=="capsule" then p,q=ends(other) end
		hit=G.SphereSweepOBB(p,q,other.radius,box.frame,box.size)~=nil
	else
		local sphere,cap=if a.kind=="sphere" then a else b,if a.kind=="sphere" then b else a
		local p,q=ends(cap)
		hit=G.SegmentDistanceSquared(p,q,sphere.frame.Position)&lt;=(sphere.radius+cap.radius)^2+EPS
	end
	return if hit then 0 else nil
end
return table.freeze(S)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF8"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Editor help and autocomplete. Runtime checks still validate every supplied value.
export type State = {[string]: boolean | number | string}
export type Volume = {kind: "box", frame: CFrame, size: Vector3}
	| {kind: "sphere", frame: CFrame, radius: number}
	| {kind: "capsule", frame: CFrame, radius: number, height: number}
export type Sweep = {kind: "sweep", start: Vector3, finish: Vector3, radius: number}
export type Snapshot = {root: CFrame, zones: {[string]: Volume}, state: State?}
export type Binding = {
	kind: string,
	capture: (serverTime: number) -&gt; Snapshot,
	trust: ("unverified" | "serverSimulated" | "serverValidated")?,
	maxSpeed: number,
	maxRadius: number,
}
export type Profile = {
	shape: Volume | Sweep,
	targets: {string},
	opens: number?,
	closes: number?,
	maxTargets: number?,
	maxReach: number?,
	eligible: ((source: State, target: State, targetId: string, targetKind: string) -&gt; boolean)?,
	world: boolean?,
}
-- Keep the value BeginAction returns; do not make your own table for a move reference.
export type Move = {}
export type Contact = {id: string, kind: string, zone: string, time: number, epoch: number,
	state: State, root: CFrame, distance: number, fraction: number}
export type Result = {ok: boolean, reason: string, contacts: {Contact}, time: number?,
	capturedAt: number?, rewind: number?, source: any?, shape: (Volume | Sweep)?, actor: string?}
export type CaptureResult = {ok: boolean, reason: string, time: number?,
	faults: {{id: string, reason: string}}?, contacts: {Contact}}
export type Options = {
	seconds: number?, rate: number?, maxGap: number?, maxRewind: number?,
	clock: (() -&gt; number)?,
	resolveRewind: ((actorId: string, approvedServerContext: any, captureTime: number) -&gt; number)?,
	world: ((queryTime: number, now: number, shape: Sweep) -&gt; {covered: boolean, blocked: boolean?, fraction: number?})?,
}
export type Explanation = {code: string, known: boolean, subject: string?, title: string, meaning: string, fix: string}
export type Service = {
	Track: (self: Service, id: string, binding: Binding) -&gt; (),
	Untrack: (self: Service, id: string) -&gt; boolean,
	Discontinuity: (self: Service, id: string, reason: string?) -&gt; (),
	Capture: (self: Service, serverTime: number?) -&gt; CaptureResult,
	BeginAction: (self: Service, actorId: string, profile: Profile, approvedServerContext: any?) -&gt; (Move?, string?),
	Query: (self: Service, move: Move) -&gt; Result,
	EndAction: (self: Service, move: Move) -&gt; boolean,
	Inspect: (self: Service) -&gt; any,
	Destroy: (self: Service) -&gt; (),
}
return table.freeze({})
</ProtectedString></Properties></Item></Item><Item class="Script" referent="CF9"><Properties><string name="Name">Setup</string><ProtectedString name="Source">-- Packaged as a Script with Core and Editor children. Save as Local Plugin in Studio.
assert(plugin,"Save this Script as a Local Plugin")
local toolbar=plugin:CreateToolbar("Chrono V3")
local toggle=toolbar:CreateButton("ChronoSetup","Connect Chrono to your existing game","")
toggle.ClickableWhenViewportHidden=true
local widget=plugin:CreateDockWidgetPluginGuiAsync("ChronoV3Setup-3.1",DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right,false,false,500,800,360,480))
widget.Title="Chrono V3 • Step-by-step setup"
local view=require(script.Editor.View).Mount(widget,{core=script.Core,
 onInstalled=function(object) game:GetService("Selection"):Set({object}) end,
 openScript=function(object)
  game:GetService("Selection"):Set({object})
  if object:IsA("LuaSourceContainer") then
   local opened,reason=game:GetService("ScriptEditorService"):OpenScriptDocumentAsync(object)
   assert(opened,reason)
  end
 end})
toggle.Click:Connect(function() widget.Enabled=not widget.Enabled end)
plugin.Unloading:Connect(function() view.Destroy() widget:Destroy() end)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF10"><Properties><string name="Name">Core</string><ProtectedString name="Source">--!strict
-- Chrono V3: server historical contact evidence. No automatic gameplay/network side effects.
local Guard=require(script.Guard)
local Contract=require(script.Contract)
local History=require(script.History)
local Shapes=require(script.Shapes)
local Types=require(script.Types)
local API={Shapes=Shapes,Version="3.1.0"}
-- Optional explanation helper. It never changes the result or runs a hit check.
function API.Explain(reason: (string | {reason: string})?): Types.Explanation return require(script.Help).Explain(reason) end
local Methods={} Methods.__index=Methods
local private=setmetatable({}, {__mode="k"})
local function session(self)
	local s=assert(private[self],"This Chrono instance was destroyed, or the call used the wrong object.")
	assert(not s.inCallback,"Do not call Chrono again from inside a position or rule function. Return its data first.")
	return s
end
local function call(s,callback,...)
	s.inCallback=true
	local out=table.pack(Contract.Call(callback,...))
	s.inCallback=false
	return table.unpack(out,1,out.n)
end
local function bounded(n,lo,hi) return Guard.Number(n) and n&gt;=lo and n&lt;=hi end
local function name(n) return type(n)=="string" and #n&gt;0 and #n&lt;=64 end
local function frozenResult(ok,reason,fields)
	local out=fields or {} out.ok=ok out.reason=reason
	if not out.contacts then out.contacts=table.freeze({}) end
	return table.freeze(out)
end
local function failure(s,reason,fields)
	s.stats.rejected+=1 s.stats.lastRejection=reason
	return frozenResult(false,reason,fields)
end
local function fresh(s)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return nil,"clock_fault" end
	if not s.time then return nil,"capture_required" end
	if now&lt;s.time-1e-6 then return nil,"clock_reversed" end
	if now-s.time&gt;s.maxGap then return nil,"capture_stale" end
	return now
end
function API.new(options: Types.Options?): Types.Service
	assert(game:GetService("RunService"):IsServer(),"Chrono V3 runs on the server")
	local o=options or {}
	local seconds,rate,gap=o.seconds or 0.6,o.rate or 60,o.maxGap or 0.075
	assert(bounded(seconds,0.05,10) and bounded(rate,1,240) and bounded(gap,0.001,1),"Use seconds=0.05 to 10, rate=1 to 240, and maxGap=0.001 to 1. These control saved-position storage.")
	assert(bounded(o.maxRewind or 0,0,seconds),"maxRewind must be zero or a positive number no greater than seconds (the time you keep past positions).")
	assert(o.clock==nil or type(o.clock)=="function","clock must be a function that returns server time in seconds, or leave it unset.")
	assert(o.resolveRewind==nil or type(o.resolveRewind)=="function","resolveRewind must be a function that returns an approved earlier-time delay, or leave it unset.")
	assert(o.world==nil or type(o.world)=="function","world must be an obstacle-check function, or leave it unset.")
	local self=setmetatable({},Methods)
	private[self]={clock=o.clock or function() return workspace:GetServerTimeNow() end,
		seconds=seconds,capacity=math.ceil(rate*seconds)+2,maxGap=gap,maxRewind=o.maxRewind or 0,
		resolveRewind=o.resolveRewind,world=o.world,actors={},actions={},actionCount=0,roster=0,
		stats={captures=0,queries=0,accepted=0,rejected=0,contacts=0,providerFaults=0,lastRejection="none"}}
	return self :: any -- Public method types help Studio autocomplete; checks above still run.
end
function Methods:Track(id,binding)
	local s=session(self)
	assert(name(id) and type(binding)=="table" and name(binding.kind),"Track needs short text id and kind names. Example: id='player-12', kind='player'.")
	assert(not s.actors[id],"This id is already tracked. Call Untrack before deliberately registering a replacement.")
	assert(type(binding.capture)=="function","Track needs capture=function(time) ... end to supply the object's position, hitboxes and game values.")
	assert(bounded(binding.maxSpeed,0,4096) and bounded(binding.maxRadius,0.001,512),"Set maxSpeed from 0 to 4096 studs/second and maxRadius from 0.001 to 512 studs. They must describe your allowed movement and hitbox extent.")
	local trust=binding.trust or "unverified"
	assert(trust=="unverified" or trust=="serverValidated" or trust=="serverSimulated","Use trust='unverified', 'serverValidated' or 'serverSimulated'. Choose a trusted label only after your server actually checks or calculates the data.")
	local count=0 for _ in s.actors do count+=1 end assert(count&lt;256,"This instance already tracks 256 objects. Remove objects no longer needed before adding another.")
	s.actors[id]={id=id,kind=binding.kind,capture=binding.capture,trust=trust,status="awaiting_capture",faults=0,
		history=History.new({seconds=s.seconds,capacity=s.capacity,maxGap=s.maxGap,maxSpeed=binding.maxSpeed,maxRadius=binding.maxRadius})}
	s.roster+=1
end
function Methods:Untrack(id)
	local s=session(self) if not s.actors[id] then return false end
	s.actors[id]=nil s.roster+=1 return true
end
function Methods:Discontinuity(id,reason)
	local s=session(self) local actor=assert(s.actors[id],"actor not tracked")
	local ok,now=call(s,s.clock) assert(ok and Guard.Number(now),"clock fault")
	actor.history:Break(math.max(now,s.time or now)) actor.status=reason or "discontinuity" actor.quarantined=false
end
-- Invoke after your authoritative simulation. All providers must describe the same instant.
-- An optional timestamp supports a fixed-step server simulation using this clock domain.
function Methods:Capture(time)
	local s=session(self)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return frozenResult(false,"clock_fault") end
	time=time or now
	if not Guard.Number(time) or time&gt;now+1e-6 or now-time&gt;s.maxGap then return frozenResult(false,"invalid_capture_time") end
	if s.time and time&lt;=s.time then return frozenResult(false,"non_monotonic") end
	s.time=time s.stats.captures+=1
	local faults={}
	for id,actor in s.actors do
		if actor.quarantined then table.insert(faults,table.freeze({id=id,reason="quarantined"})) continue end
		local called,snapshot=call(s,actor.capture,time)
		local pushed,reason=false,"provider_fault"
		if called then
			-- Validation itself can encounter an erroneous table metamethod from an adapter.
			local validated,accepted,why=call(s,function() return actor.history:Push(time,snapshot) end)
			pushed=validated and accepted==true
			reason=if validated then why else "invalid_snapshot"
		end
		if not pushed then
			actor.history:Break(time) actor.faults+=1 s.stats.providerFaults+=1
			actor.status=reason actor.quarantined=true table.insert(faults,table.freeze({id=id,reason=reason}))
		else actor.status="captured" end
	end
	for token,action in s.actions do
		if time&gt;action.started+action.close or action.roster~=s.roster then s.actions[token]=nil s.actionCount-=1 end
	end
	return frozenResult(#faults==0,if #faults==0 then "captured" else "capture_fault",{time=time,faults=table.freeze(faults)})
end
-- Call only after your existing server move/action service authorizes the action.
-- No client-facing RemoteEvent is created. Context is consumed only by YOUR timing resolver.
function Methods:BeginAction(actorId,profile,approvedContext)
	local s=session(self) local now,err=fresh(s)
	if not now then return nil,err end
	local actor=s.actors[actorId] if not actor then return nil,"actor_missing" end
	if actor.trust=="unverified" then return nil,"unverified_source" end
	if type(profile)~="table" then return nil,"invalid_profile" end
	local shape=Shapes.Copy(profile.shape)
	local opening,closing=profile.opens or 0,profile.closes or 0.25
	if not shape or not bounded(opening,0,10) or not bounded(closing,opening,10)
		or not bounded(profile.maxReach or 32,0,4096) or Shapes.Reach(shape)&gt;(profile.maxReach or 32)
		or not Guard.Integer(profile.maxTargets or 1,1,256) then return nil,"invalid_profile" end
	if profile.eligible~=nil and type(profile.eligible)~="function" then return nil,"invalid_profile" end
	if profile.world~=nil and type(profile.world)~="boolean" then return nil,"invalid_profile" end
	if profile.world and (not s.world or shape.kind~="sweep") then return nil,"world_provider_or_shape" end
	if type(profile.targets)~="table" then return nil,"target_kinds_required" end
	local kinds,count={},0
	for _,kind in profile.targets do
		if not name(kind) then return nil,"invalid_target_kind" end kinds[kind]=true count+=1
	end
	if count==0 or count&gt;32 then return nil,"target_kinds_required" end
	local rewind=0
	if s.resolveRewind then
		local resolved,value=call(s,s.resolveRewind,actorId,approvedContext,s.time)
		if not resolved or not bounded(value,0,s.maxRewind) then return nil,"rewind_rejected" end rewind=value
	end
	local source,reason=actor.history:Sample(s.time-rewind,now)
	if not source then return nil,"source_"..reason end
	local actorActions=0 for _,a in s.actions do if a.actor==actorId then actorActions+=1 end end
	if s.actionCount&gt;=512 or actorActions&gt;=4 then return nil,"action_capacity" end
	local token=table.freeze({})
	s.actions[token]={actor=actorId,epoch=actor.history.epoch,roster=s.roster,started=s.time,
		open=opening,close=closing,shape=shape,kinds=table.freeze(kinds),eligible=profile.eligible,
		world=profile.world==true,maxTargets=profile.maxTargets or 1,rewind=rewind,hit={},totalHits=0}
	s.actionCount+=1
	return token
end
function Methods:EndAction(token)
	local s=session(self) if not s.actions[token] then return false end
	s.actions[token]=nil s.actionCount-=1 return true
end
function Methods:Query(token)
	local s=session(self) s.stats.queries+=1
	local action=s.actions[token] if not action then return failure(s,"invalid_action") end
	local now,err=fresh(s) if not now then return failure(s,err) end
	if action.roster~=s.roster then return failure(s,"roster_changed") end
	local actor=s.actors[action.actor]
	if not actor or actor.history.epoch~=action.epoch then return failure(s,"source_epoch_changed") end
	local elapsed=s.time-action.started
	if elapsed&lt;action.open then return failure(s,"not_active") end
	if elapsed&gt;action.close then return failure(s,"action_expired") end
	if action.lastTime==s.time then return failure(s,"duplicate_query") end
	if action.totalHits&gt;=action.maxTargets then return failure(s,"action_spent") end
	local time=s.time-action.rewind
	local source,reason=actor.history:Sample(time,now)
	if not source then return failure(s,"source_"..reason) end
	local transformed,query=Contract.Call(Shapes.At,action.shape,source.root)
	if not transformed then return failure(s,"shape_out_of_bounds") end
	local fraction=1 local blocked=false
	if action.world then
		local called,cover=call(s,s.world,time,now,query)
		if not called or type(cover)~="table" or cover.covered~=true or type(cover.blocked)~="boolean"
			or not bounded(cover.fraction,0,1) then return failure(s,"world_unknown") end
		blocked=cover.blocked fraction=if blocked then cover.fraction else 1
	end
	local contacts={}
	for id,target in s.actors do
		if id==action.actor or not action.kinds[target.kind] or action.hit[id] then continue end
		-- A missing target can hide a closer contact. Never return a partial success.
		if target.trust=="unverified" then return failure(s,"unverified_target",{actor=id}) end
		local snapshot,why=target.history:Sample(time,now)
		if not snapshot then return failure(s,"target_"..why,{actor=id}) end
		if action.eligible then
			local called,allowed=call(s,action.eligible,source.state,snapshot.state,id,target.kind)
			if not called or type(allowed)~="boolean" then return failure(s,"rules_fault",{actor=id}) end
			if not allowed then continue end
		end
		local best,zoneName=nil,nil
		for zone,volume in snapshot.zones do
			local t=Shapes.Intersect(query,volume)
			-- Cover wins exact ties. With no cover callback, include sweep endpoint tangency.
			if t and (t&lt;fraction or (not blocked and t&lt;=fraction)) and (not best or t&lt;best or (t==best and zone&lt;zoneName)) then best=t zoneName=zone end
		end
		if best then
			local distance=if query.kind=="sweep" then (query.finish-query.start).Magnitude*best else 0
			table.insert(contacts,table.freeze({id=id,kind=target.kind,zone=zoneName,distance=distance,fraction=best,
				time=time,epoch=snapshot.epoch,state=snapshot.state,root=snapshot.root}))
		end
	end
	table.sort(contacts,function(a,b) if a.fraction~=b.fraction then return a.fraction&lt;b.fraction end return a.id&lt;b.id end)
	while #contacts&gt;action.maxTargets-action.totalHits do table.remove(contacts) end
	-- Commit duplicate suppression only after every relevant provider/rule/world check passed.
	for _,contact in contacts do action.hit[contact.id]=true end
	action.totalHits+=#contacts action.lastTime=s.time
	s.stats.accepted+=1 s.stats.contacts+=#contacts
	return frozenResult(true,"covered",{time=time,capturedAt=s.time,rewind=action.rewind,source=source,
		contacts=table.freeze(contacts),shape=query})
end
function Methods:Inspect()
	local s=session(self) local actors={}
	for id,a in s.actors do
		local row=a.history:Latest()
		table.insert(actors,table.freeze({id=id,kind=a.kind,declaredTrust=a.trust,status=a.status,
			captured=row~=nil,latest=if row then row.time else nil,epoch=a.history.epoch,faults=a.faults}))
	end
	table.sort(actors,function(a,b) return a.id&lt;b.id end)
	return table.freeze({version=API.Version,time=s.time,actors=table.freeze(actors),activeActions=s.actionCount,
		stats=table.freeze(table.clone(s.stats)),worldEnabled=s.world~=nil,maxRewind=s.maxRewind})
end
function Methods:Destroy() session(self) private[self]=nil end
return table.freeze(API)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF11"><Properties><string name="Name">Contract</string><ProtectedString name="Source">--!strict
-- These guards contain yielding adapters. They cannot preempt an infinite CPU loop.
local Guard = require(script.Parent.Guard)
local Contract = {}
function Contract.Call(callback, ...)
	if type(callback) ~= "function" then return false, "callback_missing" end
	local thread = coroutine.create(callback)
	local result = table.pack(coroutine.resume(thread, ...))
	if not result[1] then return false, tostring(result[2]) end
	if coroutine.status(thread) ~= "dead" then
		coroutine.close(thread)
		return false, "callback_yielded"
	end
	return true, table.unpack(result, 2, result.n)
end
function Contract.State(state)
	if type(state) ~= "table" then return nil end
	local result, count = {}, 0
	for key, value in state do
		count += 1
		if count &gt; 32 or type(key) ~= "string" or #key &gt; 64 then return nil end
		if type(value) == "number" then
			if not Guard.Number(value) or math.abs(value) &gt; 1e12 then return nil end
		elseif type(value) == "string" then
			if #value &gt; 128 then return nil end
		elseif type(value) ~= "boolean" then return nil end
		result[key] = value
	end
	return table.freeze(result)
end
function Contract.SameState(a, b)
	for k, v in a do if b[k] ~= v then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end
return table.freeze(Contract)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF12"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
local Guard = require(script.Parent.Guard)
local Geometry = {}
local EPSILON = 1e-9

function Geometry.SegmentDistanceSquared(start: Vector3,finish: Vector3,point: Vector3): number
	local delta=finish-start
	local lengthSquared=delta:Dot(delta)
	local alpha=if lengthSquared&gt;1e-12 then math.clamp((point-start):Dot(delta)/lengthSquared,0,1) else 0
	local offset=point-(start+delta*alpha)
	return offset:Dot(offset)
end

function Geometry.RayOBB(origin: Vector3, direction: Vector3, length: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(origin) or not Guard.Unit(direction) or not Guard.Number(length) or length &lt; 0
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local o, d, half = frame:PointToObjectSpace(origin), frame:VectorToObjectSpace(direction), size * 0.5
	local enter, leave = 0, length
	for _, axis in {"X", "Y", "Z"} do
		local start, delta, extent = o[axis], d[axis], half[axis]
		if math.abs(delta) &lt; EPSILON then
			if math.abs(start) &gt; extent then return nil end
		else
			local a, b = (-extent - start) / delta, (extent - start) / delta
			if a &gt; b then a, b = b, a end
			enter, leave = math.max(enter, a), math.min(leave, b)
			if enter &gt; leave then return nil end
		end
	end
	return enter
end

-- Exact moving sphere vs a stationary OBB, including rounded edges/corners.
-- Split the ray at box-plane crossings; point-to-box distance is quadratic on each interval.
function Geometry.SphereSweepOBB(start: Vector3, finish: Vector3, radius: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(start) or not Guard.Vector(finish) or not Guard.Number(radius) or radius &lt; 0 or radius &gt; 32
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local origin = frame:PointToObjectSpace(start)
	local delta = frame:VectorToObjectSpace(finish - start)
	local half = size * 0.5
	local cuts = {0, 1}
	for _, axis in {"X", "Y", "Z"} do
		if math.abs(delta[axis]) &gt; EPSILON then
			for _, sign in {-1, 1} do
				local t = (sign * half[axis] - origin[axis]) / delta[axis]
				if t &gt; 0 and t &lt; 1 then table.insert(cuts, t) end
			end
		end
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local lower, upper = cuts[i], cuts[i + 1]
		local midpoint = (lower + upper) * 0.5
		local a, b, c = 0, 0, -radius * radius
		for _, axis in {"X", "Y", "Z"} do
			local p = origin[axis] + delta[axis] * midpoint
			if math.abs(p) &gt; half[axis] then
				local offset = origin[axis] - (if p &gt; 0 then half[axis] else -half[axis])
				a += delta[axis] * delta[axis]
				b += 2 * delta[axis] * offset
				c += offset * offset
			end
		end
		if (a * lower + b) * lower + c &lt;= EPSILON then return lower end
		if a &gt; EPSILON then
			local discriminant = b * b - 4 * a * c
			if discriminant &gt;= -EPSILON then
				local root = (-b - math.sqrt(math.max(discriminant, 0))) / (2 * a)
				if root &gt;= lower - EPSILON and root &lt;= upper + EPSILON then return math.clamp(root, lower, upper) end
			end
		end
	end
	return nil
end

return table.freeze(Geometry)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF13"><Properties><string name="Name">Guard</string><ProtectedString name="Source">--!strict
local Guard = {}

function Guard.Number(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Guard.Integer(value: any, minimum: number, maximum: number): boolean
	return Guard.Number(value) and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end

function Guard.Vector(value: any, limit: number?): boolean
	if typeof(value) ~= "Vector3" then return false end
	local bound = limit or 1e7
	return Guard.Number(value.X) and Guard.Number(value.Y) and Guard.Number(value.Z)
		and math.abs(value.X) &lt;= bound and math.abs(value.Y) &lt;= bound and math.abs(value.Z) &lt;= bound
end

function Guard.Frame(value: any, limit: number?): boolean
	if typeof(value) ~= "CFrame" or not Guard.Vector(value.Position, limit) then return false end
	for _, component in {value:GetComponents()} do
		if not Guard.Number(component) then return false end
	end
	-- CFrame.new accepts explicit matrix entries. Reject scaled/sheared/reflected matrices.
	local x,y,z=value.RightVector,value.UpVector,value.ZVector
	return math.abs(x.Magnitude-1)&lt;1e-4 and math.abs(y.Magnitude-1)&lt;1e-4
		and math.abs(z.Magnitude-1)&lt;1e-4 and math.abs(x:Dot(y))&lt;1e-4
		and math.abs(y:Dot(z))&lt;1e-4 and math.abs(z:Dot(x))&lt;1e-4
		and x:Cross(y):Dot(z)&gt;0.9999
end

function Guard.Size(value: any, maximum: number?): boolean
	return Guard.Vector(value, maximum or 512) and value.X &gt; 0 and value.Y &gt; 0 and value.Z &gt; 0
end

function Guard.Unit(value: any): boolean
	return Guard.Vector(value, 1.01) and math.abs(value.Magnitude - 1) &lt;= 0.001
end

return table.freeze(Guard)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF14"><Properties><string name="Name">Help</string><ProtectedString name="Source">-- Help text only. Looking up a message never changes a hit check or trusts a position.
local Help={}
local terms={
	{"authoritative","Server decides","The server makes or checks the value used to decide a hit. A player cannot make a position valid just by sending it.","A tackle uses a position your server movement code has checked."},
	{"server","Server","The computer running the shared game rules for all players. In Studio Play, you can switch between the server and a player's client.","The server decides who gets the ball."},
	{"client","Client","One player's running copy of the game. It handles input, the camera and what that player sees.","A LocalScript reads the tackle button."},
	{"history","Saved past positions","A short list of earlier positions, hitboxes and game values, with the time of each record. Chrono keeps these in memory and later removes old records.","Keep the last 0.6 seconds so a check can use an earlier position."},
	{"snapshot","One saved record","The position, hitboxes and game values of one object at one time.","At time 10.2, the ball was here and the player was on team 2."},
	{"actor","Tracked object","Anything Chrono checks: a player, a ball, an NPC or another game object. It does not have to be a character.","Register the football as kind ball."},
	{"provider","Function that supplies data","A function you write. Chrono calls it to get an object's position, hitboxes and game values.","Read a ball position calculated by your server and return a sphere around it."},
	{"adapter","Connection to your game code","A small piece of code that connects Chrono calls to the scripts your game already uses. Bindings is the generated module for these connections.","When your move script accepts a tackle, start a Chrono action."},
	{"bindings","Connections to your game code","The functions that connect your players, moves and rules to Chrono. The setup creates a Bindings module for you to edit.","Call Bindings.Track when your game adds a player."},
	{"callback","Function given to another function","A function Chrono calls when it needs data or a rule result. The function must finish without task.wait or waiting for an event.","eligible = function(source, target) return source.team ~= target.team end"},
	{"root","Reference position","The main position and direction from which an object's hitboxes are measured. It is a CFrame value; it need not be a part named HumanoidRootPart.","For a ball, its center can be the root."},
	{"cframe","Position and direction (CFrame)","A Roblox value that stores both where something is and which way it faces.","CFrame.new(0, 0, -3) places a local hitbox 3 studs in front."},
	{"local space","Relative to an object","Measure a shape from the object's reference position and facing direction. It moves with that object.","A tackle box stays 3 studs in front of the player."},
	{"world space","Position in the map","Measure a shape in the map's coordinate system, rather than from one object.","A provider returns the ball hitbox at the ball's map position."},
	{"state","Game values saved with a position","Small values your hit rules need at that time. Use true/false, numbers or short text. Do not put Instances or nested tables here.","{active=true, team=2, invulnerable=false}"},
	{"eligible","Allowed by your game rules","A target can count only if the rules you supply allow it. Your game must also check its current rules before applying the result.","A teammate or an invulnerable player may be excluded."},
	{"hitbox","Shape used to check contact","An invisible shape your gameplay uses to decide whether a move reaches an object. It may be simpler than the visible model.","A sphere can represent a football."},
	{"capsule","Cylinder with round ends","A shape like a cylinder with a half-sphere at each end. Height includes both round ends and must be at least twice the radius.","A simple body hitbox can have radius 1.5 and total height 5 studs."},
	{"radius","Center-to-edge distance","The distance from the center of a ball or circular part to its edge. Diameter is twice this value.","Radius 1.5 means a ball is 3 studs wide."},
	{"ray","Line check","A line from a start point to an end point. It has no thickness.","A straight instant-shot check can use a ray."},
	{"sweep","Shape checked along a path","Check a ball all along a straight line, rather than only at its final position. Other objects are held at the one saved time being checked.","A thick straight attack can use a swept sphere."},
	{"interpolation","Estimate between saved positions","If the requested time lies between two records, Chrono estimates a position between them. It refuses to guess across a large gap or an uncertain change.","Records at 10.0 and 10.05 can estimate a pose at 10.025."},
	{"coverage","Enough saved data for the requested time","Chrono has suitable records around that time and its time, change and shape checks pass. This does not prove your supplied positions were honest.","A covered check with zero contacts means a checked miss."},
	{"rewind","Check an earlier position","Use saved records from before the latest update. This is off by default and needs a timing rule supplied by your server.","Your approved timing rule may allow checking 0.08 seconds earlier."},
	{"lag compensation","Use earlier data to account for delay","A game policy that can let an input use an earlier position because messages took time to travel. Chrono does not choose a fair time automatically.","Decide how much delay your game allows before rejecting an old request."},
	{"latency","Message travel delay","The time a message takes to travel. Ping usually measures a round trip, not one direction.","50 ms each way adds about 100 ms to a round trip."},
	{"epoch","Position-record version","A number that changes when tracking is reset. Older records cannot silently be used after that reset.","A respawn starts a new version of the player's position records."},
	{"discontinuity","Approved tracking reset","A real change where earlier positions must no longer connect to later ones. Your game reports it with Discontinuity after approving the change.","Teleport, respawn, or a change in who simulates an object."},
	{"quarantine","Pause one object's recording","Chrono stops using an object's records after its data function fails or returns bad data. Fix the cause, report the approved reset, then record again.","Do not reset tracking repeatedly just to hide a faulty data function."},
	{"network ownership","Who calculates Roblox physics","Roblox can let a player's client calculate an object's physics. Reading that result on the server alone does not prove it was a legal move.","Your server still needs to check player movement used to decide competitive hits."},
	{"stud","Roblox distance unit","A unit for size and distance in Roblox Studio.","A default Part is 4 studs wide along its X axis."},
	{"hz","Updates per second (Hz)","How often something is updated each second. Chrono's rate setting sizes its storage; your script still calls Capture.","60 Hz means 60 updates in one second."},
	{"handle","Move reference returned by Chrono","The value BeginAction returns after it accepts a move. Keep it and pass it to Query and EndAction. Do not create your own table as a replacement.","local move, reason = chrono:BeginAction(playerId, profile)"},
	{"capture","Save one update","Capture asks each registered object's data function for a position record. Your game calls it after all participating objects finish the same server update.","chrono:Capture()"},
	{"query","Check a move","Query checks the move reference you kept from BeginAction. It returns allowed contacts or a reason explaining why the check could not complete.","local result = chrono:Query(move)"},
	{"profile","Settings for one move","A plain Luau table describing the shape, target types, timing, target limit and rules for a move.","The generated Actions.Contact table is one profile."},
	{"contact","One returned target","A tracked object whose saved hitbox touched the move's shape and passed the supplied rules. Your game still decides whether to apply its current result.","result.contacts[1].id is the first returned object id."},
	{"active window","Time when the move may hit","The time from opens to closes, counted after your server starts the move.","opens=0.12 and closes=0.35 allow checks from 120 to 350 ms after the start."},
	{"id","One object's name in your code","A stable short text label for a particular registered object. Keep it unique while that object is tracked.","player-12 is an id; player is its kind."},
	{"kind","Group name for similar objects","A short text label for an object type. A move's targets list uses these labels to choose which groups to check.","Register a ball with kind='ball'; use targets={'ball'} to check that group."},
	{"unverified","Data not approved for hits","The default label for positions whose server-side calculation or validation has not been established. Chrono refuses gameplay checks that need them.","Selecting a Part in Studio creates only an unverified reference."},
	{"serverSimulated","Data calculated by your server","Use this trust label only when your own server code actually calculates the positions used for hit checks.","A server-owned ball simulation supplies its position."},
	{"serverValidated","Data checked by your server","Use this trust label only after your server actually verifies the supplied positions and hitboxes against the rules your game requires.","Your existing movement checks reject impossible client moves before their data reaches Chrono."},
	{"ModuleScript","A reusable code file","A Roblox code file that returns a value when another script calls require on it. Installing the generated main module does not automatically connect it to your game.","local startChrono = require(game.ServerScriptService.ChronoV3Integration)"},
	{"boolean","True or false","A value with only two choices. Useful for saved rules such as whether a player is active or invulnerable.","state = {active=true, invulnerable=false}"},
	{"hitscan","Instant line check","Check a straight line immediately. There is no simulated bullet flying along that path over later frames.","The Instant line check preset creates a ray-shaped query."},
	{"source","Object doing the move","The registered object whose saved position and facing direction place the move's hitbox.","The tackling player is the source; the player or ball being checked is a target."},
	{"target","Object the move may touch","A registered object of a kind listed in the move's targets. Its saved hitbox is checked against the move.","A kick can target the ball kind."},
	{"jitter","Changing message delay","Messages do not all take the same time to arrive. This makes updates arrive at uneven intervals.","Studio's Network Simulator can add different jitter in each direction."},
	{"packet loss","Dropped network packets","Some small pieces of network data do not arrive. Reliable messages can be resent, which adds delay; unreliable updates may stay missing.","0.5% means half of one percent, not 50%."},
}
for _,entry in terms do table.freeze(entry) end
Help.Terms=table.freeze(terms)
local messages={
	captured={"Positions saved","The supplied positions passed the recording checks.","Continue updating the game, then call Capture again after the next update."},
	covered={"Hitbox check completed","There was enough saved data for this check. Zero returned contacts means nothing was touched.","Use the returned contacts only after checking your game's current rules."},
	capture_required={"No positions saved yet","Chrono needs a recorded starting position before it can start a move.","Register your objects with Track. Call Capture once before accepting move requests, then after each game update."},
	capture_stale={"Positions are not recent enough","The game has not saved a recent enough update for this check.","Call Capture after every required server update. Check for stopped loops or functions that wait."},
	clock_fault={"The time function failed","The clock did not return a usable number.","Use the default clock, or return time in seconds from one consistent server clock."},
	clock_reversed={"Time moved backwards","The clock is earlier than the latest saved update.","Use the same server clock for saving positions and checking moves. Do not mix different clocks."},
	invalid_capture_time={"Cannot record this time","The supplied time is too far behind the clock, in the future, or not a valid number.","Use Capture() with its default time first. For a fixed-step simulation, pass a recent server time in the same clock system."},
	non_monotonic={"This update is not newer","Chrono already saved this time or a later time.","Record once per simulation step, in increasing time order. Do not record the same step twice."},
	actor_missing={"Object is not registered","The move's source id was not found.","Call Track for this id before starting the move. Keep the same id spelling in both calls."},
	unverified_source={"The move's position is not approved","The object's data is marked unverified, so it cannot be used to decide gameplay.","Connect data your server actually calculates or validates. Only then choose the matching trust label. Changing the label alone does not validate movement."},
	unverified_target={"A target's position is not approved","One object of a target kind is marked unverified. Chrono refuses a partial result.","Supply checked data for that target kind, or correct which kinds the move should check. Selected Studio references stay unverified."},
	invalid_profile={"Move settings are not usable","A shape, distance limit, active time, target count or rule function is invalid.","Check the Actions module. Times must be ordered, dimensions positive, and maxReach large enough for the full shape."},
	target_kinds_required={"Choose which object types to check","The move needs at least one target kind.","Set targets to a list such as {\"player\", \"ball\"}. Use the kind names passed to Track."},
	invalid_target_kind={"An object type name is invalid","A target kind must be a short nonempty string.","Use the same short kind names in Track and the move's targets list."},
	world_provider_or_shape={"The obstacle check is not connected","world=true needs an obstacle-data function and a ray or moving-ball query.","Connect the world function for a sweep. For an overlap move, implement your game's obstruction rule. Do not disable an obstacle rule just to make a failed check pass."},
	rewind_rejected={"The earlier check time was refused","Your server timing function failed or requested more time than allowed.","Return a delay between zero and maxRewind from your server timing rule. Check request age and never trust a client's time without validation."},
	action_capacity={"Too many moves are still open","This object or service has reached its limit for open move references.","Call EndAction when a move ends or is cancelled. Continue Capture so old moves are removed."},
	invalid_action={"The move reference is no longer valid","It was ended, removed, expired, or was not created by this Chrono instance.","Keep the value BeginAction returns. Start a new move only after your server accepts a new move request."},
	roster_changed={"The tracked object list changed","An object was added or removed after this move started. This version cancels older move references for safety.","End the old move. Let your game decide whether a new move can start after the next saved update."},
	source_epoch_changed={"The moving object was reset","A teleport, respawn or data error changed its position-record version.","End the old move. Fix data errors if present, save the new position, then let your server authorize another move."},
	not_active={"It is too early for this move to hit","The move's hit period has not started yet.","Keep saving positions. Query again during opens to closes, or correct those times in Actions."},
	action_expired={"The move's hit period has ended","This move can no longer return a contact.","Call EndAction. Start a new move only when your game authorizes one."},
	duplicate_query={"This update was already checked","This move already completed a check using the latest saved update.","Wait for your game's next update and Capture before querying this move again. Do not apply the same result twice."},
	action_spent={"The move reached its contact limit","It already returned the total number of targets allowed for this move.","End this move or wait for its normal cancellation. Change maxTargets only if your game is meant to allow more contacts."},
	shape_out_of_bounds={"The hitbox is outside the supported range","The shape could not be placed safely at the recorded root position.","Check its position, size and distance from the root. Very large map coordinates also need a precision review."},
	world_unknown={"Obstacle data is missing or uncertain","The optional obstacle function could not prove what was clear or blocked at this time.","Check your world function and its saved obstacle data. It must report covered, blocked and fraction. Include a check for starting inside an obstacle."},
	rules_fault={"The target rule function failed","eligible must finish immediately and return exactly true or false.","Check the function in Actions. Remove waiting calls and fix its errors. Save needed rule values in the snapshot state."},
	capture_fault={"Some positions were not saved","One or more object functions failed or returned unusable data. See the faults list for object ids and reasons.","Explain each item in result.faults. Fix its cause, then report an approved tracking reset for that object."},
	provider_fault={"The position function failed","The function given to Track threw an error or tried to wait.","Check that function for errors. Return root, zones and state immediately. Do not use task.wait or wait for events inside it."},
	quarantined={"Recording for this object is paused","An earlier position function failed. Chrono keeps refusing it until you deliberately reset tracking.","Find and fix the first error. Then call Discontinuity for that object and Capture again. Do not reset every frame."},
	invalid_snapshot={"The position record is not usable","The supplied table or a value it contains could not be read safely.","Return a plain table with root=CFrame, zones={...}, and optional flat state={...}. Check the data function for errors."},
	invalid_state={"Saved game values are not usable","State must contain only true/false values, finite numbers or short text, with string keys.","Save values such as team=2 and active=true. Do not save Instances, nested tables or NaN numbers in state."},
	invalid_zones={"The hitbox list is not usable","There are too many zones or a zone name is invalid.","Return 1 to 32 named shapes. Zone names must be strings up to 64 bytes."},
	invalid_zone={"One hitbox is not usable","A target zone must be a valid box, sphere or capsule.","Build it with Core.Shapes.Box, Sphere or Capsule. Check frame, size, radius and height."},
	empty_zones={"The object has no hitbox","At least one target shape is required in each saved record.","Return a named hitbox in zones, such as zones={Body=S.Sphere(frame,1)}."},
	zone_out_of_bounds={"A hitbox is too far from its object","Its root-to-shape distance plus full outside extent exceeds maxRadius.","Check the world-space hitbox position. Increase maxRadius only to match the real maximum extent your game allows."},
	speed_bound={"The object moved farther than allowed","The root travelled farther than maxSpeed allows between saved updates.","Check your movement data and speed setting. For a game-approved teleport, explicitly reset tracking. Do not raise the limit to accept unexplained movement."},
	empty={"No position records are available","There is no usable record for this object yet.","Track it, supply a valid position function and call Capture before querying it."},
	too_old={"The requested position was not kept","The requested time is before the oldest stored record.","Use a more recent approved time. Check seconds, rate, capture frequency and how long messages are delayed."},
	not_recorded={"That time has not been recorded","The requested time is later than this object's latest saved position.","Check provider faults and simulation order. Capture the shared game update before querying it."},
	expired={"The requested time is too old","The requested time exceeds the configured age limit.","Reject or retry according to your game rules. Only increase the age limit after choosing a fair delay policy."},
	future={"The requested time is in the future","The requested position is later than the server's current clock.","Use a consistent server clock and validate any client-reported times."},
	invalid_time={"The time value is not usable","A time is not a finite number.","Pass time in seconds from the same server clock used by Capture."},
	epoch_changed={"Earlier position records were reset","The requested exact record belongs to an older tracking version.","Do not use records from before a teleport, respawn or approved reset. Capture the new state before a new move."},
	discontinuity={"The requested time crosses a reset","Chrono cannot connect records across a teleport, respawn or tracking failure.","Use a time wholly within the current tracking version. Do not guess a path through the reset."},
	sample_gap={"Saved positions are too far apart","There is too much missing time between the two records needed for this check.","Check capture frequency and stalled updates. Refuse the uncertain check rather than treating it as a miss or a hit."},
	state_boundary={"A game value changed between records","For example, invulnerability changed between the two saved times. Chrono cannot prove its value at the requested time.","Record transitions at their actual server time. Expect uncertain in-between requests to be refused."},
	geometry_boundary={"A hitbox changed between records","A zone was added, removed, resized or changed shape between those times.","Record shape changes at their actual time. Do not interpolate a different shape through the change."},
}
for _,entry in messages do table.freeze(entry) end
Help.Messages=table.freeze(messages)
function Help.Explain(value)
	local code=if type(value)=="table" then value.reason else value
	if type(code)~="string" then code="unknown" end
	local key,subject=code,nil
	if code:sub(1,7)=="source_" and messages[code]==nil then key=code:sub(8) subject="Object doing the move"
	elseif code:sub(1,7)=="target_" and messages[code]==nil then key=code:sub(8) subject="Possible target" end
	local entry=messages[key]
	return table.freeze({code=code,known=entry~=nil,subject=subject,
		title=if entry then entry[1] else "More information is needed",
		meaning=if entry then entry[2] else "This message is not in the built-in help list. Keep the original code when reporting it.",
		fix=if entry then entry[3] else "Check Studio Output and the documentation. Include the original message and a small example when asking for help."})
end
function Help.FindTerms(query)
	local result={} local q=string.lower(if type(query)=="string" then query else "")
	for _,entry in terms do if q=="" or (string.lower(table.concat(entry," "))):find(q,1,true) then table.insert(result,entry) end end
	return result
end
return table.freeze(Help)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF15"><Properties><string name="Name">History</string><ProtectedString name="Source">--!strict
local Guard=require(script.Parent.Guard)
local Contract=require(script.Parent.Contract)
local Shapes=require(script.Parent.Shapes)
local H={} H.__index=H
function H.new(options)
	return setmetatable({rows=table.create(options.capacity),head=1,count=0,capacity=options.capacity,
		epoch=1,maxAge=options.seconds,maxGap=options.maxGap,maxSpeed=options.maxSpeed,
		maxRadius=options.maxRadius,boundary=-math.huge},H)
end
function H:_at(i) return self.rows[(self.head+i-2)%self.capacity+1] end
function H:Latest() return if self.count&gt;0 then self:_at(self.count) else nil end
function H:Break(time)
	self.epoch+=1 self.boundary=time
end
function H:Push(time,snapshot)
	if type(snapshot)~="table" or not Guard.Frame(snapshot.root) or type(snapshot.zones)~="table" then return false,"invalid_snapshot" end
	local state=Contract.State(snapshot.state or {})
	if not state then return false,"invalid_state" end
	local zones,count={},0
	for name,shape in snapshot.zones do
		count+=1
		if count&gt;32 or type(name)~="string" or #name&gt;64 then return false,"invalid_zones" end
		local zone=Shapes.Copy(shape,true)
		if not zone then return false,"invalid_zone" end
		if (zone.frame.Position-snapshot.root.Position).Magnitude+Shapes.Radius(zone)&gt;self.maxRadius+1e-5 then return false,"zone_out_of_bounds" end
		zones[name]=zone
	end
	if count==0 then return false,"empty_zones" end
	local latest=self:Latest()
	if time&lt;self.boundary or (latest and time&lt;=latest.time) then return false,"non_monotonic" end
	if latest and latest.epoch==self.epoch and (snapshot.root.Position-latest.root.Position).Magnitude&gt;self.maxSpeed*(time-latest.time)+1e-4 then return false,"speed_bound" end
	local row=table.freeze({time=time,root=snapshot.root,zones=table.freeze(zones),state=state,epoch=self.epoch})
	if self.count&lt;self.capacity then self.count+=1 self.rows[(self.head+self.count-2)%self.capacity+1]=row
	else self.rows[self.head]=row self.head=self.head%self.capacity+1 end
	return true
end
function H:Sample(time,now)
	if not Guard.Number(time) or not Guard.Number(now) then return nil,"invalid_time" end
	if time&gt;now+1e-6 then return nil,"future" end
	if now-time&gt;self.maxAge then return nil,"expired" end
	if self.count==0 then return nil,"empty" end
	if time&lt;self:_at(1).time then return nil,"too_old" end
	if time&gt;self:Latest().time then return nil,"not_recorded" end
	local low,high=1,self.count
	while low&lt;=high do local mid=(low+high)//2 if self:_at(mid).time&lt;time then low=mid+1 else high=mid-1 end end
	local after=self:_at(low)
	if after.time==time then
		if after.epoch~=self.epoch then return nil,"epoch_changed" end
		return after
	end
	local before=self:_at(low-1)
	if before.epoch~=after.epoch or after.epoch~=self.epoch then return nil,"discontinuity" end
	if after.time-before.time&gt;self.maxGap then return nil,"sample_gap" end
	if not Contract.SameState(before.state,after.state) then return nil,"state_boundary" end
	local alpha=(time-before.time)/(after.time-before.time)
	local zones={}
	for name,zone in before.zones do
		local nextZone=after.zones[name]
		if not nextZone or not Shapes.SameDimensions(zone,nextZone) then return nil,"geometry_boundary" end
		zones[name]=Shapes.Lerp(zone,nextZone,alpha)
	end
	for name in after.zones do if not before.zones[name] then return nil,"geometry_boundary" end end
	return table.freeze({time=time,root=before.root:Lerp(after.root,alpha),state=before.state,
		zones=table.freeze(zones),epoch=before.epoch})
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF16"><Properties><string name="Name">Shapes</string><ProtectedString name="Source">--!strict
-- Geometry uses studs, seconds, world CFrames, and closed volumes (tangency counts).
local Guard = require(script.Parent.Guard)
local G = require(script.Parent.Geometry)
local S = {}
local EPS = 1e-7
local function positive(v, maximum)
	return Guard.Number(v) and v &gt; 0 and v &lt;= maximum
end
function S.Copy(s, targetOnly)
	if type(s) ~= "table" then return nil end
	if s.kind == "box" and Guard.Frame(s.frame) and Guard.Size(s.size, 512) then
		return table.freeze({kind="box", frame=s.frame, size=s.size})
	elseif s.kind == "sphere" and Guard.Frame(s.frame) and positive(s.radius,32) then
		return table.freeze({kind="sphere", frame=s.frame, radius=s.radius})
	elseif s.kind == "capsule" and Guard.Frame(s.frame) and positive(s.radius,32)
		and positive(s.height,512) and s.height &gt;= s.radius*2 then
		return table.freeze({kind="capsule", frame=s.frame, radius=s.radius, height=s.height})
	elseif not targetOnly and s.kind == "sweep" and Guard.Vector(s.start) and Guard.Vector(s.finish)
		and Guard.Number(s.radius) and s.radius &gt;= 0 and s.radius &lt;= 32
		and (s.finish-s.start).Magnitude &lt;= 4096 then
		return table.freeze({kind="sweep", start=s.start, finish=s.finish, radius=s.radius})
	end
	return nil
end
local function checked(s) return assert(S.Copy(s), "invalid Chrono shape") end
function S.Box(frame, size) return checked({kind="box",frame=frame,size=size}) end
function S.Sphere(frame, radius) return checked({kind="sphere",frame=frame,radius=radius}) end
function S.Capsule(frame, radius, height) return checked({kind="capsule",frame=frame,radius=radius,height=height}) end
function S.Sweep(start, finish, radius) return checked({kind="sweep",start=start,finish=finish,radius=radius}) end
function S.Ray(start, finish) return S.Sweep(start,finish,0) end
function S.At(shape, frame)
	assert(Guard.Frame(frame), "invalid reference frame")
	local out = table.clone(shape)
	if out.kind == "sweep" then
		out.start, out.finish = frame:PointToWorldSpace(out.start), frame:PointToWorldSpace(out.finish)
	else out.frame = frame*out.frame end
	return checked(out)
end
function S.Radius(s)
	if s.kind == "box" then return s.size.Magnitude*0.5 end
	if s.kind == "capsule" then return s.height*0.5 end
	return s.radius
end
function S.Reach(s)
	if s.kind == "sweep" then return math.max(s.start.Magnitude,s.finish.Magnitude)+s.radius end
	return s.frame.Position.Magnitude+S.Radius(s)
end
function S.SameDimensions(a,b)
	return a.kind==b.kind and a.size==b.size and a.radius==b.radius and a.height==b.height
end
function S.Lerp(a,b,alpha)
	local out=table.clone(a) out.frame=a.frame:Lerp(b.frame,alpha)
	return table.freeze(out)
end
local function ends(c)
	local offset=c.frame.UpVector*(c.height*0.5-c.radius)
	return c.frame.Position-offset,c.frame.Position+offset
end
-- Closest distance between two closed segments, including zero length segments.
local function segmentPair(p1,q1,p2,q2)
	local d1,d2,r=q1-p1,q2-p2,p1-p2
	local a,e,f=d1:Dot(d1),d2:Dot(d2),d2:Dot(r)
	local s,t=0,0
	if a&lt;=1e-12 and e&lt;=1e-12 then return r:Dot(r) end
	if a&lt;=1e-12 then t=math.clamp(f/e,0,1)
	else
		local c=d1:Dot(r)
		if e&lt;=1e-12 then s=math.clamp(-c/a,0,1)
		else
			local b=d1:Dot(d2) local denominator=a*e-b*b
			if denominator&gt;1e-12 then s=math.clamp((b*f-c*e)/denominator,0,1) end
			t=(b*s+f)/e
			if t&lt;0 then t=0 s=math.clamp(-c/a,0,1)
			elseif t&gt;1 then t=1 s=math.clamp((b-c)/a,0,1) end
		end
	end
	local delta=r+d1*s-d2*t
	return delta:Dot(delta)
end
local function raySphere(p,q,center,radius)
	local d,m=q-p,p-center
	local a,c=d:Dot(d),m:Dot(m)-radius*radius
	if c&lt;=EPS then return 0 end
	if a&lt;1e-12 then return nil end
	local b=m:Dot(d) local h=b*b-a*c
	if h&lt;0 then return nil end
	local t=(-b-math.sqrt(h))/a
	if t&gt;=0 and t&lt;=1 then return t end
	return nil
end
-- Point swept against a capsule. Split where projection onto its axis clamps.
-- On each piece, squared distance to the segment is a quadratic in t.
local function rayCapsule(p,q,a,b,radius)
	local axis,d,m=b-a,q-p,p-a
	local length2=axis:Dot(axis)
	if length2&lt;1e-12 then return raySphere(p,q,a,radius) end
	local u0,du=m:Dot(axis)/length2,d:Dot(axis)/length2
	local cuts={0,1}
	if math.abs(du)&gt;1e-12 then
		for _,u in {0,1} do local t=(u-u0)/du if t&gt;0 and t&lt;1 then table.insert(cuts,t) end end
	end
	table.sort(cuts)
	for i=1,#cuts-1 do
		local lower,upper=cuts[i],cuts[i+1]
		local u=u0+du*(lower+upper)*0.5
		local v,w
		if u&lt;0 then v,w=m,d elseif u&gt;1 then v,w=p-b,d
		else v,w=m-axis*u0,d-axis*du end
		local aa,bb,cc=w:Dot(w),2*v:Dot(w),v:Dot(v)-radius*radius
		if (aa*lower+bb)*lower+cc&lt;=EPS then return lower end
		if aa&gt;1e-12 then
			local discriminant=bb*bb-4*aa*cc
			if discriminant&gt;=0 then
				local t=(-bb-math.sqrt(discriminant))/(2*aa)
				if t&gt;=lower-EPS and t&lt;=upper+EPS then return math.clamp(t,lower,upper) end
			end
		end
	end
	return nil
end
local function boxBox(a,b)
	local aa={a.frame.RightVector,a.frame.UpVector,a.frame.ZVector}
	local ba={b.frame.RightVector,b.frame.UpVector,b.frame.ZVector}
	local axes={aa[1],aa[2],aa[3],ba[1],ba[2],ba[3]}
	for _,u in aa do for _,v in ba do table.insert(axes,u:Cross(v)) end end
	local halfA,halfB=a.size*0.5,b.size*0.5
	local dimsA,dimsB={halfA.X,halfA.Y,halfA.Z},{halfB.X,halfB.Y,halfB.Z}
	local delta=b.frame.Position-a.frame.Position
	for _,axis in axes do
		if axis.Magnitude&gt;1e-7 then
			axis=axis.Unit local ra,rb=0,0
			for i=1,3 do ra+=dimsA[i]*math.abs(axis:Dot(aa[i])) rb+=dimsB[i]*math.abs(axis:Dot(ba[i])) end
			if math.abs(delta:Dot(axis))&gt;ra+rb+EPS then return false end
		end
	end
	return true
end
-- Returns the first travel fraction for a sweep, or zero for volume overlap.
-- This is exact for supplied primitives at one time; it is not continuous actor motion.
function S.Intersect(a,b)
	if a.kind=="sweep" then
		if b.kind=="box" then return G.SphereSweepOBB(a.start,a.finish,a.radius,b.frame,b.size) end
		if b.kind=="sphere" then return raySphere(a.start,a.finish,b.frame.Position,a.radius+b.radius) end
		local p,q=ends(b) return rayCapsule(a.start,a.finish,p,q,a.radius+b.radius)
	end
	local hit=false
	if a.kind=="box" and b.kind=="box" then hit=boxBox(a,b)
	elseif a.kind=="sphere" and b.kind=="sphere" then
		hit=(a.frame.Position-b.frame.Position).Magnitude&lt;=a.radius+b.radius+EPS
	elseif a.kind=="capsule" and b.kind=="capsule" then
		local p,q=ends(a) local r,s=ends(b)
		hit=segmentPair(p,q,r,s)&lt;=(a.radius+b.radius)^2+EPS
	elseif a.kind=="box" or b.kind=="box" then
		local box,other=if a.kind=="box" then a else b,if a.kind=="box" then b else a
		local p,q=other.frame.Position,other.frame.Position
		if other.kind=="capsule" then p,q=ends(other) end
		hit=G.SphereSweepOBB(p,q,other.radius,box.frame,box.size)~=nil
	else
		local sphere,cap=if a.kind=="sphere" then a else b,if a.kind=="sphere" then b else a
		local p,q=ends(cap)
		hit=G.SegmentDistanceSquared(p,q,sphere.frame.Position)&lt;=(sphere.radius+cap.radius)^2+EPS
	end
	return if hit then 0 else nil
end
return table.freeze(S)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF17"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Editor help and autocomplete. Runtime checks still validate every supplied value.
export type State = {[string]: boolean | number | string}
export type Volume = {kind: "box", frame: CFrame, size: Vector3}
	| {kind: "sphere", frame: CFrame, radius: number}
	| {kind: "capsule", frame: CFrame, radius: number, height: number}
export type Sweep = {kind: "sweep", start: Vector3, finish: Vector3, radius: number}
export type Snapshot = {root: CFrame, zones: {[string]: Volume}, state: State?}
export type Binding = {
	kind: string,
	capture: (serverTime: number) -&gt; Snapshot,
	trust: ("unverified" | "serverSimulated" | "serverValidated")?,
	maxSpeed: number,
	maxRadius: number,
}
export type Profile = {
	shape: Volume | Sweep,
	targets: {string},
	opens: number?,
	closes: number?,
	maxTargets: number?,
	maxReach: number?,
	eligible: ((source: State, target: State, targetId: string, targetKind: string) -&gt; boolean)?,
	world: boolean?,
}
-- Keep the value BeginAction returns; do not make your own table for a move reference.
export type Move = {}
export type Contact = {id: string, kind: string, zone: string, time: number, epoch: number,
	state: State, root: CFrame, distance: number, fraction: number}
export type Result = {ok: boolean, reason: string, contacts: {Contact}, time: number?,
	capturedAt: number?, rewind: number?, source: any?, shape: (Volume | Sweep)?, actor: string?}
export type CaptureResult = {ok: boolean, reason: string, time: number?,
	faults: {{id: string, reason: string}}?, contacts: {Contact}}
export type Options = {
	seconds: number?, rate: number?, maxGap: number?, maxRewind: number?,
	clock: (() -&gt; number)?,
	resolveRewind: ((actorId: string, approvedServerContext: any, captureTime: number) -&gt; number)?,
	world: ((queryTime: number, now: number, shape: Sweep) -&gt; {covered: boolean, blocked: boolean?, fraction: number?})?,
}
export type Explanation = {code: string, known: boolean, subject: string?, title: string, meaning: string, fix: string}
export type Service = {
	Track: (self: Service, id: string, binding: Binding) -&gt; (),
	Untrack: (self: Service, id: string) -&gt; boolean,
	Discontinuity: (self: Service, id: string, reason: string?) -&gt; (),
	Capture: (self: Service, serverTime: number?) -&gt; CaptureResult,
	BeginAction: (self: Service, actorId: string, profile: Profile, approvedServerContext: any?) -&gt; (Move?, string?),
	Query: (self: Service, move: Move) -&gt; Result,
	EndAction: (self: Service, move: Move) -&gt; boolean,
	Inspect: (self: Service) -&gt; any,
	Destroy: (self: Service) -&gt; (),
}
return table.freeze({})
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="CF18"><Properties><string name="Name">Editor</string></Properties><Item class="ModuleScript" referent="CF19"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Game-neutral data schema. Presets are editable examples, not game adapters.
local C={}
local Fields=require(script.Parent.Fields)
function C.Default()
	return {name="ChronoV3Integration",kind="actor",targets="actor,ball",shape="Capsule",radius=1.5,height=5,
		width=4,depth=5,forward=3,length=100,opens=0.12,closes=0.35,maxTargets=1,
		seconds=0.6,maxGap=0.075,maxRewind=0,maxSpeed=100,maxRadius=16,rules="all"}
end
function C.Preset(preset,previous)
	local c=C.Default() c.name=previous.name
	if preset=="Sports" then c.kind="player" c.targets="player,ball"
	elseif preset=="Melee" then c.shape="Box" c.kind="fighter" c.targets="fighter" c.forward=2 c.rules="team"
	elseif preset=="Hitscan" then c.shape="Ray" c.kind="player" c.targets="player" c.opens=0 c.closes=0.1 c.rules="team" end
	return c
end
local function number(v,lo,hi) return type(v)=="number" and v==v and v&gt;=lo and v&lt;=hi end
function C.ParseNumber(value)
	if type(value)=="number" then return value end
	if type(value)~="string" then return nil end
	local text=value:match("^%s*(.-)%s*$")
	if not text:find("%.") then text=text:gsub(",",".") end
	local result=tonumber(text)
	return if result and result==result and math.abs(result)&lt;math.huge then result else nil
end
function C.Check(c)
	local errors={}
	local function add(field,message) table.insert(errors,{field=field,page=Fields.Items[field].page,message=message}) end
	if type(c)~="table" then add("name","No settings were supplied. Start with an example on page 1.") return errors end
	if type(c.name)~="string" or #c.name==0 or #c.name&gt;48 or c.name:match("^%s*$") or c.name:find('[%c/\\\"]') then add("name","Use a short name without quotation marks, slash or backslash. Spaces are allowed. Example: Football contact.") end
	if type(c.kind)~="string" or #c.kind==0 or #c.kind&gt;48 or c.kind:find("[%s,%c]") then add("kind","Use one short object type name without spaces or commas. Example: player or ball.") end
	local count=0
	if type(c.targets)~="string" or #c.targets&gt;256 then add("targets","Enter target type names, separated by commas. Example: player, ball.")
	else
		for kind in c.targets:gmatch("[^,]+") do
			kind=kind:match("^%s*(.-)%s*$")
			if #kind==0 or #kind&gt;48 or kind:find("[%s%c]") then add("targets","Each target type needs one short name. Use commas between names, not spaces.") break end
			count+=1
		end
		if count==0 or count&gt;16 then add("targets","Enter 1 to 16 target type names. Example: player, ball.") end
	end
	if not table.find({"Box","Sphere","Capsule","Ray","SweptSphere"},c.shape) then add("shape","Choose one of the five hitbox shapes.") end
	local used={opens=true,closes=true,maxTargets=true,seconds=true,maxGap=true,maxRewind=true,maxSpeed=true,maxRadius=true}
	if c.shape=="Box" then used.width=true used.height=true used.depth=true used.forward=true
	elseif c.shape=="Sphere" then used.radius=true used.forward=true
	elseif c.shape=="Capsule" then used.radius=true used.height=true used.forward=true
	elseif c.shape=="Ray" then used.length=true
	elseif c.shape=="SweptSphere" then used.length=true used.radius=true end
	for _,key in Fields.Order do
		local field=Fields.Items[key]
		if used[key] and not number(c[key],field.min,field.max) then add(key,string.format("%s: enter a number from %s to %s %s.",field.label,field.min,field.max,field.unit)) end
	end
	if number(c.maxTargets,1,256) and c.maxTargets%1~=0 then add("maxTargets","The object count must be a whole number, such as 1 or 3.") end
	if number(c.opens,0,10) and number(c.closes,0,10) and c.closes&lt;c.opens then add("closes","Stop time must be the same as, or later than, the time hits start.") end
	if number(c.seconds,0.05,10) and number(c.maxRewind,0,10) and c.maxRewind&gt;c.seconds then add("maxRewind","The allowed past time cannot be longer than the time you keep past positions.") end
	if c.shape=="Capsule" and number(c.height,0.02,64) and number(c.radius,0.01,32) and c.height&lt;c.radius*2 then add("height","A capsule needs height at least twice its radius. Radius 1.5 needs total height 3 or more.") end
	if c.rules~="all" and c.rules~="team" then add("rules","Choose a target rule example.") end
	return errors
end
function C.Validate(c)
	local errors=C.Check(c)
	return #errors==0,if errors[1] then errors[1].message else nil
end
function C.Generate(c)
	local ok,why=C.Validate(c) assert(ok,why)
	local shape
	if c.shape=="Box" then shape=string.format("S.Box(CFrame.new(0,0,-%s),Vector3.new(%s,%s,%s))",c.forward,c.width,c.height,c.depth)
	elseif c.shape=="Sphere" then shape=string.format("S.Sphere(CFrame.new(0,0,-%s),%s)",c.forward,c.radius)
	elseif c.shape=="Capsule" then shape=string.format("S.Capsule(CFrame.new(0,0,-%s),%s,%s)",c.forward,c.radius,c.height)
	else shape=string.format("S.Sweep(Vector3.zero,Vector3.new(0,0,-%s),%s)",c.length,if c.shape=="Ray" then 0 else c.radius) end
	local kinds={} for kind in c.targets:gmatch("[^,%s]+") do table.insert(kinds,string.format("%q",kind)) end
	local rules=if c.rules=="team" then "return source.active == true and target.active == true and source.team ~= nil and target.team ~= nil and source.team ~= target.team" else "return true -- Example only: add the rules your game needs before using real moves."
	local reach=if c.shape=="Ray" then c.length elseif c.shape=="SweptSphere" then c.length+c.radius
		elseif c.shape=="Capsule" then c.forward+c.height/2 elseif c.shape=="Sphere" then c.forward+c.radius
		else c.forward+Vector3.new(c.width,c.height,c.depth).Magnitude/2
	return {
		Actions=string.format([[-- MOVE SETTINGS. Edit these values to match one move in your game.
-- A hitbox is an invisible shape used to check contact.
-- Its position here is measured from the moving object's main position and direction.
local S=require(script.Parent.Core).Shapes
return {
 Contact = {
  shape = %s,
  targets = {%s},
  opens = %s,
  closes = %s,
  maxTargets = %s,
  maxReach = %.9g,
 -- opens/closes: seconds after your server accepts the move.
 -- maxTargets: total different objects this move may return; not a count per frame.
 -- source/target: saved game values from your position functions, such as team and active.
  eligible = function(source, target)
  %s
  end,
 },
}
]],shape,table.concat(kinds,","),c.opens,c.closes,c.maxTargets,reach+0.0001,rules),
		Settings=string.format([[-- RECORDING SETTINGS. These do not control your camera, movement, animation or health.
-- seconds: how long to keep earlier positions and hitboxes in memory.
-- rate: expected updates per second. This sizes the storage; your script still calls Capture.
-- maxGap: largest time gap across which Chrono may estimate an in-between position.
-- maxRewind: largest earlier time your SERVER timing rule may approve. Zero is simplest.
return {seconds=%s,rate=60,maxGap=%s,maxRewind=%s}
-- A larger maxRewind alone does not enable earlier checks.
-- Add a resolveRewind function only after deciding how your server validates delayed requests.
]],c.seconds,c.maxGap,c.maxRewind),
		Bindings=string.format([[-- CONNECT YOUR GAME HERE. This file does not replace your player or move scripts.
-- capture is a function YOU supply. It returns a position, hitboxes and rule values at one time.
-- "unverified": data is not approved for gameplay checks.
-- "serverSimulated": your server calculates the data itself.
-- "serverValidated": your server already checks that the supplied data is allowed.
-- Changing the label does not make a player's movement safe. That check belongs in your game.
return function(chrono)
 local B={}
 function B.Track(id,capture,declaredTrust,kind)
  chrono:Track(id,{kind=kind or %q,capture=capture,trust=declaredTrust or "unverified",maxSpeed=%s,maxRadius=%s})
 end
 -- Optional reference for inspecting a selected Part. It stays unverified.
 -- A server reading a client-controlled Part is not the same as a server checking its movement.
 function B.TrackReference(id,part,kind)
  B.Track(id,function(time)
   return {root=part.CFrame,zones={Body=require(script.Parent.Core).Shapes.Box(part.CFrame,part.Size)},state={}}
  end,"unverified",kind)
 end
 -- CONNECTION 1: when your game adds an object, call B.Track with its data function.
 -- Return {root=mainCFrame,zones={Body=shape},state={active=true,team=1}}.
 -- root is the object's reference position AND direction. Zones use map positions.
 -- state contains simple game values: booleans, numbers and short text, not Instances/tables.
 -- CONNECTION 2: after your server updates all participating objects, call chrono:Capture().
 -- Save once before allowing moves, then after every needed game update.
 -- CONNECTION 3: AFTER your server accepts a move (cooldown, stamina, etc.), call BeginAction.
 -- Keep its returned move reference. During the hit period, call Query with that reference.
 -- CONNECTION 4: if result.ok is true, recheck CURRENT rules and apply your own result once.
 -- Your game decides possession, damage or stun. Keep your existing animations and effects.
 -- On an approved teleport/respawn/change of physics owner: chrono:Discontinuity(id,reason).
 -- When cancelled/finished: chrono:EndAction(move). When removed: chrono:Untrack(id).
 -- If something fails: local help=require(script.Parent.Core).Explain(reason)
 -- Print help.title, help.meaning and help.fix. The original reason code stays available.
 return B
end
]],c.kind,c.maxSpeed,c.maxRadius),
		Integration=[[-- START HERE: require this module from your existing SERVER startup script.
-- Requiring this file returns a function. Call that function once to make a Chrono instance.
-- The instance does not move objects or start recording on its own.
return function(overrides)
 local Core=require(script.Core)
 local options=table.clone(require(script.Settings))
 for key,value in overrides or {} do options[key]=value end
 local chrono=Core.new(options)
 return {Chrono=chrono,Actions=require(script.Actions),Bindings=require(script.Bindings)(chrono),Explain=Core.Explain}
end
]],
		Practice=string.format([[-- SAFE PRACTICE: uses made-up server values, no live players or map changes.
-- Uses your shape and target rule with an immediate hit period for this example.
-- This does NOT test your game's connections or real move timing.
return function(Integration)
 local time=10
 local kit=Integration({clock=function() return time end})
 local chrono=kit.Chrono
 local S=require(script.Parent.Core).Shapes
 local targetFrame=CFrame.new(0,0,-%s)
 chrono:Track("practice-source",{kind="practice",trust="serverSimulated",maxSpeed=1,maxRadius=2,
  capture=function() return {root=CFrame.new(),zones={Body=S.Sphere(CFrame.new(),1)},state={active=true,team=1}} end})
 chrono:Track("practice-target",{kind=kit.Actions.Contact.targets[1],trust="serverSimulated",maxSpeed=1,maxRadius=2,
  capture=function() return {root=targetFrame,zones={Body=S.Sphere(targetFrame,1)},state={active=true,team=2}} end})
 assert(chrono:Capture().ok,"Practice could not save its first position")
 local practiceProfile=table.clone(kit.Actions.Contact)
 practiceProfile.opens=0 practiceProfile.closes=1
 local move,reason=chrono:BeginAction("practice-source",practiceProfile)
 assert(move,reason)
 local result=chrono:Query(move)
 local contacts=#result.contacts
 local replay=chrono:Query(move)
 local passed=result.ok and contacts==1 and replay.reason=="duplicate_query"
 local report={passed=passed,contacts=contacts,reason=result.reason,
  duplicateStopped=replay.reason=="duplicate_query",message=if passed then "Practice passed: one contact; repeated check refused. Your game connections are not tested yet." else "Practice failed. Read the reason and use Core.Explain(reason)."}
 chrono:EndAction(move) chrono:Destroy()
 return report
end
]],if c.shape=="Ray" or c.shape=="SweptSphere" then c.length*0.5 else c.forward),
		RunPractice=[[-- PRACTICE ONLY. Starts turned OFF. It never runs in a published game.
-- 1. In Explorer, select this Script and set Enabled=true in Properties.
-- 2. Press Play. Read Output for "Chrono V3 practice".
-- 3. Stop Play. Turn this Script off again or remove it when you finish learning.
if not game:GetService("RunService"):IsStudio() then return end
local report=require(script.Parent.Practice)(require(script.Parent))
print("Chrono V3 practice: "..report.message)
script.Parent:SetAttribute("PracticePassed",report.passed)
script.Parent:SetAttribute("PracticeMessage",report.message)
]],
	}
end
return table.freeze(C)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF20"><Properties><string name="Name">Fields</string><ProtectedString name="Source">-- Stable field order and plain-language help shared by the form and validation messages.
local F={}
F.Order={"name","kind","targets","shape","width","height","depth","radius","forward","length","opens","closes","maxTargets","seconds","maxGap","maxRewind","maxSpeed","maxRadius","rules"}
F.Items={
	name={label="Name for the added code",page=2,hint="This name appears in Explorer under ServerScriptService. Example: Football contact. Existing code with the same name will not be replaced."},
	kind={label="Object type name",page=2,hint="A short name your scripts use to group objects. Examples: player, ball, fighter. Use the same spelling in your game code. This is the code field kind."},
	targets={label="Object types this move can touch",page=3,hint="Separate names with commas. Example: player, ball. These names must match the kinds you register with Track."},
	shape={label="Hitbox shape",page=3,hint="Choose an invisible gameplay shape. The picture below is a preview; it does not read or change your map."},
	width={label="Box width",page=3,min=0.01,max=64,unit="studs",hint="Side-to-side size. A stud is Roblox's distance unit."},
	height={label="Total height",page=3,min=0.02,max=64,unit="studs",hint="Bottom-to-top size. For a capsule (a cylinder with round ends), include both round ends."},
	depth={label="Box depth",page=3,min=0.01,max=64,unit="studs",hint="Front-to-back size. Larger values let the move reach farther in that direction."},
	radius={label="Radius: center to edge",page=3,min=0.01,max=32,unit="studs",hint="Radius 1.5 makes a ball 3 studs wide. A capsule's width is also twice its radius."},
	forward={label="Distance in front of the object",page=3,min=0,max=512,unit="studs",hint="The hitbox center stays this far in front of the saved position. It turns with the object. Zero centers it on the object."},
	length={label="Distance to check along the line",page=3,min=0.01,max=4096,unit="studs",hint="Check straight ahead for this distance. A line has no thickness; a moving-ball check also uses the radius."},
	opens={label="Wait before the move can hit",page=3,min=0,max=10,unit="seconds",hint="Time after your server accepts the move. Example: 0.12 seconds is 120 milliseconds (ms). Zero allows an immediate hit."},
	closes={label="Stop checking hits after",page=3,min=0,max=10,unit="seconds",hint="Measured from the same move start. Example: wait 0.12 and stop at 0.35 means a 0.23-second hit period."},
	maxTargets={label="Maximum objects touched per move",page=3,min=1,max=256,unit="objects",hint="This is a total for the whole move. Each object is returned at most once for that move reference."},
	seconds={label="How long to keep past positions",page=4,min=0.05,max=10,unit="seconds",hint="History means saved earlier positions and hitboxes. Old records are removed. Keeping them longer uses more memory."},
	maxGap={label="Largest allowed gap between records",page=4,min=0.001,max=1,unit="seconds",hint="Chrono can estimate between nearby records. It refuses to guess across a larger gap. 0.075 seconds is 75 ms."},
	maxRewind={label="Maximum time allowed into the past",page=4,min=0,max=10,unit="seconds",hint="Rewind means checking earlier positions. Zero is the simplest start. A larger limit still needs a server function that approves each delay."},
	maxSpeed={label="Maximum allowed movement speed",page=2,min=0,max=4096,unit="studs / second",hint="The largest speed your game allows for the reference position. A faster unexplained jump pauses recording. Approved teleports need a tracking reset."},
	maxRadius={label="Farthest allowed hitbox edge",page=2,min=0.01,max=512,unit="studs",hint="Measure from the object's reference position to the farthest edge of any target hitbox. Include both its offset and size."},
	rules={label="Example target rule",page=4,hint="Your game decides which targets are allowed. Team, immunity, possession and round rules belong in this function."},
}
F.Shapes={{code="Box",label="Box",help="A rectangular box. Useful for broad tackle or melee volumes."},
	{code="Sphere",label="Ball (sphere)",help="A round ball. Useful for a football or a round area."},
	{code="Capsule",label="Body with round ends (capsule)",help="A cylinder with half a ball at each end. Useful for a simple body shape."},
	{code="Ray",label="Thin line (ray)",help="A straight line with no thickness. Useful for an instant line check."},
	{code="SweptSphere",label="Ball along a line (sweep)",help="Check a ball at every point along a straight line, not only at its end."}}
return F
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF21"><Properties><string name="Name">Installer</string><ProtectedString name="Source">-- Edit-time only. New owned namespace, explicit preview, one undo record, no game script rewriting.
local Config=require(script.Parent.Config)
local Installer={}
local OWNER="ChronoV3-3.1.0"
local plans=setmetatable({}, {__mode="k"})
function Installer.Preview(config,references,core,service)
	local ok,why=Config.Validate(config) if not ok then return nil,why end
	if not core or not core:IsA("ModuleScript") then return nil,"The Chrono code package is missing. Import the complete setup plugin, including its Core child." end
	local target=service or game:GetService("ServerScriptService")
	if target:FindFirstChild(config.name) then return nil,"Code with this name already exists under "..target.Name..". Choose a different name, or open the existing code to edit it. Nothing has been replaced." end
	local refs={} for _,object in references or {} do
		if typeof(object)~="Instance" or not object:IsDescendantOf(game) or #refs&gt;=64 then return nil,"Select at most 64 objects that still exist in this place. Selecting none is also allowed." end
		table.insert(refs,object)
	end
	local generated=Config.Generate(config)
	local handle=table.freeze({})
	plans[handle]={config=table.clone(config),references=refs,core=core,target=target,sources=generated}
	return handle,table.freeze({destination=target:GetFullName().."."..config.name,
		objects=#refs,declaredTrust="unverified",status="Settings checked. Your game's connections have not been tested.",
		action=generated.Actions,bindings=generated.Bindings,settings=generated.Settings,practice=generated.Practice,
		changes="Add one named code group under ServerScriptService. Includes Core (the library), Bindings (your connections), Actions (move settings), Settings, Practice, an OFF practice test Script, StartHere notes and optional object references. Your game scripts will not be edited. Nothing starts running."})
end
function Installer.Apply(handle,dependencies)
	assert(not game:GetService("RunService"):IsRunning(),"Stop Play before installing")
	local plan=plans[handle] if not plan then return nil,"First choose Check settings on the review page, then install that reviewed version." end
	local d=dependencies or {}
	local history=d.history or game:GetService("ChangeHistoryService")
	local editor=d.editor or game:GetService("ScriptEditorService")
	if plan.target:FindFirstChild(plan.config.name) then return nil,"Someone added code with this name after you checked. Choose a new name and check again. Existing code was kept." end
	for _,ref in plan.references do if not ref:IsDescendantOf(game) then return nil,"A selected object was removed. Choose the references again, then check settings." end end
	local recording=history:TryBeginRecording("ChronoV3Install","Install Chrono V3 integration")
	if not recording then return nil,"Studio could not start an Undo step. Finish any other plugin edit, then try again. No code was installed." end
	local container
	local ok,err=pcall(function()
		container=Instance.new("ModuleScript") container.Name=plan.config.name container:SetAttribute("ChronoV3Owner",OWNER)
		local function write(object,source) editor:UpdateSourceAsync(object,function() return source end) end
		write(container,plan.sources.Integration)
		local clone=plan.core:Clone() clone.Name="Core" clone.Parent=container
		for _,key in {"Actions","Bindings","Settings","Practice"} do local module=Instance.new("ModuleScript") module.Name=key write(module,plan.sources[key]) module.Parent=container end
		local runner=Instance.new("Script") runner.Name="RunPractice" runner.Enabled=false write(runner,plan.sources.RunPractice) runner.Parent=container
		local notes=Instance.new("StringValue") notes.Name="StartHere"
		notes.Value="1. To learn with safe made-up data: enable RunPractice, press Play and read Output for 'Chrono V3 practice'. Then stop Play and turn that test off. The test changes no map objects. It tests the chosen shape and rule with an immediate hit period.\n\n2. For your game: edit Bindings and Actions. Supply positions your server calculates or checks. Connect Capture after updates; BeginAction after your server accepts a move; Query during its hit period; EndAction on cancellation. Your own code applies possession, damage or stun.\n\n3. Core.Explain(reason) gives a plain-language explanation and next step.\n\n4. PracticePassed only describes the made-up test. It does not certify your game or test real network delay.\n\n5. The setup does not replace your movement, animation, camera or effects. Use the guide in the plugin for definitions and the full connection checklist."
		notes.Parent=container
		local references=Instance.new("Folder") references.Name="References" references.Parent=container
		for i,ref in plan.references do local value=Instance.new("ObjectValue") value.Name=string.format("Reference%02d",i) value.Value=ref value.Parent=references end
		container:SetAttribute("Configured",true) container:SetAttribute("GameAdapterExercised",false)
		container.Parent=plan.target
	end)
	if not ok then if container then container:Destroy() end history:FinishRecording(recording,Enum.FinishRecordingOperation.Cancel) return nil,"Studio could not finish writing the added code. This installation was undone. Studio reported: "..tostring(err) end
	history:FinishRecording(recording,Enum.FinishRecordingOperation.Commit)
	plans[handle]=nil
	return container
end
return table.freeze(Installer)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF22"><Properties><string name="Name">Preview</string><ProtectedString name="Source">-- A picture in the plugin only. These Parts never enter Workspace or affect gameplay.
local Config=require(script.Parent.Config)
local Preview={}
function Preview.Draw(parent,config)
	local frame=Instance.new("ViewportFrame") frame.Name="ShapePicture" frame.Size=UDim2.new(1,0,0,190)
	frame.BackgroundColor3=Color3.fromRGB(12,25,36) frame.BorderSizePixel=0 frame.Ambient=Color3.fromRGB(175,190,210)
	frame.LightColor=Color3.fromRGB(245,248,255) frame.LightDirection=Vector3.new(-1,-1,-1) frame.Parent=parent
	for _,problem in Config.Check(config) do if problem.page==3 then
		local label=Instance.new("TextLabel") label.Size=UDim2.fromScale(1,1) label.BackgroundTransparency=1 label.TextWrapped=true
		label.Text="Fix the hitbox settings to see the picture." label.TextColor3=Color3.fromRGB(231,236,244) label.Parent=frame return frame
	end end
	local model=Instance.new("WorldModel") model.Parent=frame
	local blue=Color3.fromRGB(64,178,238) local orange=Color3.fromRGB(255,178,78)
	local parts={}
	local function part(name,shape,size,cf,color,transparency)
		table.insert(parts,{name=name,shape=shape,size=size,frame=cf,color=color,transparency=transparency or 0})
	end
	local radius=Config.ParseNumber(config.radius) or 1.5 local forward=Config.ParseNumber(config.forward) or 0
	local center=Vector3.new(0,0,-forward) local span=math.max(6,forward+6)
	if config.shape=="Box" then
		part("Hitbox",Enum.PartType.Block,Vector3.new(config.width,config.height,config.depth),CFrame.new(center),blue)
		span=math.max(span,forward+config.width,forward+config.height,forward+config.depth)
	elseif config.shape=="Sphere" then part("Hitbox",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(center),blue) span=math.max(span,forward+radius*2)
	elseif config.shape=="Capsule" then
		local middle=config.height-radius*2
		if middle&gt;0 then part("Middle",Enum.PartType.Cylinder,Vector3.new(middle,radius*2,radius*2),CFrame.new(center)*CFrame.Angles(0,0,math.pi/2),blue) end
		for _,sign in {-1,1} do part("RoundEnd",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(center+Vector3.new(0,sign*middle/2,0)),blue) end
		span=math.max(span,forward+config.height)
	else
		local length=config.length center=Vector3.new(0,0,-length/2) span=math.max(6,length)
		local width=if config.shape=="Ray" then math.max(0.06,length/180) else radius*2
		part("Line",Enum.PartType.Cylinder,Vector3.new(length,width,width),CFrame.new(center)*CFrame.Angles(0,math.pi/2,0),blue,0.3)
		if config.shape=="SweptSphere" then for _,z in {0,-length} do part("RoundEnd",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(0,0,z),blue,0.2) end span=math.max(span,length+radius*2) end
	end
	part("ReferencePosition",Enum.PartType.Ball,Vector3.one*math.max(0.35,span/35),CFrame.new(),orange)
	-- Normalize before creating Parts, so very long previews avoid Part-size and camera limits.
	local scale=math.min(1,60/span)
	for _,data in parts do
		local p=Instance.new("Part") p.Name=data.name p.Shape=data.shape p.Size=data.size*scale
		p.CFrame=CFrame.new(data.frame.Position*scale)*data.frame.Rotation p.Color=data.color p.Transparency=data.transparency
		p.Anchored=true p.CanCollide=false p.Material=Enum.Material.SmoothPlastic p.Parent=model
	end
	local focus=center*(0.5*scale) local viewSpan=span*scale
	local camera=Instance.new("Camera") camera.FieldOfView=40 camera.CFrame=CFrame.lookAt(focus+Vector3.new(viewSpan*0.9,viewSpan*0.65,viewSpan*1.15),focus) camera.Parent=frame frame.CurrentCamera=camera
	return frame
end
return Preview
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF23"><Properties><string name="Name">View</string><ProtectedString name="Source">-- Plain-language setup. The code names remain available beside their explanations.
local Config=require(script.Parent.Config)
local Fields=require(script.Parent.Fields)
local Installer=require(script.Parent.Installer)
local Preview=require(script.Parent.Preview)
local View={}
local colors={background=Color3.fromRGB(17,23,32),card=Color3.fromRGB(28,37,49),text=Color3.fromRGB(237,242,249),muted=Color3.fromRGB(183,199,215),accent=Color3.fromRGB(94,225,183),error=Color3.fromRGB(255,181,163)}
function View.Mount(parent,options)
	local o=options or {}
	local config=Config.Default()
	local Help=require(assert(o.core,"Pass the Core ModuleScript to the setup view").Help)
	local page,mode=1,"setup"
	local helpTab="words"
	local pages={"Choose an example","Choose objects","Build a hitbox","Choose game rules","Check and add code","Connect and test"}
	local refs,advanced={},{}
	local plan,summary,installed,lastProblem=nil,nil,nil,nil
	local query,reason="","capture_required"
	local codeVisible,codeTab=false,"Actions"
	local connections,pageConnections={},{}
	local fieldsByKey={} local order=0 local destroyed=false
	local root=Instance.new("Frame") root.Name="ChronoSetup" root.Size=UDim2.fromScale(1,1) root.BackgroundColor3=colors.background root.BorderSizePixel=0 root.Parent=parent
	local function connect(signal,fn,permanent)
		local c=signal:Connect(fn) table.insert(if permanent then connections else pageConnections,c) return c
	end
	local function place(v,target)
		order+=1 v.LayoutOrder=order v.Parent=target return v
	end
	local function padding(target,amount)
		local p=Instance.new("UIPadding") p.PaddingTop=UDim.new(0,amount) p.PaddingBottom=UDim.new(0,amount) p.PaddingLeft=UDim.new(0,amount) p.PaddingRight=UDim.new(0,amount) p.Parent=target
	end
	local function stack(target)
		local list=Instance.new("UIListLayout") list.SortOrder=Enum.SortOrder.LayoutOrder list.Padding=UDim.new(0,8) list.Parent=target return list
	end
	local function label(target,text,size,color)
		local v=Instance.new("TextLabel") v.Name="Text" v.Size=UDim2.new(1,0,0,20) v.AutomaticSize=Enum.AutomaticSize.Y
		v.BackgroundTransparency=1 v.Text=tostring(text) v.TextWrapped=true v.TextXAlignment=Enum.TextXAlignment.Left v.TextYAlignment=Enum.TextYAlignment.Top
		v.Font=Enum.Font.Gotham v.TextSize=size or 16 v.TextColor3=color or colors.text return place(v,target)
	end
	local function card(target,name)
		local f=Instance.new("Frame") f.Name=name or "Card" f.Size=UDim2.new(1,0,0,0) f.AutomaticSize=Enum.AutomaticSize.Y f.BackgroundColor3=colors.card f.BorderSizePixel=0
		place(f,target) padding(f,12) stack(f) local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(0,8) corner.Parent=f return f
	end
	local function button(target,text,callback,selected,permanent)
		local b=Instance.new("TextButton") b.Name=text:gsub("[^%w]","") b.Size=UDim2.new(1,0,0,42) b.BackgroundColor3=if selected then Color3.fromRGB(32,84,74) else colors.card
		b.BorderSizePixel=0 b.Text=text b.TextSize=14 b.TextWrapped=true b.Font=Enum.Font.GothamMedium b.TextColor3=colors.text
		place(b,target) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,6) c.Parent=b connect(b.Activated,callback,permanent) return b
	end
	local header=Instance.new("Frame") header.Name="Header" header.Position=UDim2.fromOffset(16,14) header.Size=UDim2.new(1,-32,0,96) header.BackgroundTransparency=1 header.Parent=root
	local brand=label(header,"CHRONO V3  /  3.1",14,colors.accent) brand.Size=UDim2.new(0.48,0,0,28) brand.AutomaticSize=Enum.AutomaticSize.None
	local title=label(header,"",22) title.Position=UDim2.fromOffset(0,42) title.Size=UDim2.new(1,0,0,54) title.AutomaticSize=Enum.AutomaticSize.None
	local content=Instance.new("ScrollingFrame") content.Name="Content" content.Position=UDim2.fromOffset(16,116) content.Size=UDim2.new(1,-32,1,-238)
	content.BackgroundTransparency=1 content.BorderSizePixel=0 content.ScrollBarThickness=5 content.AutomaticCanvasSize=Enum.AutomaticSize.Y content.CanvasSize=UDim2.new() content.Parent=root
	local contentLayout=stack(content)
	local footer=Instance.new("Frame") footer.Name="Footer" footer.Position=UDim2.new(0,16,1,-112) footer.Size=UDim2.new(1,-32,0,102) footer.BackgroundTransparency=1 footer.Parent=root
	local status=label(footer,"Your game is not connected yet.",14,colors.muted) status.Size=UDim2.new(1,0,0,48) status.AutomaticSize=Enum.AutomaticSize.None
	local rebuild,go
	local back,nextButton
	local function invalidate()
		plan=nil summary=nil lastProblem=nil status.Text="Settings changed. Check them before adding code.\nYour game's connections are not checked."
	end
	local function field(key)
		local info=Fields.Items[key] local f=card(content,"Field_"..key) fieldsByKey[key]=f
		label(f,info.label..(if info.unit then " ("..info.unit..")" else ""),15)
		local input=Instance.new("TextBox") input.Name="Input" input.Size=UDim2.new(1,0,0,38) input.Text=tostring(config[key]) input.ClearTextOnFocus=false input.Font=Enum.Font.Code input.TextSize=17
		input.BackgroundColor3=colors.background input.BorderSizePixel=0 input.TextColor3=colors.text place(input,f)
		label(f,info.hint,14,colors.muted)
		local problemText=label(f,"",14,colors.error) problemText.Visible=false
		local function showProblems()
			local lines={} for _,problem in Config.Check(config) do if problem.field==key then table.insert(lines,problem.message) end end
			problemText.Text=table.concat(lines,"\n") problemText.Visible=#lines&gt;0
		end
		showProblems()
		connect(input.FocusLost,function()
			if info.min~=nil then config[key]=Config.ParseNumber(input.Text) or input.Text else config[key]=input.Text:match("^%s*(.-)%s*$") end
			invalidate() showProblems()
		end)
	end
	local function note(heading,text)
		local f=card(content) label(f,heading,17,colors.accent) label(f,text,14,colors.muted) return f
	end
	local function openObject(object)
		if not object then lastProblem="The requested file is not available. Add the reviewed code first." rebuild() return end
		local ok,err=pcall(function()
			if o.openScript then o.openScript(object) else game:GetService("Selection"):Set({object}) end
		end)
		status.Text=if ok then "Selected "..object.Name.." in Explorer. Read its comments for the next step." else "Select the file in Explorer to open it. Studio reported: "..tostring(err)
	end
	local function currentInstall()
		if installed and installed.Parent then return installed end
		local target=o.target or game:GetService("ServerScriptService")
		local candidate=target:FindFirstChild(tostring(config.name))
		if candidate and candidate:IsA("ModuleScript") and type(candidate:GetAttribute("ChronoV3Owner"))=="string" then return candidate end
		return nil
	end
	local function preview()
		local errors=Config.Check(config)
		if #errors&gt;0 then plan=nil summary=nil status.Text=string.format("Fix %d setting(s). Use the buttons on the review page.",#errors) return false,errors end
		local handle,detail=Installer.Preview(config,refs,o.core,o.target)
		if not handle then plan=nil summary=nil lastProblem=tostring(detail) status.Text="Code was not added. Read the message above." return false,detail end
		plan,summary=handle,detail lastProblem=nil
		status.Text="Settings checked. No code added yet.\nYour game's connections are not checked."
		return true,detail
	end
	local function install()
		if game:GetService("RunService"):IsRunning() then lastProblem="Stop Play, then return here to add the code." rebuild() return nil end
		if not plan then lastProblem="Choose Check settings first. Then add the reviewed code." rebuild() return nil end
		local ok,object,err=pcall(Installer.Apply,plan,o.dependencies)
		plan=nil
		if not ok or not object then lastProblem=if ok then tostring(err) else tostring(object) status.Text="Code was not added. Read the message above." rebuild() return nil end
		installed=object lastProblem=nil page=6
		status.Text="Code added. Next: run the practice test.\nYour game's connections are not checked."
		if o.onInstalled then o.onInstalled(object) end rebuild()
		return object
	end
	go=function(newPage,key)
		page=math.clamp(newPage,1,#pages) mode="setup"
		if key then advanced[page]=true end rebuild()
		if key then task.defer(function()
			local f=fieldsByKey[key]
			if f and f.Parent then content.CanvasPosition=Vector2.new(0,math.max(0,f.AbsolutePosition.Y-content.AbsolutePosition.Y+content.CanvasPosition.Y-8)) local input=f:FindFirstChild("Input") if input then input:CaptureFocus() end end
		end) end
	end
	local function more(text)
		button(content,(if advanced[page] then "Hide: " else "More settings: ")..text,function() advanced[page]=not advanced[page] rebuild() end)
		return advanced[page]
	end
	local function codeBox(text)
		local f=card(content,"CodeCard")
		label(f,"Select and copy this code if you want to edit it elsewhere.",14,colors.muted)
		local scroll=Instance.new("ScrollingFrame") scroll.Name="CodeScroll" scroll.Size=UDim2.new(1,0,0,240) scroll.BackgroundColor3=colors.background scroll.BorderSizePixel=0 scroll.ScrollBarThickness=4 scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y scroll.CanvasSize=UDim2.new() place(scroll,f)
		local box=Instance.new("TextBox") box.Name="Code" box.Size=UDim2.new(1,-12,0,240) box.AutomaticSize=Enum.AutomaticSize.Y box.Text=text box.TextWrapped=true box.MultiLine=true box.ClearTextOnFocus=false box.TextEditable=false box.Font=Enum.Font.Code box.TextSize=13 box.TextColor3=colors.text box.BackgroundTransparency=1 box.TextXAlignment=Enum.TextXAlignment.Left box.TextYAlignment=Enum.TextYAlignment.Top box.Parent=scroll
		button(f,"Select all code",function() box:CaptureFocus() box.CursorPosition=#text+1 box.SelectionStart=1 end)
	end
	local function learn()
		note("Help in plain language","Look up a word, or explain a result message. The real code name stays visible so you can find it in a script.")
		local tabs=Instance.new("Frame") tabs.Name="HelpTabs" tabs.Size=UDim2.new(1,0,0,40) tabs.BackgroundTransparency=1 place(tabs,content)
		local words=button(tabs,"Word meanings",function() helpTab="words" rebuild() end,helpTab=="words") words.Size=UDim2.new(0.48,0,0,40)
		local messages=button(tabs,"Result messages",function() helpTab="messages" rebuild() end,helpTab=="messages") messages.Size=UDim2.new(0.48,0,0,40) messages.Position=UDim2.new(0.52,0,0,0)
		if helpTab=="messages" then
		local errors=card(content,"MessageHelp") label(errors,"Understand a result message",18,colors.accent)
		label(errors,"Paste a reason code from your result or Output. Example: target_state_boundary.",14,colors.muted)
		local input=Instance.new("TextBox") input.Name="ReasonCode" input.Size=UDim2.new(1,0,0,38) input.Text=reason input.ClearTextOnFocus=false input.Font=Enum.Font.Code input.TextSize=14 input.TextColor3=colors.text input.BackgroundColor3=colors.background place(input,errors)
		connect(input.FocusLost,function() reason=input.Text:match("^%s*(.-)%s*$") rebuild() end)
		local h=Help.Explain(reason) label(errors,h.title,17) if h.subject then label(errors,h.subject,14,colors.muted) end
		label(errors,"What happened: "..h.meaning,14) label(errors,"What to do: "..h.fix,14,colors.accent)
		return end
		local search=Instance.new("TextBox") search.Name="WordSearch" search.Size=UDim2.new(1,0,0,40) search.PlaceholderText="Type a word, then press Enter" search.Text=query search.ClearTextOnFocus=false search.Font=Enum.Font.Gotham search.TextSize=15 search.TextColor3=colors.text search.PlaceholderColor3=colors.muted search.BackgroundColor3=colors.card place(search,content)
		connect(search.FocusLost,function() local y=content.CanvasPosition query=search.Text rebuild() content.CanvasPosition=y end)
		local entries=Help.FindTerms(query)
		label(content,tostring(#entries).." explanation(s)",14,colors.muted)
		if #entries==0 then label(content,"No matching word. Try a shorter word or clear the search.",14) end
		for _,entry in entries do local f=card(content) label(f,entry[2],17,colors.accent) label(f,"Code / technical word: "..entry[1],13,colors.muted) label(f,entry[3],14) label(f,"Example: "..entry[4],14,colors.muted) end
	end
	rebuild=function()
		for _,c in pageConnections do c:Disconnect() end table.clear(pageConnections) table.clear(fieldsByKey)
		for _,v in content:GetChildren() do if v~=contentLayout then v:Destroy() end end
		content.CanvasPosition=Vector2.zero
		title.Text=if mode=="learn" then "Words and result messages" else string.format("%d of %d  |  %s",page,#pages,pages[page])
		if back then
			back.Text=if mode=="learn" then "Return to setup" else "Back"
			back.Visible=mode=="learn" or page&gt;1
			back.Size=UDim2.new(if mode=="learn" then 1 else 0.48,0,0,40)
		end
		if nextButton then
			nextButton.Visible=mode~="learn"
			nextButton.Text=if page==#pages then "Start page" else "Next"
			nextButton.Size=UDim2.new(if page==1 then 1 else 0.48,0,0,40)
			nextButton.Position=UDim2.new(if page==1 then 0 else 0.52,0,0,58)
		end
		if lastProblem then note("What needs attention",lastProblem) end
		if mode=="learn" then learn() return end
		if page==1 then
			note("What Chrono V3 does","Your game supplies positions and hitboxes. Chrono saves them and checks whether a move touches an allowed object. Your game decides what happens next: possession, damage, stun or another result.")
			label(content,"Start with an example. You can change every setting.",16)
			for _,entry in {{"Sports","Sports: tackle, kick or ball"},{"Melee","Melee: a close-range attack"},{"Hitscan","Instant line check: a straight shot"}} do
				button(content,entry[2],function() config=Config.Preset(entry[1],config) invalidate() go(2) end)
			end
			note("Your existing game stays in charge","Keep your movement, camera, animations, visual effects and cutscenes. You will write a small connection to your server scripts. The setup creates starting code and a safe practice test; it does not understand your game's moves automatically.")
			button(content,"I already know my settings: continue",function() go(2) end)
		elseif page==2 then
			field("name") field("kind")
			note("Which position can decide a hit?","Use positions your server calculates or checks. This is often called authoritative data. A player sending a position, or a server reading that position, does not prove that movement was allowed.")
			button(content,"Keep links to selected objects (optional)",function()
				refs=if o.selection then o.selection() else game:GetService("Selection"):Get() invalidate() status.Text=tostring(#refs).." object link(s) selected. Their positions are not approved automatically." rebuild()
			end)
			if #refs&gt;0 then local names={} for i=1,math.min(6,#refs) do table.insert(names,refs[i].Name) end label(content,"Links: "..table.concat(names,", "),14,colors.muted) end
			note("What you will connect","In Bindings, return {root, zones, state}. Root is the main position and direction. Zones are named hitbox shapes in the map. State holds simple values such as team=2 or active=true. The next pages explain the hitbox and move.")
			if more("movement limits") then field("maxSpeed") field("maxRadius") end
		elseif page==3 then
			field("targets")
			for _,shape in Fields.Shapes do button(content,(if config.shape==shape.code then "Selected: " else "Use: ")..shape.label,function() config.shape=shape.code invalidate() rebuild() end,config.shape==shape.code) if config.shape==shape.code then label(content,shape.help,14,colors.muted) end end
			local picture=Preview.Draw(content,config) order+=1 picture.LayoutOrder=order
			label(content,"Orange: main object position. Blue: chosen hitbox or path. Picture scaled to fit; a thin line is drawn wider so you can see it.",13,colors.muted)
			if config.shape=="Ray" or config.shape=="SweptSphere" then field("length") else field("forward") end
			if config.shape=="Box" then field("width") field("height") field("depth")
			elseif config.shape~="Ray" then field("radius") if config.shape=="Capsule" then field("height") end end
			field("opens") field("closes") field("maxTargets")
			note("Very fast moves need extra care","A check uses saved positions at one time. It does not calculate every movement between updates. Use enough updates, or an appropriate straight-line sweep for your move. A sweep still holds the other objects at one chosen time.")
		elseif page==4 then
			note("Start with the present time","By default, Chrono checks the latest saved game update. Earlier-position checks are optional. Keep that default while connecting your first move.")
			button(content,"Rule example: allow all matching types",function() config.rules="all" invalidate() rebuild() end,config.rules=="all")
			button(content,"Rule example: active and on different teams",function() config.rules="team" invalidate() rebuild() end,config.rules=="team")
			label(content,if config.rules=="team" then "This example expects state.active and state.team for both objects. The practice test supplies them. Your real position functions must supply your real values." else "Allow all is only a starting example. Add your own immunity, possession, round and other rules before using real moves.",14,colors.muted)
			if more("saved positions and delay") then field("seconds") field("maxGap") field("maxRewind") end
			note("Should a wall stop this move?","Your game must choose that rule. An optional obstacle function can check earlier map data for line or moving-ball checks. Overlap moves such as tackles need your game's own wall rule. This setup does not silently decide that walls are clear.")
		elseif page==5 then
			local errors=Config.Check(config)
			if #errors&gt;0 then
				note("Fix these settings first",tostring(#errors).." setting(s) need attention. Select one to go to its field.")
				for _,e in errors do button(content,e.message,function() go(e.page,e.field) end) end
			else
				note("Your settings",string.format("Added code: %s\nObject type: %s\nTarget types: %s\nHitbox: %s\nHits allowed from %s to %s seconds\nTotal target limit: %s",config.name,config.kind,config.targets,config.shape,config.opens,config.closes,config.maxTargets))
			end
			button(content,"Check settings and show changes",function() preview() rebuild() end)
			if summary then
				note("Where the code goes",summary.destination.."\n\n"..summary.changes)
				button(content,"Add this reviewed code",install,true)
				button(content,if codeVisible then "Hide generated code" else "Read generated code (optional)",function() codeVisible=not codeVisible rebuild() end)
				if codeVisible then
					for _,key in {"Actions","Bindings","Practice"} do button(content,"Read "..key,function() codeTab=key rebuild() end,codeTab==key) end
					codeBox(if codeTab=="Bindings" then summary.bindings elseif codeTab=="Practice" then summary.practice else summary.action)
				end
			end
			note("What this check proves","Settings checked means these values are usable. It does not prove a player's position is safe, your game is connected, or a real move works. After adding code, run the practice example, then test your own connections.")
		elseif page==6 then
			local target=currentInstall()
			if not target then note("Add the code first","Return to page 5, check the settings and add the reviewed code. You can then open the files from here.") end
			note("1. Try the safe practice example","Open RunPractice below. In Properties, turn Enabled on. Press Play and read Output for 'Chrono V3 practice'. Stop Play, then turn that test off again. It uses made-up positions and an immediate hit period, changes no map objects, and never runs in a published game.")
			button(content,"Open RunPractice test script",function() openObject(target and target:FindFirstChild("RunPractice")) end)
			note("2. Connect your real game","Open Bindings. Add a function that supplies positions and hitboxes your server calculates or checks. Call Capture after each shared update. After your move script accepts a request, use BeginAction, Query during the hit period, and EndAction when the move ends or is cancelled.")
			button(content,"Open Bindings: connections to your game",function() openObject(target and target:FindFirstChild("Bindings")) end)
			button(content,"Open Actions: hitbox and move rules",function() openObject(target and target:FindFirstChild("Actions")) end)
			button(content,"Open Practice: a complete small example",function() openObject(target and target:FindFirstChild("Practice")) end)
			note("3. Apply your game's result once","A successful Query returns contacts. Your game rechecks its current rules and applies possession, damage or stun. An empty contact list is a checked miss. A failed check has no partial result. Do not apply the same returned contacts twice.")
			note("4. Test changes and bad connections","Try joining/leaving, respawn, teleport, immunity, cancelled moves and repeated requests. Use Discontinuity after a game-approved tracking reset; Untrack removes an object. Test actual messages with Studio's Network Simulator. The practice example alone does not test your game or network.")
			if o.inspect then button(content,"Read connected game report",function()
				local ok,r=pcall(o.inspect)
				if ok and type(r)=="table" and type(r.stats)=="table" then status.Text=string.format("Recorded updates: %s. Completed checks: %s. Refused checks: %s.",r.stats.captures,r.stats.accepted,r.stats.rejected)
				else status.Text="No usable report from your game. The setup cannot confirm the connections." end
			end) end
			note("If a result is confusing","Use Core.Explain(reason) in code, or open Words &amp; errors above and paste the reason code. It explains the message and the next step. Use the V3.1 setup and guide for this package.")
		end
	end
	local helpButton=button(header,"Words &amp; errors",function() mode=if mode=="learn" then "setup" else "learn" rebuild() end,false,true)
	helpButton.Size=UDim2.new(0.48,0,0,30) helpButton.Position=UDim2.new(0.52,0,0,0)
	back=button(footer,"Back",function() if mode=="learn" then mode="setup" rebuild() else go(page-1) end end,false,true)
	back.Name="Back" back.Size=UDim2.new(0.48,0,0,40) back.Position=UDim2.fromOffset(0,58)
	nextButton=button(footer,"Next",function()
		if mode=="learn" then mode="setup" rebuild() else go(if page==#pages then 1 else page+1) end
	end,false,true) nextButton.Name="Next" nextButton.Size=UDim2.new(0.48,0,0,40) nextButton.Position=UDim2.new(0.52,0,0,58)
	rebuild()
	local controller={Root=root}
	function controller.Go(p) assert(p&gt;=1 and p&lt;=#pages) go(p) end
	function controller.Set(key,value) assert(config[key]~=nil) config[key]=value invalidate() rebuild() end
	function controller.Preview() return preview() end
	function controller.Install() return install() end
	function controller.Config() return table.clone(config) end
	function controller.Learn(text) mode="learn" helpTab="words" query=text or "" rebuild() end
	function controller.Explain(code) mode="learn" helpTab="messages" reason=code rebuild() end
	function controller.Destroy()
		if destroyed then return end destroyed=true
		for _,c in pageConnections do c:Disconnect() end for _,c in connections do c:Disconnect() end root:Destroy()
	end
	return controller
end
return View
</ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="CF24"><Properties><string name="Name">Examples</string></Properties><Item class="ModuleScript" referent="CF25"><Properties><string name="Name">Guides</string><ProtectedString name="Source">-- Optional developer-only guide. It creates no network events or gameplay controls.
-- Mount(screenGui, optionalMetricsFunction, optionalHelpModule).
-- The packaged ChronoV3Guides.rbxmx includes a Help child; source users can pass Core.Help.
local Guide={}
function Guide.Mount(parent,getMetrics,help)
	local Help=help or (script:FindFirstChild("Help") and require(script.Help))
	local panel=Instance.new("ScrollingFrame") panel.Name="ChronoV3Guide" panel.Size=UDim2.new(0.92,0,0.85,0) panel.Position=UDim2.fromScale(0.04,0.075)
	panel.AutomaticCanvasSize=Enum.AutomaticSize.Y panel.CanvasSize=UDim2.new() panel.ScrollBarThickness=5 panel.BackgroundColor3=Color3.fromRGB(17,23,32) panel.BorderSizePixel=0 panel.Parent=parent
	local limit=Instance.new("UISizeConstraint") limit.MaxSize=Vector2.new(660,720) limit.Parent=panel
	local layout=Instance.new("UIListLayout") layout.SortOrder=Enum.SortOrder.LayoutOrder layout.Padding=UDim.new(0,12) layout.Parent=panel
	local padding=Instance.new("UIPadding") padding.PaddingLeft=UDim.new(0,18) padding.PaddingRight=UDim.new(0,18) padding.PaddingTop=UDim.new(0,18) padding.PaddingBottom=UDim.new(0,18) padding.Parent=panel
	local connections={} local localConnections={} local order=0
	local function place(v,target) order+=1 v.LayoutOrder=order v.Parent=target return v end
	local function text(target,value,size,color)
		local v=Instance.new("TextLabel") v.Size=UDim2.new(1,0,0,20) v.AutomaticSize=Enum.AutomaticSize.Y v.BackgroundTransparency=1 v.Text=value v.TextWrapped=true v.Font=Enum.Font.Gotham v.TextSize=size or 15 v.TextColor3=color or Color3.fromRGB(232,241,249) v.TextXAlignment=Enum.TextXAlignment.Left v.TextYAlignment=Enum.TextYAlignment.Top return place(v,target)
	end
	text(panel,"CHRONO V3  /  Learning guide",22,Color3.fromRGB(94,225,183))
	local body=Instance.new("Frame") body.Name="Lesson" body.Size=UDim2.new(1,0,0,0) body.AutomaticSize=Enum.AutomaticSize.Y body.BackgroundTransparency=1 place(body,panel)
	local bodyLayout=Instance.new("UIListLayout") bodyLayout.SortOrder=Enum.SortOrder.LayoutOrder bodyLayout.Padding=UDim.new(0,12) bodyLayout.Parent=body
	local pages={
		{"How it works","1. Your game supplies positions and invisible hitbox shapes.\n\n2. Chrono saves short records of earlier positions. This is called history. It stays in memory; old records are removed.\n\n3. After your server accepts a move, Chrono checks which allowed objects its shape touches.\n\n4. Your own game code decides possession, damage or another result. Your animation and effects code stays in your game."},
		{"Which positions can decide hits?","The server must calculate or check the positions used to decide a competitive hit. This is often called authoritative data.\n\nA client is one player's game copy. A player sending a position does not prove the movement was allowed. A server reading that position does not prove it either.\n\nThe trust labels describe your code's guarantee. Choosing a label does not create that guarantee."},
		{"The few calls you connect","Track: register a player, ball or other object and a function that returns its data.\n\nCapture: save one update after your server updates all participating objects. Save once before allowing moves.\n\nBeginAction: keep the move reference it returns after your server approves a move.\n\nQuery: check the move during its hit period.\n\nEndAction: stop a finished or cancelled move.\n\nUntrack removes an object. Discontinuity reports an approved reset such as a teleport or respawn."},
		{"A result is not always a hit","A successful Query means the data checks completed. If contacts is empty, nothing was touched.\n\nA refused check is different: Chrono could not safely complete it. Keep its reason code. Help explains why and what to do next.\n\nYour game still checks its CURRENT rules before applying the result once. Prevent repeated requests and repeated application in your game code."},
		{"What to test in your game","Try normal hits and misses, players joining/leaving, respawn, teleport, immunity, cancelled moves and repeated input.\n\nA bad data function pauses that object's recording. Fix the original error before resetting tracking.\n\nStudio's Network Simulator adds real message delay, variation and packet loss to a playtest. Test the real connections you wrote.\n\nThe supplied practice example uses made-up values. A passing practice example does not prove your game is connected or that its network behavior is correct."},
	}
	local index,mode,search,code=1,"lessons","","capture_required"
	local render
	local function button(target,caption,fn,temporary)
		local b=Instance.new("TextButton") b.Name=caption:gsub("[^%w]","") b.Size=UDim2.new(1,0,0,40) b.TextWrapped=true b.BackgroundColor3=Color3.fromRGB(33,53,65) b.TextColor3=Color3.fromRGB(230,245,240) b.Font=Enum.Font.GothamMedium b.TextSize=14 b.Text=caption place(b,target)
		table.insert(if temporary then localConnections else connections,b.Activated:Connect(fn))
	end
	render=function()
		for _,c in localConnections do c:Disconnect() end table.clear(localConnections)
		for _,v in body:GetChildren() do if v~=bodyLayout then v:Destroy() end end
		if mode=="lessons" then text(body,string.format("%d of %d  |  %s",index,#pages,pages[index][1]),19) text(body,pages[index][2],15)
		else
			text(body,"Understand a result message",19)
			local input=Instance.new("TextBox") input.Name="ReasonCode" input.Size=UDim2.new(1,0,0,38) input.Text=code input.ClearTextOnFocus=false input.Font=Enum.Font.Code input.TextSize=15 input.BackgroundColor3=Color3.fromRGB(30,40,52) input.TextColor3=Color3.fromRGB(237,242,249) place(input,body)
			table.insert(localConnections,input.FocusLost:Connect(function() code=input.Text:match("^%s*(.-)%s*$") render() end))
			if Help then
				local h=Help.Explain(code) text(body,h.title,17) text(body,"What happened: "..h.meaning) text(body,"What to do: "..h.fix)
			else text(body,"Copy the packaged guide with its Help child for the full message explanations. The setup plugin also contains them.") end
			text(body,"Find a word",19)
			local input2=Instance.new("TextBox") input2.Name="WordSearch" input2.Size=UDim2.new(1,0,0,38) input2.Text=search input2.PlaceholderText="history, authoritative, root..." input2.ClearTextOnFocus=false input2.Font=Enum.Font.Gotham input2.TextSize=15 input2.BackgroundColor3=Color3.fromRGB(30,40,52) input2.TextColor3=Color3.fromRGB(237,242,249) place(input2,body)
			table.insert(localConnections,input2.FocusLost:Connect(function() search=input2.Text render() end))
			if Help then
				local entries=Help.FindTerms(search)
				if #entries==0 then text(body,"No matching word. Try a shorter word or clear the search.") end
				for _,e in entries do text(body,e[2].." ("..e[1]..")",17) text(body,e[3]) text(body,"Example: "..e[4],13,Color3.fromRGB(183,199,215)) end
			end
		end
	end
	button(panel,"Previous lesson",function() mode="lessons" index=math.max(1,index-1) render() panel.CanvasPosition=Vector2.zero end)
	button(panel,"Next lesson",function() mode="lessons" index=index%#pages+1 render() panel.CanvasPosition=Vector2.zero end)
	button(panel,"Words and result messages",function() mode=if mode=="lessons" then "help" else "lessons" render() panel.CanvasPosition=Vector2.zero end)
	local status=text(panel,"This guide does not know whether your game is connected. A practice pass tests the example only.",13,Color3.fromRGB(183,199,215))
	if getMetrics then button(panel,"Read your connected game report",function()
		local ok,r=pcall(getMetrics)
		if not ok or type(r)~="table" or type(r.stats)~="table" then status.Text="No usable report from your game. Check the function supplying it." return end
		local line=string.format("Saved updates: %s. Completed checks: %s. Refused checks: %s.",tostring(r.stats.captures),tostring(r.stats.accepted),tostring(r.stats.rejected))
		if Help then local h=Help.Explain(r.stats.lastRejection) line..="\nLast refusal: "..h.title..". "..h.fix end
		status.Text=line
	end) end
	render()
	return function() for _,c in localConnections do c:Disconnect() end for _,c in connections do c:Disconnect() end panel:Destroy() end
end
return Guide
</ProtectedString></Properties><Item class="ModuleScript" referent="CF27"><Properties><string name="Name">Help</string><ProtectedString name="Source">-- Help text only. Looking up a message never changes a hit check or trusts a position.
local Help={}
local terms={
	{"authoritative","Server decides","The server makes or checks the value used to decide a hit. A player cannot make a position valid just by sending it.","A tackle uses a position your server movement code has checked."},
	{"server","Server","The computer running the shared game rules for all players. In Studio Play, you can switch between the server and a player's client.","The server decides who gets the ball."},
	{"client","Client","One player's running copy of the game. It handles input, the camera and what that player sees.","A LocalScript reads the tackle button."},
	{"history","Saved past positions","A short list of earlier positions, hitboxes and game values, with the time of each record. Chrono keeps these in memory and later removes old records.","Keep the last 0.6 seconds so a check can use an earlier position."},
	{"snapshot","One saved record","The position, hitboxes and game values of one object at one time.","At time 10.2, the ball was here and the player was on team 2."},
	{"actor","Tracked object","Anything Chrono checks: a player, a ball, an NPC or another game object. It does not have to be a character.","Register the football as kind ball."},
	{"provider","Function that supplies data","A function you write. Chrono calls it to get an object's position, hitboxes and game values.","Read a ball position calculated by your server and return a sphere around it."},
	{"adapter","Connection to your game code","A small piece of code that connects Chrono calls to the scripts your game already uses. Bindings is the generated module for these connections.","When your move script accepts a tackle, start a Chrono action."},
	{"bindings","Connections to your game code","The functions that connect your players, moves and rules to Chrono. The setup creates a Bindings module for you to edit.","Call Bindings.Track when your game adds a player."},
	{"callback","Function given to another function","A function Chrono calls when it needs data or a rule result. The function must finish without task.wait or waiting for an event.","eligible = function(source, target) return source.team ~= target.team end"},
	{"root","Reference position","The main position and direction from which an object's hitboxes are measured. It is a CFrame value; it need not be a part named HumanoidRootPart.","For a ball, its center can be the root."},
	{"cframe","Position and direction (CFrame)","A Roblox value that stores both where something is and which way it faces.","CFrame.new(0, 0, -3) places a local hitbox 3 studs in front."},
	{"local space","Relative to an object","Measure a shape from the object's reference position and facing direction. It moves with that object.","A tackle box stays 3 studs in front of the player."},
	{"world space","Position in the map","Measure a shape in the map's coordinate system, rather than from one object.","A provider returns the ball hitbox at the ball's map position."},
	{"state","Game values saved with a position","Small values your hit rules need at that time. Use true/false, numbers or short text. Do not put Instances or nested tables here.","{active=true, team=2, invulnerable=false}"},
	{"eligible","Allowed by your game rules","A target can count only if the rules you supply allow it. Your game must also check its current rules before applying the result.","A teammate or an invulnerable player may be excluded."},
	{"hitbox","Shape used to check contact","An invisible shape your gameplay uses to decide whether a move reaches an object. It may be simpler than the visible model.","A sphere can represent a football."},
	{"capsule","Cylinder with round ends","A shape like a cylinder with a half-sphere at each end. Height includes both round ends and must be at least twice the radius.","A simple body hitbox can have radius 1.5 and total height 5 studs."},
	{"radius","Center-to-edge distance","The distance from the center of a ball or circular part to its edge. Diameter is twice this value.","Radius 1.5 means a ball is 3 studs wide."},
	{"ray","Line check","A line from a start point to an end point. It has no thickness.","A straight instant-shot check can use a ray."},
	{"sweep","Shape checked along a path","Check a ball all along a straight line, rather than only at its final position. Other objects are held at the one saved time being checked.","A thick straight attack can use a swept sphere."},
	{"interpolation","Estimate between saved positions","If the requested time lies between two records, Chrono estimates a position between them. It refuses to guess across a large gap or an uncertain change.","Records at 10.0 and 10.05 can estimate a pose at 10.025."},
	{"coverage","Enough saved data for the requested time","Chrono has suitable records around that time and its time, change and shape checks pass. This does not prove your supplied positions were honest.","A covered check with zero contacts means a checked miss."},
	{"rewind","Check an earlier position","Use saved records from before the latest update. This is off by default and needs a timing rule supplied by your server.","Your approved timing rule may allow checking 0.08 seconds earlier."},
	{"lag compensation","Use earlier data to account for delay","A game policy that can let an input use an earlier position because messages took time to travel. Chrono does not choose a fair time automatically.","Decide how much delay your game allows before rejecting an old request."},
	{"latency","Message travel delay","The time a message takes to travel. Ping usually measures a round trip, not one direction.","50 ms each way adds about 100 ms to a round trip."},
	{"epoch","Position-record version","A number that changes when tracking is reset. Older records cannot silently be used after that reset.","A respawn starts a new version of the player's position records."},
	{"discontinuity","Approved tracking reset","A real change where earlier positions must no longer connect to later ones. Your game reports it with Discontinuity after approving the change.","Teleport, respawn, or a change in who simulates an object."},
	{"quarantine","Pause one object's recording","Chrono stops using an object's records after its data function fails or returns bad data. Fix the cause, report the approved reset, then record again.","Do not reset tracking repeatedly just to hide a faulty data function."},
	{"network ownership","Who calculates Roblox physics","Roblox can let a player's client calculate an object's physics. Reading that result on the server alone does not prove it was a legal move.","Your server still needs to check player movement used to decide competitive hits."},
	{"stud","Roblox distance unit","A unit for size and distance in Roblox Studio.","A default Part is 4 studs wide along its X axis."},
	{"hz","Updates per second (Hz)","How often something is updated each second. Chrono's rate setting sizes its storage; your script still calls Capture.","60 Hz means 60 updates in one second."},
	{"handle","Move reference returned by Chrono","The value BeginAction returns after it accepts a move. Keep it and pass it to Query and EndAction. Do not create your own table as a replacement.","local move, reason = chrono:BeginAction(playerId, profile)"},
	{"capture","Save one update","Capture asks each registered object's data function for a position record. Your game calls it after all participating objects finish the same server update.","chrono:Capture()"},
	{"query","Check a move","Query checks the move reference you kept from BeginAction. It returns allowed contacts or a reason explaining why the check could not complete.","local result = chrono:Query(move)"},
	{"profile","Settings for one move","A plain Luau table describing the shape, target types, timing, target limit and rules for a move.","The generated Actions.Contact table is one profile."},
	{"contact","One returned target","A tracked object whose saved hitbox touched the move's shape and passed the supplied rules. Your game still decides whether to apply its current result.","result.contacts[1].id is the first returned object id."},
	{"active window","Time when the move may hit","The time from opens to closes, counted after your server starts the move.","opens=0.12 and closes=0.35 allow checks from 120 to 350 ms after the start."},
	{"id","One object's name in your code","A stable short text label for a particular registered object. Keep it unique while that object is tracked.","player-12 is an id; player is its kind."},
	{"kind","Group name for similar objects","A short text label for an object type. A move's targets list uses these labels to choose which groups to check.","Register a ball with kind='ball'; use targets={'ball'} to check that group."},
	{"unverified","Data not approved for hits","The default label for positions whose server-side calculation or validation has not been established. Chrono refuses gameplay checks that need them.","Selecting a Part in Studio creates only an unverified reference."},
	{"serverSimulated","Data calculated by your server","Use this trust label only when your own server code actually calculates the positions used for hit checks.","A server-owned ball simulation supplies its position."},
	{"serverValidated","Data checked by your server","Use this trust label only after your server actually verifies the supplied positions and hitboxes against the rules your game requires.","Your existing movement checks reject impossible client moves before their data reaches Chrono."},
	{"ModuleScript","A reusable code file","A Roblox code file that returns a value when another script calls require on it. Installing the generated main module does not automatically connect it to your game.","local startChrono = require(game.ServerScriptService.ChronoV3Integration)"},
	{"boolean","True or false","A value with only two choices. Useful for saved rules such as whether a player is active or invulnerable.","state = {active=true, invulnerable=false}"},
	{"hitscan","Instant line check","Check a straight line immediately. There is no simulated bullet flying along that path over later frames.","The Instant line check preset creates a ray-shaped query."},
	{"source","Object doing the move","The registered object whose saved position and facing direction place the move's hitbox.","The tackling player is the source; the player or ball being checked is a target."},
	{"target","Object the move may touch","A registered object of a kind listed in the move's targets. Its saved hitbox is checked against the move.","A kick can target the ball kind."},
	{"jitter","Changing message delay","Messages do not all take the same time to arrive. This makes updates arrive at uneven intervals.","Studio's Network Simulator can add different jitter in each direction."},
	{"packet loss","Dropped network packets","Some small pieces of network data do not arrive. Reliable messages can be resent, which adds delay; unreliable updates may stay missing.","0.5% means half of one percent, not 50%."},
}
for _,entry in terms do table.freeze(entry) end
Help.Terms=table.freeze(terms)
local messages={
	captured={"Positions saved","The supplied positions passed the recording checks.","Continue updating the game, then call Capture again after the next update."},
	covered={"Hitbox check completed","There was enough saved data for this check. Zero returned contacts means nothing was touched.","Use the returned contacts only after checking your game's current rules."},
	capture_required={"No positions saved yet","Chrono needs a recorded starting position before it can start a move.","Register your objects with Track. Call Capture once before accepting move requests, then after each game update."},
	capture_stale={"Positions are not recent enough","The game has not saved a recent enough update for this check.","Call Capture after every required server update. Check for stopped loops or functions that wait."},
	clock_fault={"The time function failed","The clock did not return a usable number.","Use the default clock, or return time in seconds from one consistent server clock."},
	clock_reversed={"Time moved backwards","The clock is earlier than the latest saved update.","Use the same server clock for saving positions and checking moves. Do not mix different clocks."},
	invalid_capture_time={"Cannot record this time","The supplied time is too far behind the clock, in the future, or not a valid number.","Use Capture() with its default time first. For a fixed-step simulation, pass a recent server time in the same clock system."},
	non_monotonic={"This update is not newer","Chrono already saved this time or a later time.","Record once per simulation step, in increasing time order. Do not record the same step twice."},
	actor_missing={"Object is not registered","The move's source id was not found.","Call Track for this id before starting the move. Keep the same id spelling in both calls."},
	unverified_source={"The move's position is not approved","The object's data is marked unverified, so it cannot be used to decide gameplay.","Connect data your server actually calculates or validates. Only then choose the matching trust label. Changing the label alone does not validate movement."},
	unverified_target={"A target's position is not approved","One object of a target kind is marked unverified. Chrono refuses a partial result.","Supply checked data for that target kind, or correct which kinds the move should check. Selected Studio references stay unverified."},
	invalid_profile={"Move settings are not usable","A shape, distance limit, active time, target count or rule function is invalid.","Check the Actions module. Times must be ordered, dimensions positive, and maxReach large enough for the full shape."},
	target_kinds_required={"Choose which object types to check","The move needs at least one target kind.","Set targets to a list such as {\"player\", \"ball\"}. Use the kind names passed to Track."},
	invalid_target_kind={"An object type name is invalid","A target kind must be a short nonempty string.","Use the same short kind names in Track and the move's targets list."},
	world_provider_or_shape={"The obstacle check is not connected","world=true needs an obstacle-data function and a ray or moving-ball query.","Connect the world function for a sweep. For an overlap move, implement your game's obstruction rule. Do not disable an obstacle rule just to make a failed check pass."},
	rewind_rejected={"The earlier check time was refused","Your server timing function failed or requested more time than allowed.","Return a delay between zero and maxRewind from your server timing rule. Check request age and never trust a client's time without validation."},
	action_capacity={"Too many moves are still open","This object or service has reached its limit for open move references.","Call EndAction when a move ends or is cancelled. Continue Capture so old moves are removed."},
	invalid_action={"The move reference is no longer valid","It was ended, removed, expired, or was not created by this Chrono instance.","Keep the value BeginAction returns. Start a new move only after your server accepts a new move request."},
	roster_changed={"The tracked object list changed","An object was added or removed after this move started. This version cancels older move references for safety.","End the old move. Let your game decide whether a new move can start after the next saved update."},
	source_epoch_changed={"The moving object was reset","A teleport, respawn or data error changed its position-record version.","End the old move. Fix data errors if present, save the new position, then let your server authorize another move."},
	not_active={"It is too early for this move to hit","The move's hit period has not started yet.","Keep saving positions. Query again during opens to closes, or correct those times in Actions."},
	action_expired={"The move's hit period has ended","This move can no longer return a contact.","Call EndAction. Start a new move only when your game authorizes one."},
	duplicate_query={"This update was already checked","This move already completed a check using the latest saved update.","Wait for your game's next update and Capture before querying this move again. Do not apply the same result twice."},
	action_spent={"The move reached its contact limit","It already returned the total number of targets allowed for this move.","End this move or wait for its normal cancellation. Change maxTargets only if your game is meant to allow more contacts."},
	shape_out_of_bounds={"The hitbox is outside the supported range","The shape could not be placed safely at the recorded root position.","Check its position, size and distance from the root. Very large map coordinates also need a precision review."},
	world_unknown={"Obstacle data is missing or uncertain","The optional obstacle function could not prove what was clear or blocked at this time.","Check your world function and its saved obstacle data. It must report covered, blocked and fraction. Include a check for starting inside an obstacle."},
	rules_fault={"The target rule function failed","eligible must finish immediately and return exactly true or false.","Check the function in Actions. Remove waiting calls and fix its errors. Save needed rule values in the snapshot state."},
	capture_fault={"Some positions were not saved","One or more object functions failed or returned unusable data. See the faults list for object ids and reasons.","Explain each item in result.faults. Fix its cause, then report an approved tracking reset for that object."},
	provider_fault={"The position function failed","The function given to Track threw an error or tried to wait.","Check that function for errors. Return root, zones and state immediately. Do not use task.wait or wait for events inside it."},
	quarantined={"Recording for this object is paused","An earlier position function failed. Chrono keeps refusing it until you deliberately reset tracking.","Find and fix the first error. Then call Discontinuity for that object and Capture again. Do not reset every frame."},
	invalid_snapshot={"The position record is not usable","The supplied table or a value it contains could not be read safely.","Return a plain table with root=CFrame, zones={...}, and optional flat state={...}. Check the data function for errors."},
	invalid_state={"Saved game values are not usable","State must contain only true/false values, finite numbers or short text, with string keys.","Save values such as team=2 and active=true. Do not save Instances, nested tables or NaN numbers in state."},
	invalid_zones={"The hitbox list is not usable","There are too many zones or a zone name is invalid.","Return 1 to 32 named shapes. Zone names must be strings up to 64 bytes."},
	invalid_zone={"One hitbox is not usable","A target zone must be a valid box, sphere or capsule.","Build it with Core.Shapes.Box, Sphere or Capsule. Check frame, size, radius and height."},
	empty_zones={"The object has no hitbox","At least one target shape is required in each saved record.","Return a named hitbox in zones, such as zones={Body=S.Sphere(frame,1)}."},
	zone_out_of_bounds={"A hitbox is too far from its object","Its root-to-shape distance plus full outside extent exceeds maxRadius.","Check the world-space hitbox position. Increase maxRadius only to match the real maximum extent your game allows."},
	speed_bound={"The object moved farther than allowed","The root travelled farther than maxSpeed allows between saved updates.","Check your movement data and speed setting. For a game-approved teleport, explicitly reset tracking. Do not raise the limit to accept unexplained movement."},
	empty={"No position records are available","There is no usable record for this object yet.","Track it, supply a valid position function and call Capture before querying it."},
	too_old={"The requested position was not kept","The requested time is before the oldest stored record.","Use a more recent approved time. Check seconds, rate, capture frequency and how long messages are delayed."},
	not_recorded={"That time has not been recorded","The requested time is later than this object's latest saved position.","Check provider faults and simulation order. Capture the shared game update before querying it."},
	expired={"The requested time is too old","The requested time exceeds the configured age limit.","Reject or retry according to your game rules. Only increase the age limit after choosing a fair delay policy."},
	future={"The requested time is in the future","The requested position is later than the server's current clock.","Use a consistent server clock and validate any client-reported times."},
	invalid_time={"The time value is not usable","A time is not a finite number.","Pass time in seconds from the same server clock used by Capture."},
	epoch_changed={"Earlier position records were reset","The requested exact record belongs to an older tracking version.","Do not use records from before a teleport, respawn or approved reset. Capture the new state before a new move."},
	discontinuity={"The requested time crosses a reset","Chrono cannot connect records across a teleport, respawn or tracking failure.","Use a time wholly within the current tracking version. Do not guess a path through the reset."},
	sample_gap={"Saved positions are too far apart","There is too much missing time between the two records needed for this check.","Check capture frequency and stalled updates. Refuse the uncertain check rather than treating it as a miss or a hit."},
	state_boundary={"A game value changed between records","For example, invulnerability changed between the two saved times. Chrono cannot prove its value at the requested time.","Record transitions at their actual server time. Expect uncertain in-between requests to be refused."},
	geometry_boundary={"A hitbox changed between records","A zone was added, removed, resized or changed shape between those times.","Record shape changes at their actual time. Do not interpolate a different shape through the change."},
}
for _,entry in messages do table.freeze(entry) end
Help.Messages=table.freeze(messages)
function Help.Explain(value)
	local code=if type(value)=="table" then value.reason else value
	if type(code)~="string" then code="unknown" end
	local key,subject=code,nil
	if code:sub(1,7)=="source_" and messages[code]==nil then key=code:sub(8) subject="Object doing the move"
	elseif code:sub(1,7)=="target_" and messages[code]==nil then key=code:sub(8) subject="Possible target" end
	local entry=messages[key]
	return table.freeze({code=code,known=entry~=nil,subject=subject,
		title=if entry then entry[1] else "More information is needed",
		meaning=if entry then entry[2] else "This message is not in the built-in help list. Keep the original code when reporting it.",
		fix=if entry then entry[3] else "Check Studio Output and the documentation. Include the original message and a small example when asking for help."})
end
function Help.FindTerms(query)
	local result={} local q=string.lower(if type(query)=="string" then query else "")
	for _,entry in terms do if q=="" or (string.lower(table.concat(entry," "))):find(q,1,true) then table.insert(result,entry) end end
	return result
end
return table.freeze(Help)
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="CF26"><Properties><string name="Name">SportsAdapter</string><ProtectedString name="Source">-- Example dependency boundary for YOUR existing server services, not a replacement framework.
-- ActorService snapshots must already be server-simulated or server-validated.
return function(Integration,ActorService,MoveService,BallService)
	local kit=Integration()
	local chrono,actions,bindings=kit.Chrono,kit.Actions,kit.Bindings
	local liveActions={}
	local connections={}
	local function register(id)
		bindings.Track(id,function(time)
			-- Must atomically return the root, gameplay zones and scalar eligibility state at time.
			return ActorService:CaptureHitboxes(id,time)
		end,"serverValidated","player")
	end
	for _,id in ActorService:GetIds() do register(id) end
	bindings.Track("match-ball",function(time) return BallService:CaptureHitbox(time) end,"serverSimulated","ball")
	table.insert(connections,ActorService.Added:Connect(register))
	table.insert(connections,ActorService.Removed:Connect(function(id) chrono:Untrack(id) end))
	table.insert(connections,ActorService.Discontinuity:Connect(function(id,reason) chrono:Discontinuity(id,reason) end))
	-- Your existing server service already checked stamina, cooldown, possession and request replay.
	table.insert(connections,MoveService.Authorized:Connect(function(actorId,moveId)
		if liveActions[actorId] then chrono:EndAction(liveActions[actorId]) end
		if moveId=="Tackle" then liveActions[actorId]=chrono:BeginAction(actorId,actions.Contact) end
	end))
	table.insert(connections,MoveService.Cancelled:Connect(function(actorId)
		if liveActions[actorId] then chrono:EndAction(liveActions[actorId]) liveActions[actorId]=nil end
	end))
	-- This event must fire after all participating server actors and the ball completed the same step.
	table.insert(connections,ActorService.AfterSimulation:Connect(function(serverTime)
		chrono:Capture(serverTime)
		for actorId,action in liveActions do
			local result=chrono:Query(action)
			if result.ok then
				for _,contact in result.contacts do
					-- The outcome is game-owned. Its current-state checks may still refuse the contact.
					MoveService:TryApplyTackle(actorId,contact.id,contact.time)
				end
			elseif result.reason=="invalid_action" or result.reason=="source_epoch_changed" or result.reason=="roster_changed" then
				chrono:EndAction(action) liveActions[actorId]=nil
			end
		end
	end))
	return function()
		for _,connection in connections do connection:Disconnect() end
		chrono:Destroy()
	end
end
</ProtectedString></Properties></Item></Item><Item class="StringValue" referent="CF28"><Properties><string name="Name">ReadMe</string><string name="Value">ChronoFork V3.1. Unofficial Chrono fork; original credit: Parihsz and contributors. Developed with OpenAI Codex / AI under VertimaXx direction. Save Setup as a Local Plugin. Open Plugins &gt; Chrono V3 &gt; ChronoSetup. Practice starts OFF and does not certify your game. Your server supplies checked positions and owns move authorization/outcomes. See README and CREDITS.</string></Properties></Item></Item></roblox>