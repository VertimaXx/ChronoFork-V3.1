</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF106"><Properties><string name="Name">Types</string><ProtectedString name="Source">local API=require(script.Parent.Parent.Replication.Shared.Types)
export type SnapshotData&lt;Value = CFrame, Velocity = Vector3&gt; = API.SnapshotData&lt;Value,Velocity&gt;
