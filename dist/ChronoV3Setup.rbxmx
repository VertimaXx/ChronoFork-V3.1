<roblox version="4"><Item class="Script" referent="CF0"><Properties><string name="Name">ChronoV3Setup</string><ProtectedString name="Source">-- Packaged as a Script with Core and Editor children. Save as Local Plugin in Studio.
assert(plugin,"Save this Script as a Local Plugin")
local toolbar=plugin:CreateToolbar("Chrono V3")
local toggle=toolbar:CreateButton("ChronoSetup","Connect Chrono to your existing game","")
local connectButton=toolbar:CreateButton("ChronoConnect","Open object, event and script-call connections","")
toggle.ClickableWhenViewportHidden=true
local widget=plugin:CreateDockWidgetPluginGuiAsync("ChronoV3Setup-3.1",DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right,false,false,500,800,360,480))
widget.Title="Chrono V3 • Connect your game"
local view=require(script.Editor.View).Mount(widget,{core=script.Core,runtime=script.Runtime,
 onInstalled=function(object) game:GetService("Selection"):Set({object}) end,
 openScript=function(object)
  game:GetService("Selection"):Set({object})
  if object:IsA("LuaSourceContainer") then
   local opened,reason=game:GetService("ScriptEditorService"):OpenScriptDocumentAsync(object)
   assert(opened,reason)
  end
 end})
toggle.Click:Connect(function() widget.Enabled=not widget.Enabled end)
connectButton.Click:Connect(function() view.Go(6) widget.Enabled=true end)
plugin.Unloading:Connect(function() view.Destroy() widget:Destroy() end)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF1"><Properties><string name="Name">Core</string><ProtectedString name="Source">--!strict
-- Chrono V3: server historical contact evidence. No automatic gameplay/network side effects.
local Guard=require(script.Guard)
local Contract=require(script.Contract)
local History=require(script.History)
local Shapes=require(script.Shapes)
local Types=require(script.Types)
local API={Shapes=Shapes,Version="3.1.0"}
-- Optional explanation helper. It never changes the result or runs a hit check.
function API.Explain(reason: (string | {reason: string})?): Types.Explanation return require(script.Help).Explain(reason) end
local Methods={} Methods.__index=Methods
local private=setmetatable({}, {__mode="k"})
local function session(self)
	local s=assert(private[self],"This Chrono instance was destroyed, or the call used the wrong object.")
	assert(not s.inCallback,"Do not call Chrono again from inside a position or rule function. Return its data first.")
	return s
end
local function call(s,callback,...)
	s.inCallback=true
	local out=table.pack(Contract.Call(callback,...))
	s.inCallback=false
	return table.unpack(out,1,out.n)
end
local function bounded(n,lo,hi) return Guard.Number(n) and n&gt;=lo and n&lt;=hi end
local function name(n) return type(n)=="string" and #n&gt;0 and #n&lt;=64 end
local function frozenResult(ok,reason,fields)
	local out=fields or {} out.ok=ok out.reason=reason
	if not out.contacts then out.contacts=table.freeze({}) end
	return table.freeze(out)
end
local function failure(s,reason,fields)
	s.stats.rejected+=1 s.stats.lastRejection=reason
	return frozenResult(false,reason,fields)
end
local function fresh(s)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return nil,"clock_fault" end
	if not s.time then return nil,"capture_required" end
	if now&lt;s.time-1e-6 then return nil,"clock_reversed" end
	if now-s.time&gt;s.maxGap then return nil,"capture_stale" end
	return now
end
function API.new(options: Types.Options?): Types.Service
	assert(game:GetService("RunService"):IsServer(),"Chrono V3 runs on the server")
	local o=options or {}
	local seconds,rate,gap=o.seconds or 0.6,o.rate or 60,o.maxGap or 0.075
	assert(bounded(seconds,0.05,10) and bounded(rate,1,240) and bounded(gap,0.001,1),"Use seconds=0.05 to 10, rate=1 to 240, and maxGap=0.001 to 1. These control saved-position storage.")
	assert(bounded(o.maxRewind or 0,0,seconds),"maxRewind must be zero or a positive number no greater than seconds (the time you keep past positions).")
	assert(o.clock==nil or type(o.clock)=="function","clock must be a function that returns server time in seconds, or leave it unset.")
	assert(o.resolveRewind==nil or type(o.resolveRewind)=="function","resolveRewind must be a function that returns an approved earlier-time delay, or leave it unset.")
	assert(o.world==nil or type(o.world)=="function","world must be an obstacle-check function, or leave it unset.")
	local self=setmetatable({},Methods)
	private[self]={clock=o.clock or function() return workspace:GetServerTimeNow() end,
		seconds=seconds,capacity=math.ceil(rate*seconds)+2,maxGap=gap,maxRewind=o.maxRewind or 0,
		resolveRewind=o.resolveRewind,world=o.world,actors={},actions={},actionCount=0,roster=0,
		stats={captures=0,queries=0,accepted=0,rejected=0,contacts=0,providerFaults=0,lastRejection="none"}}
	return self :: any -- Public method types help Studio autocomplete; checks above still run.
end
function Methods:Track(id,binding)
	local s=session(self)
	assert(name(id) and type(binding)=="table" and name(binding.kind),"Track needs short text id and kind names. Example: id='player-12', kind='player'.")
	assert(not s.actors[id],"This id is already tracked. Call Untrack before deliberately registering a replacement.")
	assert(type(binding.capture)=="function","Track needs capture=function(time) ... end to supply the object's position, hitboxes and game values.")
	assert(bounded(binding.maxSpeed,0,4096) and bounded(binding.maxRadius,0.001,512),"Set maxSpeed from 0 to 4096 studs/second and maxRadius from 0.001 to 512 studs. They must describe your allowed movement and hitbox extent.")
	local trust=binding.trust or "unverified"
	assert(trust=="unverified" or trust=="serverValidated" or trust=="serverSimulated","Use trust='unverified', 'serverValidated' or 'serverSimulated'. Choose a trusted label only after your server actually checks or calculates the data.")
	local count=0 for _ in s.actors do count+=1 end assert(count&lt;256,"This instance already tracks 256 objects. Remove objects no longer needed before adding another.")
	s.actors[id]={id=id,kind=binding.kind,capture=binding.capture,trust=trust,status="awaiting_capture",faults=0,
		history=History.new({seconds=s.seconds,capacity=s.capacity,maxGap=s.maxGap,maxSpeed=binding.maxSpeed,maxRadius=binding.maxRadius})}
	s.roster+=1
end
function Methods:Untrack(id)
	local s=session(self) if not s.actors[id] then return false end
	s.actors[id]=nil s.roster+=1 return true
end
function Methods:Discontinuity(id,reason)
	local s=session(self) local actor=assert(s.actors[id],"actor not tracked")
	local ok,now=call(s,s.clock) assert(ok and Guard.Number(now),"clock fault")
	actor.history:Break(math.max(now,s.time or now)) actor.status=reason or "discontinuity" actor.quarantined=false
end
-- Invoke after your authoritative simulation. All providers must describe the same instant.
-- An optional timestamp supports a fixed-step server simulation using this clock domain.
function Methods:Capture(time)
	local s=session(self)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return frozenResult(false,"clock_fault") end
	time=time or now
	if not Guard.Number(time) or time&gt;now+1e-6 or now-time&gt;s.maxGap then return frozenResult(false,"invalid_capture_time") end
	if s.time and time&lt;=s.time then return frozenResult(false,"non_monotonic") end
	s.time=time s.stats.captures+=1
	local faults={}
	for id,actor in s.actors do
		if actor.quarantined then table.insert(faults,table.freeze({id=id,reason="quarantined"})) continue end
		local called,snapshot=call(s,actor.capture,time)
		local pushed,reason=false,"provider_fault"
		if called then
			-- Validation itself can encounter an erroneous table metamethod from an adapter.
			local validated,accepted,why=call(s,function() return actor.history:Push(time,snapshot) end)
			pushed=validated and accepted==true
			reason=if validated then why else "invalid_snapshot"
		end
		if not pushed then
			actor.history:Break(time) actor.faults+=1 s.stats.providerFaults+=1
			actor.status=reason actor.quarantined=true table.insert(faults,table.freeze({id=id,reason=reason}))
		else actor.status="captured" end
	end
	for token,action in s.actions do
		if time&gt;action.started+action.close or action.roster~=s.roster then s.actions[token]=nil s.actionCount-=1 end
	end
	return frozenResult(#faults==0,if #faults==0 then "captured" else "capture_fault",{time=time,faults=table.freeze(faults)})
end
-- Call only after your existing server move/action service authorizes the action.
-- No client-facing RemoteEvent is created. Context is consumed only by YOUR timing resolver.
function Methods:BeginAction(actorId,profile,approvedContext)
	local s=session(self) local now,err=fresh(s)
	if not now then return nil,err end
	local actor=s.actors[actorId] if not actor then return nil,"actor_missing" end
	if actor.trust=="unverified" then return nil,"unverified_source" end
	if type(profile)~="table" then return nil,"invalid_profile" end
	local shape=Shapes.Copy(profile.shape)
	local opening,closing=profile.opens or 0,profile.closes or 0.25
	if not shape or not bounded(opening,0,10) or not bounded(closing,opening,10)
		or not bounded(profile.maxReach or 32,0,4096) or Shapes.Reach(shape)&gt;(profile.maxReach or 32)
		or not Guard.Integer(profile.maxTargets or 1,1,256) then return nil,"invalid_profile" end
	if profile.eligible~=nil and type(profile.eligible)~="function" then return nil,"invalid_profile" end
	if profile.world~=nil and type(profile.world)~="boolean" then return nil,"invalid_profile" end
	if profile.world and (not s.world or shape.kind~="sweep") then return nil,"world_provider_or_shape" end
	if type(profile.targets)~="table" then return nil,"target_kinds_required" end
	local kinds,count={},0
	for _,kind in profile.targets do
		if not name(kind) then return nil,"invalid_target_kind" end kinds[kind]=true count+=1
	end
	if count==0 or count&gt;32 then return nil,"target_kinds_required" end
	local rewind=0
	if s.resolveRewind then
		local resolved,value=call(s,s.resolveRewind,actorId,approvedContext,s.time)
		if not resolved or not bounded(value,0,s.maxRewind) then return nil,"rewind_rejected" end rewind=value
	end
	local source,reason=actor.history:Sample(s.time-rewind,now)
	if not source then return nil,"source_"..reason end
	local actorActions=0 for _,a in s.actions do if a.actor==actorId then actorActions+=1 end end
	if s.actionCount&gt;=512 or actorActions&gt;=4 then return nil,"action_capacity" end
	local token=table.freeze({})
	s.actions[token]={actor=actorId,epoch=actor.history.epoch,roster=s.roster,started=s.time,
		open=opening,close=closing,shape=shape,kinds=table.freeze(kinds),eligible=profile.eligible,
		world=profile.world==true,maxTargets=profile.maxTargets or 1,rewind=rewind,hit={},totalHits=0}
	s.actionCount+=1
	return token
end
function Methods:EndAction(token)
	local s=session(self) if not s.actions[token] then return false end
	s.actions[token]=nil s.actionCount-=1 return true
end
function Methods:Query(token)
	local s=session(self) s.stats.queries+=1
	local action=s.actions[token] if not action then return failure(s,"invalid_action") end
	local now,err=fresh(s) if not now then return failure(s,err) end
	if action.roster~=s.roster then return failure(s,"roster_changed") end
	local actor=s.actors[action.actor]
	if not actor or actor.history.epoch~=action.epoch then return failure(s,"source_epoch_changed") end
	local elapsed=s.time-action.started
	if elapsed&lt;action.open then return failure(s,"not_active") end
	if elapsed&gt;action.close then return failure(s,"action_expired") end
	if action.lastTime==s.time then return failure(s,"duplicate_query") end
	if action.totalHits&gt;=action.maxTargets then return failure(s,"action_spent") end
	local time=s.time-action.rewind
	local source,reason=actor.history:Sample(time,now)
	if not source then return failure(s,"source_"..reason) end
	local transformed,query=Contract.Call(Shapes.At,action.shape,source.root)
	if not transformed then return failure(s,"shape_out_of_bounds") end
	local fraction=1 local blocked=false
	if action.world then
		local called,cover=call(s,s.world,time,now,query)
		if not called or type(cover)~="table" or cover.covered~=true or type(cover.blocked)~="boolean"
			or not bounded(cover.fraction,0,1) then return failure(s,"world_unknown") end
		blocked=cover.blocked fraction=if blocked then cover.fraction else 1
	end
	local contacts={}
	for id,target in s.actors do
		if id==action.actor or not action.kinds[target.kind] or action.hit[id] then continue end
		-- A missing target can hide a closer contact. Never return a partial success.
		if target.trust=="unverified" then return failure(s,"unverified_target",{actor=id}) end
		local snapshot,why=target.history:Sample(time,now)
		if not snapshot then return failure(s,"target_"..why,{actor=id}) end
		if action.eligible then
			local called,allowed=call(s,action.eligible,source.state,snapshot.state,id,target.kind)
			if not called or type(allowed)~="boolean" then return failure(s,"rules_fault",{actor=id}) end
			if not allowed then continue end
		end
		local best,zoneName=nil,nil
		for zone,volume in snapshot.zones do
			local t=Shapes.Intersect(query,volume)
			-- Cover wins exact ties. With no cover callback, include sweep endpoint tangency.
			if t and (t&lt;fraction or (not blocked and t&lt;=fraction)) and (not best or t&lt;best or (t==best and zone&lt;zoneName)) then best=t zoneName=zone end
		end
		if best then
			local distance=if query.kind=="sweep" then (query.finish-query.start).Magnitude*best else 0
			table.insert(contacts,table.freeze({id=id,kind=target.kind,zone=zoneName,distance=distance,fraction=best,
				time=time,epoch=snapshot.epoch,state=snapshot.state,root=snapshot.root}))
		end
	end
	table.sort(contacts,function(a,b) if a.fraction~=b.fraction then return a.fraction&lt;b.fraction end return a.id&lt;b.id end)
	while #contacts&gt;action.maxTargets-action.totalHits do table.remove(contacts) end
	-- Commit duplicate suppression only after every relevant provider/rule/world check passed.
	for _,contact in contacts do action.hit[contact.id]=true end
	action.totalHits+=#contacts action.lastTime=s.time
	s.stats.accepted+=1 s.stats.contacts+=#contacts
	return frozenResult(true,"covered",{time=time,capturedAt=s.time,rewind=action.rewind,source=source,
		contacts=table.freeze(contacts),shape=query})
end
function Methods:Inspect()
	local s=session(self) local actors={}
	for id,a in s.actors do
		local row=a.history:Latest()
		table.insert(actors,table.freeze({id=id,kind=a.kind,declaredTrust=a.trust,status=a.status,
			captured=row~=nil,latest=if row then row.time else nil,epoch=a.history.epoch,faults=a.faults}))
	end
	table.sort(actors,function(a,b) return a.id&lt;b.id end)
	return table.freeze({version=API.Version,time=s.time,actors=table.freeze(actors),activeActions=s.actionCount,
		stats=table.freeze(table.clone(s.stats)),worldEnabled=s.world~=nil,maxRewind=s.maxRewind})
end
function Methods:Destroy() session(self) private[self]=nil end
return table.freeze(API)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF2"><Properties><string name="Name">Contract</string><ProtectedString name="Source">--!strict
-- These guards contain yielding adapters. They cannot preempt an infinite CPU loop.
local Guard = require(script.Parent.Guard)
local Contract = {}
function Contract.Call(callback, ...)
	if type(callback) ~= "function" then return false, "callback_missing" end
	local thread = coroutine.create(callback)
	local result = table.pack(coroutine.resume(thread, ...))
	if not result[1] then return false, tostring(result[2]) end
	if coroutine.status(thread) ~= "dead" then
		coroutine.close(thread)
		return false, "callback_yielded"
	end
	return true, table.unpack(result, 2, result.n)
end
function Contract.State(state)
	if type(state) ~= "table" then return nil end
	local result, count = {}, 0
	for key, value in state do
		count += 1
		if count &gt; 32 or type(key) ~= "string" or #key &gt; 64 then return nil end
		if type(value) == "number" then
			if not Guard.Number(value) or math.abs(value) &gt; 1e12 then return nil end
		elseif type(value) == "string" then
			if #value &gt; 128 then return nil end
		elseif type(value) ~= "boolean" then return nil end
		result[key] = value
	end
	return table.freeze(result)
end
function Contract.SameState(a, b)
	for k, v in a do if b[k] ~= v then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end
return table.freeze(Contract)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF3"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
local Guard = require(script.Parent.Guard)
local Geometry = {}
local EPSILON = 1e-9

function Geometry.SegmentDistanceSquared(start: Vector3,finish: Vector3,point: Vector3): number
	local delta=finish-start
	local lengthSquared=delta:Dot(delta)
	local alpha=if lengthSquared&gt;1e-12 then math.clamp((point-start):Dot(delta)/lengthSquared,0,1) else 0
	local offset=point-(start+delta*alpha)
	return offset:Dot(offset)
end

function Geometry.RayOBB(origin: Vector3, direction: Vector3, length: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(origin) or not Guard.Unit(direction) or not Guard.Number(length) or length &lt; 0
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local o, d, half = frame:PointToObjectSpace(origin), frame:VectorToObjectSpace(direction), size * 0.5
	local enter, leave = 0, length
	for _, axis in {"X", "Y", "Z"} do
		local start, delta, extent = o[axis], d[axis], half[axis]
		if math.abs(delta) &lt; EPSILON then
			if math.abs(start) &gt; extent then return nil end
		else
			local a, b = (-extent - start) / delta, (extent - start) / delta
			if a &gt; b then a, b = b, a end
			enter, leave = math.max(enter, a), math.min(leave, b)
			if enter &gt; leave then return nil end
		end
	end
	return enter
end

-- Exact moving sphere vs a stationary OBB, including rounded edges/corners.
-- Split the ray at box-plane crossings; point-to-box distance is quadratic on each interval.
function Geometry.SphereSweepOBB(start: Vector3, finish: Vector3, radius: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(start) or not Guard.Vector(finish) or not Guard.Number(radius) or radius &lt; 0 or radius &gt; 32
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local origin = frame:PointToObjectSpace(start)
	local delta = frame:VectorToObjectSpace(finish - start)
	local half = size * 0.5
	local cuts = {0, 1}
	for _, axis in {"X", "Y", "Z"} do
		if math.abs(delta[axis]) &gt; EPSILON then
			for _, sign in {-1, 1} do
				local t = (sign * half[axis] - origin[axis]) / delta[axis]
				if t &gt; 0 and t &lt; 1 then table.insert(cuts, t) end
			end
		end
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local lower, upper = cuts[i], cuts[i + 1]
		local midpoint = (lower + upper) * 0.5
		local a, b, c = 0, 0, -radius * radius
		for _, axis in {"X", "Y", "Z"} do
			local p = origin[axis] + delta[axis] * midpoint
			if math.abs(p) &gt; half[axis] then
				local offset = origin[axis] - (if p &gt; 0 then half[axis] else -half[axis])
				a += delta[axis] * delta[axis]
				b += 2 * delta[axis] * offset
				c += offset * offset
			end
		end
		if (a * lower + b) * lower + c &lt;= EPSILON then return lower end
		if a &gt; EPSILON then
			local discriminant = b * b - 4 * a * c
			if discriminant &gt;= -EPSILON then
				local root = (-b - math.sqrt(math.max(discriminant, 0))) / (2 * a)
				if root &gt;= lower - EPSILON and root &lt;= upper + EPSILON then return math.clamp(root, lower, upper) end
			end
		end
	end
	return nil
end

return table.freeze(Geometry)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF4"><Properties><string name="Name">Guard</string><ProtectedString name="Source">--!strict
local Guard = {}

function Guard.Number(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Guard.Integer(value: any, minimum: number, maximum: number): boolean
	return Guard.Number(value) and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end

function Guard.Vector(value: any, limit: number?): boolean
	if typeof(value) ~= "Vector3" then return false end
	local bound = limit or 1e7
	return Guard.Number(value.X) and Guard.Number(value.Y) and Guard.Number(value.Z)
		and math.abs(value.X) &lt;= bound and math.abs(value.Y) &lt;= bound and math.abs(value.Z) &lt;= bound
end

function Guard.Frame(value: any, limit: number?): boolean
	if typeof(value) ~= "CFrame" or not Guard.Vector(value.Position, limit) then return false end
	for _, component in {value:GetComponents()} do
		if not Guard.Number(component) then return false end
	end
	-- CFrame.new accepts explicit matrix entries. Reject scaled/sheared/reflected matrices.
	local x,y,z=value.RightVector,value.UpVector,value.ZVector
	return math.abs(x.Magnitude-1)&lt;1e-4 and math.abs(y.Magnitude-1)&lt;1e-4
		and math.abs(z.Magnitude-1)&lt;1e-4 and math.abs(x:Dot(y))&lt;1e-4
		and math.abs(y:Dot(z))&lt;1e-4 and math.abs(z:Dot(x))&lt;1e-4
		and x:Cross(y):Dot(z)&gt;0.9999
end

function Guard.Size(value: any, maximum: number?): boolean
	return Guard.Vector(value, maximum or 512) and value.X &gt; 0 and value.Y &gt; 0 and value.Z &gt; 0
end

function Guard.Unit(value: any): boolean
	return Guard.Vector(value, 1.01) and math.abs(value.Magnitude - 1) &lt;= 0.001
end

return table.freeze(Guard)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF5"><Properties><string name="Name">Help</string><ProtectedString name="Source">-- Help text only. Looking up a message never changes a hit check or trusts a position.
local Help={}
local terms={
	{"authoritative","Server decides","The server makes or checks the value used to decide a hit. A player cannot make a position valid just by sending it.","A tackle uses a position your server movement code has checked."},
	{"server","Server","The computer running the shared game rules for all players. In Studio Play, you can switch between the server and a player's client.","The server decides who gets the ball."},
	{"client","Client","One player's running copy of the game. It handles input, the camera and what that player sees.","A LocalScript reads the tackle button."},
	{"history","Saved past positions","A short list of earlier positions, hitboxes and game values, with the time of each record. Chrono keeps these in memory and later removes old records.","Keep the last 0.6 seconds so a check can use an earlier position."},
	{"snapshot","One saved record","The position, hitboxes and game values of one object at one time.","At time 10.2, the ball was here and the player was on team 2."},
	{"actor","Tracked object","Anything Chrono checks: a player, a ball, an NPC or another game object. It does not have to be a character.","Register the football as kind ball."},
	{"provider","Function that supplies data","A function you write. Chrono calls it to get an object's position, hitboxes and game values.","Read a ball position calculated by your server and return a sphere around it."},
	{"adapter","Connection to your game code","A small piece of code that connects Chrono calls to the scripts your game already uses. Bindings is the generated module for these connections.","When your move script accepts a tackle, start a Chrono action."},
	{"bindings","Connections to your game code","The functions that connect your players, moves and rules to Chrono. The setup creates a Bindings module for you to edit.","Call Bindings.Track when your game adds a player."},
	{"callback","Function given to another function","A function Chrono calls when it needs data or a rule result. The function must finish without task.wait or waiting for an event.","eligible = function(source, target) return source.team ~= target.team end"},
	{"root","Reference position","The main position and direction from which an object's hitboxes are measured. It is a CFrame value; it need not be a part named HumanoidRootPart.","For a ball, its center can be the root."},
	{"cframe","Position and direction (CFrame)","A Roblox value that stores both where something is and which way it faces.","CFrame.new(0, 0, -3) places a local hitbox 3 studs in front."},
	{"local space","Relative to an object","Measure a shape from the object's reference position and facing direction. It moves with that object.","A tackle box stays 3 studs in front of the player."},
	{"world space","Position in the map","Measure a shape in the map's coordinate system, rather than from one object.","A provider returns the ball hitbox at the ball's map position."},
	{"state","Game values saved with a position","Small values your hit rules need at that time. Use true/false, numbers or short text. Do not put Instances or nested tables here.","{active=true, team=2, invulnerable=false}"},
	{"eligible","Allowed by your game rules","A target can count only if the rules you supply allow it. Your game must also check its current rules before applying the result.","A teammate or an invulnerable player may be excluded."},
	{"hitbox","Shape used to check contact","An invisible shape your gameplay uses to decide whether a move reaches an object. It may be simpler than the visible model.","A sphere can represent a football."},
	{"capsule","Cylinder with round ends","A shape like a cylinder with a half-sphere at each end. Height includes both round ends and must be at least twice the radius.","A simple body hitbox can have radius 1.5 and total height 5 studs."},
	{"radius","Center-to-edge distance","The distance from the center of a ball or circular part to its edge. Diameter is twice this value.","Radius 1.5 means a ball is 3 studs wide."},
	{"ray","Line check","A line from a start point to an end point. It has no thickness.","A straight instant-shot check can use a ray."},
	{"sweep","Shape checked along a path","Check a ball all along a straight line, rather than only at its final position. Other objects are held at the one saved time being checked.","A thick straight attack can use a swept sphere."},
	{"interpolation","Estimate between saved positions","If the requested time lies between two records, Chrono estimates a position between them. It refuses to guess across a large gap or an uncertain change.","Records at 10.0 and 10.05 can estimate a pose at 10.025."},
	{"coverage","Enough saved data for the requested time","Chrono has suitable records around that time and its time, change and shape checks pass. This does not prove your supplied positions were honest.","A covered check with zero contacts means a checked miss."},
	{"rewind","Check an earlier position","Use saved records from before the latest update. This is off by default and needs a timing rule supplied by your server.","Your approved timing rule may allow checking 0.08 seconds earlier."},
	{"lag compensation","Use earlier data to account for delay","A game policy that can let an input use an earlier position because messages took time to travel. Chrono does not choose a fair time automatically.","Decide how much delay your game allows before rejecting an old request."},
	{"latency","Message travel delay","The time a message takes to travel. Ping usually measures a round trip, not one direction.","50 ms each way adds about 100 ms to a round trip."},
	{"epoch","Position-record version","A number that changes when tracking is reset. Older records cannot silently be used after that reset.","A respawn starts a new version of the player's position records."},
	{"discontinuity","Approved tracking reset","A real change where earlier positions must no longer connect to later ones. Your game reports it with Discontinuity after approving the change.","Teleport, respawn, or a change in who simulates an object."},
	{"quarantine","Pause one object's recording","Chrono stops using an object's records after its data function fails or returns bad data. Fix the cause, report the approved reset, then record again.","Do not reset tracking repeatedly just to hide a faulty data function."},
	{"network ownership","Who calculates Roblox physics","Roblox can let a player's client calculate an object's physics. Reading that result on the server alone does not prove it was a legal move.","Your server still needs to check player movement used to decide competitive hits."},
	{"stud","Roblox distance unit","A unit for size and distance in Roblox Studio.","A default Part is 4 studs wide along its X axis."},
	{"hz","Updates per second (Hz)","How often something is updated each second. Chrono's rate setting sizes its storage; your script still calls Capture.","60 Hz means 60 updates in one second."},
	{"handle","Move reference returned by Chrono","The value BeginAction returns after it accepts a move. Keep it and pass it to Query and EndAction. Do not create your own table as a replacement.","local move, reason = chrono:BeginAction(playerId, profile)"},
	{"capture","Save one update","Capture asks each registered object's data function for a position record. Your game calls it after all participating objects finish the same server update.","chrono:Capture()"},
	{"query","Check a move","Query checks the move reference you kept from BeginAction. It returns allowed contacts or a reason explaining why the check could not complete.","local result = chrono:Query(move)"},
	{"profile","Settings for one move","A plain Luau table describing the shape, target types, timing, target limit and rules for a move.","The generated Actions.Contact table is one profile."},
	{"contact","One returned target","A tracked object whose saved hitbox touched the move's shape and passed the supplied rules. Your game still decides whether to apply its current result.","result.contacts[1].id is the first returned object id."},
	{"active window","Time when the move may hit","The time from opens to closes, counted after your server starts the move.","opens=0.12 and closes=0.35 allow checks from 120 to 350 ms after the start."},
	{"id","One object's name in your code","A stable short text label for a particular registered object. Keep it unique while that object is tracked.","player-12 is an id; player is its kind."},
	{"kind","Group name for similar objects","A short text label for an object type. A move's targets list uses these labels to choose which groups to check.","Register a ball with kind='ball'; use targets={'ball'} to check that group."},
	{"unverified","Data not approved for hits","The default label for positions whose server-side calculation or validation has not been established. Chrono refuses gameplay checks that need them.","Selecting a Part in Studio creates only an unverified reference."},
	{"serverSimulated","Data calculated by your server","Use this trust label only when your own server code actually calculates the positions used for hit checks.","A server-owned ball simulation supplies its position."},
	{"serverValidated","Data checked by your server","Use this trust label only after your server actually verifies the supplied positions and hitboxes against the rules your game requires.","Your existing movement checks reject impossible client moves before their data reaches Chrono."},
	{"ModuleScript","A reusable code file","A Roblox code file that returns a value when another script calls require on it. Installing the generated main module does not automatically connect it to your game.","local startChrono = require(game.ServerScriptService.ChronoV3Integration)"},
	{"boolean","True or false","A value with only two choices. Useful for saved rules such as whether a player is active or invulnerable.","state = {active=true, invulnerable=false}"},
	{"hitscan","Instant line check","Check a straight line immediately. There is no simulated bullet flying along that path over later frames.","The Instant line check preset creates a ray-shaped query."},
	{"source","Object doing the move","The registered object whose saved position and facing direction place the move's hitbox.","The tackling player is the source; the player or ball being checked is a target."},
	{"target","Object the move may touch","A registered object of a kind listed in the move's targets. Its saved hitbox is checked against the move.","A kick can target the ball kind."},
	{"jitter","Changing message delay","Messages do not all take the same time to arrive. This makes updates arrive at uneven intervals.","Studio's Network Simulator can add different jitter in each direction."},
	{"packet loss","Dropped network packets","Some small pieces of network data do not arrive. Reliable messages can be resent, which adds delay; unreliable updates may stay missing.","0.5% means half of one percent, not 50%."},
}
for _,entry in terms do table.freeze(entry) end
Help.Terms=table.freeze(terms)
local messages={
	captured={"Positions saved","The supplied positions passed the recording checks.","Continue updating the game, then call Capture again after the next update."},
	covered={"Hitbox check completed","There was enough saved data for this check. Zero returned contacts means nothing was touched.","Use the returned contacts only after checking your game's current rules."},
	capture_required={"No positions saved yet","Chrono needs a recorded starting position before it can start a move.","Register your objects with Track. Call Capture once before accepting move requests, then after each game update."},
	capture_stale={"Positions are not recent enough","The game has not saved a recent enough update for this check.","Call Capture after every required server update. Check for stopped loops or functions that wait."},
	clock_fault={"The time function failed","The clock did not return a usable number.","Use the default clock, or return time in seconds from one consistent server clock."},
	clock_reversed={"Time moved backwards","The clock is earlier than the latest saved update.","Use the same server clock for saving positions and checking moves. Do not mix different clocks."},
	invalid_capture_time={"Cannot record this time","The supplied time is too far behind the clock, in the future, or not a valid number.","Use Capture() with its default time first. For a fixed-step simulation, pass a recent server time in the same clock system."},
	non_monotonic={"This update is not newer","Chrono already saved this time or a later time.","Record once per simulation step, in increasing time order. Do not record the same step twice."},
	actor_missing={"Object is not registered","The move's source id was not found.","Call Track for this id before starting the move. Keep the same id spelling in both calls."},
	unverified_source={"The move's position is not approved","The object's data is marked unverified, so it cannot be used to decide gameplay.","Connect data your server actually calculates or validates. Only then choose the matching trust label. Changing the label alone does not validate movement."},
	unverified_target={"A target's position is not approved","One object of a target kind is marked unverified. Chrono refuses a partial result.","Supply checked data for that target kind, or correct which kinds the move should check. Selected Studio references stay unverified."},
	invalid_profile={"Move settings are not usable","A shape, distance limit, active time, target count or rule function is invalid.","Check the Actions module. Times must be ordered, dimensions positive, and maxReach large enough for the full shape."},
	target_kinds_required={"Choose which object types to check","The move needs at least one target kind.","Set targets to a list such as {\"player\", \"ball\"}. Use the kind names passed to Track."},
	invalid_target_kind={"An object type name is invalid","A target kind must be a short nonempty string.","Use the same short kind names in Track and the move's targets list."},
	world_provider_or_shape={"The obstacle check is not connected","world=true needs an obstacle-data function and a ray or moving-ball query.","Connect the world function for a sweep. For an overlap move, implement your game's obstruction rule. Do not disable an obstacle rule just to make a failed check pass."},
	rewind_rejected={"The earlier check time was refused","Your server timing function failed or requested more time than allowed.","Return a delay between zero and maxRewind from your server timing rule. Check request age and never trust a client's time without validation."},
	action_capacity={"Too many moves are still open","This object or service has reached its limit for open move references.","Call EndAction when a move ends or is cancelled. Continue Capture so old moves are removed."},
	invalid_action={"The move reference is no longer valid","It was ended, removed, expired, or was not created by this Chrono instance.","Keep the value BeginAction returns. Start a new move only after your server accepts a new move request."},
	roster_changed={"The tracked object list changed","An object was added or removed after this move started. This version cancels older move references for safety.","End the old move. Let your game decide whether a new move can start after the next saved update."},
	source_epoch_changed={"The moving object was reset","A teleport, respawn or data error changed its position-record version.","End the old move. Fix data errors if present, save the new position, then let your server authorize another move."},
	not_active={"It is too early for this move to hit","The move's hit period has not started yet.","Keep saving positions. Query again during opens to closes, or correct those times in Actions."},
	action_expired={"The move's hit period has ended","This move can no longer return a contact.","Call EndAction. Start a new move only when your game authorizes one."},
	duplicate_query={"This update was already checked","This move already completed a check using the latest saved update.","Wait for your game's next update and Capture before querying this move again. Do not apply the same result twice."},
	action_spent={"The move reached its contact limit","It already returned the total number of targets allowed for this move.","End this move or wait for its normal cancellation. Change maxTargets only if your game is meant to allow more contacts."},
	shape_out_of_bounds={"The hitbox is outside the supported range","The shape could not be placed safely at the recorded root position.","Check its position, size and distance from the root. Very large map coordinates also need a precision review."},
	world_unknown={"Obstacle data is missing or uncertain","The optional obstacle function could not prove what was clear or blocked at this time.","Check your world function and its saved obstacle data. It must report covered, blocked and fraction. Include a check for starting inside an obstacle."},
	rules_fault={"The target rule function failed","eligible must finish immediately and return exactly true or false.","Check the function in Actions. Remove waiting calls and fix its errors. Save needed rule values in the snapshot state."},
	capture_fault={"Some positions were not saved","One or more object functions failed or returned unusable data. See the faults list for object ids and reasons.","Explain each item in result.faults. Fix its cause, then report an approved tracking reset for that object."},
	provider_fault={"The position function failed","The function given to Track threw an error or tried to wait.","Check that function for errors. Return root, zones and state immediately. Do not use task.wait or wait for events inside it."},
	quarantined={"Recording for this object is paused","An earlier position function failed. Chrono keeps refusing it until you deliberately reset tracking.","Find and fix the first error. Then call Discontinuity for that object and Capture again. Do not reset every frame."},
	invalid_snapshot={"The position record is not usable","The supplied table or a value it contains could not be read safely.","Return a plain table with root=CFrame, zones={...}, and optional flat state={...}. Check the data function for errors."},
	invalid_state={"Saved game values are not usable","State must contain only true/false values, finite numbers or short text, with string keys.","Save values such as team=2 and active=true. Do not save Instances, nested tables or NaN numbers in state."},
	invalid_zones={"The hitbox list is not usable","There are too many zones or a zone name is invalid.","Return 1 to 32 named shapes. Zone names must be strings up to 64 bytes."},
	invalid_zone={"One hitbox is not usable","A target zone must be a valid box, sphere or capsule.","Build it with Core.Shapes.Box, Sphere or Capsule. Check frame, size, radius and height."},
	empty_zones={"The object has no hitbox","At least one target shape is required in each saved record.","Return a named hitbox in zones, such as zones={Body=S.Sphere(frame,1)}."},
	zone_out_of_bounds={"A hitbox is too far from its object","Its root-to-shape distance plus full outside extent exceeds maxRadius.","Check the world-space hitbox position. Increase maxRadius only to match the real maximum extent your game allows."},
	speed_bound={"The object moved farther than allowed","The root travelled farther than maxSpeed allows between saved updates.","Check your movement data and speed setting. For a game-approved teleport, explicitly reset tracking. Do not raise the limit to accept unexplained movement."},
	empty={"No position records are available","There is no usable record for this object yet.","Track it, supply a valid position function and call Capture before querying it."},
	too_old={"The requested position was not kept","The requested time is before the oldest stored record.","Use a more recent approved time. Check seconds, rate, capture frequency and how long messages are delayed."},
	not_recorded={"That time has not been recorded","The requested time is later than this object's latest saved position.","Check provider faults and simulation order. Capture the shared game update before querying it."},
	expired={"The requested time is too old","The requested time exceeds the configured age limit.","Reject or retry according to your game rules. Only increase the age limit after choosing a fair delay policy."},
	future={"The requested time is in the future","The requested position is later than the server's current clock.","Use a consistent server clock and validate any client-reported times."},
	invalid_time={"The time value is not usable","A time is not a finite number.","Pass time in seconds from the same server clock used by Capture."},
	epoch_changed={"Earlier position records were reset","The requested exact record belongs to an older tracking version.","Do not use records from before a teleport, respawn or approved reset. Capture the new state before a new move."},
	discontinuity={"The requested time crosses a reset","Chrono cannot connect records across a teleport, respawn or tracking failure.","Use a time wholly within the current tracking version. Do not guess a path through the reset."},
	sample_gap={"Saved positions are too far apart","There is too much missing time between the two records needed for this check.","Check capture frequency and stalled updates. Refuse the uncertain check rather than treating it as a miss or a hit."},
	state_boundary={"A game value changed between records","For example, invulnerability changed between the two saved times. Chrono cannot prove its value at the requested time.","Record transitions at their actual server time. Expect uncertain in-between requests to be refused."},
	geometry_boundary={"A hitbox changed between records","A zone was added, removed, resized or changed shape between those times.","Record shape changes at their actual time. Do not interpolate a different shape through the change."},
}
for _,entry in messages do table.freeze(entry) end
Help.Messages=table.freeze(messages)
function Help.Explain(value)
	local code=if type(value)=="table" then value.reason else value
	if type(code)~="string" then code="unknown" end
	local key,subject=code,nil
	if code:sub(1,7)=="source_" and messages[code]==nil then key=code:sub(8) subject="Object doing the move"
	elseif code:sub(1,7)=="target_" and messages[code]==nil then key=code:sub(8) subject="Possible target" end
	local entry=messages[key]
	return table.freeze({code=code,known=entry~=nil,subject=subject,
		title=if entry then entry[1] else "More information is needed",
		meaning=if entry then entry[2] else "This message is not in the built-in help list. Keep the original code when reporting it.",
		fix=if entry then entry[3] else "Check Studio Output and the documentation. Include the original message and a small example when asking for help."})
end
function Help.FindTerms(query)
	local result={} local q=string.lower(if type(query)=="string" then query else "")
	for _,entry in terms do if q=="" or (string.lower(table.concat(entry," "))):find(q,1,true) then table.insert(result,entry) end end
	return result
end
return table.freeze(Help)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF6"><Properties><string name="Name">History</string><ProtectedString name="Source">--!strict
local Guard=require(script.Parent.Guard)
local Contract=require(script.Parent.Contract)
local Shapes=require(script.Parent.Shapes)
local H={} H.__index=H
function H.new(options)
	return setmetatable({rows=table.create(options.capacity),head=1,count=0,capacity=options.capacity,
		epoch=1,maxAge=options.seconds,maxGap=options.maxGap,maxSpeed=options.maxSpeed,
		maxRadius=options.maxRadius,boundary=-math.huge},H)
end
function H:_at(i) return self.rows[(self.head+i-2)%self.capacity+1] end
function H:Latest() return if self.count&gt;0 then self:_at(self.count) else nil end
function H:Break(time)
	self.epoch+=1 self.boundary=time
end
function H:Push(time,snapshot)
	if type(snapshot)~="table" or not Guard.Frame(snapshot.root) or type(snapshot.zones)~="table" then return false,"invalid_snapshot" end
	local state=Contract.State(snapshot.state or {})
	if not state then return false,"invalid_state" end
	local zones,count={},0
	for name,shape in snapshot.zones do
		count+=1
		if count&gt;32 or type(name)~="string" or #name&gt;64 then return false,"invalid_zones" end
		local zone=Shapes.Copy(shape,true)
		if not zone then return false,"invalid_zone" end
		if (zone.frame.Position-snapshot.root.Position).Magnitude+Shapes.Radius(zone)&gt;self.maxRadius+1e-5 then return false,"zone_out_of_bounds" end
		zones[name]=zone
	end
	if count==0 then return false,"empty_zones" end
	local latest=self:Latest()
	if time&lt;self.boundary or (latest and time&lt;=latest.time) then return false,"non_monotonic" end
	if latest and latest.epoch==self.epoch and (snapshot.root.Position-latest.root.Position).Magnitude&gt;self.maxSpeed*(time-latest.time)+1e-4 then return false,"speed_bound" end
	local row=table.freeze({time=time,root=snapshot.root,zones=table.freeze(zones),state=state,epoch=self.epoch})
	if self.count&lt;self.capacity then self.count+=1 self.rows[(self.head+self.count-2)%self.capacity+1]=row
	else self.rows[self.head]=row self.head=self.head%self.capacity+1 end
	return true
end
function H:Sample(time,now)
	if not Guard.Number(time) or not Guard.Number(now) then return nil,"invalid_time" end
	if time&gt;now+1e-6 then return nil,"future" end
	if now-time&gt;self.maxAge then return nil,"expired" end
	if self.count==0 then return nil,"empty" end
	if time&lt;self:_at(1).time then return nil,"too_old" end
	if time&gt;self:Latest().time then return nil,"not_recorded" end
	local low,high=1,self.count
	while low&lt;=high do local mid=(low+high)//2 if self:_at(mid).time&lt;time then low=mid+1 else high=mid-1 end end
	local after=self:_at(low)
	if after.time==time then
		if after.epoch~=self.epoch then return nil,"epoch_changed" end
		return after
	end
	local before=self:_at(low-1)
	if before.epoch~=after.epoch or after.epoch~=self.epoch then return nil,"discontinuity" end
	if after.time-before.time&gt;self.maxGap then return nil,"sample_gap" end
	if not Contract.SameState(before.state,after.state) then return nil,"state_boundary" end
	local alpha=(time-before.time)/(after.time-before.time)
	local zones={}
	for name,zone in before.zones do
		local nextZone=after.zones[name]
		if not nextZone or not Shapes.SameDimensions(zone,nextZone) then return nil,"geometry_boundary" end
		zones[name]=Shapes.Lerp(zone,nextZone,alpha)
	end
	for name in after.zones do if not before.zones[name] then return nil,"geometry_boundary" end end
	return table.freeze({time=time,root=before.root:Lerp(after.root,alpha),state=before.state,
		zones=table.freeze(zones),epoch=before.epoch})
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF7"><Properties><string name="Name">Shapes</string><ProtectedString name="Source">--!strict
-- Geometry uses studs, seconds, world CFrames, and closed volumes (tangency counts).
local Guard = require(script.Parent.Guard)
local G = require(script.Parent.Geometry)
local S = {}
local EPS = 1e-7
local function positive(v, maximum)
	return Guard.Number(v) and v &gt; 0 and v &lt;= maximum
end
function S.Copy(s, targetOnly)
	if type(s) ~= "table" then return nil end
	if s.kind == "box" and Guard.Frame(s.frame) and Guard.Size(s.size, 512) then
		return table.freeze({kind="box", frame=s.frame, size=s.size})
	elseif s.kind == "sphere" and Guard.Frame(s.frame) and positive(s.radius,32) then
		return table.freeze({kind="sphere", frame=s.frame, radius=s.radius})
	elseif s.kind == "capsule" and Guard.Frame(s.frame) and positive(s.radius,32)
		and positive(s.height,512) and s.height &gt;= s.radius*2 then
		return table.freeze({kind="capsule", frame=s.frame, radius=s.radius, height=s.height})
	elseif not targetOnly and s.kind == "sweep" and Guard.Vector(s.start) and Guard.Vector(s.finish)
		and Guard.Number(s.radius) and s.radius &gt;= 0 and s.radius &lt;= 32
		and (s.finish-s.start).Magnitude &lt;= 4096 then
		return table.freeze({kind="sweep", start=s.start, finish=s.finish, radius=s.radius})
	end
	return nil
end
local function checked(s) return assert(S.Copy(s), "invalid Chrono shape") end
function S.Box(frame, size) return checked({kind="box",frame=frame,size=size}) end
function S.Sphere(frame, radius) return checked({kind="sphere",frame=frame,radius=radius}) end
function S.Capsule(frame, radius, height) return checked({kind="capsule",frame=frame,radius=radius,height=height}) end
function S.Sweep(start, finish, radius) return checked({kind="sweep",start=start,finish=finish,radius=radius}) end
function S.Ray(start, finish) return S.Sweep(start,finish,0) end
function S.At(shape, frame)
	assert(Guard.Frame(frame), "invalid reference frame")
	local out = table.clone(shape)
	if out.kind == "sweep" then
		out.start, out.finish = frame:PointToWorldSpace(out.start), frame:PointToWorldSpace(out.finish)
	else out.frame = frame*out.frame end
	return checked(out)
end
function S.Radius(s)
	if s.kind == "box" then return s.size.Magnitude*0.5 end
	if s.kind == "capsule" then return s.height*0.5 end
	return s.radius
end
function S.Reach(s)
	if s.kind == "sweep" then return math.max(s.start.Magnitude,s.finish.Magnitude)+s.radius end
	return s.frame.Position.Magnitude+S.Radius(s)
end
function S.SameDimensions(a,b)
	return a.kind==b.kind and a.size==b.size and a.radius==b.radius and a.height==b.height
end
function S.Lerp(a,b,alpha)
	local out=table.clone(a) out.frame=a.frame:Lerp(b.frame,alpha)
	return table.freeze(out)
end
local function ends(c)
	local offset=c.frame.UpVector*(c.height*0.5-c.radius)
	return c.frame.Position-offset,c.frame.Position+offset
end
-- Closest distance between two closed segments, including zero length segments.
local function segmentPair(p1,q1,p2,q2)
	local d1,d2,r=q1-p1,q2-p2,p1-p2
	local a,e,f=d1:Dot(d1),d2:Dot(d2),d2:Dot(r)
	local s,t=0,0
	if a&lt;=1e-12 and e&lt;=1e-12 then return r:Dot(r) end
	if a&lt;=1e-12 then t=math.clamp(f/e,0,1)
	else
		local c=d1:Dot(r)
		if e&lt;=1e-12 then s=math.clamp(-c/a,0,1)
		else
			local b=d1:Dot(d2) local denominator=a*e-b*b
			if denominator&gt;1e-12 then s=math.clamp((b*f-c*e)/denominator,0,1) end
			t=(b*s+f)/e
			if t&lt;0 then t=0 s=math.clamp(-c/a,0,1)
			elseif t&gt;1 then t=1 s=math.clamp((b-c)/a,0,1) end
		end
	end
	local delta=r+d1*s-d2*t
	return delta:Dot(delta)
end
local function raySphere(p,q,center,radius)
	local d,m=q-p,p-center
	local a,c=d:Dot(d),m:Dot(m)-radius*radius
	if c&lt;=EPS then return 0 end
	if a&lt;1e-12 then return nil end
	local b=m:Dot(d) local h=b*b-a*c
	if h&lt;0 then return nil end
	local t=(-b-math.sqrt(h))/a
	if t&gt;=0 and t&lt;=1 then return t end
	return nil
end
-- Point swept against a capsule. Split where projection onto its axis clamps.
-- On each piece, squared distance to the segment is a quadratic in t.
local function rayCapsule(p,q,a,b,radius)
	local axis,d,m=b-a,q-p,p-a
	local length2=axis:Dot(axis)
	if length2&lt;1e-12 then return raySphere(p,q,a,radius) end
	local u0,du=m:Dot(axis)/length2,d:Dot(axis)/length2
	local cuts={0,1}
	if math.abs(du)&gt;1e-12 then
		for _,u in {0,1} do local t=(u-u0)/du if t&gt;0 and t&lt;1 then table.insert(cuts,t) end end
	end
	table.sort(cuts)
	for i=1,#cuts-1 do
		local lower,upper=cuts[i],cuts[i+1]
		local u=u0+du*(lower+upper)*0.5
		local v,w
		if u&lt;0 then v,w=m,d elseif u&gt;1 then v,w=p-b,d
		else v,w=m-axis*u0,d-axis*du end
		local aa,bb,cc=w:Dot(w),2*v:Dot(w),v:Dot(v)-radius*radius
		if (aa*lower+bb)*lower+cc&lt;=EPS then return lower end
		if aa&gt;1e-12 then
			local discriminant=bb*bb-4*aa*cc
			if discriminant&gt;=0 then
				local t=(-bb-math.sqrt(discriminant))/(2*aa)
				if t&gt;=lower-EPS and t&lt;=upper+EPS then return math.clamp(t,lower,upper) end
			end
		end
	end
	return nil
end
local function boxBox(a,b)
	local aa={a.frame.RightVector,a.frame.UpVector,a.frame.ZVector}
	local ba={b.frame.RightVector,b.frame.UpVector,b.frame.ZVector}
	local axes={aa[1],aa[2],aa[3],ba[1],ba[2],ba[3]}
	for _,u in aa do for _,v in ba do table.insert(axes,u:Cross(v)) end end
	local halfA,halfB=a.size*0.5,b.size*0.5
	local dimsA,dimsB={halfA.X,halfA.Y,halfA.Z},{halfB.X,halfB.Y,halfB.Z}
	local delta=b.frame.Position-a.frame.Position
	for _,axis in axes do
		if axis.Magnitude&gt;1e-7 then
			axis=axis.Unit local ra,rb=0,0
			for i=1,3 do ra+=dimsA[i]*math.abs(axis:Dot(aa[i])) rb+=dimsB[i]*math.abs(axis:Dot(ba[i])) end
			if math.abs(delta:Dot(axis))&gt;ra+rb+EPS then return false end
		end
	end
	return true
end
-- Returns the first travel fraction for a sweep, or zero for volume overlap.
-- This is exact for supplied primitives at one time; it is not continuous actor motion.
function S.Intersect(a,b)
	if a.kind=="sweep" then
		if b.kind=="box" then return G.SphereSweepOBB(a.start,a.finish,a.radius,b.frame,b.size) end
		if b.kind=="sphere" then return raySphere(a.start,a.finish,b.frame.Position,a.radius+b.radius) end
		local p,q=ends(b) return rayCapsule(a.start,a.finish,p,q,a.radius+b.radius)
	end
	local hit=false
	if a.kind=="box" and b.kind=="box" then hit=boxBox(a,b)
	elseif a.kind=="sphere" and b.kind=="sphere" then
		hit=(a.frame.Position-b.frame.Position).Magnitude&lt;=a.radius+b.radius+EPS
	elseif a.kind=="capsule" and b.kind=="capsule" then
		local p,q=ends(a) local r,s=ends(b)
		hit=segmentPair(p,q,r,s)&lt;=(a.radius+b.radius)^2+EPS
	elseif a.kind=="box" or b.kind=="box" then
		local box,other=if a.kind=="box" then a else b,if a.kind=="box" then b else a
		local p,q=other.frame.Position,other.frame.Position
		if other.kind=="capsule" then p,q=ends(other) end
		hit=G.SphereSweepOBB(p,q,other.radius,box.frame,box.size)~=nil
	else
		local sphere,cap=if a.kind=="sphere" then a else b,if a.kind=="sphere" then b else a
		local p,q=ends(cap)
		hit=G.SegmentDistanceSquared(p,q,sphere.frame.Position)&lt;=(sphere.radius+cap.radius)^2+EPS
	end
	return if hit then 0 else nil
end
return table.freeze(S)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF8"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Editor help and autocomplete. Runtime checks still validate every supplied value.
export type State = {[string]: boolean | number | string}
export type Volume = {kind: "box", frame: CFrame, size: Vector3}
	| {kind: "sphere", frame: CFrame, radius: number}
	| {kind: "capsule", frame: CFrame, radius: number, height: number}
export type Sweep = {kind: "sweep", start: Vector3, finish: Vector3, radius: number}
export type Snapshot = {root: CFrame, zones: {[string]: Volume}, state: State?}
export type Binding = {
	kind: string,
	capture: (serverTime: number) -&gt; Snapshot,
	trust: ("unverified" | "serverSimulated" | "serverValidated")?,
	maxSpeed: number,
	maxRadius: number,
}
export type Profile = {
	shape: Volume | Sweep,
	targets: {string},
	opens: number?,
	closes: number?,
	maxTargets: number?,
	maxReach: number?,
	eligible: ((source: State, target: State, targetId: string, targetKind: string) -&gt; boolean)?,
	world: boolean?,
}
-- Keep the value BeginAction returns; do not make your own table for a move reference.
export type Move = {}
export type Contact = {id: string, kind: string, zone: string, time: number, epoch: number,
	state: State, root: CFrame, distance: number, fraction: number}
export type Result = {ok: boolean, reason: string, contacts: {Contact}, time: number?,
	capturedAt: number?, rewind: number?, source: any?, shape: (Volume | Sweep)?, actor: string?}
export type CaptureResult = {ok: boolean, reason: string, time: number?,
	faults: {{id: string, reason: string}}?, contacts: {Contact}}
export type Options = {
	seconds: number?, rate: number?, maxGap: number?, maxRewind: number?,
	clock: (() -&gt; number)?,
	resolveRewind: ((actorId: string, approvedServerContext: any, captureTime: number) -&gt; number)?,
	world: ((queryTime: number, now: number, shape: Sweep) -&gt; {covered: boolean, blocked: boolean?, fraction: number?})?,
}
export type Explanation = {code: string, known: boolean, subject: string?, title: string, meaning: string, fix: string}
export type Service = {
	Track: (self: Service, id: string, binding: Binding) -&gt; (),
	Untrack: (self: Service, id: string) -&gt; boolean,
	Discontinuity: (self: Service, id: string, reason: string?) -&gt; (),
	Capture: (self: Service, serverTime: number?) -&gt; CaptureResult,
	BeginAction: (self: Service, actorId: string, profile: Profile, approvedServerContext: any?) -&gt; (Move?, string?),
	Query: (self: Service, move: Move) -&gt; Result,
	EndAction: (self: Service, move: Move) -&gt; boolean,
	Inspect: (self: Service) -&gt; any,
	Destroy: (self: Service) -&gt; (),
}
return table.freeze({})
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="CF9"><Properties><string name="Name">Editor</string></Properties><Item class="ModuleScript" referent="CF10"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Game-neutral data schema. Presets are editable examples, not game adapters.
local C={}
local Fields=require(script.Parent.Fields)
function C.Default()
	return {name="ChronoV3Integration",kind="actor",targets="actor,ball",shape="Capsule",radius=1.5,height=5,
		width=4,depth=5,forward=3,length=100,opens=0.12,closes=0.35,maxTargets=1,
		seconds=0.6,maxGap=0.075,maxRewind=0,maxSpeed=100,maxRadius=16,rules="all"}
end
function C.Preset(preset,previous)
	local c=C.Default() c.name=previous.name
	if preset=="Sports" then c.kind="player" c.targets="player,ball"
	elseif preset=="Melee" then c.shape="Box" c.kind="fighter" c.targets="fighter" c.forward=2 c.rules="team"
	elseif preset=="Hitscan" then c.shape="Ray" c.kind="player" c.targets="player" c.opens=0 c.closes=0.1 c.rules="team" end
	return c
end
local function number(v,lo,hi) return type(v)=="number" and v==v and v&gt;=lo and v&lt;=hi end
function C.ParseNumber(value)
	if type(value)=="number" then return value end
	if type(value)~="string" then return nil end
	local text=value:match("^%s*(.-)%s*$")
	if not text:find("%.") then text=text:gsub(",",".") end
	local result=tonumber(text)
	return if result and result==result and math.abs(result)&lt;math.huge then result else nil
end
function C.Check(c)
	local errors={}
	local function add(field,message) table.insert(errors,{field=field,page=Fields.Items[field].page,message=message}) end
	if type(c)~="table" then add("name","No settings were supplied. Start with an example on page 1.") return errors end
	if type(c.name)~="string" or #c.name==0 or #c.name&gt;48 or c.name:match("^%s*$") or c.name:find('[%c/\\\"]') then add("name","Use a short name without quotation marks, slash or backslash. Spaces are allowed. Example: Football contact.") end
	if type(c.kind)~="string" or #c.kind==0 or #c.kind&gt;48 or c.kind:find("[%s,%c]") then add("kind","Use one short object type name without spaces or commas. Example: player or ball.") end
	local count=0
	if type(c.targets)~="string" or #c.targets&gt;256 then add("targets","Enter target type names, separated by commas. Example: player, ball.")
	else
		for kind in c.targets:gmatch("[^,]+") do
			kind=kind:match("^%s*(.-)%s*$")
			if #kind==0 or #kind&gt;48 or kind:find("[%s%c]") then add("targets","Each target type needs one short name. Use commas between names, not spaces.") break end
			count+=1
		end
		if count==0 or count&gt;16 then add("targets","Enter 1 to 16 target type names. Example: player, ball.") end
	end
	if not table.find({"Box","Sphere","Capsule","Ray","SweptSphere"},c.shape) then add("shape","Choose one of the five hitbox shapes.") end
	local used={opens=true,closes=true,maxTargets=true,seconds=true,maxGap=true,maxRewind=true,maxSpeed=true,maxRadius=true}
	if c.shape=="Box" then used.width=true used.height=true used.depth=true used.forward=true
	elseif c.shape=="Sphere" then used.radius=true used.forward=true
	elseif c.shape=="Capsule" then used.radius=true used.height=true used.forward=true
	elseif c.shape=="Ray" then used.length=true
	elseif c.shape=="SweptSphere" then used.length=true used.radius=true end
	for _,key in Fields.Order do
		local field=Fields.Items[key]
		if used[key] and not number(c[key],field.min,field.max) then add(key,string.format("%s: enter a number from %s to %s %s.",field.label,field.min,field.max,field.unit)) end
	end
	if number(c.maxTargets,1,256) and c.maxTargets%1~=0 then add("maxTargets","The object count must be a whole number, such as 1 or 3.") end
	if number(c.opens,0,10) and number(c.closes,0,10) and c.closes&lt;c.opens then add("closes","Stop time must be the same as, or later than, the time hits start.") end
	if number(c.seconds,0.05,10) and number(c.maxRewind,0,10) and c.maxRewind&gt;c.seconds then add("maxRewind","The allowed past time cannot be longer than the time you keep past positions.") end
	if c.shape=="Capsule" and number(c.height,0.02,64) and number(c.radius,0.01,32) and c.height&lt;c.radius*2 then add("height","A capsule needs height at least twice its radius. Radius 1.5 needs total height 3 or more.") end
	if c.rules~="all" and c.rules~="team" then add("rules","Choose a target rule example.") end
	return errors
end
function C.Validate(c)
	local errors=C.Check(c)
	return #errors==0,if errors[1] then errors[1].message else nil
end
function C.Generate(c)
	local ok,why=C.Validate(c) assert(ok,why)
	local shape
	if c.shape=="Box" then shape=string.format("S.Box(CFrame.new(0,0,-%s),Vector3.new(%s,%s,%s))",c.forward,c.width,c.height,c.depth)
	elseif c.shape=="Sphere" then shape=string.format("S.Sphere(CFrame.new(0,0,-%s),%s)",c.forward,c.radius)
	elseif c.shape=="Capsule" then shape=string.format("S.Capsule(CFrame.new(0,0,-%s),%s,%s)",c.forward,c.radius,c.height)
	else shape=string.format("S.Sweep(Vector3.zero,Vector3.new(0,0,-%s),%s)",c.length,if c.shape=="Ray" then 0 else c.radius) end
	local kinds={} for kind in c.targets:gmatch("[^,%s]+") do table.insert(kinds,string.format("%q",kind)) end
	local rules=if c.rules=="team" then "return source.active == true and target.active == true and source.team ~= nil and target.team ~= nil and source.team ~= target.team" else "return true -- Example only: add the rules your game needs before using real moves."
	local reach=if c.shape=="Ray" then c.length elseif c.shape=="SweptSphere" then c.length+c.radius
		elseif c.shape=="Capsule" then c.forward+c.height/2 elseif c.shape=="Sphere" then c.forward+c.radius
		else c.forward+Vector3.new(c.width,c.height,c.depth).Magnitude/2
	return {
		Actions=string.format([[-- MOVE SETTINGS. Edit these values to match one move in your game.
-- A hitbox is an invisible shape used to check contact.
-- Its position here is measured from the moving object's main position and direction.
local S=require(script.Parent.Core).Shapes
return {
 Contact = {
  shape = %s,
  targets = {%s},
  opens = %s,
  closes = %s,
  maxTargets = %s,
  maxReach = %.9g,
 -- opens/closes: seconds after your server accepts the move.
 -- maxTargets: total different objects this move may return; not a count per frame.
 -- source/target: saved game values from your position functions, such as team and active.
  eligible = function(source, target)
  %s
  end,
 },
}
]],shape,table.concat(kinds,","),c.opens,c.closes,c.maxTargets,reach+0.0001,rules),
		Settings=string.format([[-- RECORDING SETTINGS. These do not control your camera, movement, animation or health.
-- seconds: how long to keep earlier positions and hitboxes in memory.
-- rate: expected updates per second. This sizes the storage; your script still calls Capture.
-- maxGap: largest time gap across which Chrono may estimate an in-between position.
-- maxRewind: largest earlier time your SERVER timing rule may approve. Zero is simplest.
return {seconds=%s,rate=60,maxGap=%s,maxRewind=%s,maxSpeed=%s,maxRadius=%s}
-- A larger maxRewind alone does not enable earlier checks.
-- Add a resolveRewind function only after deciding how your server validates delayed requests.
]],c.seconds,c.maxGap,c.maxRewind,c.maxSpeed,c.maxRadius),
		Bindings=string.format([[-- ADVANCED MANUAL CONNECTIONS. The plugin's supplied Connector handles routine tracking/recording.
-- Use page 6 for that workflow; do not start both Connector and another manual instance.
-- This file does not replace your player or move scripts.
-- capture is a function YOU supply. It returns a position, hitboxes and rule values at one time.
-- "unverified": data is not approved for gameplay checks.
-- "serverSimulated": your server calculates the data itself.
-- "serverValidated": your server already checks that the supplied data is allowed.
-- Changing the label does not make a player's movement safe. That check belongs in your game.
return function(chrono)
 local B={}
 function B.Track(id,capture,declaredTrust,kind)
  chrono:Track(id,{kind=kind or %q,capture=capture,trust=declaredTrust or "unverified",maxSpeed=%s,maxRadius=%s})
 end
 -- Optional reference for inspecting a selected Part. It stays unverified.
 -- A server reading a client-controlled Part is not the same as a server checking its movement.
 function B.TrackReference(id,part,kind)
  B.Track(id,function(time)
   return {root=part.CFrame,zones={Body=require(script.Parent.Core).Shapes.Box(part.CFrame,part.Size)},state={}}
  end,"unverified",kind)
 end
 -- CONNECTION 1: when your game adds an object, call B.Track with its data function.
 -- Return {root=mainCFrame,zones={Body=shape},state={active=true,team=1}}.
 -- root is the object's reference position AND direction. Zones use map positions.
 -- state contains simple game values: booleans, numbers and short text, not Instances/tables.
 -- CONNECTION 2: after your server updates all participating objects, call chrono:Capture().
 -- Save once before allowing moves, then after every needed game update.
 -- CONNECTION 3: AFTER your server accepts a move (cooldown, stamina, etc.), call BeginAction.
 -- Keep its returned move reference. During the hit period, call Query with that reference.
 -- CONNECTION 4: if result.ok is true, recheck CURRENT rules and apply your own result once.
 -- Your game decides possession, damage or stun. Keep your existing animations and effects.
 -- On an approved teleport/respawn/change of physics owner: chrono:Discontinuity(id,reason).
 -- When cancelled/finished: chrono:EndAction(move). When removed: chrono:Untrack(id).
 -- If something fails: local help=require(script.Parent.Core).Explain(reason)
 -- Print help.title, help.meaning and help.fix. The original reason code stays available.
 return B
end
]],c.kind,c.maxSpeed,c.maxRadius),
		Integration=[[-- LOW-LEVEL MANUAL CONSTRUCTOR. With page-6 connections, require Connector instead.
-- Its supplied StartConnection Script handles startup. Do not create a second instance here.
-- For a manual integration: require this module from your existing SERVER startup script.
-- Requiring this file returns a function. Call that function once to make a Chrono instance.
-- The instance does not move objects or start recording on its own.
return function(overrides)
 local Core=require(script.Core)
 local options=table.clone(require(script.Settings))
 for key,value in overrides or {} do options[key]=value end
 local chrono=Core.new(options)
 return {Chrono=chrono,Actions=require(script.Actions),Bindings=require(script.Bindings)(chrono),Explain=Core.Explain}
end
]],
		Practice=string.format([[-- SAFE PRACTICE: uses made-up server values, no live players or map changes.
-- Uses your shape and target rule with an immediate hit period for this example.
-- This does NOT test your game's connections or real move timing.
return function(Integration)
 local time=10
 local kit=Integration({clock=function() return time end})
 local chrono=kit.Chrono
 local S=require(script.Parent.Core).Shapes
 local targetFrame=CFrame.new(0,0,-%s)
 chrono:Track("practice-source",{kind="practice",trust="serverSimulated",maxSpeed=1,maxRadius=2,
  capture=function() return {root=CFrame.new(),zones={Body=S.Sphere(CFrame.new(),1)},state={active=true,team=1}} end})
 chrono:Track("practice-target",{kind=kit.Actions.Contact.targets[1],trust="serverSimulated",maxSpeed=1,maxRadius=2,
  capture=function() return {root=targetFrame,zones={Body=S.Sphere(targetFrame,1)},state={active=true,team=2}} end})
 assert(chrono:Capture().ok,"Practice could not save its first position")
 local practiceProfile=table.clone(kit.Actions.Contact)
 practiceProfile.opens=0 practiceProfile.closes=1
 local move,reason=chrono:BeginAction("practice-source",practiceProfile)
 assert(move,reason)
 local result=chrono:Query(move)
 local contacts=#result.contacts
 local replay=chrono:Query(move)
 local passed=result.ok and contacts==1 and replay.reason=="duplicate_query"
 local report={passed=passed,contacts=contacts,reason=result.reason,
  duplicateStopped=replay.reason=="duplicate_query",message=if passed then "Practice passed: one contact; repeated check refused. Your game connections are not tested yet." else "Practice failed. Read the reason and use Core.Explain(reason)."}
 chrono:EndAction(move) chrono:Destroy()
 return report
end
]],if c.shape=="Ray" or c.shape=="SweptSphere" then c.length*0.5 else c.forward),
		RunPractice=[[-- PRACTICE ONLY. Starts turned OFF. It never runs in a published game.
-- 1. In Explorer, select this Script and set Enabled=true in Properties.
-- 2. Press Play. Read Output for "Chrono V3 practice".
-- 3. Stop Play. Turn this Script off again or remove it when you finish learning.
if not game:GetService("RunService"):IsStudio() then return end
local report=require(script.Parent.Practice)(require(script.Parent))
print("Chrono V3 practice: "..report.message)
script.Parent:SetAttribute("PracticePassed",report.passed)
script.Parent:SetAttribute("PracticeMessage",report.message)
]],
	}
end
return table.freeze(C)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF11"><Properties><string name="Name">ConnectionAdvanced</string><ProtectedString name="Source">-- Advanced controls are part of the same plugin and save the same reviewed settings.
local C=require(script.Parent.ConnectionConfig)
local Picture=require(script.Parent.VolumePreview)
local A={}
function A.Draw(tab,ui,state,root,c,links,h)
 if not table.find({"Bodies","Moves","Timing","Recording"},tab) then return false end
 local input,choose,refresh,message=h.input,h.choose,h.refresh,h.message
 local function options(key,rows,title,values)
  values=values or c if title then ui.label(ui.content,title,16) end
  for _,row in rows do
   local value=if type(row)=="table" then row[1] else row local text=if type(row)=="table" then row[2] else row
   ui.button(ui.content,text,function() values[key]=value refresh() end,values[key]==value)
  end
 end
 local function toggle(key,text)
  ui.button(ui.content,text..(if c[key] then ": on" else ": off"),function() c[key]=not c[key] refresh() end,c[key])
 end
 local function volumes(key,attack)
  local list=c[key] local indexKey=key.."Index" state[indexKey]=math.clamp(state[indexKey] or 1,1,math.max(1,#list))
  ui.note(if attack then "Named moves" else "Named target hitboxes",if attack then "Choose a move below. Names are used by Begin and the accepted-move event. Your Actions file is kept when the builder is selected." else "A returned contact names the area touched, such as Head or Body. Shapes turn and move with the recorded root. They do not follow animated limbs. A position provider can supply animated zones instead.")
  for i,v in list do ui.button(ui.content,tostring(i)..". "..v.name,function() state[indexKey]=i refresh() end,i==state[indexKey]) end
  ui.button(ui.content,if attack then "Add move" else "Add target hitbox",function()
   if #list&gt;=32 then message("Maximum 32 entries.") return end
   local used={} for _,v in list do used[v.name]=true end local n=#list+1 local prefix=if attack then "Move" else "Zone"
   while used[prefix..n] do n+=1 end
   table.insert(list,if attack then C.Move(prefix..n) else C.Volume(prefix..n)) state[indexKey]=#list refresh()
  end)
  local v=list[state[indexKey]] if not v then return end
  input(if attack then "Move name" else "Hitbox name","name",v,false)
  options("shape",if attack then {"Box","Sphere","Capsule","Ray","SweptSphere"} else {"Box","Sphere","Capsule"},"Shape",v)
  if v.shape=="Box" then
   for _,row in {{"width","Width (studs)"},{"height","Height (studs)"},{"depth","Depth (studs)"}} do input(row[2],row[1],v,true) end
  elseif v.shape=="Sphere" or v.shape=="Capsule" or v.shape=="SweptSphere" then
   input("Radius: center to edge (studs)","radius",v,true)
   if v.shape=="Capsule" then input("Total height, including round ends (studs)","height",v,true) end
  end
  if v.shape=="Ray" or v.shape=="SweptSphere" then input("Line length (studs)","length",v,true) end
  ui.note("Position and rotation","Offsets use the saved root: X right, Y up, Z backward (negative Z is forward). Rotations are degrees in pitch, yaw, roll order. Orange marks the root; colored shapes are hitboxes.")
  for _,row in {{"x","X offset (studs)"},{"y","Y offset (studs)"},{"z","Z offset (studs)"},{"pitch","Pitch: X rotation (degrees)"},{"yaw","Yaw: Y rotation (degrees)"},{"roll","Roll: Z rotation (degrees)"}} do input(row[2],row[1],v,true) end
  ui.place(Picture.Draw(nil,if attack then {v} else list,attack),ui.content)
  ui.button(ui.content,"Update shape picture",refresh)
  if attack then
   for _,row in {{"targets","Target kinds, separated by commas"},{"opens","Wait before checking (seconds)"},{"closes","Stop checking, from move start (seconds)"},{"maxTargets","Different targets for the WHOLE move"},{"maxReach","Farthest allowed attack edge (studs)"}} do input(row[2],row[1],v,row[1]~="targets") end
   options("rule",{{"all","Allow matching types"},{"team","Active objects on different teams"},{"Hook","Use Eligible inside Hooks"}},"Target rule",v)
   options("queryMode",{{"Default","Use connection check mode"},{"Once","Check once"},{"Repeated","Check again at later recorded updates"}},"Hit checking",v)
   ui.button(ui.content,"Check obstacles: "..tostring(v.world),function() v.world=not v.world refresh() end,v.world)
   ui.label(ui.content,"Obstacle checks require a ray or swept sphere and a provider on Timing. Other shapes need the game's wall rule inside Hooks.",13)
  end
  ui.button(ui.content,"Duplicate selected entry",function()
   if #list&gt;=32 then message("Maximum 32 entries.") return end
   local used={} for _,row in list do used[row.name]=true end local n=1 while used[v.name.."Copy"..n] do n+=1 end
   local copy=C.Copy(v) copy.name=v.name.."Copy"..n table.insert(list,copy) state[indexKey]=#list refresh()
  end)
  ui.button(ui.content,"Remove selected entry",function() table.remove(list,state[indexKey]) refresh() end)
 end
 if tab=="Bodies" then
  ui.note("One object, several target areas","Up to 32 named Box, Sphere or Capsule shapes. Empty list uses the simple body on Objects. Provider-supplied zones take priority; these controls do not override that provider. Data-only objects supply their zones in their snapshot.")
  volumes("zones",false)
 elseif tab=="Moves" then
  options("moveSource",{{"Actions","Use the Actions module inside the package"},{"Builder","Use moves configured in this plugin"}},"Where move settings come from")
  if c.moveSource=="Builder" then
   ui.button(ui.content,"Copy the original setup move into this builder",function()
    local data=root and root:FindFirstChild("SetupData")
    if not data then message("This older code group has no saved setup values. Add a move below, or keep using its Actions file.") return end
    local ok,v=pcall(game.HttpService.JSONDecode,game.HttpService,data.Value) if not ok then message("Saved setup values are unreadable.") return end
    for _,row in c.moves do if row.name=="Contact" then message("Contact already exists. Your move was kept.") return end end
    if #c.moves&gt;=32 then message("Maximum 32 entries.") return end
    local m=C.Move("Contact")
    for _,k in {"shape","width","height","depth","radius","length","targets","opens","closes","maxTargets"} do m[k]=v[k] end
    m.z=if v.shape=="Ray" or v.shape=="SweptSphere" then 0 else -v.forward m.rule=v.rules
    m.maxReach=4096 table.insert(c.moves,m) state.movesIndex=#c.moves refresh()
   end)
   volumes("moves",true)
  else ui.note("Custom move logic stays inside Actions","Open Actions in Test &amp; restore. Each named profile uses the same Core shape, targets, opens/closes, maxTargets, maxReach, world and eligible fields. Optional queryMode chooses Once or Repeated for that move. The plugin keeps that file when switching modes.") end
 elseif tab=="Timing" then
  ui.note("Which positions decide a contact?","Present checks the latest recorded update. Earlier checks look back by one server-approved delay, fixed when the move starts. Missing, old or interrupted records refuse the check. A larger maximum alone does not enable compensation.")
  options("timing",{{"Present","Latest saved positions (default)"},{"MeasuredPing","Earlier positions: measured player ping"},{"Provider","Earlier positions: my server timing rule"}},"Timing policy")
  input("Maximum approved lookback (seconds)","maxRewind",c,true,"Must fit saved history. Over-limit requests refuse; no silent clamp.")
  if c.timing=="MeasuredPing" then
   input("Additional known display delay (seconds)","displayDelay",c,true,"Only use a delay your own display pipeline actually adds. Default zero.")
   ui.note("Measured ping is an estimate","Uses half the server's GetNetworkPing round-trip value, plus the configured display delay. It does not know exact packet arrival asymmetry or the exact screen frame seen by the player. Data-only actors need TimingPlayer inside Hooks to identify their player.")
  elseif c.timing=="Provider" then choose("Timing","Timing provider","ModuleScript with Resolve(actor,serverContext,captureTime,maximum). Context must already be checked by your server. A template is available in Test &amp; restore.") end
  options("candidates",{{"Existing","Keep an existing present-part target list"},{"Chrono","Use targets returned by Chrono contacts"}},"Where hit candidates come from")
  ui.note("A gate cannot discover missing targets","Allows only checks a target your code already found. A present-time overlap can miss someone who was inside an earlier hitbox. Earlier timing therefore requires Chrono candidates: use Resolve with Outcome, or Query contacts. This choice records your integration intent; Play tests must verify the actual code path.")
  ui.note("Obstacle checks","Choose only objects that should stop these moves. The built-in option saves anchored Part bounding boxes, including conservative boxes around meshes. Terrain and moving historical cover need your own provider.")
  options("worldMode",{{"None","No Core obstacle provider"},{"StaticBoxes","Anchored obstacles: saved bounding boxes"},{"Provider","My obstacle provider"}},"Obstacle policy")
  if c.worldMode=="StaticBoxes" then
   choose("Obstacles","Obstacle folder","Select a Workspace Folder/Model containing anchored blocking Parts. CanCollide and CanQuery must both be true. A changed obstacle list/box starts a new coverage period; earlier checks across that change refuse.")
   input("Maximum obstacle Parts","maxObstacles",c,true)
  elseif c.worldMode=="Provider" then choose("World","Obstacle provider","ModuleScript with Check(queryTime,currentTime,shape). It must return covered, blocked and fraction; unknown historical cover must refuse. Template in Test &amp; restore.") end
 elseif tab=="Recording" then
  ui.note("When positions are saved","All participating objects must describe the same instant. Heartbeat suits ordinary server physics. A game with its own simulation should save after completing each simulation step; selecting a mode does not create that simulation.")
  options("recording",{{"Heartbeat","Automatic: after physics"},{"Manual","My server calls Connector.Capture(time)"},{"Event","My completed-step BindableEvent"}},"Recording mode")
  if c.recording=="Event" then choose("Capture","Completed-step recording event","Server BindableEvent argument: optional timestamp in the selected clock's seconds. Fire AFTER updating all participating objects.") end
  choose("Clock","Optional shared clock","No link uses Workspace.GetServerTimeNow. A selected module returns Now() in seconds. Every Capture timestamp and position provider must use that same clock. See template in Test &amp; restore.")
  for _,row in {{"recordRate","Expected / automatic update rate (per second)"},{"historySeconds","How long to keep positions (seconds)"},{"maxGap","Largest allowed record gap (seconds)"},{"recordMaxSpeed","Maximum root travel speed (studs/second)"},{"recordMaxRadius","Farthest target hitbox edge from root (studs)"}} do input(row[2],row[1],c,true) end
  ui.note("Storage and evidence limits","Storage holds ceil(rate × seconds) + 2 updates per object. Heartbeat also refreshes on move/query/approval calls, preserving immediate provider checks. Include those updates in the expected rate. Recording faster than that rate shortens usable history. Manual/Event gives your simulation sole recording control. Speed/extent limits do not prove movement was permitted.")
  if c.legacyLimits then
   ui.note("Older installation limits retained","This installation still uses its old 4096 speed / derived extent policy. Switch deliberately to the configured limits below after reviewing your game.")
   ui.button(ui.content,"Use reviewed recording limits instead of legacy limits",function() c.legacyLimits=false refresh() end)
  end
  toggle("objectLimits","Allow server object attributes ChronoMaxSpeed / ChronoMaxRadius")
  ui.note("Limits by object kind","Override defaults for named kinds, such as fighter or ball. Server object attributes override these; data bindings and RecordingLimits in Hooks may override them again.")
  for i,v in c.kindLimits do
   input("Kind name","kind",v,false) input("Maximum speed","maxSpeed",v,true) input("Farthest hitbox edge","maxRadius",v,true)
   ui.button(ui.content,"Remove kind limit "..i,function() table.remove(c.kindLimits,i) refresh() end)
  end
  ui.button(ui.content,"Add limits for another kind",function()
   if #c.kindLimits&gt;=32 then message("Maximum 32 kinds.") return end
   table.insert(c.kindLimits,{kind="kind"..(#c.kindLimits+1),maxSpeed=c.recordMaxSpeed,maxRadius=c.recordMaxRadius}) refresh()
  end)
 end
 return true
end
return A

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF12"><Properties><string name="Name">ConnectionConfig</string><ProtectedString name="Source">return require(script.Parent.Parent.Runtime.Configuration)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF13"><Properties><string name="Name">ConnectionExample</string><ProtectedString name="Source">-- An optional working scene shipped INSIDE the plugin. Never presented as your own game's validation.
local X={}
local function note(object)
	local record=Instance.new("StringValue") record.Name="LearningExampleSource" record.Value=object.Source record.Parent=object
end
function X.Create(package,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before adding the learning scene." end
	local name="ChronoConnectionExample"
	if workspace:FindFirstChild(name) or game.ServerScriptService:FindFirstChild(name) then return nil,"The learning scene already exists. Open its code group, or remove that example before adding another." end
	local folder=Instance.new("Folder") folder.Name=name folder.Parent=workspace
	local group
	local ok,why=pcall(function()
		for _,row in {{"Mover",Vector3.new(35,4,0)},{"Target",Vector3.new(35,4,-3)}} do
			local model=Instance.new("Model") model.Name=row[1]
			local root=Instance.new("Part") root.Name="HumanoidRootPart" root.Size=Vector3.new(2,4,2) root.Anchored=true root.CanCollide=false root.Position=row[2]
			root.Color=if row[1]=="Mover" then Color3.fromRGB(255,179,93) else Color3.fromRGB(94,225,183)
			root.Parent=model model.PrimaryPart=root model:SetAttribute("PracticeContacts",0) model.Parent=folder
		end
		local events=Instance.new("Folder") events.Name="Events" events.Parent=folder
		local links={Actors=folder}
		for _,key in {"Begin","Query","Cancel","Outcome"} do local event=Instance.new("BindableEvent") event.Name=key event.Parent=events links[key]=event end
		local C=require(package.Editor.Config) local I=require(package.Editor.Installer)
		local c=C.Default() c.name=name c.kind="actor" c.targets="actor" c.shape="Box" c.width=4 c.height=5 c.depth=5 c.forward=3 c.opens=0.12 c.closes=0.5 c.rules="all"
		local handle,err=I.Preview(c,{},package.Core) assert(handle,err) group=assert(I.Apply(handle,d))
		local CC=require(package.Editor.ConnectionConfig) local CI=require(package.Editor.ConnectionInstaller)
		local settings=CC.Default() settings.actors="Folder" settings.width=2 settings.height=4 settings.depth=2
		local plan,reason=CI.Preview(group,settings,links,package.Runtime) assert(plan,reason) assert(CI.Apply(plan,d))
		local runner=Instance.new("Script") runner.Name="RunLearningScene"
		local source=[[-- Supplied learning example. Does not alter combat, health or your game's rules.
if not game:GetService("RunService"):IsStudio() then return end
local actors=workspace.ChronoConnectionExample local events=actors.Events
events.Outcome.Event:Connect(function(source,target,action,context,contact)
 target:SetAttribute("PracticeContacts",(target:GetAttribute("PracticeContacts") or 0)+1)
 print("Chrono learning scene: checked contact with "..target.Name)
end)
task.wait(1)
while script.Parent.Parent do
 events.Begin:Fire(actors.Mover,"Contact","practice")
 task.wait(0.2) events.Query:Fire(actors.Mover,"practice")
 task.wait(2)
end
]]
		(d and d.editor or game:GetService("ScriptEditorService")):UpdateSourceAsync(runner,function() return source end)
		runner.Parent=group
		note(runner)
		group:SetAttribute("ConnectionLearningScene",true)
	end)
	if not ok then if group then
		local guide=game.StarterPlayer.StarterPlayerScripts:FindFirstChild(name.."ConnectionGuide") if guide then guide:Destroy() end group:Destroy()
	end folder:Destroy() return nil,"Learning scene was not added: "..tostring(why) end
	return group
end
function X.Remove(group,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before removing the learning scene." end
	if not group or not group:GetAttribute("ConnectionLearningScene") then return nil,"Select the supplied learning scene's code group." end
	local runner=group:FindFirstChild("RunLearningScene")
	if not runner or not runner:FindFirstChild("LearningExampleSource") or runner.Source~=runner.LearningExampleSource.Value then return nil,"The learning script was customized. Keep those edits before removing the example." end
	local CI=require(script.Parent.ConnectionInstaller)
	local ok,why=CI.Remove(group,d) if not ok then return nil,why end
	local history=d and d.history or game:GetService("ChangeHistoryService") local rec=history:TryBeginRecording("ChronoRemoveLearningScene","Remove supplied Chrono learning scene")
	if not rec then return nil,"Connections removed. Studio could not start the final scene-removal Undo step." end
	local scene=workspace:FindFirstChild("ChronoConnectionExample") if scene then scene:Destroy() end group:Destroy()
	history:FinishRecording(rec,Enum.FinishRecordingOperation.Commit) return true
end
return X
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF14"><Properties><string name="Name">ConnectionInstaller</string><ProtectedString name="Source">local Config=require(script.Parent.ConnectionConfig)
local I={}
local OWNER="ChronoV3Connections-20261025"
local linkNames={"Actors","Provider","Registry","Clock","Timing","World","Obstacles","Begin","Query","Cancel","Outcome","Capture"}
local function connectorClone(runtime)
	local connector=runtime:Clone() connector.Name="Connector"
	if connector:FindFirstChild("Guide.client") then connector["Guide.client"]:Destroy() end
	if connector:FindFirstChild("Hooks") then connector.Hooks.Name="DefaultHooks" end
	return connector
end
local function sourceObject(root,name,guide)
	if guide and name==guide.Name then return guide end
	local object=root for segment in name:gmatch("[^.]+") do object=object and object:FindFirstChild(segment) end return object
end
local plans=setmetatable({}, {__mode="k"})
local startup=[[-- Supplied by the Chrono connection wizard. Your game owns accepted inputs and outcomes.
local ok,why=pcall(function() require(script.Parent.Connector).Start() end)
if not ok then warn("Chrono connection could not start: "..tostring(why)) end
]]
local connectionSource=[[-- Wizard values live in ConnectionData so Studio object Undo restores them reliably.
-- Customize Hooks for code changes. Do not run a second connection instance.
return game:GetService("HttpService"):JSONDecode(script.Parent.ConnectionData.Value)
]]
local function validRoot(root)
	return typeof(root)=="Instance" and root:IsA("ModuleScript") and type(root:GetAttribute("ChronoV3Owner"))=="string" and root:FindFirstChild("Core") and root:FindFirstChild("Actions") and root:FindFirstChild("Settings")
end
function I.Preview(root,c,links,runtime)
	if not validRoot(root) then return nil,"Choose an installed Chrono V3 code group first (page 5)." end
	local ok,why=Config.Validate(c,links) if not ok then return nil,why end
	if not runtime or not runtime:FindFirstChild("Movement") or not runtime:FindFirstChild("Hooks") then return nil,"This plugin is missing its connection package. Install the complete new setup file." end
	if root:FindFirstChild("Connector") then return nil,"Connections already exist here. Use Save connection settings; your customized Hooks and runtime will be kept." end
	for _,name in {"Connections","ConnectionData","Hooks","ConnectionLinks","StartConnection","ConnectionRecord","ConnectionPatches"} do if root:FindFirstChild(name) then return nil,"A file named "..name.." already exists. Choose a fresh code group; no existing file was replaced." end end
	local copy=Config.Normalize(c) local refs=table.clone(links or {})
	local handle=table.freeze({})
	plans[handle]={root=root,c=copy,links=refs,runtime=runtime}
	return handle,{destination=root:GetFullName(),positions=c.positions,
		changes="Add the supplied Connector, movement option, Hooks, settings, object/event links and server startup. Tracking and recording start automatically. Existing combat scripts change only when you explicitly insert a generated hook. No RemoteEvent is added.",
		dependency=if c.positions=="ServerPhysics" then "Player-owned positions refuse checks. Use the humanoid checker or an existing position provider for those objects."
		elseif c.positions=="Humanoid" then "Bounded humanoid root checks: ordinary static ground only. Configure allowed movement; connect legitimate knockback/teleports. This is not complete movement security."
		else "Your selected provider must independently check or calculate positions and implement Snapshot(object,time).",
		wiring=if refs.Begin and refs.Outcome and (refs.Query or c.autoQuery) then "Existing server events selected. Verify their argument order and cancellation behavior in Play."
		else "Some attack/outcome connections remain. Use the built-in hook builder for ordinary script functions, or choose matching server events."}
end
local function dependencies(d)
	d=d or {} return d.history or game:GetService("ChangeHistoryService"),d.editor or game:GetService("ScriptEditorService")
end
function I.Apply(handle,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before changing connections." end
	local p=plans[handle] if not p then return nil,"Check connections first, then add the reviewed version." end
	local c,root=p.c,p.root
	local checked,why=Config.Validate(c,p.links) if not checked then return nil,why end
	if not root.Parent or root:FindFirstChild("Connector") then return nil,"The destination changed after review. Check connections again." end
	for _,name in {"Connections","ConnectionData","Hooks","ConnectionLinks","StartConnection","ConnectionRecord","ConnectionPatches"} do if root:FindFirstChild(name) then return nil,"The destination changed after review: "..name end end
	local history,editor=dependencies(d) local recording=history:TryBeginRecording("ChronoConnections","Connect Chrono to game")
	if not recording then return nil,"Studio could not start an Undo step. Nothing changed." end
	local created={} local sources={} local guide
	local function write(object,source) editor:UpdateSourceAsync(object,function() return source end) end
	local function remember(object) table.insert(created,object) object:SetAttribute("ChronoConnectionOwner",OWNER) return object end
	local ok,err=pcall(function()
		local connector=remember(connectorClone(p.runtime))
		connector.Parent=root
		local hooks=remember(p.runtime.Hooks:Clone()) hooks.Name="Hooks" hooks.Parent=root
		local config=remember(Instance.new("ModuleScript")) config.Name="Connections" write(config,connectionSource) config.Parent=root
		local data=remember(Instance.new("StringValue")) data.Name="ConnectionData" data.Value=game.HttpService:JSONEncode(c) data.Parent=root
		local links=remember(Instance.new("Folder")) links.Name="ConnectionLinks"
		for _,key in linkNames do local v=Instance.new("ObjectValue") v.Name=key v.Value=p.links[key] v.Parent=links end
		links.Parent=root
		local boot=remember(Instance.new("Script")) boot.Name="StartConnection" write(boot,startup) boot.Parent=root
		local patches=remember(Instance.new("Folder")) patches.Name="ConnectionPatches" patches.Parent=root
		if c.guide then
			local target=game:GetService("StarterPlayer").StarterPlayerScripts local name=root.Name.."ConnectionGuide"
			assert(not target:FindFirstChild(name),"A guide with that name already exists")
			guide=remember(Instance.new("LocalScript")) guide.Name=name
			write(guide,p.runtime["Guide.client"].Source) guide:SetAttribute("ConnectionName",root.Name) guide.Parent=target
		end
		for _,obj in created do
			if obj:IsA("LuaSourceContainer") then table.insert(sources,{name=obj.Name,source=obj.Source}) end
		end
		for _,obj in connector:GetDescendants() do if obj:IsA("LuaSourceContainer") then table.insert(sources,{name="Connector."..obj.Name,source=obj.Source}) end end
		local record=remember(Instance.new("StringValue")) record.Name="ConnectionRecord"
		record.Value=game:GetService("HttpService"):JSONEncode(sources) record.Parent=root
		root:SetAttribute("ConnectionSettings",game:GetService("HttpService"):JSONEncode(c))
		root:SetAttribute("ConnectionBuild",Config.Build) root:SetAttribute("GameAdapterExercised",false)
	end)
	if not ok then for i=#created,1,-1 do created[i]:Destroy() end history:FinishRecording(recording,Enum.FinishRecordingOperation.Cancel) return nil,"Connection installation was undone: "..tostring(err) end
	history:FinishRecording(recording,Enum.FinishRecordingOperation.Commit) plans[handle]=nil
	return root
end
function I.Load(root)
	if not validRoot(root) or not root:FindFirstChild("ConnectionLinks") then return nil,"Choose a code group with connections." end
	for _,name in {"Connector","Connections","ConnectionData","Hooks","ConnectionRecord","ConnectionPatches"} do if not root:FindFirstChild(name) then return nil,"A connection file is missing: "..name..". Your remaining code was kept." end end
	local ok,c=pcall(game.HttpService.JSONDecode,game.HttpService,root.ConnectionData.Value)
	if not ok then return nil,"Stored settings are unavailable. Your existing code was kept." end
	local links={} for _,v in root.ConnectionLinks:GetChildren() do if v:IsA("ObjectValue") then links[v.Name]=v.Value end end
	return Config.Normalize(c),links
end
function I.Save(root,c,links,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before saving settings." end
	local old,why=I.Load(root) if not old then return nil,why end
	if not root.Connector:FindFirstChild("Configuration") then return nil,"Upgrade the supplied Connector in Test &amp; restore before saving new settings. Existing code was kept." end
	local ok,reason=Config.Validate(c,links) if not ok then return nil,reason end
	c=Config.Normalize(c)
	if c.guide~=old.guide then return nil,"Guide installation stays as originally chosen. You can disable its LocalScript, or remove and reinstall the connection package." end
	local _,editor=dependencies(d)
	local original=editor:GetEditorSource(root.Connections)
	local rows=game.HttpService:JSONDecode(root.ConnectionRecord.Value)
	for _,row in rows do if row.name=="Connections" and row.source~=original then return nil,"Connections was edited manually. Copy those settings into the wizard before saving, or keep the manual file. Your code was kept." end end
	local history,editor=dependencies(d) local rec=history:TryBeginRecording("ChronoConnectionSettings","Update Chrono connection settings")
	if not rec then return nil,"Studio could not start an Undo step." end
	local oldAttribute=root:GetAttribute("ConnectionSettings") local oldData=root.ConnectionData.Value local oldLinks={} local added={}
	for _,v in root.ConnectionLinks:GetChildren() do table.insert(oldLinks,{object=v,value=v.Value}) end
	local changed,err=pcall(function()
		assert(editor:GetEditorSource(root.Connections)==original,"Settings reader changed during the save. Review again.")
		root.ConnectionData.Value=game.HttpService:JSONEncode(c)
		for _,name in linkNames do if not root.ConnectionLinks:FindFirstChild(name) then local v=Instance.new("ObjectValue") v.Name=name v.Parent=root.ConnectionLinks table.insert(added,v) end end
		for _,v in root.ConnectionLinks:GetChildren() do v.Value=links[v.Name] end
		root:SetAttribute("ConnectionSettings",game.HttpService:JSONEncode(c))
	end)
	if not changed then
		root.ConnectionData.Value=oldData
		for _,v in added do v:Destroy() end
		for _,row in oldLinks do row.object.Value=row.value end root:SetAttribute("ConnectionSettings",oldAttribute)
		history:FinishRecording(rec,Enum.FinishRecordingOperation.Cancel) return nil,tostring(err)
	end
	history:FinishRecording(rec,Enum.FinishRecordingOperation.Commit) return root
end
function I.Seed(root)
	local c=Config.Default()
	local data=root and root:FindFirstChild("SetupData")
	if data then local ok,v=pcall(game.HttpService.JSONDecode,game.HttpService,data.Value) if ok then
		c.kind=v.kind c.historySeconds=v.seconds c.maxGap=v.maxGap c.maxRewind=v.maxRewind c.recordMaxSpeed=v.maxSpeed c.recordMaxRadius=v.maxRadius
	end end
	return c
end
-- Explicit upgrade, separate from Save. Never replaces an edited Connector.
-- Hooks/Actions stay intact; newly supplied defaults fill only missing hook functions.
function I.Upgrade(root,runtime,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before upgrading." end
	local c,links=I.Load(root) if not c then return nil,links end
	if not runtime or not runtime:FindFirstChild("Configuration") then return nil,"Complete new plugin required." end
	local history,editor=dependencies(d)
	local oldRecord=root.ConnectionRecord.Value local rows=game.HttpService:JSONDecode(oldRecord) local kept={}
 local expected={}
 local guide=game.StarterPlayer.StarterPlayerScripts:FindFirstChild(root.Name.."ConnectionGuide")
 local guideBefore local guideAfter=runtime["Guide.client"].Source
	for _,row in rows do
		if row.name=="Connector" or row.name:sub(1,10)=="Connector." then
			local object=sourceObject(root,row.name) if not object or editor:GetEditorSource(object)~=row.source then return nil,"Connector was customized: "..row.name..". Keep your changes; install a fresh code group to compare." end
			expected[row.name]=true
		else
			if guide and row.name==guide.Name and editor:GetEditorSource(guide)==row.source then
				guideBefore=row.source row=table.clone(row) row.source=guideAfter
			end
			table.insert(kept,row)
		end
	end
	for _,object in root.Connector:GetDescendants() do if not expected["Connector."..object.Name] then return nil,"Connector contains an extension. Keep it before choosing an upgrade." end end
	local rec=history:TryBeginRecording("ChronoUpgradeConnections","Upgrade supplied Chrono connector") if not rec then return nil,"Studio could not start an Undo step." end
	local old=root.Connector local fresh local oldBuild=root:GetAttribute("ConnectionBuild") local oldData=root.ConnectionData.Value local oldAttribute=root:GetAttribute("ConnectionSettings") local added={}
	local ok,err=pcall(function()
		fresh=connectorClone(runtime) fresh:SetAttribute("ChronoConnectionOwner",OWNER)
		old.Parent=nil fresh.Parent=root
		if guideBefore then
			assert(editor:GetEditorSource(guide)==guideBefore,"Guide changed during upgrade")
			editor:UpdateSourceAsync(guide,function(current) return if current==guideBefore then guideAfter else nil end)
			assert(editor:GetEditorSource(guide)==guideAfter,"Guide changed during upgrade")
		end
		table.insert(kept,{name="Connector",source=fresh.Source})
		for _,object in fresh:GetDescendants() do if object:IsA("LuaSourceContainer") then table.insert(kept,{name="Connector."..object.Name,source=object.Source}) end end
		for _,name in linkNames do if not root.ConnectionLinks:FindFirstChild(name) then local v=Instance.new("ObjectValue") v.Name=name v.Parent=root.ConnectionLinks table.insert(added,v) end end
		root.ConnectionData.Value=game.HttpService:JSONEncode(c) root:SetAttribute("ConnectionSettings",root.ConnectionData.Value)
		root.ConnectionRecord.Value=game.HttpService:JSONEncode(kept) root:SetAttribute("ConnectionBuild",Config.Build)
	end)
	if not ok then
		if fresh then fresh:Destroy() end old.Parent=root for _,v in added do v:Destroy() end
		if guideBefore and editor:GetEditorSource(guide)==guideAfter then editor:UpdateSourceAsync(guide,function() return guideBefore end) end
		root.ConnectionRecord.Value=oldRecord root.ConnectionData.Value=oldData root:SetAttribute("ConnectionSettings",oldAttribute) root:SetAttribute("ConnectionBuild",oldBuild)
		history:FinishRecording(rec,Enum.FinishRecordingOperation.Cancel) return nil,tostring(err)
	end
	old:Destroy() history:FinishRecording(rec,Enum.FinishRecordingOperation.Commit) return root
end
function I.Remove(root,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before removing connections." end
	if not root:FindFirstChild("ConnectionRecord") then return nil,"No connection installation record was found." end
	if #root.ConnectionPatches:GetChildren()&gt;0 then return nil,"Restore generated game-script hooks first using their saved patch records." end
	local _,editor=dependencies(d)
	local guide=game.StarterPlayer.StarterPlayerScripts:FindFirstChild(root.Name.."ConnectionGuide")
	local connector=root:FindFirstChild("Connector")
	local supplied={} for _,row in game.HttpService:JSONDecode(root.ConnectionRecord.Value) do supplied[row.name]=true end
	if connector then for _,child in connector:GetDescendants() do if not supplied["Connector."..child.Name] then return nil,"Additional content inside Connector was kept. Move or back up your extension before removing supplied connections." end end end
	for _,name in {"Hooks","Connections","ConnectionData","StartConnection","ConnectionRecord"} do local child=root:FindFirstChild(name) if child and #child:GetChildren()&gt;0 then return nil,"Additional content inside "..name.." was kept. Move or back up that extension first." end end
	if guide and #guide:GetChildren()&gt;0 then return nil,"The guide contains extra content. Keep that extension before removing the guide." end
	for _,row in game.HttpService:JSONDecode(root.ConnectionRecord.Value) do
		local connector=root:FindFirstChild("Connector")
		local object=sourceObject(root,row.name,guide)
		if not object or editor:GetEditorSource(object)~=row.source then return nil,"Customized or missing file: "..row.name..". Keep a copy of your edits before removing the package." end
	end
	local history=dependencies(d) local recording=history:TryBeginRecording("ChronoRemoveConnections","Remove supplied Chrono connections")
	if not recording then return nil,"Studio could not start an Undo step." end
	for _,child in root:GetChildren() do if tostring(child:GetAttribute("ChronoConnectionOwner")):match("^ChronoV3Connections%-%d+$") then child:Destroy() end end
	if guide and tostring(guide:GetAttribute("ChronoConnectionOwner")):match("^ChronoV3Connections%-%d+$") then guide:Destroy() end
	root:SetAttribute("ConnectionBuild",nil) root:SetAttribute("ConnectionSettings",nil)
	history:FinishRecording(recording,Enum.FinishRecordingOperation.Commit) return true
end
return I
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF15"><Properties><string name="Name">ConnectionView</string><ProtectedString name="Source">local Config=require(script.Parent.ConnectionConfig)
local Installer=require(script.Parent.ConnectionInstaller)
local Builder=require(script.Parent.HookBuilder)
local Picture=require(script.Parent.VolumePreview)
local Templates=require(script.Parent.ProviderTemplates)
local Advanced=require(script.Parent.ConnectionAdvanced)
local V={}
function V.New() return {c=Config.Default(),links={},tab="Objects",hook="Begin",vars={actor="character",target="target",token="chronoMove",action="Contact",velocity="velocity",duration="duration",frame="destinationCFrame",exit="return"},line=1} end
function V.Draw(ui,state,o)
	local root=state.root or o.root local c=state.c local links=state.links
	if root and root:FindFirstChild("Connector") and state.loadedRoot~=root then
		local saved,refs=Installer.Load(root)
		if saved then state.c=saved state.links=refs c=saved links=refs state.loadedRoot=root end
	end
	if root and not root:FindFirstChild("Connector") and state.seededRoot~=root then state.c=Installer.Seed(root) c=state.c state.seededRoot=root end
	local function message(text)
		text=tostring(text) state.notice=if #text&gt;110 then text else nil
		ui.status.Text=if state.notice then "Read the connection message above." else text
		if state.notice then task.defer(ui.rebuild) end
	end
	local function selected() return (if o.selection then o.selection() else game:GetService("Selection"):Get())[1] end
	local function refresh() local position=ui.content.CanvasPosition state.plan=nil state.patch=nil ui.rebuild() ui.content.CanvasPosition=position end
	local function input(label,key,values,numeric,hint)
		local f=ui.card(ui.content,"Connection_"..key) ui.label(f,label,15)
		local box=Instance.new("TextBox") box.Name="Input" box.Size=UDim2.new(1,0,0,38) box.Text=tostring(values[key]) box.ClearTextOnFocus=false
		box.Font=Enum.Font.Code box.TextSize=15 box.TextColor3=Color3.fromRGB(237,242,249) box.BackgroundColor3=Color3.fromRGB(17,23,32) box.BorderSizePixel=0 ui.place(box,f)
		if hint then ui.label(f,hint,13) end
		ui.connect(box.FocusLost,function()
			values[key]=if numeric then require(script.Parent.Config).ParseNumber(box.Text) or box.Text else box.Text
			state.plan=nil state.patch=nil message("Value updated. Check settings or regenerate the call before applying changes.")
		end)
	end
	local function choose(key,title,help)
		ui.note(title,help.."\nSelected: "..(links[key] and links[key]:GetFullName() or "none"))
		ui.button(ui.content,"Use selected object for "..title,function() links[key]=selected() refresh() end)
		if links[key] then ui.button(ui.content,"Clear "..title,function() links[key]=nil refresh() end) end
	end
	ui.label(ui.content,"Chrono supplies tracking, recording and move handling. Customize Actions and Hooks for your game.",14)
	ui.label(ui.content,"Code group: "..(root and root.Name or "choose one"),14)
	if root and root:FindFirstChild("Connector") and not state.displayedRoot then state.displayedRoot=root message("Connection files found. Use Test &amp; restore to verify real runtime activity.") end
	ui.button(ui.content,"Use selected installed code group",function()
		local candidate=selected()
		if not candidate or not candidate:IsA("ModuleScript") or not candidate:GetAttribute("ChronoV3Owner") then message("Select the installed Chrono group under ServerScriptService.") return end
		state.root=candidate local loaded,refs=Installer.Load(candidate)
		if loaded then state.c=loaded state.links=refs end refresh()
	end)
	local tabs=Instance.new("Frame") tabs.Name="ConnectionTabs" tabs.Size=UDim2.new(1,0,0,164) tabs.BackgroundTransparency=1 ui.place(tabs,ui.content)
	for i,name in {"Objects","Bodies","Moves","Timing","Recording","Events","Calls","Test &amp; restore"} do
		local b=ui.button(tabs,name,function() state.tab=name ui.rebuild() end,state.tab==name)
		b.Size=UDim2.new(0.49,0,0,36) b.Position=UDim2.new(if i%2==0 then 0.51 else 0,0,0,math.floor((i-1)/2)*42)
	end
	if state.notice then ui.note("Connection message",state.notice) end
	if state.tab=="Objects" then
		ui.note("1. Which objects participate?","Players follows player characters and respawns. Folder follows its direct child models/parts. Tag follows objects marked with the chosen CollectionService tag. References follows one selected object, or a folder of objects. Objects need a root Part, unless they are Parts themselves. Each may set a ChronoKind attribute for mixed kinds, such as player and ball.")
		for _,name in {"Players","PlayersAndFolder","Folder","Tag","References","Data","PlayersAndData"} do ui.button(ui.content,"Objects: "..(if name=="PlayersAndFolder" then "Players + extra objects" elseif name=="Data" then "Server data (no Parts)" elseif name=="PlayersAndData" then "Players + server data" else name),function() c.actors=name refresh() end,c.actors==name) end
		if c.actors=="Folder" or c.actors=="References" or c.actors=="PlayersAndFolder" then choose("Actors","Participating objects","Select an existing Workspace folder/model/Part in Explorer, then use the button. Players + extra objects follows characters automatically and adds these objects, such as a server-controlled ball.") end
		if c.actors=="Tag" then input("Object tag","tag",c,false) end
		if c.actors=="Data" or c.actors=="PlayersAndData" then choose("Registry","Optional pure-data object registry","No Parts needed. Snapshots(time) returns a dictionary keyed by stable text ids. Or use the generated Track/Capture calls. Customize the supplied Registry template inside this package.") end
		input("Root Part name","root",c,false,"Usually HumanoidRootPart. A tracked Part uses itself.")
		input("Default object kind","kind",c,false,"Match the target kinds in Actions. Use ChronoKind attributes for balls or other kinds.")
		ui.note("2. Who checks the position?","Server physics accepts anchored or server-owned Parts only. Player-owned movement needs either the supplied limited humanoid checker or your existing independent position checker. Selecting a label does not verify movement.")
		for _,row in {{"ServerPhysics","Server calculates physics"},{"Humanoid","Use supplied humanoid checks"},{"Provider","Connect my existing position checker"}} do ui.button(ui.content,row[2],function() c.positions=row[1] refresh() end,c.positions==row[1]) end
		if c.positions=="Provider" then
			choose("Provider","Existing position checker","Select a server ModuleScript returning Snapshot(object,time). That function must return {ok=true,root=CFrame,zones={...},state={...}} AFTER checking movement. If its API differs, adapt the small function inside this package; the plugin cannot infer that API.")
		elseif c.positions=="Humanoid" then
			ui.note("Supported movement","Checks root travel, jump height, gravity and small wall sweeps on static ground. Configure the actual allowed speeds below. Connect server knockback and teleports using Calls. Moving platforms, vehicles, flying and root-motion moves need an existing/custom checker. This is not complete anti-cheat or exact animated-body checking.")
			input("Allowed walking speed (studs/second)","walk",c,true)
			input("Allowed upward jump speed (studs/second)","jump",c,true)
			input("Root height above ground (studs)","ground",c,true,"Measure your rig. Usually about 3 for a basic R6 rig; other rigs differ.")
			ui.button(ui.content,if c.correction then "Invalid movement: return to last checked position" else "Invalid movement: refuse contact checks",function() c.correction=not c.correction refresh() end,c.correction)
			ui.button(ui.content,if state.advanced then "Hide movement tolerances" else "Show movement tolerances",function() state.advanced=not state.advanced ui.rebuild() end)
			if state.advanced then for _,row in {{"burst","Packet burst allowance (seconds)"},{"slack","Horizontal position slack (studs)"},{"verticalSlack","Vertical position slack (studs)"},{"wallRadius","Wall sweep radius (studs)"}} do input(row[2],row[1],c,true) end end
		end
		ui.note("3. Target gameplay hitbox","This is the deliberate contact shape around each object's root. It is separate from the attacking shape in Actions. It does not reconstruct animated limbs. When keeping an existing overlap test, Allows can add approval before its original outcome.")
		ui.button(ui.content,if c.partBodies then "Non-character objects: use root Part size" else "Non-character objects: use configured body shape",function() c.partBodies=not c.partBodies refresh() end,c.partBodies)
		ui.label(ui.content,"The humanoid option also accepts non-character objects whose physics the server controls. Root Part size uses a sphere for a round Ball Part, otherwise a bounding box; meshes are not exact geometry.",13)
		for _,shape in {"Box","Sphere","Capsule"} do ui.button(ui.content,"Target body: "..shape,function() c.body=shape refresh() end,c.body==shape) end
		if c.body=="Box" then input("Body width (studs)","width",c,true) input("Body height (studs)","height",c,true) input("Body depth (studs)","depth",c,true)
		else input("Body radius (studs)","radius",c,true) if c.body=="Capsule" then input("Total body height (studs)","height",c,true) end end
		input("Optional active attribute","activeAttribute",c,false,"Blank uses living Humanoid / active object. Otherwise the named server attribute must be true.")
		input("Optional team attribute","teamAttribute",c,false,"Blank uses the player's Team name when available. A team rule needs meaningful teams on both objects.")
		if root and root:FindFirstChild("Connector") then
			ui.label(ui.content,if c.guide then "Studio guide was installed. Enable/disable its LocalScript under StarterPlayerScripts." else "Studio guide was not installed. Its installation choice is kept when saving settings.",13)
		else ui.button(ui.content,if c.guide then "Studio guide: included" else "Studio guide: off",function() c.guide=not c.guide refresh() end,c.guide) end
		if root and root:FindFirstChild("Connector") then
			ui.button(ui.content,"Load saved connection settings",function() local loaded,refs=Installer.Load(root) if loaded then state.c=loaded state.links=refs refresh() else message(refs) end end)
			ui.button(ui.content,"Save connection settings (keeps customized code)",function() local obj,why=Installer.Save(root,c,links,o.dependencies) message(if obj then "Settings saved. Restart Play to load them. Hooks were kept." else why) end)
		else
			ui.button(ui.content,"Check connections and show changes",function()
				local handle,summary=Installer.Preview(root,c,links,o.runtime)
				state.plan=handle state.summary=if handle then summary else nil message(if handle then "Review the connection changes below." else summary) ui.rebuild()
			end)
			if state.summary and state.plan then
				ui.note("Changes",state.summary.changes.."\n\n"..state.summary.dependency.."\n\n"..state.summary.wiring.."\nTiming: "..c.timing.."; maximum lookback: "..c.maxRewind.." seconds.")
				ui.button(ui.content,"Add these reviewed connections",function()
					local obj,why=Installer.Apply(state.plan,o.dependencies) state.plan=nil state.summary=nil
					if obj then state.root=obj message("Connection package added. Select Events or Calls to connect real attacks; Play tests the actual wiring.") else message(why) end ui.rebuild()
				end,true)
			end
		end
	elseif Advanced.Draw(state.tab,ui,state,root,c,links,{input=input,choose=choose,refresh=refresh,message=message}) then
		-- Advanced tab drawn above.
	elseif state.tab=="Events" then
		ui.note("Existing server events","Use this page if your game already has BindableEvents for accepted moves and their results. Never connect a raw RemoteEvent. First authenticate the player and check cooldown, stamina and other move rules in the original server code. Select Calls for ordinary functions instead. If argument order differs, customize ReadBegin/ReadQuery/ReadCancel/ApplyOutcome in the supplied Hooks. Links take effect after Add connections / Save connection settings on Objects.")
		choose("Begin","Accepted move event","Arguments: sourceModel, actionName, moveKey, context. actionName defaults to Contact. moveKey identifies this active move; repeated keys refuse.")
		choose("Query","Hit moment event","Arguments: sourceModel, moveKey. Use the same key as Begin. At this moment Chrono checks contacts and sends approved targets to Outcome.")
		choose("Cancel","Cancelled move event","Arguments: sourceModel, moveKey. Fire from every existing cancellation path before it can apply an outcome.")
		choose("Outcome","Existing outcome event","Receives sourceModel, targetModel, actionName, context, contact. Keep existing damage/possession/block/parry rules in its server handler. Use Hooks to adapt unusual data; no universal damage amount is invented.")
		ui.button(ui.content,if c.autoQuery then "Hit timing: automatic within the active window" else "Hit timing: existing Query event or generated Allows call",function() c.autoQuery=not c.autoQuery refresh() end,c.autoQuery)
		ui.note("Automatic timing is optional","Once checks at the first saved update in the hit window. Repeated checks again at later saved updates until expiry or the total target limit. Each target is returned at most once per move. Keep cancellation linked.")
		for _,mode in {"Once","Repeated"} do ui.button(ui.content,"Default check mode: "..mode,function() c.queryMode=mode refresh() end,c.queryMode==mode) end
		input("Minimum time between automatic repeated checks (seconds)","queryInterval",c,true,"The recording rate also limits how often checks can run.")
		if root and root:FindFirstChild("Connector") then ui.button(ui.content,"Save event links and timing",function() local obj,why=Installer.Save(root,c,links,o.dependencies) message(if obj then "Event links saved. Restart Play and verify the argument order." else why) end) end
	elseif state.tab=="Calls" then
		ui.note("Generate the calls your existing scripts need","Choose the event's meaning, enter the variable names already used by your game, and preview an insertion at a selected server-script line. The plugin supplies the surrounding tracking and recording. You choose the correct location; it does not guess the meaning of arbitrary code.")
		for _,kind in {"Begin","Gate","Query","Resolve","Capture","Track","Untrack","Reset","Inspect","Destroy","Cancel","Finish","Motion","Teleport"} do ui.button(ui.content,"Call: "..kind,function() state.hook=kind state.patch=nil ui.rebuild() end,state.hook==kind) end
		input("Existing source character/object variable","actor",state.vars,false)
		input("Move reference variable (same scope at start and hit)","token",state.vars,false)
		input("Action name in Actions / move builder","action",state.vars,false)
  if state.hook=="Capture" then state.vars.timestamp=state.vars.timestamp or "" input("Optional existing simulation timestamp variable","timestamp",state.vars,false,"Blank uses the selected clock now.") end
  if state.hook=="Track" then
   state.vars.id=state.vars.id or "actorId" state.vars.snapshot=state.vars.snapshot or "snapshotFunction" state.vars.objectKind=state.vars.objectKind or c.kind state.vars.trust=state.vars.trust or "unverified"
   input("Existing stable text-id variable","id",state.vars,false) input("Existing data function variable","snapshot",state.vars,false) input("Object kind","objectKind",state.vars,false)
   ui.note("Who supplies this data?","Unverified refuses hit decisions. Server calculated / checked are declarations about your actual game code. Selecting a trusted label does not make client data safe.")
   for _,trust in {"unverified","serverSimulated","serverValidated"} do ui.button(ui.content,"Data declaration: "..trust,function() state.vars.trust=trust refresh() end,state.vars.trust==trust) end
  end
		if state.hook=="Gate" or state.hook=="Motion" then input("Existing target variable","target",state.vars,false) end
		if state.hook=="Gate" then ui.button(ui.content,"When refused: "..state.vars.exit,function() state.vars.exit=if state.vars.exit=="return" then "continue" else "return" state.patch=nil ui.rebuild() end) end
		if state.hook=="Motion" then input("Existing velocity variable","velocity",state.vars,false) input("Existing duration variable","duration",state.vars,false) end
		if state.hook=="Teleport" then input("Existing destination CFrame variable","frame",state.vars,false) end
		ui.button(ui.content,"Generate call with these variable names",function() state.patch=nil ui.rebuild() end)
		local code,explanation=Builder.Generate(root,state.hook,state.vars)
		if code then
			ui.note("Where this belongs",explanation) ui.codeBox(code)
			ui.button(ui.content,"Use selected existing server script",function() state.script=selected() state.patch=nil ui.rebuild() end)
			ui.label(ui.content,"Script: "..(state.script and state.script:GetFullName() or "not selected"),14)
			input("Insert before line number","line",state,true,"Open the selected script, place its cursor on the intended line, then use Read cursor line. Always inspect the resulting edit.")
			ui.button(ui.content,"Read cursor line from selected script",function()
				local editor=game:GetService("ScriptEditorService") local doc=state.script and editor:FindScriptDocument(state.script)
				if doc then state.line=doc:GetSelectionStart() state.patch=nil ui.rebuild() else message("Open the selected script in Studio's editor first.") end
			end)
			ui.button(ui.content,if state.hook=="Teleport" then "Preview replacing the selected teleport line" else "Preview the generated insertion",function()
				local current,why=Builder.Generate(root,state.hook,state.vars)
				if not current then message(why) return end
				local handle,detail=Builder.Preview(root,state.script,state.line,current,nil,state.hook=="Teleport")
				state.patch=handle state.patchDetail=if handle then detail else nil message(if handle then "Review the full resulting script below. Your source is unchanged until Apply." else detail) ui.rebuild()
			end)
			if state.patch and state.patchDetail then
				ui.note("Reviewed edit",state.patchDetail.path.." at line "..state.patchDetail.line..". An exact copy is saved for Restore. If the source changes, this preview refuses to apply.")
				ui.codeBox(state.patchDetail.after)
				ui.button(ui.content,"Apply this reviewed game-script edit",function() local record,why=Builder.Apply(state.patch,o.dependencies) state.patch=nil message(if record then "Call inserted. A restore record is available in Test &amp; restore." else why) ui.rebuild() end,true)
			end
		else ui.note("Call needs attention",explanation) end
	else
		ui.note("What counts as connected?","Setup completion is not proof of working combat. In Play, verify objects, position updates, accepted moves, contact checks and actual outcomes. A miss has zero contacts. A refusal has insufficient evidence. Test cancellations, respawns, teleports, joins/leaves and Studio network delay/loss with real clients.")
		if root and root:FindFirstChild("Connector") then
   ui.note("Upgrade supplied connection runtime","Explicit upgrade keeps Hooks, Actions and existing timing policy. An edited Connector refuses automatic replacement. Studio Undo restores the previous runtime.")
   ui.button(ui.content,"Upgrade supplied Connector to "..Config.Version,function() local object,why=Installer.Upgrade(root,o.runtime,o.dependencies) message(if object then "Connector upgraded. Review settings, save and restart Play." else why) ui.rebuild() end)
   ui.note("Provider templates inside this package","Add and open a template, customize it here, then select its ModuleScript on the relevant tab and Save. Timing and position templates deliberately refuse until real game data is supplied.")
   for _,key in {"Provider","Registry","Clock","Timing","World"} do ui.button(ui.content,"Add "..key.." provider template",function() local object,why=Templates.Add(root,key,o.dependencies) if object then links[key]=object if o.openScript then o.openScript(object) end message("Template added and selected. Customize it, then Save settings.") else message(why) end end) end
  end
  ui.button(ui.content,"Read the running connection report",function()
			local reports=game.ReplicatedStorage:FindFirstChild("_ChronoConnectionReports") local report=reports and root and reports:FindFirstChild(root.Name)
			if not report then message("No running report. Install connections and press Play. Do not require another runtime instance from debugging tools.") return end
			local ok,r=pcall(game.HttpService.JSONDecode,game.HttpService,report.Value)
			if ok then state.report=r ui.rebuild() else message("Report is not ready yet.") end
		end)
		if state.report then local r=state.report local s=r.stats ui.note("Measured runtime",string.format("Objects: %d\nUpdates: %d\nMoves: %d\nChecks: %d\nContacts: %d\nOutcomes permitted: %d\nRefusals: %d\nCorrections: %d\nErrors: %d\nLast status: %s",r.actors,s.captures,s.begun,s.queries,s.contacts,s.applied,s.refused,s.corrections,s.errors,s.reason)) ui.note("Active policies","Timing: "..tostring(r.timing).."; approved delay: "..tostring(r.rewind).." / "..tostring(r.maxRewind).." seconds\nRecording: "..tostring(r.recording).."; checks: "..tostring(r.queryMode).."; obstacles: "..tostring(r.world).."\nObstacle status: "..tostring(r.worldFault or "no reported fault")) end
		if root then
			if root:GetAttribute("ConnectionLearningScene") then ui.button(ui.content,"Remove the supplied learning scene",function() local ok,why=require(script.Parent.ConnectionExample).Remove(root,o.dependencies) if ok then state.root=nil end message(if ok then "Learning scene removed." else why) ui.rebuild() end) end
			for _,name in {"Hooks","Connections","Actions","Connector","RunPractice"} do ui.button(ui.content,"Open "..name.." inside the package",function() local object=root:FindFirstChild(name) if object and o.openScript then o.openScript(object) else message("Add connections first, then open the supplied file.") end end) end
			local patches=root:FindFirstChild("ConnectionPatches")
			if patches then local records=patches:GetChildren() for i=#records,1,-1 do local record=records[i] ui.button(ui.content,"Restore call in "..(record:FindFirstChild("Target") and record.Target.Value and record.Target.Value.Name or record.Name),function() local ok,why=Builder.Restore(record,o.dependencies) message(if ok then "Original script restored. Other edits were kept." else why) ui.rebuild() end) end end
			ui.button(ui.content,"Remove supplied connections (keep the Core and Actions)",function() local ok,why=Installer.Remove(root,o.dependencies) message(if ok then "Supplied connection files removed. Core and Actions remain." else why) ui.rebuild() end)
		end
	end
 if state.tab~="Objects" then
  ui.button(ui.content,"Check all connection settings",function() local ok,why=Config.Validate(c,links) message(if ok then "Settings are usable. Save or add connections, then test the actual game path in Play." else why) end)
  if root and root:FindFirstChild("Connector") then ui.button(ui.content,"Save all connection settings and links",function() local obj,why=Installer.Save(root,c,links,o.dependencies) message(if obj then "Settings saved. Restart Play to load them. Customized code was kept." else why) end)
  else ui.label(ui.content,"Return to Objects to review and add these connections.",14) end
 end
end
return V


</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF16"><Properties><string name="Name">Fields</string><ProtectedString name="Source">-- Stable field order and plain-language help shared by the form and validation messages.
local F={}
F.Order={"name","kind","targets","shape","width","height","depth","radius","forward","length","opens","closes","maxTargets","seconds","maxGap","maxRewind","maxSpeed","maxRadius","rules"}
F.Items={
	name={label="Name for the added code",page=2,hint="This name appears in Explorer under ServerScriptService. Example: Football contact. Existing code with the same name will not be replaced."},
	kind={label="Object type name",page=2,hint="A short name your scripts use to group objects. Examples: player, ball, fighter. Use the same spelling in your game code. This is the code field kind."},
	targets={label="Object types this move can touch",page=3,hint="Separate names with commas. Example: player, ball. These names must match the kinds you register with Track."},
	shape={label="Hitbox shape",page=3,hint="Choose an invisible gameplay shape. The picture below is a preview; it does not read or change your map."},
	width={label="Box width",page=3,min=0.01,max=64,unit="studs",hint="Side-to-side size. A stud is Roblox's distance unit."},
	height={label="Total height",page=3,min=0.02,max=64,unit="studs",hint="Bottom-to-top size. For a capsule (a cylinder with round ends), include both round ends."},
	depth={label="Box depth",page=3,min=0.01,max=64,unit="studs",hint="Front-to-back size. Larger values let the move reach farther in that direction."},
	radius={label="Radius: center to edge",page=3,min=0.01,max=32,unit="studs",hint="Radius 1.5 makes a ball 3 studs wide. A capsule's width is also twice its radius."},
	forward={label="Distance in front of the object",page=3,min=0,max=512,unit="studs",hint="The hitbox center stays this far in front of the saved position. It turns with the object. Zero centers it on the object."},
	length={label="Distance to check along the line",page=3,min=0.01,max=4096,unit="studs",hint="Check straight ahead for this distance. A line has no thickness; a moving-ball check also uses the radius."},
	opens={label="Wait before the move can hit",page=3,min=0,max=10,unit="seconds",hint="Time after your server accepts the move. Example: 0.12 seconds is 120 milliseconds (ms). Zero allows an immediate hit."},
	closes={label="Stop checking hits after",page=3,min=0,max=10,unit="seconds",hint="Measured from the same move start. Example: wait 0.12 and stop at 0.35 means a 0.23-second hit period."},
	maxTargets={label="Maximum objects touched per move",page=3,min=1,max=256,unit="objects",hint="This is a total for the whole move. Each object is returned at most once for that move reference."},
	seconds={label="How long to keep past positions",page=4,min=0.05,max=10,unit="seconds",hint="History means saved earlier positions and hitboxes. Old records are removed. Keeping them longer uses more memory."},
	maxGap={label="Largest allowed gap between records",page=4,min=0.001,max=1,unit="seconds",hint="Chrono can estimate between nearby records. It refuses to guess across a larger gap. 0.075 seconds is 75 ms."},
	maxRewind={label="Maximum time allowed into the past",page=4,min=0,max=10,unit="seconds",hint="Rewind means checking earlier positions. Zero is the simplest start. A larger limit still needs a server function that approves each delay."},
	maxSpeed={label="Maximum allowed movement speed",page=2,min=0,max=4096,unit="studs / second",hint="The largest speed your game allows for the reference position. A faster unexplained jump pauses recording. Approved teleports need a tracking reset."},
	maxRadius={label="Farthest allowed hitbox edge",page=2,min=0.01,max=512,unit="studs",hint="Measure from the object's reference position to the farthest edge of any target hitbox. Include both its offset and size."},
	rules={label="Example target rule",page=4,hint="Your game decides which targets are allowed. Team, immunity, possession and round rules belong in this function."},
}
F.Shapes={{code="Box",label="Box",help="A rectangular box. Useful for broad tackle or melee volumes."},
	{code="Sphere",label="Ball (sphere)",help="A round ball. Useful for a football or a round area."},
	{code="Capsule",label="Body with round ends (capsule)",help="A cylinder with half a ball at each end. Useful for a simple body shape."},
	{code="Ray",label="Thin line (ray)",help="A straight line with no thickness. Useful for an instant line check."},
	{code="SweptSphere",label="Ball along a line (sweep)",help="Check a ball at every point along a straight line, not only at its end."}}
return F
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF17"><Properties><string name="Name">HookBuilder</string><ProtectedString name="Source">-- Generates small calls and applies an exact reviewed edit. Never guesses what arbitrary game code means.
local H={}
local plans=setmetatable({}, {__mode="k"})
local function variable(text)
	if type(text)~="string" or #text&gt;128 or text:find("[^%w_%.]") or text:find("%.%.") or text:sub(-1)=="." then return false end
	for word in text:gmatch("[^.]+") do if not word:match("^[%a_][%w_]*$") or table.find({"nil","true","false","return","end","local","function","then","if","else","for","while","do","continue","break","and","or","not","repeat","until","in","elseif","export","type"},word) then return false end end
	return #text&gt;0
end
function H.Generate(root,kind,v)
	v=v or {} local actor=v.actor or "character" local token=v.token or "chronoMove"
	local target=v.target or "target" local action=v.action or "Contact"
	if not variable(actor) or not variable(target) or not variable(token) or token:find("%.") then return nil,"Use ordinary variable names, such as character, target and chronoMove." end
	if type(action)~="string" or #action==0 or #action&gt;64 or action:find("%c") then return nil,"Choose a short move name from Actions." end
	if not root or not root:FindFirstChild("Connector") then return nil,"Add the connection package before generating calls." end
	local ref="require(game:GetService(\"ServerScriptService\")["..string.format("%q",root.Name).."].Connector)"
	local exit=if v.exit=="continue" then "continue" else "return"
	local code,explanation
	if kind=="Begin" then
		code="local "..token.." = "..ref..".Begin("..actor..", "..string.format("%q",action)..")\nif not "..token.." then return end"
		explanation="Insert INSIDE the accepted-attack function, AFTER existing request/cooldown checks and BEFORE animation/windup. The move variable must remain in scope at its hit and cancellation points."
	elseif kind=="Gate" then
		code="if not "..ref..".Allows("..token..", "..target..") then "..exit.." end"
		explanation="Insert immediately BEFORE the existing damage/possession call. Choose 'continue' inside a target loop, or 'return' inside a per-target function. It permits each target once. This cannot discover a target missed by a present-part search; use Resolve or Query contacts for earlier timing."
	elseif kind=="Query" then
		code="local chronoResult, chronoReason = "..ref..".Query("..token..")\nif not chronoResult then return end\n-- chronoResult.contacts contains .target, .zone, .time and .state.\n-- Use these targets; do not filter through a present-part overlap first."
		explanation="Insert at the hit moment. This returns covered contacts, without applying outcomes. For supplied outcome delivery use Resolve instead. A repeated move may Query again AFTER another Capture; total targets and duplicate prevention span the whole move."
	elseif kind=="Resolve" then
		code=ref..".Resolve("..token..")"
		explanation="Insert at the hit moment, or use automatic checking on Events. Sends Chrono contacts to the selected Outcome event and OnContact inside Hooks, once per target. Supports earlier timing without an external present-part candidate list. Keep current damage, block, parry and possession rules there."
	elseif kind=="Capture" then
		local stamp=v.timestamp or "" if stamp~="" and not variable(stamp) then return nil,"Use an existing simulation timestamp variable, or leave it blank." end
		code=ref..".Capture("..stamp..")"
		explanation="Manual recording: insert AFTER your server finishes updating ALL participating objects at the same simulation instant. Optional timestamp uses the chosen clock's seconds. The plugin does not create a simulation loop or movement checker."
	elseif kind=="Track" then
		local snapshot=v.snapshot or "snapshotFunction" local id=v.id or "actorId" local trust=v.trust or "unverified"
		if not variable(snapshot) or not variable(id) or not table.find({"unverified","serverValidated","serverSimulated"},trust) then return nil,"Choose existing id/function variables and a valid data trust declaration." end
		code=ref..".Track("..id..", {kind="..string.format("%q",v.objectKind or "actor")..", trust="..string.format("%q",trust)..", capture="..snapshot.."})"
		explanation="Data-only alternative to the Registry provider: insert when your server creates an object. id is stable short text; capture(time) returns {ok=true,root,zones,state}. Uses recording limits from the plugin. Choose a trusted declaration only when your server really calculates/checks the data. No Parts are required."
	elseif kind=="Untrack" or kind=="Reset" then
		code=ref..(if kind=="Reset" then ".Discontinuity(" else ".Untrack(")..actor..")"
		explanation=if kind=="Reset" then "After an approved data teleport or position-provider repair, clear interrupted records. Update your server data first; old moves cannot cross this reset." else "When a manually registered data object is removed, unregister its stable text id. Automatic registries/folders handle their own removals."
	elseif kind=="Inspect" then
		code="local chronoReport = "..ref..".Inspect()"
		explanation="Server diagnostics: configuration, per-object limits, counters and unchanged Core inspection. Avoid exposing this information as a client gameplay authority."
	elseif kind=="Destroy" then
		code=ref..".Destroy()"
		explanation="Stop this supplied connection instance and its listeners during deliberate server teardown. Disable StartConnection if it should stay stopped; later public calls start it again."
	elseif kind=="Cancel" or kind=="Finish" then
		code=ref.."."..kind.."("..token..")"
		explanation="Insert on the existing cancellation path, or after the move's hit checks finish. Every early exit after Begin needs Cancel."
	elseif kind=="Motion" then
		if not variable(v.velocity or "velocity") or not variable(v.duration or "duration") then return nil,"Use your existing velocity and duration variable names." end
		code=ref..".AllowMotion("..target..", "..(v.velocity or "velocity")..", "..(v.duration or "duration")..")"
		explanation="Humanoid checker only. Insert BEFORE the server applies its existing knockback/dash. This grants a bounded movement allowance; it does not create the force."
	elseif kind=="Teleport" then
		if not variable(v.frame or "destinationCFrame") then return nil,"Use your destination CFrame variable name." end
		code=ref..".Teleport("..actor..", "..(v.frame or "destinationCFrame")..")"
		explanation="This call PERFORMS the approved teleport and resets records. Select the line containing only your old server teleport statement. Preview replaces that line rather than executing both. Keep other logic on separate lines before reviewing the replacement."
	else return nil,"Choose Begin, Gate, Cancel, Finish, Motion or Teleport." end
	return code,explanation
end
function H.Preview(root,object,line,code,editor,replaceLine)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before editing scripts." end
	if not root or not root:FindFirstChild("ConnectionPatches") then return nil,"Add connections first." end
	if not object or not object:IsA("LuaSourceContainer") or not object:IsDescendantOf(game) then return nil,"Select the existing SERVER Script/ModuleScript to connect." end
	if object:IsA("LocalScript") or (object:IsA("Script") and object.RunContext==Enum.RunContext.Client) or object:IsDescendantOf(game.StarterPlayer) or object:IsDescendantOf(game.StarterGui) then return nil,"Choose server code. Never put a contact approval call in a client script." end
	if object:IsDescendantOf(root) then return nil,"Generated game hooks belong at existing game events. Customize package files with Open Hooks instead." end
	editor=editor or game:GetService("ScriptEditorService")
	local before=editor:GetEditorSource(object)
	local lines=string.split(before,"\n")
	if type(line)~="number" or line%1~=0 or line&lt;1 or line&gt;#lines+1 then return nil,"Choose a line in the selected server script." end
	local marker="-- Chrono connection "..game.HttpService:GenerateGUID(false)
	local chunk=marker.."\n"..code.."\n-- End Chrono connection"
	if replaceLine then if line&gt;#lines then return nil,"Select the existing teleport statement's line." end table.remove(lines,line) end
	table.insert(lines,line,chunk) local after=table.concat(lines,"\n")
	local handle=table.freeze({}) plans[handle]={root=root,object=object,before=before,after=after,marker=marker}
	return handle,{before=before,after=after,line=line,path=object:GetFullName(),inserted=chunk}
end
function H.Apply(handle,d)
	local p=plans[handle] if not p then return nil,"Preview the generated edit first." end
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before applying the edit." end
	if not p.object.Parent or not p.root:FindFirstChild("ConnectionPatches") then return nil,"The selected script/package was removed. Preview again." end
	d=d or {} local editor=d.editor or game:GetService("ScriptEditorService") local history=d.history or game:GetService("ChangeHistoryService")
	if editor:GetEditorSource(p.object)~=p.before then return nil,"That script changed since the preview. Preview again; your edits were kept." end
	local recording=history:TryBeginRecording("ChronoInsertHook","Insert reviewed Chrono connection call")
	if not recording then return nil,"Studio could not start an Undo step." end
	local record local changed=false
	local ok,err=pcall(function()
		editor:UpdateSourceAsync(p.object,function(current) if current~=p.before then return nil end changed=true return p.after end)
		assert(changed and editor:GetEditorSource(p.object)==p.after,"Script changed during the edit. Preview again.")
		record=Instance.new("Folder") record.Name="Patch"..game.HttpService:GenerateGUID(false)
		for key,value in {Before=p.before,After=p.after} do local t=Instance.new("StringValue") t.Name=key t.Value=value t.Parent=record end
		local target=Instance.new("ObjectValue") target.Name="Target" target.Value=p.object target.Parent=record
		record.Parent=p.root.ConnectionPatches
	end)
	if not ok then
		if changed and editor:GetEditorSource(p.object)==p.after then editor:UpdateSourceAsync(p.object,function() return p.before end) end
		if record then record:Destroy() end history:FinishRecording(recording,Enum.FinishRecordingOperation.Cancel) return nil,tostring(err)
	end
	history:FinishRecording(recording,Enum.FinishRecordingOperation.Commit) plans[handle]=nil return record
end
function H.Restore(record,d)
	if game:GetService("RunService"):IsRunning() then return nil,"Stop Play before restoring code." end
	if not record or not record:FindFirstChild("Target") or not record.Target.Value or not record:FindFirstChild("Before") or not record:FindFirstChild("After") then return nil,"Select a saved patch record." end
	d=d or {} local editor=d.editor or game:GetService("ScriptEditorService") local history=d.history or game:GetService("ChangeHistoryService")
	local object=record.Target.Value
	if editor:GetEditorSource(object)~=record.After.Value then return nil,"This script has newer edits. Restore later patches first, or keep your changes and remove the marked call manually." end
	local rec=history:TryBeginRecording("ChronoRestoreHook","Restore script before Chrono hook")
	if not rec then return nil,"Studio could not start an Undo step." end
	local changed=false
	local ok,err=pcall(function()
		editor:UpdateSourceAsync(object,function(current) if current~=record.After.Value then return nil end changed=true return record.Before.Value end)
		assert(changed,"Script changed during restore") record:Destroy()
	end)
	history:FinishRecording(rec,if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
	return if ok then true else nil,err
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF18"><Properties><string name="Name">Installer</string><ProtectedString name="Source">-- Edit-time only. New owned namespace, explicit preview, one undo record, no game script rewriting.
local Config=require(script.Parent.Config)
local Installer={}
local OWNER="ChronoV3-3.2.0"
local plans=setmetatable({}, {__mode="k"})
function Installer.Preview(config,references,core,service)
	local ok,why=Config.Validate(config) if not ok then return nil,why end
	if not core or not core:IsA("ModuleScript") then return nil,"The Chrono code package is missing. Import the complete setup plugin, including its Core child." end
	local target=service or game:GetService("ServerScriptService")
	if target:FindFirstChild(config.name) then return nil,"Code with this name already exists under "..target.Name..". Choose a different name, or open the existing code to edit it. Nothing has been replaced." end
	local refs={} for _,object in references or {} do
		if typeof(object)~="Instance" or not object:IsDescendantOf(game) or #refs&gt;=64 then return nil,"Select at most 64 objects that still exist in this place. Selecting none is also allowed." end
		table.insert(refs,object)
	end
	local generated=Config.Generate(config)
	local handle=table.freeze({})
	plans[handle]={config=table.clone(config),references=refs,core=core,target=target,sources=generated}
	return handle,table.freeze({destination=target:GetFullName().."."..config.name,
		objects=#refs,declaredTrust="unverified",status="Settings checked. Your game's connections have not been tested.",
		action=generated.Actions,bindings=generated.Bindings,settings=generated.Settings,practice=generated.Practice,
		changes="Add one named code group under ServerScriptService. Includes Core (the library), Bindings (your connections), Actions (move settings), Settings, Practice, an OFF practice test Script, StartHere notes and optional object references. Your game scripts will not be edited. Nothing starts running."})
end
function Installer.Apply(handle,dependencies)
	assert(not game:GetService("RunService"):IsRunning(),"Stop Play before installing")
	local plan=plans[handle] if not plan then return nil,"First choose Check settings on the review page, then install that reviewed version." end
	local d=dependencies or {}
	local history=d.history or game:GetService("ChangeHistoryService")
	local editor=d.editor or game:GetService("ScriptEditorService")
	if plan.target:FindFirstChild(plan.config.name) then return nil,"Someone added code with this name after you checked. Choose a new name and check again. Existing code was kept." end
	for _,ref in plan.references do if not ref:IsDescendantOf(game) then return nil,"A selected object was removed. Choose the references again, then check settings." end end
	local recording=history:TryBeginRecording("ChronoV3Install","Install Chrono V3 integration")
	if not recording then return nil,"Studio could not start an Undo step. Finish any other plugin edit, then try again. No code was installed." end
	local container
	local ok,err=pcall(function()
		container=Instance.new("ModuleScript") container.Name=plan.config.name container:SetAttribute("ChronoV3Owner",OWNER)
		local function write(object,source) editor:UpdateSourceAsync(object,function() return source end) end
		write(container,plan.sources.Integration)
		local clone=plan.core:Clone() clone.Name="Core" clone.Parent=container
		local setup=Instance.new("StringValue") setup.Name="SetupData" setup.Value=game.HttpService:JSONEncode(plan.config) setup.Parent=container
		for _,key in {"Actions","Bindings","Settings","Practice"} do local module=Instance.new("ModuleScript") module.Name=key write(module,plan.sources[key]) module.Parent=container end
		local runner=Instance.new("Script") runner.Name="RunPractice" runner.Enabled=false write(runner,plan.sources.RunPractice) runner.Parent=container
		local notes=Instance.new("StringValue") notes.Name="StartHere"
		notes.Value="1. Return to Plugins &gt; Chrono V3 &gt; ChronoConnect (page 6). Choose objects and a position source, then add the supplied connection package. It handles tracking and recording.\n\n2. Use Events for existing server BindableEvents or Calls to generate and insert reviewed calls at accepted moves, hit outcomes and cancellations. Customize Actions and Hooks inside the package.\n\n3. The supplied humanoid checker is limited to ordinary static-ground movement. Choose an existing independent provider for unsupported movement. Existing input/cooldown/stamina and outcome rules remain the game's responsibility.\n\n4. Press Play and inspect the connection report. Setup completion is not certification. Test real clients, cancellation, respawns and network impairment.\n\n5. For a small made-up API test, enable RunPractice, Play, then stop and disable it. For a working scene, use the supplied learning scene on page 1. Neither certifies your game.\n\n6. Bindings and this main constructor remain an advanced manual option. Do not start them as a second instance when Connector is running. Core.Explain(reason) explains core refusals."
		notes.Parent=container
		local references=Instance.new("Folder") references.Name="References" references.Parent=container
		for i,ref in plan.references do local value=Instance.new("ObjectValue") value.Name=string.format("Reference%02d",i) value.Value=ref value.Parent=references end
		container:SetAttribute("Configured",true) container:SetAttribute("GameAdapterExercised",false)
		container.Parent=plan.target
	end)
	if not ok then if container then container:Destroy() end history:FinishRecording(recording,Enum.FinishRecordingOperation.Cancel) return nil,"Studio could not finish writing the added code. This installation was undone. Studio reported: "..tostring(err) end
	history:FinishRecording(recording,Enum.FinishRecordingOperation.Commit)
	plans[handle]=nil
	return container
end
return table.freeze(Installer)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF19"><Properties><string name="Name">Preview</string><ProtectedString name="Source">-- A picture in the plugin only. These Parts never enter Workspace or affect gameplay.
local Config=require(script.Parent.Config)
local Preview={}
function Preview.Draw(parent,config)
	local frame=Instance.new("ViewportFrame") frame.Name="ShapePicture" frame.Size=UDim2.new(1,0,0,190)
	frame.BackgroundColor3=Color3.fromRGB(12,25,36) frame.BorderSizePixel=0 frame.Ambient=Color3.fromRGB(175,190,210)
	frame.LightColor=Color3.fromRGB(245,248,255) frame.LightDirection=Vector3.new(-1,-1,-1) frame.Parent=parent
	for _,problem in Config.Check(config) do if problem.page==3 then
		local label=Instance.new("TextLabel") label.Size=UDim2.fromScale(1,1) label.BackgroundTransparency=1 label.TextWrapped=true
		label.Text="Fix the hitbox settings to see the picture." label.TextColor3=Color3.fromRGB(231,236,244) label.Parent=frame return frame
	end end
	local model=Instance.new("WorldModel") model.Parent=frame
	local blue=Color3.fromRGB(64,178,238) local orange=Color3.fromRGB(255,178,78)
	local parts={}
	local function part(name,shape,size,cf,color,transparency)
		table.insert(parts,{name=name,shape=shape,size=size,frame=cf,color=color,transparency=transparency or 0})
	end
	local radius=Config.ParseNumber(config.radius) or 1.5 local forward=Config.ParseNumber(config.forward) or 0
	local center=Vector3.new(0,0,-forward) local span=math.max(6,forward+6)
	if config.shape=="Box" then
		part("Hitbox",Enum.PartType.Block,Vector3.new(config.width,config.height,config.depth),CFrame.new(center),blue)
		span=math.max(span,forward+config.width,forward+config.height,forward+config.depth)
	elseif config.shape=="Sphere" then part("Hitbox",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(center),blue) span=math.max(span,forward+radius*2)
	elseif config.shape=="Capsule" then
		local middle=config.height-radius*2
		if middle&gt;0 then part("Middle",Enum.PartType.Cylinder,Vector3.new(middle,radius*2,radius*2),CFrame.new(center)*CFrame.Angles(0,0,math.pi/2),blue) end
		for _,sign in {-1,1} do part("RoundEnd",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(center+Vector3.new(0,sign*middle/2,0)),blue) end
		span=math.max(span,forward+config.height)
	else
		local length=config.length center=Vector3.new(0,0,-length/2) span=math.max(6,length)
		local width=if config.shape=="Ray" then math.max(0.06,length/180) else radius*2
		part("Line",Enum.PartType.Cylinder,Vector3.new(length,width,width),CFrame.new(center)*CFrame.Angles(0,math.pi/2,0),blue,0.3)
		if config.shape=="SweptSphere" then for _,z in {0,-length} do part("RoundEnd",Enum.PartType.Ball,Vector3.one*radius*2,CFrame.new(0,0,z),blue,0.2) end span=math.max(span,length+radius*2) end
	end
	part("ReferencePosition",Enum.PartType.Ball,Vector3.one*math.max(0.35,span/35),CFrame.new(),orange)
	-- Normalize before creating Parts, so very long previews avoid Part-size and camera limits.
	local scale=math.min(1,60/span)
	for _,data in parts do
		local p=Instance.new("Part") p.Name=data.name p.Shape=data.shape p.Size=data.size*scale
		p.CFrame=CFrame.new(data.frame.Position*scale)*data.frame.Rotation p.Color=data.color p.Transparency=data.transparency
		p.Anchored=true p.CanCollide=false p.Material=Enum.Material.SmoothPlastic p.Parent=model
	end
	local focus=center*(0.5*scale) local viewSpan=span*scale
	local camera=Instance.new("Camera") camera.FieldOfView=40 camera.CFrame=CFrame.lookAt(focus+Vector3.new(viewSpan*0.9,viewSpan*0.65,viewSpan*1.15),focus) camera.Parent=frame frame.CurrentCamera=camera
	return frame
end
return Preview
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF20"><Properties><string name="Name">ProviderTemplates</string><ProtectedString name="Source">-- All customization remains inside the installed package.
local T={}
T.Sources={
 Clock=[[-- Optional: replace the body with your server simulation's shared seconds clock.
-- Use the SAME clock for every position, Capture timestamp and timing provider.
return {Now=function() return workspace:GetServerTimeNow() end}
]],
 Registry=[[-- Pure server data, no Parts required. Return a dictionary keyed by stable text ids.
-- Replace this empty list with your game's already calculated/checked objects.
-- Each snapshot needs ok=true, root=CFrame, zones={Body=shape}, state={active=true}.
-- Shapes use MAP coordinates. Use require(script.Parent.Core).Shapes.
-- Optional per-object fields: kind, maxSpeed, maxRadius.
-- ok=true declares YOUR server already checked/calculated the data.
return {Snapshots=function(time) return {} end}
]],
 Timing=[[-- Return an approved delay in seconds, between zero and maximum.
-- This is called ONCE when the server accepts a move. The delay stays fixed for that move.
-- Do not accept a raw client timestamp or raw client-provided delay here.
-- Adapt your existing server timing check here, or use Measured ping in the plugin.
return {Resolve=function(actor,serverContext,captureTime,maximum)
 error("Connect your server timing rule inside this module before enabling Provider timing")
end}
]],
 World=[[-- Called for rays / swept spheres only. shape uses MAP coordinates.
-- Return {covered=true,blocked=boolean,fraction=number from 0 to 1}.
-- covered means YOUR provider actually knows obstacles at queryTime.
-- Never answer 'clear' merely because historical obstacle data is missing.
-- Moving doors, platforms and destructible cover need saved obstacle states.
return {Check=function(queryTime,currentTime,shape)
 return {covered=false}
end}
]],
 Provider=[[-- Connect your existing position checker here. A root read alone is not validation.
-- Return {ok=true,root=CFrame,zones={Body=shape},state={active=true}} only AFTER approval.
-- Shapes use MAP coordinates. Use require(script.Parent.Core).Shapes.
return {Snapshot=function(object,time) return {ok=false} end}
]]}
function T.Add(root,key,d)
 if not root or not root:FindFirstChild("ConnectionLinks") then return nil,"Add connections first." end
 if game:GetService("RunService"):IsRunning() then return nil,"Stop Play first." end
 if not T.Sources[key] then return nil,"Unknown provider template." end
 local name=key.."Provider" if root:FindFirstChild(name) then return nil,"A file named "..name.." exists. Open it; no code was replaced." end
 d=d or {} local h=d.history or game:GetService("ChangeHistoryService") local e=d.editor or game:GetService("ScriptEditorService")
 local rec=h:TryBeginRecording("ChronoProvider","Add Chrono provider template") if not rec then return nil,"Studio could not start an Undo step." end
 local object local ok,err=pcall(function()
  object=Instance.new("ModuleScript") object.Name=name e:UpdateSourceAsync(object,function() return T.Sources[key] end) object.Parent=root
 end)
 if not ok and object then object:Destroy() end h:FinishRecording(rec,if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
 return if ok then object else nil,err
end
return T

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF21"><Properties><string name="Name">View</string><ProtectedString name="Source">-- Plain-language setup. The code names remain available beside their explanations.
local Config=require(script.Parent.Config)
local Fields=require(script.Parent.Fields)
local Installer=require(script.Parent.Installer)
local Preview=require(script.Parent.Preview)
local ConnectionView=require(script.Parent.ConnectionView)
local View={}
local colors={background=Color3.fromRGB(17,23,32),card=Color3.fromRGB(28,37,49),text=Color3.fromRGB(237,242,249),muted=Color3.fromRGB(183,199,215),accent=Color3.fromRGB(94,225,183),error=Color3.fromRGB(255,181,163)}
function View.Mount(parent,options)
	local o=options or {}
	local config=Config.Default()
	local connectionState=ConnectionView.New()
	local Help=require(assert(o.core,"Pass the Core ModuleScript to the setup view").Help)
	local page,mode=1,"setup"
	local helpTab="words"
	local pages={"Choose an example","Choose objects","Build a hitbox","Choose game rules","Check and add code","Connect your game"}
	local refs,advanced={},{}
	local plan,summary,installed,lastProblem=nil,nil,nil,nil
	local query,reason="","capture_required"
	local codeVisible,codeTab=false,"Actions"
	local connections,pageConnections={},{}
	local fieldsByKey={} local order=0 local destroyed=false
	local root=Instance.new("Frame") root.Name="ChronoSetup" root.Size=UDim2.fromScale(1,1) root.BackgroundColor3=colors.background root.BorderSizePixel=0 root.Parent=parent
	local function connect(signal,fn,permanent)
		local c=signal:Connect(fn) table.insert(if permanent then connections else pageConnections,c) return c
	end
	local function place(v,target)
		order+=1 v.LayoutOrder=order v.Parent=target return v
	end
	local function padding(target,amount)
		local p=Instance.new("UIPadding") p.PaddingTop=UDim.new(0,amount) p.PaddingBottom=UDim.new(0,amount) p.PaddingLeft=UDim.new(0,amount) p.PaddingRight=UDim.new(0,amount) p.Parent=target
	end
	local function stack(target)
		local list=Instance.new("UIListLayout") list.SortOrder=Enum.SortOrder.LayoutOrder list.Padding=UDim.new(0,8) list.Parent=target return list
	end
	local function label(target,text,size,color)
		local v=Instance.new("TextLabel") v.Name="Text" v.Size=UDim2.new(1,0,0,20) v.AutomaticSize=Enum.AutomaticSize.Y
		v.BackgroundTransparency=1 v.Text=tostring(text) v.TextWrapped=true v.TextXAlignment=Enum.TextXAlignment.Left v.TextYAlignment=Enum.TextYAlignment.Top
		v.Font=Enum.Font.Gotham v.TextSize=size or 16 v.TextColor3=color or colors.text return place(v,target)
	end
	local function card(target,name)
		local f=Instance.new("Frame") f.Name=name or "Card" f.Size=UDim2.new(1,0,0,0) f.AutomaticSize=Enum.AutomaticSize.Y f.BackgroundColor3=colors.card f.BorderSizePixel=0
		place(f,target) padding(f,12) stack(f) local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(0,8) corner.Parent=f return f
	end
	local function button(target,text,callback,selected,permanent)
		local b=Instance.new("TextButton") b.Name=text:gsub("[^%w]","") b.Size=UDim2.new(1,0,0,42) b.BackgroundColor3=if selected then Color3.fromRGB(32,84,74) else colors.card
		b.BorderSizePixel=0 b.Text=text b.TextSize=14 b.TextWrapped=true b.Font=Enum.Font.GothamMedium b.TextColor3=colors.text
		place(b,target) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,6) c.Parent=b connect(b.Activated,callback,permanent) return b
	end
	local header=Instance.new("Frame") header.Name="Header" header.Position=UDim2.fromOffset(16,14) header.Size=UDim2.new(1,-32,0,96) header.BackgroundTransparency=1 header.Parent=root
	local brand=label(header,"CHRONO V3  /  3.2",14,colors.accent) brand.Size=UDim2.new(0.48,0,0,28) brand.AutomaticSize=Enum.AutomaticSize.None
	local title=label(header,"",22) title.Position=UDim2.fromOffset(0,42) title.Size=UDim2.new(1,0,0,54) title.AutomaticSize=Enum.AutomaticSize.None
	local content=Instance.new("ScrollingFrame") content.Name="Content" content.Position=UDim2.fromOffset(16,116) content.Size=UDim2.new(1,-32,1,-238)
	content.BackgroundTransparency=1 content.BorderSizePixel=0 content.ScrollBarThickness=5 content.AutomaticCanvasSize=Enum.AutomaticSize.Y content.CanvasSize=UDim2.new() content.Parent=root
	local contentLayout=stack(content)
	local footer=Instance.new("Frame") footer.Name="Footer" footer.Position=UDim2.new(0,16,1,-112) footer.Size=UDim2.new(1,-32,0,102) footer.BackgroundTransparency=1 footer.Parent=root
	local status=label(footer,"Your game is not connected yet.",14,colors.muted) status.Size=UDim2.new(1,0,0,48) status.AutomaticSize=Enum.AutomaticSize.None
	local rebuild,go
	local back,nextButton
	local function invalidate()
		plan=nil summary=nil lastProblem=nil status.Text="Settings changed. Check them before adding code.\nYour game's connections are not checked."
	end
	local function field(key)
		local info=Fields.Items[key] local f=card(content,"Field_"..key) fieldsByKey[key]=f
		label(f,info.label..(if info.unit then " ("..info.unit..")" else ""),15)
		local input=Instance.new("TextBox") input.Name="Input" input.Size=UDim2.new(1,0,0,38) input.Text=tostring(config[key]) input.ClearTextOnFocus=false input.Font=Enum.Font.Code input.TextSize=17
		input.BackgroundColor3=colors.background input.BorderSizePixel=0 input.TextColor3=colors.text place(input,f)
		label(f,info.hint,14,colors.muted)
		local problemText=label(f,"",14,colors.error) problemText.Visible=false
		local function showProblems()
			local lines={} for _,problem in Config.Check(config) do if problem.field==key then table.insert(lines,problem.message) end end
			problemText.Text=table.concat(lines,"\n") problemText.Visible=#lines&gt;0
		end
		showProblems()
		connect(input.FocusLost,function()
			if info.min~=nil then config[key]=Config.ParseNumber(input.Text) or input.Text else config[key]=input.Text:match("^%s*(.-)%s*$") end
			invalidate() showProblems()
		end)
	end
	local function note(heading,text)
		local f=card(content) label(f,heading,17,colors.accent) label(f,text,14,colors.muted) return f
	end
	local function openObject(object)
		if not object then lastProblem="The requested file is not available. Add the reviewed code first." rebuild() return end
		local ok,err=pcall(function()
			if o.openScript then o.openScript(object) else game:GetService("Selection"):Set({object}) end
		end)
		status.Text=if ok then "Selected "..object.Name.." in Explorer. Read its comments for the next step." else "Select the file in Explorer to open it. Studio reported: "..tostring(err)
	end
	local function currentInstall()
		if installed and installed.Parent then return installed end
		local target=o.target or game:GetService("ServerScriptService")
		local candidate=target:FindFirstChild(tostring(config.name))
		if candidate and candidate:IsA("ModuleScript") and type(candidate:GetAttribute("ChronoV3Owner"))=="string" then return candidate end
		return nil
	end
	local function preview()
		local errors=Config.Check(config)
		if #errors&gt;0 then plan=nil summary=nil status.Text=string.format("Fix %d setting(s). Use the buttons on the review page.",#errors) return false,errors end
		local handle,detail=Installer.Preview(config,refs,o.core,o.target)
		if not handle then plan=nil summary=nil lastProblem=tostring(detail) status.Text="Code was not added. Read the message above." return false,detail end
		plan,summary=handle,detail lastProblem=nil
		status.Text="Settings checked. No code added yet.\nYour game's connections are not checked."
		return true,detail
	end
	local function install()
		if game:GetService("RunService"):IsRunning() then lastProblem="Stop Play, then return here to add the code." rebuild() return nil end
		if not plan then lastProblem="Choose Check settings first. Then add the reviewed code." rebuild() return nil end
		local ok,object,err=pcall(Installer.Apply,plan,o.dependencies)
		plan=nil
		if not ok or not object then lastProblem=if ok then tostring(err) else tostring(object) status.Text="Code was not added. Read the message above." rebuild() return nil end
		installed=object lastProblem=nil page=6 connectionState.c.kind=config.kind
		status.Text="Core added. Next: choose your objects and add the supplied connections."
		if o.onInstalled then o.onInstalled(object) end rebuild()
		return object
	end
	go=function(newPage,key)
		page=math.clamp(newPage,1,#pages) mode="setup"
		if key then advanced[page]=true end rebuild()
		if key then task.defer(function()
			local f=fieldsByKey[key]
			if f and f.Parent then content.CanvasPosition=Vector2.new(0,math.max(0,f.AbsolutePosition.Y-content.AbsolutePosition.Y+content.CanvasPosition.Y-8)) local input=f:FindFirstChild("Input") if input then input:CaptureFocus() end end
		end) end
	end
	local function more(text)
		button(content,(if advanced[page] then "Hide: " else "More settings: ")..text,function() advanced[page]=not advanced[page] rebuild() end)
		return advanced[page]
	end
	local function codeBox(text)
		local f=card(content,"CodeCard")
		label(f,"Select and copy this code if you want to edit it elsewhere.",14,colors.muted)
		local scroll=Instance.new("ScrollingFrame") scroll.Name="CodeScroll" scroll.Size=UDim2.new(1,0,0,240) scroll.BackgroundColor3=colors.background scroll.BorderSizePixel=0 scroll.ScrollBarThickness=4 scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y scroll.CanvasSize=UDim2.new() place(scroll,f)
		local box=Instance.new("TextBox") box.Name="Code" box.Size=UDim2.new(1,-12,0,240) box.AutomaticSize=Enum.AutomaticSize.Y box.Text=text box.TextWrapped=true box.MultiLine=true box.ClearTextOnFocus=false box.TextEditable=false box.Font=Enum.Font.Code box.TextSize=13 box.TextColor3=colors.text box.BackgroundTransparency=1 box.TextXAlignment=Enum.TextXAlignment.Left box.TextYAlignment=Enum.TextYAlignment.Top box.Parent=scroll
		button(f,"Select all code",function() box:CaptureFocus() box.CursorPosition=#text+1 box.SelectionStart=1 end)
	end
	local function learn()
		note("Help in plain language","Look up a word, or explain a result message. The real code name stays visible so you can find it in a script.")
		local tabs=Instance.new("Frame") tabs.Name="HelpTabs" tabs.Size=UDim2.new(1,0,0,40) tabs.BackgroundTransparency=1 place(tabs,content)
		local words=button(tabs,"Word meanings",function() helpTab="words" rebuild() end,helpTab=="words") words.Size=UDim2.new(0.48,0,0,40)
		local messages=button(tabs,"Result messages",function() helpTab="messages" rebuild() end,helpTab=="messages") messages.Size=UDim2.new(0.48,0,0,40) messages.Position=UDim2.new(0.52,0,0,0)
		if helpTab=="messages" then
		local errors=card(content,"MessageHelp") label(errors,"Understand a result message",18,colors.accent)
		label(errors,"Paste a reason code from your result or Output. Example: target_state_boundary.",14,colors.muted)
		local input=Instance.new("TextBox") input.Name="ReasonCode" input.Size=UDim2.new(1,0,0,38) input.Text=reason input.ClearTextOnFocus=false input.Font=Enum.Font.Code input.TextSize=14 input.TextColor3=colors.text input.BackgroundColor3=colors.background place(input,errors)
		connect(input.FocusLost,function() reason=input.Text:match("^%s*(.-)%s*$") rebuild() end)
		local extra=o.runtime and o.runtime:FindFirstChild("Messages")
		local h=(extra and require(extra).Explain(reason)) or Help.Explain(reason) label(errors,h.title,17) if h.subject then label(errors,h.subject,14,colors.muted) end
		label(errors,"What happened: "..h.meaning,14) label(errors,"What to do: "..h.fix,14,colors.accent)
		return end
		local search=Instance.new("TextBox") search.Name="WordSearch" search.Size=UDim2.new(1,0,0,40) search.PlaceholderText="Type a word, then press Enter" search.Text=query search.ClearTextOnFocus=false search.Font=Enum.Font.Gotham search.TextSize=15 search.TextColor3=colors.text search.PlaceholderColor3=colors.muted search.BackgroundColor3=colors.card place(search,content)
		connect(search.FocusLost,function() local y=content.CanvasPosition query=search.Text rebuild() content.CanvasPosition=y end)
		local entries=Help.FindTerms(query)
		label(content,tostring(#entries).." explanation(s)",14,colors.muted)
		if #entries==0 then label(content,"No matching word. Try a shorter word or clear the search.",14) end
		for _,entry in entries do local f=card(content) label(f,entry[2],17,colors.accent) label(f,"Code / technical word: "..entry[1],13,colors.muted) label(f,entry[3],14) label(f,"Example: "..entry[4],14,colors.muted) end
	end
	rebuild=function()
		if destroyed then return end
		for _,c in pageConnections do c:Disconnect() end table.clear(pageConnections) table.clear(fieldsByKey)
		for _,v in content:GetChildren() do if v~=contentLayout then v:Destroy() end end
		content.CanvasPosition=Vector2.zero
		title.Text=if mode=="learn" then "Words and result messages" else string.format("%d of %d  |  %s",page,#pages,pages[page])
		if back then
			back.Text=if mode=="learn" then "Return to setup" else "Back"
			back.Visible=mode=="learn" or page&gt;1
			back.Size=UDim2.new(if mode=="learn" then 1 else 0.48,0,0,40)
		end
		if nextButton then
			nextButton.Visible=mode~="learn"
			nextButton.Text=if page==#pages then "Start page" else "Next"
			nextButton.Size=UDim2.new(if page==1 then 1 else 0.48,0,0,40)
			nextButton.Position=UDim2.new(if page==1 then 0 else 0.52,0,0,58)
		end
		if lastProblem then note("What needs attention",lastProblem) end
		if mode=="learn" then learn() return end
		if page==1 then
			note("What Chrono V3 does","Your game supplies positions and hitboxes. Chrono saves them and checks whether a move touches an allowed object. Your game decides what happens next: possession, damage, stun or another result.")
			if o.runtime then button(content,"Try a complete supplied learning scene",function()
				local object,why=require(script.Parent.ConnectionExample).Create({Editor=script.Parent,Core=o.core,Runtime=o.runtime},o.dependencies)
				if object then installed=object connectionState.root=object local c,l=require(script.Parent.ConnectionInstaller).Load(object) connectionState.c=c connectionState.links=l page=6 connectionState.tab="Test &amp; restore" status.Text="Learning scene added. Press Play: the supplied events produce checked contacts. This does not certify your own game." else status.Text=tostring(why) end rebuild()
			end) end
			label(content,"Start with an example. You can change every setting.",16)
			for _,entry in {{"Sports","Sports: tackle, kick or ball"},{"Melee","Melee: a close-range attack"},{"Hitscan","Instant line check: a straight shot"}} do
				button(content,entry[2],function() config=Config.Preset(entry[1],config) invalidate() go(2) end)
			end
			note("Your existing game stays in charge","Keep your camera, animations, effects and outcome rules. Page 6 supplies the connection machinery: choose objects, a position-checking option, and existing events or generated calls. Customize the delivered Hooks for unusual rules. Genuine missing game requirements are explained rather than silently assumed.")
			button(content,"I already know my settings: continue",function() go(2) end)
		elseif page==2 then
			field("name") field("kind")
			note("Which position can decide a hit?","Use positions your server calculates or checks. This is often called authoritative data. A player sending a position, or a server reading that position, does not prove that movement was allowed.")
			button(content,"Keep links to selected objects (optional)",function()
				refs=if o.selection then o.selection() else game:GetService("Selection"):Get() invalidate() status.Text=tostring(#refs).." object link(s) selected. Their positions are not approved automatically." rebuild()
			end)
			if #refs&gt;0 then local names={} for i=1,math.min(6,#refs) do table.insert(names,refs[i].Name) end label(content,"Links: "..table.concat(names,", "),14,colors.muted) end
			note("What you will connect","In Bindings, return {root, zones, state}. Root is the main position and direction. Zones are named hitbox shapes in the map. State holds simple values such as team=2 or active=true. The next pages explain the hitbox and move.")
			if more("movement limits") then field("maxSpeed") field("maxRadius") end
		elseif page==3 then
			field("targets")
			for _,shape in Fields.Shapes do button(content,(if config.shape==shape.code then "Selected: " else "Use: ")..shape.label,function() config.shape=shape.code invalidate() rebuild() end,config.shape==shape.code) if config.shape==shape.code then label(content,shape.help,14,colors.muted) end end
			local picture=Preview.Draw(content,config) order+=1 picture.LayoutOrder=order
			label(content,"Orange: main object position. Blue: chosen hitbox or path. Picture scaled to fit; a thin line is drawn wider so you can see it.",13,colors.muted)
			if config.shape=="Ray" or config.shape=="SweptSphere" then field("length") else field("forward") end
			if config.shape=="Box" then field("width") field("height") field("depth")
			elseif config.shape~="Ray" then field("radius") if config.shape=="Capsule" then field("height") end end
			field("opens") field("closes") field("maxTargets")
			note("Very fast moves need extra care","A check uses saved positions at one time. It does not calculate every movement between updates. Use enough updates, or an appropriate straight-line sweep for your move. A sweep still holds the other objects at one chosen time.")
		elseif page==4 then
			note("Start with the present time","By default, Chrono checks the latest saved game update. Earlier-position checks are optional. Keep that default while connecting your first move.")
			button(content,"Rule example: allow all matching types",function() config.rules="all" invalidate() rebuild() end,config.rules=="all")
			button(content,"Rule example: active and on different teams",function() config.rules="team" invalidate() rebuild() end,config.rules=="team")
			label(content,if config.rules=="team" then "This example expects state.active and state.team for both objects. The practice test supplies them. Your real position functions must supply your real values." else "Allow all is only a starting example. Add your own immunity, possession, round and other rules before using real moves.",14,colors.muted)
			if more("saved positions and delay") then field("seconds") field("maxGap") field("maxRewind") end
			note("Should a wall stop this move?","Your game must choose that rule. An optional obstacle function can check earlier map data for line or moving-ball checks. Overlap moves such as tackles need your game's own wall rule. This setup does not silently decide that walls are clear.")
		elseif page==5 then
			local errors=Config.Check(config)
			if #errors&gt;0 then
				note("Fix these settings first",tostring(#errors).." setting(s) need attention. Select one to go to its field.")
				for _,e in errors do button(content,e.message,function() go(e.page,e.field) end) end
			else
				note("Your settings",string.format("Added code: %s\nObject type: %s\nTarget types: %s\nHitbox: %s\nHits allowed from %s to %s seconds\nTotal target limit: %s",config.name,config.kind,config.targets,config.shape,config.opens,config.closes,config.maxTargets))
			end
			button(content,"Check settings and show changes",function() preview() rebuild() end)
			if summary then
				note("Where the code goes",summary.destination.."\n\n"..summary.changes)
				button(content,"Add this reviewed code",install,true)
				button(content,if codeVisible then "Hide generated code" else "Read generated code (optional)",function() codeVisible=not codeVisible rebuild() end)
				if codeVisible then
					for _,key in {"Actions","Bindings","Practice"} do button(content,"Read "..key,function() codeTab=key rebuild() end,codeTab==key) end
					codeBox(if codeTab=="Bindings" then summary.bindings elseif codeTab=="Practice" then summary.practice else summary.action)
				end
			end
			note("What this check proves","Settings checked means these values are usable. It does not prove a player's position is safe, your game is connected, or a real move works. After adding code, run the practice example, then test your own connections.")
		elseif page==6 then
			ConnectionView.Draw({content=content,status=status,note=note,button=button,label=label,card=card,place=place,connect=connect,codeBox=codeBox,rebuild=rebuild},connectionState,
				{root=currentInstall(),runtime=o.runtime,selection=o.selection,openScript=o.openScript,dependencies=o.dependencies})
		end
	end
	local helpButton=button(header,"Words &amp; errors",function() mode=if mode=="learn" then "setup" else "learn" rebuild() end,false,true)
	helpButton.Size=UDim2.new(0.48,0,0,30) helpButton.Position=UDim2.new(0.52,0,0,0)
	back=button(footer,"Back",function() if mode=="learn" then mode="setup" rebuild() else go(page-1) end end,false,true)
	back.Name="Back" back.Size=UDim2.new(0.48,0,0,40) back.Position=UDim2.fromOffset(0,58)
	nextButton=button(footer,"Next",function()
		if mode=="learn" then mode="setup" rebuild() else go(if page==#pages then 1 else page+1) end
	end,false,true) nextButton.Name="Next" nextButton.Size=UDim2.new(0.48,0,0,40) nextButton.Position=UDim2.new(0.52,0,0,58)
	rebuild()
	local controller={Root=root}
	function controller.Go(p) assert(p&gt;=1 and p&lt;=#pages) go(p) end
	function controller.Set(key,value) assert(config[key]~=nil) config[key]=value invalidate() rebuild() end
	function controller.Preview() return preview() end
	function controller.Install() return install() end
	function controller.Config() return table.clone(config) end
	function controller.Connections() return connectionState end
	function controller.Learn(text) mode="learn" helpTab="words" query=text or "" rebuild() end
	function controller.Explain(code) mode="learn" helpTab="messages" reason=code rebuild() end
	function controller.Destroy()
		if destroyed then return end destroyed=true
		for _,c in pageConnections do c:Disconnect() end for _,c in connections do c:Disconnect() end root:Destroy()
	end
	return controller
end
return View
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF22"><Properties><string name="Name">VolumePreview</string><ProtectedString name="Source">-- Preview geometry stays inside a ViewportFrame; never changes Workspace.
local C=require(script.Parent.ConnectionConfig)
local P={}
function P.Draw(parent,rows,attack)
 local view=Instance.new("ViewportFrame") view.Name="VolumesPicture" view.Size=UDim2.new(1,0,0,210)
 view.BackgroundColor3=Color3.fromRGB(12,25,36) view.BorderSizePixel=0 view.Ambient=Color3.fromRGB(180,195,210) view.Parent=parent
 local good=true local span=6
 for _,v in rows do if not C.CheckVolume(v,attack) then good=false break end
  span=math.max(span,Vector3.new(v.x,v.y,v.z).Magnitude+math.max(v.width,v.height,v.depth,v.radius*2,if v.shape=="Ray" or v.shape=="SweptSphere" then v.length else 0))
 end
 if not good then local l=Instance.new("TextLabel") l.Size=UDim2.fromScale(1,1) l.Text="Fix the shape values, then update the picture." l.TextWrapped=true l.BackgroundTransparency=1 l.TextColor3=Color3.new(1,1,1) l.Parent=view return view end
 local scale=math.min(1,50/span) local model=Instance.new("WorldModel") model.Parent=view
 local function part(cf,size,shape,color,alpha)
  local p=Instance.new("Part") p.Anchored=true p.CanCollide=false p.Shape=shape
  p.Size=size*scale p.CFrame=CFrame.new(cf.Position*scale)*cf.Rotation p.Color=color p.Transparency=alpha or 0.2 p.Parent=model
 end
 part(CFrame.new(),Vector3.one*math.max(0.25,span/40),Enum.PartType.Ball,Color3.fromRGB(255,181,80),0)
 for i,v in rows do
  local f=CFrame.new(v.x,v.y,v.z)*CFrame.Angles(math.rad(v.pitch),math.rad(v.yaw),math.rad(v.roll))
  local color=Color3.fromHSV((0.53+(i-1)*0.13)%1,0.65,1)
  if v.shape=="Box" then part(f,Vector3.new(v.width,v.height,v.depth),Enum.PartType.Block,color)
  elseif v.shape=="Sphere" then part(f,Vector3.one*v.radius*2,Enum.PartType.Ball,color)
  elseif v.shape=="Capsule" then local h=v.height-v.radius*2
   if h&gt;0 then part(f*CFrame.Angles(0,0,math.pi/2),Vector3.new(h,v.radius*2,v.radius*2),Enum.PartType.Cylinder,color) end
   for _,sign in {-1,1} do part(f*CFrame.new(0,sign*h/2,0),Vector3.one*v.radius*2,Enum.PartType.Ball,color) end
  else
   local width=if v.shape=="Ray" then math.max(0.06,span/180) else v.radius*2
   part(f*CFrame.new(0,0,-v.length/2)*CFrame.Angles(0,math.pi/2,0),Vector3.new(v.length,width,width),Enum.PartType.Cylinder,color)
   if v.shape=="SweptSphere" then for _,z in {0,-v.length} do part(f*CFrame.new(0,0,z),Vector3.one*v.radius*2,Enum.PartType.Ball,color) end end
  end
 end
 local camera=Instance.new("Camera") camera.FieldOfView=45
 camera.CFrame=CFrame.lookAt(Vector3.new(0.85,0.6,1.1)*span*scale,Vector3.zero) camera.Parent=view view.CurrentCamera=camera return view
end
return P

</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="CF23"><Properties><string name="Name">Runtime</string><ProtectedString name="Source">-- Supplied connection runtime, 3.2.0. One ordinary-server singleton per package.
-- Core math is unchanged. All timing/recording/query policies are explicit settings.
local Root=script.Parent
local Core=require(Root.Core)
local Contract=require(Root.Core.Contract)
local Config=require(script.Configuration)
local Volumes=require(script.Volumes)
local World=require(script.World)
local Messages=require(script.Messages)
local Movement=require(script.Movement)
local R={}
local live
local hookDepth=0
local capture,query,resolve,automatic,publish
local function invoke(fn,...)
 hookDepth+=1 local ok,a,b,c=Contract.Call(fn,...) hookDepth-=1
 if not ok then error(a,0) end return a,b,c
end
local function link(s,name) local v=s.links:FindFirstChild(name) return v and v.Value end
local function module(s,name)
 local object=link(s,name) if not object then return nil end
 local value=require(object) assert(type(value)=="table" or type(value)=="function",name.." module must return a table/function") return value
end
local function now(s)
 local value=if s.clockProvider then invoke(s.hooks.Clock,s.clockProvider) else workspace:GetServerTimeNow()
 assert(Config.Number(value,-1e12,1e12),"clock_fault") return value
end
local function fail(s,reason) s.stats.refused+=1 s.stats.reason=tostring(reason) return nil,tostring(reason) end
local function reset(s,id,reason) s.generation+=1 s.needsCapture=true s.chrono:Discontinuity(id,reason) end
local function finish(s,token)
 local move=token and s.moves[token] if not move then return false end
 s.chrono:EndAction(move.handle) s.moves[token]=nil
 if move.key~=nil and s.keys[move.actor] then s.keys[move.actor][move.key]=nil end return true
end
local function rootOf(object,c)
 if object:IsA("BasePart") then return object end
 local root=object:FindFirstChild(c.root) or object.PrimaryPart
 return if root and root:IsA("BasePart") then root else nil
end
local function owner(root) if root.Anchored then return true,nil end return pcall(root.GetNetworkOwner,root) end
local function physical(s)
 local list={} local mode=s.c.actors
 if table.find({"Players","PlayersAndFolder","PlayersAndData"},mode) then for _,p in game.Players:GetPlayers() do if p.Character then table.insert(list,p.Character) end end end
 if mode=="Tag" then list=game:GetService("CollectionService"):GetTagged(s.c.tag)
 elseif table.find({"Folder","References","PlayersAndFolder"},mode) then
  local f=link(s,"Actors")
  if f and f:IsDescendantOf(workspace) then
   if mode~="Folder" and (f:IsA("BasePart") or (f:IsA("Model") and rootOf(f,s.c))) then table.insert(list,f)
   else for _,o in f:GetChildren() do table.insert(list,o) end end
  end
 end
 local out={} local seen={}
 for _,o in list do if not seen[o] and (o:IsA("Model") or o:IsA("BasePart")) and o:IsDescendantOf(workspace) and rootOf(o,s.c) then seen[o]=true table.insert(out,o) end end
 table.sort(out,function(a,b) return a:GetFullName()&lt;b:GetFullName() end) return out
end
local function limits(s,key,kind,overrides)
 local speed,radius=s.c.recordMaxSpeed,s.c.recordMaxRadius
 if s.c.legacyLimits and typeof(key)=="Instance" then
  local c=s.c local root=rootOf(key,c)
  speed=4096 radius=if c.positions=="Provider" then 512 else math.min(512,math.max(c.radius,c.height/2,Vector3.new(c.width,c.height,c.depth).Magnitude/2,if c.partBodies and root then root.Size.Magnitude/2 else 0)+0.001)
 end
 for _,row in s.c.kindLimits do if row.kind==kind then speed,radius=row.maxSpeed,row.maxRadius break end end
 if s.c.objectLimits and typeof(key)=="Instance" then speed=key:GetAttribute("ChronoMaxSpeed") or speed radius=key:GetAttribute("ChronoMaxRadius") or radius end
 if overrides then speed=overrides.maxSpeed or speed radius=overrides.maxRadius or radius end
 if s.hooks.RecordingLimits then speed,radius=invoke(s.hooks.RecordingLimits,key,speed,radius,s.c) end
 assert(Config.Number(speed,0,4096) and Config.Number(radius,0.001,512),"recording_limits_invalid") return speed,radius
end
local function remove(s,key)
 local rec=s.actors[key] if not rec then return false end
 for token,move in s.moves do if move.actor==key then finish(s,token) end end
 s.chrono:Untrack(rec.id) s.actors[key]=nil s.byId[rec.id]=nil s.keys[key]=nil s.generation+=1 s.needsCapture=true return true
end
local function register(s,key,kind,trust,speed,radius,extra)
 s.serial+=1
 local rec=extra or {} rec.id="actor-"..s.serial rec.key=key rec.kind=kind rec.maxSpeed=speed rec.maxRadius=radius rec.trust=trust
 s.chrono:Track(rec.id,{kind=kind,trust=trust,maxSpeed=speed,maxRadius=radius,capture=function(time) assert(rec.preparedAt==time,"No common update prepared") return rec.prepared end})
 s.actors[key]=rec s.byId[rec.id]=rec s.generation+=1 s.needsCapture=true return rec
end
local function sync(s,time)
 local objects=physical(s) local found={}
 for _,o in objects do found[o]=true end
 local data={}
 if s.registry then
  local supplied=invoke(s.hooks.DataSnapshots,s.registry,time)
  assert(type(supplied)=="table","Registry.Snapshots must return a dictionary keyed by short text ids")
  local count=0 for id,snapshot in supplied do
   count+=1 assert(count&lt;=256 and Config.Name(id) and type(snapshot)=="table","data_registry_invalid")
   data[id]=snapshot
  end
 end
 for key,rec in s.actors do
  if (rec.source=="physical" and (not found[key] or rootOf(key,s.c)~=rec.root)) or (rec.source=="registry" and not data[key]) then remove(s,key) end
 end
 for _,o in objects do
  local root=rootOf(o,s.c) local kind=o:GetAttribute("ChronoKind") or s.c.kind
  local speed,radius=limits(s,o,kind)
  local rec=s.actors[o] local known,who=owner(root)
  if rec and (rec.kind~=kind or rec.maxSpeed~=speed or rec.maxRadius~=radius) then remove(s,o) rec=nil end
  if not rec then
   rec=register(s,o,kind,if s.c.positions=="ServerPhysics" then "serverSimulated" else "serverValidated",speed,radius,{source="physical",root=root,owner=who,ownerKnown=known})
   if s.c.positions=="Humanoid" and o:FindFirstChildOfClass("Humanoid") then rec.guard=Movement.New(o,root,time,s.c) end
  elseif known~=rec.ownerKnown or who~=rec.owner then rec.owner=who rec.ownerKnown=known reset(s,rec.id,"physics_owner_changed") end
 end
 for id,snapshot in data do
  local rec=s.actors[id] assert(not rec or rec.source=="registry","registry_id_conflicts_with_manual_track")
  local kind=snapshot.kind or s.c.kind local speed,radius=limits(s,id,kind,snapshot)
  if rec and (rec.kind~=kind or rec.maxSpeed~=speed or rec.maxRadius~=radius) then remove(s,id) rec=nil end
  if not rec then rec=register(s,id,kind,"serverValidated",speed,radius,{source="registry"}) end
  rec.nextSnapshot=snapshot
 end
 return objects
end
local function prepare(s,rec,time,objects)
 if rec.fault then return nil,rec.fault end
 if rec.source~="physical" then
  local snapshot=if rec.source=="registry" then rec.nextSnapshot else invoke(rec.capture,time)
  if type(snapshot)~="table" or snapshot.ok~=true then return nil,"provider_has_not_approved_position" end
  return {root=snapshot.root,zones=snapshot.zones,state=snapshot.state or {active=true}}
 end
 local o,root=rec.key,rec.root
 local frame=root.CFrame local state=invoke(s.hooks.State,o,root,s.c)
 local zones
 if s.c.positions=="ServerPhysics" then local known,who=owner(root) if not known or who~=nil then return nil,"client_owned_position_needs_checker" end
 elseif s.c.positions=="Humanoid" then
  if rec.guard then local reason,corrected frame,reason,corrected=Movement.Check(rec.guard,time,s.c,s.hooks,objects)
   if not frame then if corrected then s.stats.corrections+=1 invoke(s.hooks.AfterCorrection,o,reason) end return nil,reason end
  else local known,who=owner(root) if not known or who~=nil then return nil,"non_humanoid_needs_server_physics_or_provider" end end
 else
  local snapshot=invoke(s.hooks.ProviderSnapshot,s.provider,o,time)
  if type(snapshot)~="table" or snapshot.ok~=true then return nil,"provider_has_not_approved_position" end
  frame,zones,state=snapshot.root,snapshot.zones,snapshot.state or state
 end
 if not zones then
  if #s.c.zones&gt;0 then zones=Volumes.Zones(Core.Shapes,s.c.zones,frame)
  elseif s.c.partBodies and not o:FindFirstChildOfClass("Humanoid") then
   local size=root.Size local sphere=root:IsA("Part") and root.Shape==Enum.PartType.Ball and math.abs(size.X-size.Y)&lt;1e-5 and math.abs(size.X-size.Z)&lt;1e-5
   zones={Body=if sphere then Core.Shapes.Sphere(frame,size.X/2) else Core.Shapes.Box(frame,size)}
  else zones={Body=if s.c.body=="Sphere" then Core.Shapes.Sphere(frame,s.c.radius) elseif s.c.body=="Capsule" then Core.Shapes.Capsule(frame,s.c.radius,s.c.height) else Core.Shapes.Box(frame,Vector3.new(s.c.width,s.c.height,s.c.depth))} end
 end
 return {root=frame,zones=zones,state=state}
end
capture=function(s,time,runAutomatic)
 if s.busy then return fail(s,"connection_reentry") end
 local read,clock=Contract.Call(now,s) if not read then return fail(s,"clock_fault") end time=time or clock
 if not Config.Number(time,-1e12,clock+1e-6) or clock-time&gt;s.maxGap then return fail(s,"invalid_capture_time") end
 if s.time and time&lt;=s.time then return fail(s,"non_monotonic") end
 s.busy=true s.phaseTime=time
 local ok,accepted,reason=pcall(function()
  local objects=sync(s,time) local blocked
  if s.c.worldMode=="StaticBoxes" then
   local record,why=World.Capture(s.worldRecord,link(s,"Obstacles"),time,s.c.maxObstacles,Core.Shapes)
   s.worldRecord=record s.worldFault=why
  end
  for _,rec in s.actors do
   local worked,snapshot,why=Contract.Call(prepare,s,rec,time,objects)
   if not worked then rec.fault="position_function_error" snapshot=nil why=rec.fault s.stats.errors+=1 end
   if not snapshot then if not rec.blocked then reset(s,rec.id,why) end rec.blocked=why blocked=blocked or why
   else if rec.blocked then reset(s,rec.id,"position_available_again") end rec.blocked=nil rec.prepared=snapshot rec.preparedAt=time end
  end
  if blocked then return nil,blocked end
  local result=s.chrono:Capture(time) s.time=time s.stats.captures+=1
  for token,move in s.moves do if time&gt;move.expires then finish(s,token) end end
  if not result.ok then for _,fault in result.faults or {} do local r=s.byId[fault.id] if r then r.fault=fault.reason end end return nil,result.reason end
  s.needsCapture=false return true
 end)
 s.busy=false s.phaseTime=nil
 if not ok then s.stats.errors+=1 return fail(s,"capture_error: "..tostring(accepted)) end
 if not accepted then return fail(s,reason) end
 if runAutomatic then automatic(s) end
 if publish then publish(s) end return true
end
local function refresh(s)
 if s.busy then return nil,"connection_reentry" end
 if s.c.recording=="Heartbeat" then return capture(s,nil,false) end
 local read,t=Contract.Call(now,s) if not read then return nil,"clock_fault" end
 if not s.time then return nil,"capture_required" end
 if t&lt;s.time-1e-6 then return nil,"clock_reversed" end
 if t-s.time&gt;s.maxGap then return nil,"capture_stale" end return true
end
local function currentState(s,rec)
 if rec.source=="physical" then
  if not rec.key:IsDescendantOf(workspace) then return nil end
  return invoke(s.hooks.State,rec.key,rec.root,s.c)
 end
 return if rec.prepared then rec.prepared.state else nil
end
local function targetAllowed(s,move,target)
 local contact=move.allowed and move.allowed[target]
 if not contact or move.delivered[target] then return nil end
 local a,b=s.actors[move.actor],s.actors[target] if not a or not b then return nil end
 local x,y=currentState(s,a),currentState(s,b)
 if not x or not y or x.active~=true or y.active~=true then return nil end
 if invoke(s.hooks.CanApply,move.actor,target,move.name,move.context,contact)~=true then return nil end return contact
end
query=function(s,token,doRefresh)
 local move=token and s.moves[token] if not move then return fail(s,"move_missing_or_finished") end
 if move.checked and move.mode=="Once" then return fail(s,"move_already_checked") end
 if doRefresh then local ok,why=refresh(s) if not ok then finish(s,token) return fail(s,why) end end
 if s.moves[token]~=move then return fail(s,"move_expired") end
 local result=s.chrono:Query(move.handle) s.stats.queries+=1
 if not result.ok then
  if not table.find({"not_active","duplicate_query"},result.reason) then finish(s,token) end
  return fail(s,result.reason)
 end
 local out=table.clone(result) local contacts={}
 move.allowed={} move.checked=true move.generation=s.generation move.lastQuery=s.time
 for _,contact in result.contacts do
  local rec=s.byId[contact.id]
  if rec then local copy=table.clone(contact) copy.target=rec.key copy=table.freeze(copy) move.allowed[rec.key]=copy table.insert(contacts,copy) s.stats.contacts+=1 end
 end
 out.contacts=table.freeze(contacts) move.result=table.freeze(out) move.pendingCount=#contacts move.pending=#contacts&gt;0
 s.stats.reason="contact_check_completed" return move.result
end
local function allows(s,token,target,doRefresh)
 local move=token and s.moves[token] if not move then return false,"move_missing_or_finished" end
 local fresh,why=true,nil
 if doRefresh then fresh,why=refresh(s) end
 if fresh and (not move.checked or (move.mode=="Repeated" and move.lastQuery~=s.time and not move.pending)) then local result,reason=query(s,token,false) if not result then return false,reason end end
 if not fresh or s.moves[token]~=move or move.generation~=s.generation then finish(s,token) return false,why or "contact_records_changed" end
 local read,t=Contract.Call(now,s) if not read then finish(s,token) return false,"clock_fault" end
 if t&gt;move.result.capturedAt+s.maxGap then finish(s,token) return false,"contact_result_stale" end
 local ok,contact=Contract.Call(targetAllowed,s,move,target)
 if not ok then finish(s,token) return false,"outcome_rule_error" end
 if not contact then return false,"target_not_allowed_or_already_used" end
 move.delivered[target]=true move.pendingCount-=1 if move.pendingCount&lt;=0 then move.pending=false end s.stats.applied+=1 return true,contact
end
resolve=function(s,token,doRefresh)
 local move=token and s.moves[token] if not move then return fail(s,"move_missing_or_finished") end
 local outcome=link(s,"Outcome")
 if not outcome and s.hooks.OnContact==nil then return fail(s,"choose_outcome_event_or_hook") end
 if move.resolved and move.mode=="Once" then return fail(s,"outcomes_already_resolved") end
 if doRefresh then local fresh,reason=refresh(s) if not fresh then finish(s,token) return fail(s,reason) end end
 local result,why
 if move.pending or (move.checked and move.mode=="Once" and not move.resolved) then result=move.result else result,why=query(s,token,false) end
 if not result then return nil,why end
 move.resolved=true
 -- Deterministic contact order is preserved; target keys may be Instances or data ids.
 for _,contact in result.contacts do
  local target=contact.target local allowed=allows(s,token,target,false)
  if allowed then
   local ok,err=Contract.Call(function()
    if outcome then invoke(s.hooks.ApplyOutcome,outcome,move.actor,target,move.name,move.context,contact) end
    if s.hooks.OnContact then invoke(s.hooks.OnContact,move.actor,target,move.name,move.context,contact) end
   end)
   if not ok then s.stats.errors+=1 s.stats.reason="outcome_mapping_error: "..tostring(err) end
  end
 end
 move.pending=false
 return result
end
automatic=function(s)
 if not s.c.autoQuery then return end
 local ready={}
 for token,move in s.moves do
  if s.time&gt;=move.opens and s.time&lt;=move.expires and (not move.checked or move.mode=="Repeated") and (not move.lastQuery or s.time-move.lastQuery&gt;=s.c.queryInterval-1e-6) then table.insert(ready,token) end
 end
 for _,token in ready do local move=s.moves[token] if move then local result=resolve(s,token,false) if result and move.mode=="Once" then finish(s,token) end end end
end
publish=function(s)
 if not s.report or os.clock()-s.published&lt;0.5 then return end s.published=os.clock()
 local count=0 local paused={}
 for key,rec in s.actors do count+=1 if rec.blocked or rec.fault then table.insert(paused,{object=if typeof(key)=="Instance" then key.Name else key,reason=rec.fault or rec.blocked}) end end
 s.report.Value=game.HttpService:JSONEncode({version=Config.Version,connectionBuild=Config.Build,actors=count,positions=s.c.positions,stats=s.stats,paused=paused,core=s.chrono:Inspect().stats,explanation=Messages.Explain(s.stats.reason) or Core.Explain(s.stats.reason),
  timing=s.c.timing,rewind=s.lastRewind or 0,maxRewind=s.c.maxRewind,recording=s.c.recording,queryMode=s.c.queryMode,world=s.c.worldMode,worldFault=s.worldFault,
  outcomeLinked=link(s,"Outcome")~=nil,attackEventLinked=link(s,"Begin")~=nil})
 Root:SetAttribute("ConnectionActors",count) Root:SetAttribute("ConnectionReason",s.stats.reason)
 Root:SetAttribute("ConnectionBegun",s.stats.begun) Root:SetAttribute("ConnectionQueries",s.stats.queries)
end
function R.Start()
 assert(hookDepth==0,"Do not start Connector from a provider or rule function")
 if live then return true end
 assert(game:GetService("RunService"):IsServer(),"Use Chrono connections from server scripts")
 local base=require(Root.Settings)
 local c=Config.Normalize(require(Root.Connections),base)
 local custom=require(Root.Hooks) local defaults=require(script:FindFirstChild("DefaultHooks") or script.Hooks)
 local hooks=setmetatable({},{__index=function(_,key) local value=custom[key] return if value~=nil then value else defaults[key] end})
 local links={} for _,v in Root.ConnectionLinks:GetChildren() do if v:IsA("ObjectValue") then links[v.Name]=v.Value end end
 local valid,why=Config.Validate(c,links) assert(valid,why)
 local s={c=c,hooks=hooks,links=Root.ConnectionLinks,actors={},byId={},moves={},keys={},serial=0,connections={},generation=0,published=-math.huge,maxGap=c.maxGap,
  stats={captures=0,begun=0,queries=0,contacts=0,applied=0,refused=0,cancelled=0,corrections=0,errors=0,reason="starting"}}
 s.provider=if c.positions=="Provider" then module(s,"Provider") else nil
 s.registry=if c.actors=="Data" or c.actors=="PlayersAndData" then module(s,"Registry") else nil
 s.clockProvider=module(s,"Clock") s.timingProvider=if c.timing=="Provider" then module(s,"Timing") else nil s.worldProvider=if c.worldMode=="Provider" then module(s,"World") else nil
 local options=table.clone(base)
 options.seconds=c.historySeconds options.rate=c.recordRate options.maxGap=c.maxGap options.maxRewind=c.maxRewind
 options.clock=function() return s.phaseTime or now(s) end
 options.resolveRewind=function(id,context,time)
  local rec=s.byId[id] local delay
  if c.timing=="Present" then delay=0
  elseif c.timing=="MeasuredPing" then
   local player=if hooks.TimingPlayer then invoke(hooks.TimingPlayer,rec.key,context) elseif typeof(rec.key)=="Instance" and rec.key:IsA("Model") then game.Players:GetPlayerFromCharacter(rec.key) else nil
   assert(typeof(player)=="Instance" and player:IsA("Player") and player.Parent==game.Players,"timing_player_required")
   -- Current Roblox API defines GetNetworkPing as RTT. Half is only an estimate of one-way delay.
   delay=player:GetNetworkPing()/2+c.displayDelay
  else delay=invoke(hooks.ResolveRewind,s.timingProvider,rec.key,context,time,c.maxRewind) end
  assert(Config.Number(delay,0,c.maxRewind),"rewind_rejected")
  s.lastRewind=delay return delay
 end
 options.world=if c.worldMode=="None" then nil else function(time,current,shape)
  if c.worldMode=="StaticBoxes" then return World.Check(s.worldRecord,time,shape,Core.Shapes) end
  return invoke(hooks.WorldCheck,s.worldProvider,time,current,shape)
 end
 s.chrono=Core.new(options)
 s.actions=if c.moveSource=="Builder" then Volumes.Actions(Core.Shapes,c.moves,hooks) else require(Root.Actions)
 local wrapped={} for name,profile in s.actions do
  local copy=table.clone(profile) if copy.eligible then local rule=copy.eligible copy.eligible=function(...) return invoke(rule,...) end end wrapped[name]=copy
 end s.actions=wrapped
 live=s
 if game:GetService("RunService"):IsStudio() then
  local reports=game.ReplicatedStorage:FindFirstChild("_ChronoConnectionReports")
  if not reports then reports=Instance.new("Folder") reports.Name="_ChronoConnectionReports" reports.Parent=game.ReplicatedStorage end
  if reports:FindFirstChild(Root.Name) then live=nil s.chrono:Destroy() error("Second connection instance: require the same Connector from ordinary server scripts") end
  s.report=Instance.new("StringValue") s.report.Name=Root.Name s.report.Parent=reports
 end
 local function safe(fn,...)
  local ok,err=pcall(fn,...) if not ok then s.stats.errors+=1 s.stats.reason="connection_error: "..tostring(err) warn(s.stats.reason) end
 end
 for name,callback in {
  Begin=function(...) local actor,action,key,context=invoke(hooks.ReadBegin,...) R.Begin(actor,action,context,key or action or "Contact") end,
  Query=function(...) local actor,key=invoke(hooks.ReadQuery,...) local token=s.keys[actor] and s.keys[actor][key or "Contact"] if token then local move=s.moves[token] R.Resolve(token) if move and move.mode=="Once" then R.Finish(token) end else fail(s,"move_missing") end end,
  Cancel=function(...) local actor,key=invoke(hooks.ReadCancel,...) local token=s.keys[actor] and s.keys[actor][key or "Contact"] if token then R.Cancel(token) end end,
 } do local event=link(s,name) if event then table.insert(s.connections,event.Event:Connect(function(...) safe(callback,...) end)) end end
 if c.recording=="Event" then table.insert(s.connections,link(s,"Capture").Event:Connect(function(time) safe(R.Capture,time) end)) end
 table.insert(s.connections,game:GetService("RunService").Heartbeat:Connect(function()
  safe(function()
   if c.recording=="Heartbeat" then local t=now(s) if not s.time or t-s.time&gt;=1/c.recordRate-1e-6 then capture(s,nil,true) end end
   publish(s)
  end)
 end))
 if c.recording=="Heartbeat" then local ok,reason=capture(s,nil,false) s.stats.reason=if ok then "ready_for_moves" else reason else s.stats.reason="waiting_for_capture" end
 publish(s) return true
end
local function session(allowHook) assert(allowHook or hookDepth==0,"Do not call Connector again from a provider or rule function") if not live then R.Start() end return live end
function R.Capture(time) return capture(session(),time,true) end
function R.Track(id,binding)
 local s=session() assert(not s.busy,"connection_reentry")
 assert(Config.Name(id) and not s.actors[id] and type(binding)=="table" and type(binding.capture)=="function","Track needs an unused text id and capture function")
 local kind=binding.kind or s.c.kind local speed,radius=limits(s,id,kind,binding)
 register(s,id,kind,binding.trust or "unverified",speed,radius,{source="manual",capture=binding.capture})
 return id
end
function R.Untrack(id) local s=session() assert(not s.busy,"connection_reentry") return remove(s,id) end
function R.Discontinuity(actor,reason)
 local s=session() assert(not s.busy,"connection_reentry") local rec=assert(s.actors[actor],"Object is not connected")
 reset(s,rec.id,reason or "approved_reset") rec.fault=nil rec.blocked=nil
 for token,move in s.moves do if move.actor==actor then finish(s,token) end end return true
end
function R.Begin(actor,name,context,key)
 local s=session() name=name or "Contact"
 local profile=s.actions[name] if not profile then return fail(s,"move_settings_missing") end
 if key~=nil and (type(key)~="string" or #key&gt;64) then return fail(s,"move_key_invalid") end
 if key~=nil and s.keys[actor] and s.keys[actor][key] then return fail(s,"move_key_already_active") end
 local ok,why=refresh(s) if not ok then return fail(s,why) end
 local rec=s.actors[actor] if not rec then return fail(s,"actor_not_connected") end
 local mode=profile.queryMode or s.c.queryMode if mode~="Once" and mode~="Repeated" then return fail(s,"invalid_query_mode") end
 local permitted,value=Contract.Call(invoke,s.hooks.CanStart,actor,name,context,rec.prepared.state)
 if not permitted or value~=true then return fail(s,"move_not_allowed") end
 local handle,reason=s.chrono:BeginAction(rec.id,profile,context) if not handle then return fail(s,reason) end
 local token=table.freeze({}) s.moves[token]={actor=actor,name=name,context=context,handle=handle,key=key,opens=s.time+(profile.opens or 0),expires=s.time+(profile.closes or 0.25),delivered={},mode=profile.queryMode or s.c.queryMode}
 if key~=nil then s.keys[actor]=s.keys[actor] or {} s.keys[actor][key]=token end
 s.stats.begun+=1 s.stats.reason="move_started" return token
end
function R.Query(token) return query(session(),token,true) end
function R.Allows(token,target) return allows(session(),token,target,true) end
function R.Resolve(token) return resolve(session(),token,true) end
function R.Cancel(token) local s=session() if finish(s,token) then s.stats.cancelled+=1 return true end return false end
function R.Finish(token) return finish(session(),token) end
function R.AllowMotion(actor,velocity,seconds)
 local s=session(true) local rec=s.actors[actor]
 if not rec then assert(not s.busy,"Object is not connected") sync(s,now(s)) rec=s.actors[actor] end
 assert(rec and rec.guard,"Motion permission needs the supplied humanoid checker") Movement.Allow(rec.guard,velocity,seconds,now(s))
end
function R.Teleport(actor,frame)
 local s=session() assert(not s.busy,"connection_reentry") local rec=s.actors[actor]
 if not rec then sync(s,now(s)) rec=s.actors[actor] end
 assert(rec and rec.source=="physical","For data-only objects, update server data then call Discontinuity") assert(typeof(frame)=="CFrame","Teleport needs a CFrame")
 if rec.guard then Movement.Reset(rec.guard,frame,now(s),s.c) elseif actor:IsA("Model") then actor:PivotTo(frame*rec.root.CFrame:Inverse()*actor:GetPivot()) else actor.CFrame=frame end
 return R.Discontinuity(actor,"approved_teleport")
end
function R.Resume(actor) return R.Discontinuity(actor,"provider_fixed_by_server") end
function R.Inspect()
 local s=session() local count=0 local limitsList={}
 for key,rec in s.actors do count+=1 table.insert(limitsList,{object=if typeof(key)=="Instance" then key:GetFullName() else key,kind=rec.kind,maxSpeed=rec.maxSpeed,maxRadius=rec.maxRadius,source=rec.source}) end
 return {version=Config.Version,stats=table.clone(s.stats),actors=count,core=s.chrono:Inspect(),positions=s.c.positions,configuration=Config.Copy(s.c),limits=limitsList}
end
function R.Explain(reason) return Messages.Explain(reason) or Core.Explain(reason) end
function R.Destroy()
 local s=live if not s then return end assert(not s.busy and hookDepth==0,"connection_reentry")
 for _,c in s.connections do c:Disconnect() end s.chrono:Destroy() if s.report then s.report:Destroy() end live=nil
end
return R

</ProtectedString></Properties><Item class="ModuleScript" referent="CF24"><Properties><string name="Name">Configuration</string><ProtectedString name="Source">-- Shared wizard/runtime schema. Plain data; editor does not execute game modules.
local C={Version="3.2.0",Build="2026-10-25"}
function C.Copy(v,seen)
 if type(v)~="table" then return v end
 seen=seen or {} assert(not seen[v],"Settings must not contain repeated/cyclic tables") seen[v]=true
 local o={} for k,x in v do o[k]=C.Copy(x,seen) end seen[v]=nil return o
end
function C.Volume(name) return {name=name or "Body",shape="Box",width=4,height=5,depth=2,radius=2,x=0,y=0,z=0,pitch=0,yaw=0,roll=0,length=20} end
function C.Move(name) local v=C.Volume(name or "Contact") v.z=-3 v.depth=5 v.targets="actor" v.opens=0.12 v.closes=0.35 v.maxTargets=1 v.maxReach=32 v.rule="all" v.world=false v.queryMode="Default" return v end
function C.Default()
 return {schema=2,actors="Players",tag="ChronoActor",root="HumanoidRootPart",kind="actor",positions="ServerPhysics",
 body="Box",width=4,height=5,depth=2,radius=2,walk=20,jump=50,ground=3,burst=0.4,slack=1.25,verticalSlack=3,wallRadius=0.7,
 correction=false,autoQuery=false,guide=true,partBodies=false,activeAttribute="",teamAttribute="",
 recording="Heartbeat",recordRate=60,historySeconds=0.6,maxGap=0.075,maxRewind=0,recordMaxSpeed=100,recordMaxRadius=16,
 timing="Present",displayDelay=0,queryMode="Once",queryInterval=1/60,candidates="Existing",worldMode="None",maxObstacles=1024,
 moveSource="Actions",moves={},zones={},kindLimits={},objectLimits=true,legacyLimits=false}
end
function C.Normalize(v,base)
 local out=C.Default() base=base or {}
 for key,value in {historySeconds=base.seconds,maxGap=base.maxGap,maxRewind=base.maxRewind,recordRate=base.rate,recordMaxSpeed=base.maxSpeed,recordMaxRadius=base.maxRadius} do if value~=nil then out[key]=value end end
 if v then for key,value in v do out[key]=C.Copy(value) end end
 if v and v.schema==nil then
  out.legacyLimits=true
  out.recordMaxSpeed=4096
  out.recordMaxRadius=if v.positions=="Provider" then 512 else math.min(512,math.max(v.radius or 2,(v.height or 5)/2,Vector3.new(v.width or 4,v.height or 5,v.depth or 2).Magnitude/2)+0.001)
 end
 out.schema=2 return out
end
local function number(n,a,b) return type(n)=="number" and n==n and n&gt;=a and n&lt;=b end
local function name(s) return type(s)=="string" and #s&gt;0 and #s&lt;=64 and not s:find("%c") end
C.Number=number C.Name=name
function C.CheckVolume(v,attack)
 if type(v)~="table" or not name(v.name) then return false,"Give every hitbox/move a short name." end
 if not table.find(if attack then {"Box","Sphere","Capsule","Ray","SweptSphere"} else {"Box","Sphere","Capsule"},v.shape) then return false,"Choose a supported shape." end
 for key,b in {width={0.01,512},height={0.02,512},depth={0.01,512},radius={0.01,32},length={0.01,4096},x={-4096,4096},y={-4096,4096},z={-4096,4096},pitch={-360,360},yaw={-360,360},roll={-360,360}} do if not number(v[key],b[1],b[2]) then return false,"Invalid hitbox value: "..key end end
 if v.shape=="Capsule" and v.height&lt;v.radius*2 then return false,"Capsule height must include both round ends: at least twice its radius." end
 if attack then
  if not number(v.opens,0,10) or not number(v.closes,v.opens,10) or not number(v.maxTargets,1,256) or v.maxTargets%1~=0 or not number(v.maxReach,0,4096) then return false,"Review timing, reach and target count." end
  if not table.find({"all","team","Hook"},v.rule) or not table.find({"Default","Once","Repeated"},v.queryMode) or type(v.world)~="boolean" then return false,"Choose the move rule, check mode and wall option." end
  if v.world and v.shape~="Ray" and v.shape~="SweptSphere" then return false,"Core obstacle checks support rays and swept spheres; other moves need your own wall rule." end
  if type(v.targets)~="string" then return false,"Enter target kinds separated by commas." end
  local count=0 for k in v.targets:gmatch("[^,%s]+") do if not name(k) then return false,"Invalid target kind." end count+=1 end
  if count&lt;1 or count&gt;32 then return false,"Use 1 to 32 target kinds." end
  local position=Vector3.new(v.x,v.y,v.z) local reach
  if v.shape=="Ray" or v.shape=="SweptSphere" then
   local f=CFrame.new(position)*CFrame.Angles(math.rad(v.pitch),math.rad(v.yaw),math.rad(v.roll))
   reach=math.max(position.Magnitude,(f*CFrame.new(0,0,-v.length)).Position.Magnitude)+(if v.shape=="Ray" then 0 else v.radius)
  else reach=position.Magnitude+(if v.shape=="Box" then Vector3.new(v.width,v.height,v.depth).Magnitude/2 elseif v.shape=="Capsule" then v.height/2 else v.radius) end
  if reach&gt;v.maxReach then return false,"Move "..v.name.." exceeds its allowed reach. Include its offset and size." end
 end return true
end
function C.Validate(values,links)
 if type(values)~="table" then return false,"Choose connection settings first." end
 local copied,c=pcall(C.Normalize,values) if not copied then return false,"Settings must be plain data without cycles." end links=links or {}
 local defaults=C.Default() for key in c do if defaults[key]==nil then return false,"Unknown setting: "..tostring(key) end end
 for key,choices in {actors={"Players","PlayersAndFolder","Folder","Tag","References","Data","PlayersAndData"},positions={"ServerPhysics","Humanoid","Provider"},body={"Box","Sphere","Capsule"},recording={"Heartbeat","Manual","Event"},timing={"Present","MeasuredPing","Provider"},queryMode={"Once","Repeated"},candidates={"Existing","Chrono"},worldMode={"None","StaticBoxes","Provider"},moveSource={"Actions","Builder"}} do if not table.find(choices,c[key]) then return false,"Choose a valid option: "..key end end
 for _,key in {"root","kind","tag","activeAttribute","teamAttribute"} do if type(c[key])~="string" or #c[key]&gt;64 or c[key]:find("%c") then return false,"Use short names: "..key end end
 if c.root=="" or c.kind=="" or c.kind:find("[%s,]") or (c.actors=="Tag" and c.tag=="") then return false,"Root/kind/tag names are incomplete." end
 for key,b in {width={0.02,512},height={0.02,512},depth={0.02,512},radius={0.01,32},walk={0,200},jump={0,250},ground={0.5,20},burst={0.05,1},slack={0,10},verticalSlack={0,15},wallRadius={0.1,3},recordRate={1,240},historySeconds={0.05,10},maxGap={0.001,1},maxRewind={0,10},displayDelay={0,10},recordMaxSpeed={0,4096},recordMaxRadius={0.001,512},queryInterval={1/240,1},maxObstacles={1,4096}} do if not number(c[key],b[1],b[2]) then return false,"Choose a valid number for "..key end end
 if c.maxObstacles%1~=0 then return false,"Obstacle count must be a whole number." end
 if c.maxRewind&gt;c.historySeconds or c.displayDelay&gt;c.maxRewind then return false,"Lookback must fit saved history; view delay must fit lookback." end
 if c.timing~="Present" and (c.maxRewind&lt;=0 or c.candidates~="Chrono") then return false,"Earlier checks need a positive lookback and targets from Chrono contacts, not a present-part target list." end
 if c.body=="Capsule" and c.height&lt;c.radius*2 then return false,"Target capsule height must be at least twice its radius." end
 for _,key in {"correction","autoQuery","guide","partBodies","objectLimits","legacyLimits"} do if type(c[key])~="boolean" then return false,"Choose on/off: "..key end end
 for key,required in {Provider=c.positions=="Provider" and c.actors~="Data",Registry=false,Clock=false,Timing=c.timing=="Provider",World=c.worldMode=="Provider"} do
  local v=links[key] if required and not v then return false,"Select the "..key.." server ModuleScript." end
  if v and (typeof(v)~="Instance" or not v:IsA("ModuleScript") or not v:IsDescendantOf(game)) then return false,key.." must be a ModuleScript in this place." end
 end
 if table.find({"Folder","References","PlayersAndFolder"},c.actors) then
  local v=links.Actors if typeof(v)~="Instance" or not (v:IsA("Folder") or v:IsA("Model") or (c.actors~="Folder" and v:IsA("BasePart"))) or not v:IsDescendantOf(workspace) then return false,"Select participating Workspace objects." end
 end
 if c.worldMode=="StaticBoxes" then local v=links.Obstacles if typeof(v)~="Instance" or not (v:IsA("Folder") or v:IsA("Model")) or not v:IsDescendantOf(workspace) then return false,"Select the folder/model of anchored obstacles." end end
 for _,key in {"Begin","Query","Cancel","Outcome","Capture"} do local v=links[key] if v and (typeof(v)~="Instance" or not v:IsA("BindableEvent") or not v:IsDescendantOf(game)) then return false,key..": choose a server BindableEvent, never a RemoteEvent." end end
 if c.recording=="Event" and not links.Capture then return false,"Select the completed-simulation recording event." end
 if c.autoQuery and not links.Outcome then return false,"Automatic checks need your Outcome event." end
 for _,key in {"zones","moves","kindLimits"} do
  if type(c[key])~="table" or #c[key]&gt;32 then return false,"Use at most 32 entries: "..key end
  local n=0 for index in c[key] do if type(index)~="number" or index%1~=0 or index&lt;1 or index&gt;#c[key] then return false,"Use a continuous list: "..key end n+=1 end
  if n~=#c[key] then return false,"Use a continuous list: "..key end
 end
 for _,key in {"zones","moves"} do local seen={} for _,v in c[key] do local ok,why=C.CheckVolume(v,key=="moves") if not ok then return false,why end if seen[v.name] then return false,"Duplicate name: "..v.name end seen[v.name]=true end end
 if c.moveSource=="Builder" and #c.moves==0 then return false,"Add a move on the Moves page." end
 if c.moveSource=="Builder" and c.worldMode=="None" then for _,v in c.moves do if v.world then return false,"Choose an obstacle provider on Timing for move "..v.name end end end
 local kinds={} for _,v in c.kindLimits do if type(v)~="table" or not name(v.kind) or kinds[v.kind] or not number(v.maxSpeed,0,4096) or not number(v.maxRadius,0.001,512) then return false,"Review each kind's unique name and recording limits." end kinds[v.kind]=true end
 return true
end
function C.Source() return 'return game:GetService("HttpService"):JSONDecode(script.Parent.ConnectionData.Value)\n' end
return table.freeze(C)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF25"><Properties><string name="Name">Guide.client</string><ProtectedString name="Source">-- Optional Studio-only guide. No gameplay keys, remotes or live-game debug access.
if not game:GetService("RunService"):IsStudio() then return end
local reports=game.ReplicatedStorage:WaitForChild("_ChronoConnectionReports",15)
if not reports then return end
local report=reports:WaitForChild(script:GetAttribute("ConnectionName"),15)
if not report then return end
local gui=Instance.new("ScreenGui") gui.Name="ChronoConnectionGuide" gui.ResetOnSpawn=false
gui.Parent=game.Players.LocalPlayer:WaitForChild("PlayerGui")
local toggle=Instance.new("TextButton") toggle.Name="Toggle" toggle.AnchorPoint=Vector2.new(1,0)
toggle.Position=UDim2.new(1,-18,0,20) toggle.Size=UDim2.fromOffset(260,36)
toggle.BackgroundColor3=Color3.fromRGB(27,54,61) toggle.TextColor3=Color3.fromRGB(207,255,234)
toggle.Font=Enum.Font.GothamMedium toggle.TextSize=14 toggle.Text="Chrono connections | Studio" toggle.Parent=gui
local panel=Instance.new("ScrollingFrame") panel.Name="Report" panel.AnchorPoint=Vector2.new(1,0)
panel.Position=UDim2.new(1,-18,0,62) panel.Size=UDim2.new(1,-36,0.7,0)
panel.BackgroundColor3=Color3.fromRGB(17,23,32) panel.ScrollBarThickness=4 panel.BorderSizePixel=0
panel.AutomaticCanvasSize=Enum.AutomaticSize.Y panel.CanvasSize=UDim2.new() panel.Visible=false panel.Parent=gui
local bounds=Instance.new("UISizeConstraint") bounds.MaxSize=Vector2.new(360,420) bounds.Parent=panel
local body=Instance.new("TextLabel") body.Name="Details" body.Size=UDim2.new(1,-8,0,0) body.AutomaticSize=Enum.AutomaticSize.Y
body.BackgroundTransparency=1 body.TextColor3=Color3.fromRGB(237,242,249) body.Font=Enum.Font.Gotham body.TextSize=14
body.TextWrapped=true body.TextXAlignment=Enum.TextXAlignment.Left body.TextYAlignment=Enum.TextYAlignment.Top body.Parent=panel
local padding=Instance.new("UIPadding") padding.PaddingLeft=UDim.new(0,14) padding.PaddingRight=UDim.new(0,14)
padding.PaddingTop=UDim.new(0,14) padding.PaddingBottom=UDim.new(0,14) padding.Parent=panel
local meanings={ready_for_moves="Positions are available. Waiting for an accepted attack.",
 client_owned_position_needs_checker="These parts are moved by a player. Choose a position checker in the plugin.",
 movement_speed="Movement exceeded the configured distance budget.",movement_wall="The root crossed solid geometry.",
 position_provider_required="Choose your existing position-checking module.",
 contact_check_completed="A contact check finished. An empty result is a miss.",
 move_started="An accepted move was recorded. Waiting for its hit period."}
local function update()
	local ok,r=pcall(game.HttpService.JSONDecode,game.HttpService,report.Value) if not ok then return end
	local s=r.stats
 body.Text=string.format("%s\n\nObjects connected: %d\nPosition updates: %d\nMoves started: %d\nContact checks: %d\nContacts found: %d\nOutcomes permitted: %d\nRefusals: %d   Corrections: %d\n\n%s\n\nCounters describe connections, not successful damage.",
 script:GetAttribute("ConnectionName"),r.actors,s.captures,s.begun,s.queries,s.contacts,s.applied,s.refused,s.corrections,meanings[s.reason] or s.reason)
 body.Text..=string.format("\n\nTiming: %s\nLatest approved delay: %.1f ms / %.1f ms maximum\nRecording: %s\nCheck mode: %s\nObstacles: %s",r.timing or "Present",(r.rewind or 0)*1000,(r.maxRewind or 0)*1000,r.recording or "Heartbeat",r.queryMode or "Once",r.world or "None")
 if r.explanation and r.explanation.known then body.Text..="\n\n"..r.explanation.title.."\n"..r.explanation.meaning.."\nNext: "..r.explanation.fix end
end
toggle.Activated:Connect(function() panel.Visible=not panel.Visible update() end)
report.Changed:Connect(update) update()
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF26"><Properties><string name="Name">Hooks</string><ProtectedString name="Source">-- CUSTOMIZE WITHIN THE PACKAGE. Ordinary games can use these defaults.
-- These functions run on the server. Never connect an unvalidated client request directly to Begin.
local H={}
function H.State(object,root,settings)
	local player=if object:IsA("Model") then game:GetService("Players"):GetPlayerFromCharacter(object) else nil
	local humanoid=object:FindFirstChildOfClass("Humanoid")
	local active=not humanoid or humanoid.Health&gt;0
	if settings.activeAttribute~="" then active=active and object:GetAttribute(settings.activeAttribute)==true end
	local team=if settings.teamAttribute~="" then object:GetAttribute(settings.teamAttribute) else (player and player.Team and player.Team.Name or nil)
	return {active=active,team=team}
end
-- Existing server code must already have checked cooldown, stamina, equipment and request ownership.
function H.CanStart(object,actionName,context,state) return state.active==true end
function H.CanApply(source,target,actionName,context,contact) return true end
-- Optional additional outcome function. Normally choose an existing Outcome BindableEvent instead.
function H.OnContact(source,target,actionName,context,contact) end
-- Match DIFFERENT existing server-event argument orders here, rather than rewriting the game.
function H.ReadBegin(source,actionName,key,context) return source,actionName,key,context end
function H.ReadQuery(source,key) return source,key end
function H.ReadCancel(source,key) return source,key end
function H.ApplyOutcome(event,source,target,actionName,context,contact)
	event:Fire(source,target,actionName,context,contact)
end
-- Override here for a game's existing slow/stun/dash rules. Values must come from server rules.
function H.MovementLimits(object,settings) return settings.walk,settings.jump end
function H.AfterCorrection(object,reason) end
-- Adapt a DIFFERENT existing checker API here, inside the supplied package.
function H.ProviderSnapshot(provider,object,time)
	if type(provider)=="function" then return provider(object,time) end
	return provider.Snapshot(object,time)
end
-- Providers are selected in the plugin. Adapt a game's API HERE, inside this package.
-- Every provider callback must finish immediately: no waits or network requests.
function H.Clock(provider) return if type(provider)=="function" then provider() else provider.Now() end
function H.DataSnapshots(provider,time) return provider.Snapshots(time) end
function H.ResolveRewind(provider,actor,context,time,maximum)
	return provider.Resolve(actor,context,time,maximum)
end
function H.WorldCheck(provider,time,current,shape) return provider.Check(time,current,shape) end
function H.TimingPlayer(actor,context)
	return if typeof(actor)=="Instance" and actor:IsA("Model") then game.Players:GetPlayerFromCharacter(actor) else nil
end
-- Maximum root travel per second and distance of any target hitbox from that root.
-- These reject unusable records; they do not prove movement was permitted by game rules.
function H.RecordingLimits(actor,speed,radius,settings) return speed,radius end
-- Used only by a move whose rule is "Hook". Supply your game rule here.
function H.Eligible(sourceState,targetState,targetId,targetKind,moveName) return false end
-- Optional custom snapshot: use the selected Provider module for existing checked position systems.
-- Provider.Snapshot(object, time) must return {ok=true, root=CFrame, zones={...}, state={...}}.
-- 'ok=true' is a declaration by that checker, not an extra check performed by Chrono.
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF27"><Properties><string name="Name">Messages</string><ProtectedString name="Source">-- Extra Connector explanations; Core's existing help and reason codes stay unchanged.
local M={}
M.Messages={
 capture_required={"Save the first update","No common position update is available.","Manual/Event recording: save all participating objects after their simulation step, before accepting moves."},
 capture_stale={"Saved positions are too old","The latest update is older than the allowed record gap.","Resume recording; do not replace missing evidence with current client data."},
 invalid_capture_time={"Recording time is outside the allowed range","The timestamp is invalid, in the future, or too far behind the selected clock.","Use seconds from the same server clock for simulation, providers and Capture."},
 non_monotonic={"Recording time did not advance","A timestamp was equal to or older than the previous recording.","Record once per completed simulation step, with strictly increasing times."},
 move_already_checked={"This move already used its check","Once mode allows one successful contact query.","For a continuous active window select Repeated. Target limits still apply to the whole move."},
 duplicate_query={"No new position update","This move was already checked at the latest recorded instant.","Wait for a newer Capture before checking this repeated move again."},
 rewind_rejected={"Earlier-time request refused","The timing provider failed or returned a delay outside the configured maximum.","Check the server timing rule, shared clock and saved-history range. Raw client timestamps need independent validation."},
 timing_player_required={"Choose the player for this object","Measured-ping timing could not identify a connected Player.","For data-only objects, map the object to its owner inside Hooks.TimingPlayer, or use a timing provider."},
 world_unknown={"Obstacle coverage is unknown","The obstacle provider cannot prove what blocked this query time.","Check the selected folder/provider, anchored bounds and changes since the requested time. Do not assume missing cover was clear."},
 provider_has_not_approved_position={"Position has not been approved","The selected provider did not return ok=true.","Connect a server calculation/checker inside the supplied provider module. Reading a player-owned Part alone is not a movement check."},
 client_owned_position_needs_checker={"Player-controlled position needs checking","Server-physics mode found an object whose physics a player controls.","Select a suitable position checker. Do not change its trust label to bypass this refusal."},
 position_function_error={"Position callback failed","A data function errored, yielded or reentered Connector.","Fix the supplied provider or Hooks, then reset the affected object with Discontinuity/Resume before recording again."},
 contact_result_stale={"Contact result expired","Too much time passed between finding a contact and applying its result.","Apply within the permitted record gap and recheck current game rules."},
 contact_records_changed={"Position records changed","An object was reset, replaced, added or removed after the contact check.","Start a fresh accepted move after the required records are available."},
 waiting_for_capture={"Waiting for your simulation update","Manual/Event mode does not record automatically.","Call Capture after completing a common simulation step, or fire the selected recording event."},
 action_spent={"Move reached its target limit","This move has already returned the allowed total number of different targets.","Finish it. Repeated checks never reset the whole-move target limit."},
 ready_for_moves={"Ready for accepted moves","Position records are available.","Link the accepted move, its hit moment and cancellation; inspect actual outcomes in Play."},
 contact_check_completed={"Contact check completed","The query had usable evidence. An empty contact list means a miss.","Use the returned targets and keep current game outcome rules in charge."},
}
function M.Explain(code)
 code=if type(code)=="table" then code.reason else code
 local row=M.Messages[code] if not row then return nil end
 return {known=true,code=code,title=row[1],meaning=row[2],fix=row[3]}
end
return M

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF28"><Properties><string name="Name">Movement</string><ProtectedString name="Source">-- Optional bounded humanoid checker. No combat tags, damage values or game-specific moves.
-- Checks roots on ordinary static ground. Vehicles, moving platforms and custom physics need a provider.
local M={}
local function valid(frame)
	if typeof(frame)~="CFrame" then return false end
	for _,n in {frame:GetComponents()} do if n~=n or math.abs(n)==math.huge then return false end end
	return true
end
function M.New(object,root,now,c)
	assert(valid(root.CFrame),"Spawn position is invalid")
	return {object=object,root=root,frame=root.CFrame,time=now,credit=c.walk*c.burst+c.slack,
		vertical=c.jump*c.burst+c.verticalSlack,airStart=now,airY=root.Position.Y,
		impulse=Vector3.zero,untilTime=0,blockedUntil=0}
end
function M.Allow(r,velocity,seconds,now)
	assert(typeof(velocity)=="Vector3" and velocity.Magnitude==velocity.Magnitude and velocity.Magnitude&lt;=2000,"Use a finite server-approved velocity up to 2000 studs/second")
	assert(type(seconds)=="number" and seconds&gt;=0 and seconds&lt;=5,"Motion permission lasts 0 to 5 seconds")
	r.impulse=velocity r.untilTime=now+seconds+0.35
end
function M.Reset(r,frame,now,c)
	assert(valid(frame),"Approved teleport needs a finite CFrame")
	local root=r.root
	if r.object:IsA("Model") then r.object:PivotTo(frame*root.CFrame:Inverse()*r.object:GetPivot()) else root.CFrame=frame end
	root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
	r.frame=frame r.time=now r.credit=c.walk*c.burst+c.slack r.vertical=c.jump*c.burst+c.verticalSlack
	r.airStart=now r.airY=frame.Position.Y r.blockedUntil=0 r.untilTime=0 r.impulse=Vector3.zero
end
function M.Check(r,now,c,hooks,excluded)
	local root=r.root local proposed=root.CFrame
	local function refuse(reason)
		r.blockedUntil=now+0.35
		if c.correction then
			if valid(proposed) then
				if r.object:IsA("Model") then r.object:PivotTo(r.frame*proposed:Inverse()*r.object:GetPivot()) else root.CFrame=r.frame end
			else root.CFrame=r.frame end
			root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		end
		r.time=now r.credit=0 r.vertical=0
		return nil,reason,c.correction
	end
	if not valid(proposed) then return refuse("movement_invalid") end
	local walk,jump=hooks.MovementLimits(r.object,c)
	if type(walk)~="number" or walk~=walk or walk&lt;0 or walk&gt;200 or type(jump)~="number" or jump~=jump or jump&lt;0 or jump&gt;250 then return refuse("movement_limits_invalid") end
	local dt=math.max(0,now-r.time)
	local extra=if now&lt;=r.untilTime then r.impulse else Vector3.zero
	local speed=walk+Vector3.new(extra.X,0,extra.Z).Magnitude
	r.credit=math.min(speed*c.burst+c.slack,r.credit+speed*dt)
	local delta=proposed.Position-r.frame.Position
	local horizontal=Vector3.new(delta.X,0,delta.Z).Magnitude
	if horizontal&gt;r.credit+1e-4 then return refuse("movement_speed") end
	local ray=RaycastParams.new() ray.FilterType=Enum.RaycastFilterType.Exclude ray.FilterDescendantsInstances=excluded
	ray.RespectCanCollide=true ray.CollisionGroup=root.CollisionGroup
	local hit=workspace:Raycast(proposed.Position,Vector3.new(0,-c.ground-0.5,0),ray)
	local onGround=hit and hit.Normal.Y&gt;0.5
	local gravity=workspace.Gravity
	local age=math.max(0,now-r.airStart)
	local launch=jump+math.max(0,extra.Y)
	local verticalSpeed=math.min(2000,launch+gravity*age+math.abs(extra.Y))
	r.vertical=math.min(verticalSpeed*c.burst+c.verticalSlack,r.vertical+verticalSpeed*dt)
	if math.abs(delta.Y)&gt;r.vertical+1e-4 then return refuse("movement_vertical") end
	if not onGround and gravity&gt;0 then
		local t=math.clamp(launch/gravity,math.max(0,age-0.3),age+0.3)
		if proposed.Position.Y&gt;r.airY+launch*t-0.5*gravity*t*t+c.verticalSlack then return refuse("movement_air") end
	end
	if delta.Magnitude&gt;0.01 and delta.Magnitude&lt;1000 then
		for _,height in {-c.ground*0.4,0,c.ground*0.4} do
			local wall=workspace:Spherecast(r.frame.Position+Vector3.new(0,height,0),c.wallRadius,delta,ray)
			if wall and wall.Distance&lt;delta.Magnitude-0.18 then return refuse("movement_wall") end
		end
	end
	if onGround then r.airStart=now r.airY=proposed.Position.Y end
	r.credit=math.max(0,r.credit-horizontal) r.vertical=math.max(0,r.vertical-math.abs(delta.Y))
	r.frame=proposed r.time=now
	if now&lt;r.blockedUntil then return nil,"movement_settling",false end
	return proposed
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF29"><Properties><string name="Name">Volumes</string><ProtectedString name="Source">-- Declarative shapes use unchanged Core math.
local V={}
function V.Shape(S,v)
 local f=CFrame.new(v.x,v.y,v.z)*CFrame.Angles(math.rad(v.pitch),math.rad(v.yaw),math.rad(v.roll))
 if v.shape=="Box" then return S.Box(f,Vector3.new(v.width,v.height,v.depth))
 elseif v.shape=="Sphere" then return S.Sphere(f,v.radius)
 elseif v.shape=="Capsule" then return S.Capsule(f,v.radius,v.height)
 else return S.Sweep(f.Position,(f*CFrame.new(0,0,-v.length)).Position,if v.shape=="Ray" then 0 else v.radius) end
end
function V.Zones(S,rows,root) local out={} for _,v in rows do out[v.name]=S.At(V.Shape(S,v),root) end return out end
function V.Actions(S,rows,hooks)
 local out={}
 for _,v in rows do
  local kinds={} for k in v.targets:gmatch("[^,%s]+") do table.insert(kinds,k) end
  local shape=V.Shape(S,v) assert(S.Reach(shape)&lt;=v.maxReach,"Move "..v.name.." exceeds allowed reach")
  out[v.name]={shape=shape,targets=kinds,opens=v.opens,closes=v.closes,maxTargets=v.maxTargets,maxReach=v.maxReach,world=v.world,queryMode=if v.queryMode~="Default" then v.queryMode else nil,
   eligible=function(a,b,id,kind)
    if v.rule=="team" then return a.active==true and b.active==true and a.team~=nil and b.team~=nil and a.team~=b.team end
    if v.rule=="Hook" then return hooks.Eligible(a,b,id,kind,v.name) end return true
   end}
 end return out
end
return V
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF30"><Properties><string name="Name">World</string><ProtectedString name="Source">-- Conservative static obstacle scope. Irregular objects use bounding boxes.
-- Does not reconstruct terrain/moving walls; select a historical provider for those.
local W={}
function W.Capture(previous,folder,time,limit,S)
 if not folder or not folder:IsDescendantOf(workspace) then return nil,"obstacle_folder_missing" end
 local rows={} local count=0
 for _,p in folder:GetDescendants() do
  if p:IsA("BasePart") and p.CanQuery and p.CanCollide then
   count+=1 if count&gt;limit then return nil,"obstacle_limit" end
   if not p.Anchored then return nil,"static_obstacle_not_anchored" end
   local ok,shape=pcall(S.Box,p.CFrame,p.Size) if not ok then return nil,"obstacle_shape_out_of_bounds" end
   rows[p]={frame=p.CFrame,size=p.Size,group=p.CollisionGroup,shape=shape}
  end
 end
 local changed=not previous
 if previous then
  for p,row in rows do local old=previous.rows[p] if not old or row.frame~=old.frame or row.size~=old.size or row.group~=old.group then changed=true break end end
  for p in previous.rows do if not rows[p] then changed=true break end end
 end
 return {rows=rows,boundary=if changed then time else previous.boundary,count=count}
end
function W.Check(record,time,query,S)
 if not record or time&lt;record.boundary then return {covered=false} end
 local first
 for _,row in record.rows do local f=S.Intersect(query,row.shape) if f and (not first or f&lt;first) then first=f end end
 return {covered=true,blocked=first~=nil,fraction=first or 1}
end
return W
</ProtectedString></Properties></Item></Item></Item></roblox>