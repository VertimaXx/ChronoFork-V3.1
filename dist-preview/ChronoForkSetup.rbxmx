}

export type MODEL_REPLICATION_MODE = "NATIVE" | "NATIVE_WITH_LOCK" | "CUSTOM"

export type INTERPOLATION_MODE = "CFRAME" | "ALIGN" | "NONE"

export type AlignDriver = {
	part: BasePart,
