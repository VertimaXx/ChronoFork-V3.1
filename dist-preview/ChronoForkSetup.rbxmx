<roblox version="4"><Item class="Script" referent="CF0"><Properties><string name="Name">ChronoForkSetup</string><ProtectedString name="Source">assert(plugin,"Save the complete setup Script as a local Studio plugin")
local toolbar=plugin:CreateToolbar("ChronoFork")
local setup=toolbar:CreateButton("ChronoSetup","Full movement replication setup and explained settings","")
local contact=toolbar:CreateButton("ChronoConnect","Competitive contact setup and game connections","")
setup.ClickableWhenViewportHidden=true contact.ClickableWhenViewportHidden=true
local info=DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right,false,false,510,810,370,500)
local runtimeWidget=plugin:CreateDockWidgetPluginGuiAsync("ChronoForkFull-3.3-preview",info) runtimeWidget.Title="ChronoFork · movement and networking"
local contactWidget=plugin:CreateDockWidgetPluginGuiAsync("ChronoForkContact-3.3-preview",info) contactWidget.Title="ChronoFork · competitive contacts"
local connectionView=require(script.ContactEditor.View).Mount(contactWidget,{core=script.Core,runtime=script.Runtime,
	onInstalled=function(object)game:GetService("Selection"):Set({object})end,
	openScript=function(object)game:GetService("Selection"):Set({object}) if object:IsA("LuaSourceContainer") then game:GetService("ScriptEditorService"):OpenScriptDocumentAsync(object) end end})
local view=require(script.Editor.View).Mount(runtimeWidget,script.ChronoFork,function()contactWidget.Enabled=true end)
setup.Click:Connect(function()runtimeWidget.Enabled=not runtimeWidget.Enabled end)
contact.Click:Connect(function()contactWidget.Enabled=not contactWidget.Enabled connectionView.Go(6)end)
plugin.Unloading:Connect(function()view.Destroy() connectionView.Destroy() runtimeWidget:Destroy() contactWidget:Destroy()end)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF1"><Properties><string name="Name">ChronoFork</string><ProtectedString name="Source">-- Full-runtime development package. Contact Core 3.1 remains an independent service.
-- Requiring this module does not start movement replication.
require(script:WaitForChild("Await",30)).Ready(script)
local Core=require(script.Core)
local Types=require(script.Replication.Shared.Types)
export type Entity=Types.Entity
export type EntityConfig=Types.EntityConfig
export type EntityConfigInput=Types.EntityConfigInput
export type MODEL_REPLICATION_MODE=Types.MODEL_REPLICATION_MODE
export type SnapshotData&lt;V,T&gt; = Types.SnapshotData&lt;V,T&gt;
export type Snapshot&lt;V,T&gt; = Types.Snapshot&lt;V,T&gt;
export type Ticker=Types.Ticker
export type ClientClock=Types.ClientClock
export type InterpolationBuffer=Types.InterpolationBuffer
export type PlayerEntityHolder=Types.PlayerEntityHolder
export type Connection=Types.Connection
export type Event&lt;F,T...&gt; = Types.Event&lt;F,T...&gt;
export type Signal&lt;F,T...&gt; = Types.Signal&lt;F,T...&gt;
export type ReplicationRule=Types.ReplicationRule
export type EntityReceivePacket=Types.EntityReceivePacket
export type ClientEntitiesStats=Types.ClientEntitiesStats
export type ServerEntitiesStats=Types.ServerEntitiesStats
local F={Version="3.3.0-dev",CoreVersion=Core.Version,WireVersion=2,Shapes=Core.Shapes,new=Core.new,Explain=Core.Explain}
local replication
local function original()
	if not replication then replication=require(script.Replication) end
	return replication
end
function F.Start(config)
	assert(script:GetAttribute("ChronoForkRuntimeMode")~="Engine","This package uses the engine simulation adapter; do not start a second movement driver")
	local ok,authority=pcall(function() return workspace.AuthorityMode end)
	assert(not ok or authority~=Enum.AuthorityMode.Server,
		"This place uses Roblox server authority. Use Competitive.Simulation.Bind for its simulation; do not also start custom CFrame replication.")
	return original().Start(config)
end
function F.IsStarted() return replication~=nil and replication.IsStarted() end
function F.GetStartupState() return if replication then replication.GetStartupState() else "idle" end
F.Competitive=require(script.Competitive)
F.Experimental=table.freeze({Prediction=require(script.Replication.Shared.ExperimentalPrediction)})
-- Public original APIs and paths are retained in Replication. Existing Core calls
-- remain available through new/Shapes/Explain and the explicit Core child.
return setmetatable(F,{__index=function(_,key) return original()[key] end})
</ProtectedString></Properties><Item class="ModuleScript" referent="CF2"><Properties><string name="Name">Core</string><ProtectedString name="Source">--!strict
-- Chrono V3: server historical contact evidence. No automatic gameplay/network side effects.
local Guard=require(script.Guard)
local Contract=require(script.Contract)
local History=require(script.History)
local Shapes=require(script.Shapes)
local Types=require(script.Types)
local API={Shapes=Shapes,Version="3.1.0"}
-- Optional explanation helper. It never changes the result or runs a hit check.
function API.Explain(reason: (string | {reason: string})?): Types.Explanation return require(script.Help).Explain(reason) end
local Methods={} Methods.__index=Methods
local private=setmetatable({}, {__mode="k"})
local function session(self)
	local s=assert(private[self],"This Chrono instance was destroyed, or the call used the wrong object.")
	assert(not s.inCallback,"Do not call Chrono again from inside a position or rule function. Return its data first.")
	return s
end
local function call(s,callback,...)
	s.inCallback=true
	local out=table.pack(Contract.Call(callback,...))
	s.inCallback=false
	return table.unpack(out,1,out.n)
end
local function bounded(n,lo,hi) return Guard.Number(n) and n&gt;=lo and n&lt;=hi end
local function name(n) return type(n)=="string" and #n&gt;0 and #n&lt;=64 end
local function frozenResult(ok,reason,fields)
	local out=fields or {} out.ok=ok out.reason=reason
	if not out.contacts then out.contacts=table.freeze({}) end
	return table.freeze(out)
end
local function failure(s,reason,fields)
	s.stats.rejected+=1 s.stats.lastRejection=reason
	return frozenResult(false,reason,fields)
end
local function fresh(s)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return nil,"clock_fault" end
	if not s.time then return nil,"capture_required" end
	if now&lt;s.time-1e-6 then return nil,"clock_reversed" end
	if now-s.time&gt;s.maxGap then return nil,"capture_stale" end
	return now
end
function API.new(options: Types.Options?): Types.Service
	assert(game:GetService("RunService"):IsServer(),"Chrono V3 runs on the server")
	local o=options or {}
	local seconds,rate,gap=o.seconds or 0.6,o.rate or 60,o.maxGap or 0.075
	assert(bounded(seconds,0.05,10) and bounded(rate,1,240) and bounded(gap,0.001,1),"Use seconds=0.05 to 10, rate=1 to 240, and maxGap=0.001 to 1. These control saved-position storage.")
	assert(bounded(o.maxRewind or 0,0,seconds),"maxRewind must be zero or a positive number no greater than seconds (the time you keep past positions).")
	assert(o.clock==nil or type(o.clock)=="function","clock must be a function that returns server time in seconds, or leave it unset.")
	assert(o.resolveRewind==nil or type(o.resolveRewind)=="function","resolveRewind must be a function that returns an approved earlier-time delay, or leave it unset.")
	assert(o.world==nil or type(o.world)=="function","world must be an obstacle-check function, or leave it unset.")
	local self=setmetatable({},Methods)
	private[self]={clock=o.clock or function() return workspace:GetServerTimeNow() end,
		seconds=seconds,capacity=math.ceil(rate*seconds)+2,maxGap=gap,maxRewind=o.maxRewind or 0,
		resolveRewind=o.resolveRewind,world=o.world,actors={},actions={},actionCount=0,roster=0,
		stats={captures=0,queries=0,accepted=0,rejected=0,contacts=0,providerFaults=0,lastRejection="none"}}
	return self :: any -- Public method types help Studio autocomplete; checks above still run.
end
function Methods:Track(id,binding)
	local s=session(self)
	assert(name(id) and type(binding)=="table" and name(binding.kind),"Track needs short text id and kind names. Example: id='player-12', kind='player'.")
	assert(not s.actors[id],"This id is already tracked. Call Untrack before deliberately registering a replacement.")
	assert(type(binding.capture)=="function","Track needs capture=function(time) ... end to supply the object's position, hitboxes and game values.")
	assert(bounded(binding.maxSpeed,0,4096) and bounded(binding.maxRadius,0.001,512),"Set maxSpeed from 0 to 4096 studs/second and maxRadius from 0.001 to 512 studs. They must describe your allowed movement and hitbox extent.")
	local trust=binding.trust or "unverified"
	assert(trust=="unverified" or trust=="serverValidated" or trust=="serverSimulated","Use trust='unverified', 'serverValidated' or 'serverSimulated'. Choose a trusted label only after your server actually checks or calculates the data.")
	local count=0 for _ in s.actors do count+=1 end assert(count&lt;256,"This instance already tracks 256 objects. Remove objects no longer needed before adding another.")
	s.actors[id]={id=id,kind=binding.kind,capture=binding.capture,trust=trust,status="awaiting_capture",faults=0,
		history=History.new({seconds=s.seconds,capacity=s.capacity,maxGap=s.maxGap,maxSpeed=binding.maxSpeed,maxRadius=binding.maxRadius})}
	s.roster+=1
end
function Methods:Untrack(id)
	local s=session(self) if not s.actors[id] then return false end
	s.actors[id]=nil s.roster+=1 return true
end
function Methods:Discontinuity(id,reason)
	local s=session(self) local actor=assert(s.actors[id],"actor not tracked")
	local ok,now=call(s,s.clock) assert(ok and Guard.Number(now),"clock fault")
	actor.history:Break(math.max(now,s.time or now)) actor.status=reason or "discontinuity" actor.quarantined=false
end
-- Invoke after your authoritative simulation. All providers must describe the same instant.
-- An optional timestamp supports a fixed-step server simulation using this clock domain.
function Methods:Capture(time)
	local s=session(self)
	local ok,now=call(s,s.clock)
	if not ok or not Guard.Number(now) then return frozenResult(false,"clock_fault") end
	time=time or now
	if not Guard.Number(time) or time&gt;now+1e-6 or now-time&gt;s.maxGap then return frozenResult(false,"invalid_capture_time") end
	if s.time and time&lt;=s.time then return frozenResult(false,"non_monotonic") end
	s.time=time s.stats.captures+=1
	local faults={}
	for id,actor in s.actors do
		if actor.quarantined then table.insert(faults,table.freeze({id=id,reason="quarantined"})) continue end
		local called,snapshot=call(s,actor.capture,time)
		local pushed,reason=false,"provider_fault"
		if called then
			-- Validation itself can encounter an erroneous table metamethod from an adapter.
			local validated,accepted,why=call(s,function() return actor.history:Push(time,snapshot) end)
			pushed=validated and accepted==true
			reason=if validated then why else "invalid_snapshot"
		end
		if not pushed then
			actor.history:Break(time) actor.faults+=1 s.stats.providerFaults+=1
			actor.status=reason actor.quarantined=true table.insert(faults,table.freeze({id=id,reason=reason}))
		else actor.status="captured" end
	end
	for token,action in s.actions do
		if time&gt;action.started+action.close or action.roster~=s.roster then s.actions[token]=nil s.actionCount-=1 end
	end
	return frozenResult(#faults==0,if #faults==0 then "captured" else "capture_fault",{time=time,faults=table.freeze(faults)})
end
-- Call only after your existing server move/action service authorizes the action.
-- No client-facing RemoteEvent is created. Context is consumed only by YOUR timing resolver.
function Methods:BeginAction(actorId,profile,approvedContext)
	local s=session(self) local now,err=fresh(s)
	if not now then return nil,err end
	local actor=s.actors[actorId] if not actor then return nil,"actor_missing" end
	if actor.trust=="unverified" then return nil,"unverified_source" end
	if type(profile)~="table" then return nil,"invalid_profile" end
	local shape=Shapes.Copy(profile.shape)
	local opening,closing=profile.opens or 0,profile.closes or 0.25
	if not shape or not bounded(opening,0,10) or not bounded(closing,opening,10)
		or not bounded(profile.maxReach or 32,0,4096) or Shapes.Reach(shape)&gt;(profile.maxReach or 32)
		or not Guard.Integer(profile.maxTargets or 1,1,256) then return nil,"invalid_profile" end
	if profile.eligible~=nil and type(profile.eligible)~="function" then return nil,"invalid_profile" end
	if profile.world~=nil and type(profile.world)~="boolean" then return nil,"invalid_profile" end
	if profile.world and (not s.world or shape.kind~="sweep") then return nil,"world_provider_or_shape" end
	if type(profile.targets)~="table" then return nil,"target_kinds_required" end
	local kinds,count={},0
	for _,kind in profile.targets do
		if not name(kind) then return nil,"invalid_target_kind" end kinds[kind]=true count+=1
	end
	if count==0 or count&gt;32 then return nil,"target_kinds_required" end
	local rewind=0
	if s.resolveRewind then
		local resolved,value=call(s,s.resolveRewind,actorId,approvedContext,s.time)
		if not resolved or not bounded(value,0,s.maxRewind) then return nil,"rewind_rejected" end rewind=value
	end
	local source,reason=actor.history:Sample(s.time-rewind,now)
	if not source then return nil,"source_"..reason end
	local actorActions=0 for _,a in s.actions do if a.actor==actorId then actorActions+=1 end end
	if s.actionCount&gt;=512 or actorActions&gt;=4 then return nil,"action_capacity" end
	local token=table.freeze({})
	s.actions[token]={actor=actorId,epoch=actor.history.epoch,roster=s.roster,started=s.time,
		open=opening,close=closing,shape=shape,kinds=table.freeze(kinds),eligible=profile.eligible,
		world=profile.world==true,maxTargets=profile.maxTargets or 1,rewind=rewind,hit={},totalHits=0}
	s.actionCount+=1
	return token
end
function Methods:EndAction(token)
	local s=session(self) if not s.actions[token] then return false end
	s.actions[token]=nil s.actionCount-=1 return true
end
function Methods:Query(token)
	local s=session(self) s.stats.queries+=1
	local action=s.actions[token] if not action then return failure(s,"invalid_action") end
	local now,err=fresh(s) if not now then return failure(s,err) end
	if action.roster~=s.roster then return failure(s,"roster_changed") end
	local actor=s.actors[action.actor]
	if not actor or actor.history.epoch~=action.epoch then return failure(s,"source_epoch_changed") end
	local elapsed=s.time-action.started
	if elapsed&lt;action.open then return failure(s,"not_active") end
	if elapsed&gt;action.close then return failure(s,"action_expired") end
	if action.lastTime==s.time then return failure(s,"duplicate_query") end
	if action.totalHits&gt;=action.maxTargets then return failure(s,"action_spent") end
	local time=s.time-action.rewind
	local source,reason=actor.history:Sample(time,now)
	if not source then return failure(s,"source_"..reason) end
	local transformed,query=Contract.Call(Shapes.At,action.shape,source.root)
	if not transformed then return failure(s,"shape_out_of_bounds") end
	local fraction=1 local blocked=false
	if action.world then
		local called,cover=call(s,s.world,time,now,query)
		if not called or type(cover)~="table" or cover.covered~=true or type(cover.blocked)~="boolean"
			or not bounded(cover.fraction,0,1) then return failure(s,"world_unknown") end
		blocked=cover.blocked fraction=if blocked then cover.fraction else 1
	end
	local contacts={}
	for id,target in s.actors do
		if id==action.actor or not action.kinds[target.kind] or action.hit[id] then continue end
		-- A missing target can hide a closer contact. Never return a partial success.
		if target.trust=="unverified" then return failure(s,"unverified_target",{actor=id}) end
		local snapshot,why=target.history:Sample(time,now)
		if not snapshot then return failure(s,"target_"..why,{actor=id}) end
		if action.eligible then
			local called,allowed=call(s,action.eligible,source.state,snapshot.state,id,target.kind)
			if not called or type(allowed)~="boolean" then return failure(s,"rules_fault",{actor=id}) end
			if not allowed then continue end
		end
		local best,zoneName=nil,nil
		for zone,volume in snapshot.zones do
			local t=Shapes.Intersect(query,volume)
			-- Cover wins exact ties. With no cover callback, include sweep endpoint tangency.
			if t and (t&lt;fraction or (not blocked and t&lt;=fraction)) and (not best or t&lt;best or (t==best and zone&lt;zoneName)) then best=t zoneName=zone end
		end
		if best then
			local distance=if query.kind=="sweep" then (query.finish-query.start).Magnitude*best else 0
			table.insert(contacts,table.freeze({id=id,kind=target.kind,zone=zoneName,distance=distance,fraction=best,
				time=time,epoch=snapshot.epoch,state=snapshot.state,root=snapshot.root}))
		end
	end
	table.sort(contacts,function(a,b) if a.fraction~=b.fraction then return a.fraction&lt;b.fraction end return a.id&lt;b.id end)
	while #contacts&gt;action.maxTargets-action.totalHits do table.remove(contacts) end
	-- Commit duplicate suppression only after every relevant provider/rule/world check passed.
	for _,contact in contacts do action.hit[contact.id]=true end
	action.totalHits+=#contacts action.lastTime=s.time
	s.stats.accepted+=1 s.stats.contacts+=#contacts
	return frozenResult(true,"covered",{time=time,capturedAt=s.time,rewind=action.rewind,source=source,
		contacts=table.freeze(contacts),shape=query})
end
function Methods:Inspect()
	local s=session(self) local actors={}
	for id,a in s.actors do
		local row=a.history:Latest()
		table.insert(actors,table.freeze({id=id,kind=a.kind,declaredTrust=a.trust,status=a.status,
			captured=row~=nil,latest=if row then row.time else nil,epoch=a.history.epoch,faults=a.faults}))
	end
	table.sort(actors,function(a,b) return a.id&lt;b.id end)
	return table.freeze({version=API.Version,time=s.time,actors=table.freeze(actors),activeActions=s.actionCount,
		stats=table.freeze(table.clone(s.stats)),worldEnabled=s.world~=nil,maxRewind=s.maxRewind})
end
function Methods:Destroy() session(self) private[self]=nil end
return table.freeze(API)
</ProtectedString></Properties><Item class="ModuleScript" referent="CF3"><Properties><string name="Name">Contract</string><ProtectedString name="Source">--!strict
-- These guards contain yielding adapters. They cannot preempt an infinite CPU loop.
local Guard = require(script.Parent.Guard)
local Contract = {}
function Contract.Call(callback, ...)
	if type(callback) ~= "function" then return false, "callback_missing" end
	local thread = coroutine.create(callback)
	local result = table.pack(coroutine.resume(thread, ...))
	if not result[1] then return false, tostring(result[2]) end
	if coroutine.status(thread) ~= "dead" then
		coroutine.close(thread)
		return false, "callback_yielded"
	end
	return true, table.unpack(result, 2, result.n)
end
function Contract.State(state)
	if type(state) ~= "table" then return nil end
	local result, count = {}, 0
	for key, value in state do
		count += 1
		if count &gt; 32 or type(key) ~= "string" or #key &gt; 64 then return nil end
		if type(value) == "number" then
			if not Guard.Number(value) or math.abs(value) &gt; 1e12 then return nil end
		elseif type(value) == "string" then
			if #value &gt; 128 then return nil end
		elseif type(value) ~= "boolean" then return nil end
		result[key] = value
	end
	return table.freeze(result)
end
function Contract.SameState(a, b)
	for k, v in a do if b[k] ~= v then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end
return table.freeze(Contract)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF4"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
local Guard = require(script.Parent.Guard)
local Geometry = {}
local EPSILON = 1e-9

function Geometry.SegmentDistanceSquared(start: Vector3,finish: Vector3,point: Vector3): number
	local delta=finish-start
	local lengthSquared=delta:Dot(delta)
	local alpha=if lengthSquared&gt;1e-12 then math.clamp((point-start):Dot(delta)/lengthSquared,0,1) else 0
	local offset=point-(start+delta*alpha)
	return offset:Dot(offset)
end

function Geometry.RayOBB(origin: Vector3, direction: Vector3, length: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(origin) or not Guard.Unit(direction) or not Guard.Number(length) or length &lt; 0
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local o, d, half = frame:PointToObjectSpace(origin), frame:VectorToObjectSpace(direction), size * 0.5
	local enter, leave = 0, length
	for _, axis in {"X", "Y", "Z"} do
		local start, delta, extent = o[axis], d[axis], half[axis]
		if math.abs(delta) &lt; EPSILON then
			if math.abs(start) &gt; extent then return nil end
		else
			local a, b = (-extent - start) / delta, (extent - start) / delta
			if a &gt; b then a, b = b, a end
			enter, leave = math.max(enter, a), math.min(leave, b)
			if enter &gt; leave then return nil end
		end
	end
	return enter
end

-- Exact moving sphere vs a stationary OBB, including rounded edges/corners.
-- Split the ray at box-plane crossings; point-to-box distance is quadratic on each interval.
function Geometry.SphereSweepOBB(start: Vector3, finish: Vector3, radius: number, frame: CFrame, size: Vector3): number?
	if not Guard.Vector(start) or not Guard.Vector(finish) or not Guard.Number(radius) or radius &lt; 0 or radius &gt; 32
		or not Guard.Frame(frame) or not Guard.Size(size) then return nil end
	local origin = frame:PointToObjectSpace(start)
	local delta = frame:VectorToObjectSpace(finish - start)
	local half = size * 0.5
	local cuts = {0, 1}
	for _, axis in {"X", "Y", "Z"} do
		if math.abs(delta[axis]) &gt; EPSILON then
			for _, sign in {-1, 1} do
				local t = (sign * half[axis] - origin[axis]) / delta[axis]
				if t &gt; 0 and t &lt; 1 then table.insert(cuts, t) end
			end
		end
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local lower, upper = cuts[i], cuts[i + 1]
		local midpoint = (lower + upper) * 0.5
		local a, b, c = 0, 0, -radius * radius
		for _, axis in {"X", "Y", "Z"} do
			local p = origin[axis] + delta[axis] * midpoint
			if math.abs(p) &gt; half[axis] then
				local offset = origin[axis] - (if p &gt; 0 then half[axis] else -half[axis])
				a += delta[axis] * delta[axis]
				b += 2 * delta[axis] * offset
				c += offset * offset
			end
		end
		if (a * lower + b) * lower + c &lt;= EPSILON then return lower end
		if a &gt; EPSILON then
			local discriminant = b * b - 4 * a * c
			if discriminant &gt;= -EPSILON then
				local root = (-b - math.sqrt(math.max(discriminant, 0))) / (2 * a)
				if root &gt;= lower - EPSILON and root &lt;= upper + EPSILON then return math.clamp(root, lower, upper) end
			end
		end
	end
	return nil
end

return table.freeze(Geometry)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF5"><Properties><string name="Name">Guard</string><ProtectedString name="Source">--!strict
local Guard = {}

function Guard.Number(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Guard.Integer(value: any, minimum: number, maximum: number): boolean
	return Guard.Number(value) and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end

function Guard.Vector(value: any, limit: number?): boolean
	if typeof(value) ~= "Vector3" then return false end
	local bound = limit or 1e7
	return Guard.Number(value.X) and Guard.Number(value.Y) and Guard.Number(value.Z)
		and math.abs(value.X) &lt;= bound and math.abs(value.Y) &lt;= bound and math.abs(value.Z) &lt;= bound
end

function Guard.Frame(value: any, limit: number?): boolean
	if typeof(value) ~= "CFrame" or not Guard.Vector(value.Position, limit) then return false end
	for _, component in {value:GetComponents()} do
		if not Guard.Number(component) then return false end
	end
	-- CFrame.new accepts explicit matrix entries. Reject scaled/sheared/reflected matrices.
	local x,y,z=value.RightVector,value.UpVector,value.ZVector
	return math.abs(x.Magnitude-1)&lt;1e-4 and math.abs(y.Magnitude-1)&lt;1e-4
		and math.abs(z.Magnitude-1)&lt;1e-4 and math.abs(x:Dot(y))&lt;1e-4
		and math.abs(y:Dot(z))&lt;1e-4 and math.abs(z:Dot(x))&lt;1e-4
		and x:Cross(y):Dot(z)&gt;0.9999
end

function Guard.Size(value: any, maximum: number?): boolean
	return Guard.Vector(value, maximum or 512) and value.X &gt; 0 and value.Y &gt; 0 and value.Z &gt; 0
end

function Guard.Unit(value: any): boolean
	return Guard.Vector(value, 1.01) and math.abs(value.Magnitude - 1) &lt;= 0.001
end

return table.freeze(Guard)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF6"><Properties><string name="Name">Help</string><ProtectedString name="Source">-- Help text only. Looking up a message never changes a hit check or trusts a position.
local Help={}
local terms={
	{"authoritative","Server decides","The server makes or checks the value used to decide a hit. A player cannot make a position valid just by sending it.","A tackle uses a position your server movement code has checked."},
	{"server","Server","The computer running the shared game rules for all players. In Studio Play, you can switch between the server and a player's client.","The server decides who gets the ball."},
	{"client","Client","One player's running copy of the game. It handles input, the camera and what that player sees.","A LocalScript reads the tackle button."},
	{"history","Saved past positions","A short list of earlier positions, hitboxes and game values, with the time of each record. Chrono keeps these in memory and later removes old records.","Keep the last 0.6 seconds so a check can use an earlier position."},
	{"snapshot","One saved record","The position, hitboxes and game values of one object at one time.","At time 10.2, the ball was here and the player was on team 2."},
	{"actor","Tracked object","Anything Chrono checks: a player, a ball, an NPC or another game object. It does not have to be a character.","Register the football as kind ball."},
	{"provider","Function that supplies data","A function you write. Chrono calls it to get an object's position, hitboxes and game values.","Read a ball position calculated by your server and return a sphere around it."},
	{"adapter","Connection to your game code","A small piece of code that connects Chrono calls to the scripts your game already uses. Bindings is the generated module for these connections.","When your move script accepts a tackle, start a Chrono action."},
	{"bindings","Connections to your game code","The functions that connect your players, moves and rules to Chrono. The setup creates a Bindings module for you to edit.","Call Bindings.Track when your game adds a player."},
	{"callback","Function given to another function","A function Chrono calls when it needs data or a rule result. The function must finish without task.wait or waiting for an event.","eligible = function(source, target) return source.team ~= target.team end"},
	{"root","Reference position","The main position and direction from which an object's hitboxes are measured. It is a CFrame value; it need not be a part named HumanoidRootPart.","For a ball, its center can be the root."},
	{"cframe","Position and direction (CFrame)","A Roblox value that stores both where something is and which way it faces.","CFrame.new(0, 0, -3) places a local hitbox 3 studs in front."},
	{"local space","Relative to an object","Measure a shape from the object's reference position and facing direction. It moves with that object.","A tackle box stays 3 studs in front of the player."},
	{"world space","Position in the map","Measure a shape in the map's coordinate system, rather than from one object.","A provider returns the ball hitbox at the ball's map position."},
	{"state","Game values saved with a position","Small values your hit rules need at that time. Use true/false, numbers or short text. Do not put Instances or nested tables here.","{active=true, team=2, invulnerable=false}"},
	{"eligible","Allowed by your game rules","A target can count only if the rules you supply allow it. Your game must also check its current rules before applying the result.","A teammate or an invulnerable player may be excluded."},
	{"hitbox","Shape used to check contact","An invisible shape your gameplay uses to decide whether a move reaches an object. It may be simpler than the visible model.","A sphere can represent a football."},
	{"capsule","Cylinder with round ends","A shape like a cylinder with a half-sphere at each end. Height includes both round ends and must be at least twice the radius.","A simple body hitbox can have radius 1.5 and total height 5 studs."},
	{"radius","Center-to-edge distance","The distance from the center of a ball or circular part to its edge. Diameter is twice this value.","Radius 1.5 means a ball is 3 studs wide."},
	{"ray","Line check","A line from a start point to an end point. It has no thickness.","A straight instant-shot check can use a ray."},
	{"sweep","Shape checked along a path","Check a ball all along a straight line, rather than only at its final position. Other objects are held at the one saved time being checked.","A thick straight attack can use a swept sphere."},
	{"interpolation","Estimate between saved positions","If the requested time lies between two records, Chrono estimates a position between them. It refuses to guess across a large gap or an uncertain change.","Records at 10.0 and 10.05 can estimate a pose at 10.025."},
	{"coverage","Enough saved data for the requested time","Chrono has suitable records around that time and its time, change and shape checks pass. This does not prove your supplied positions were honest.","A covered check with zero contacts means a checked miss."},
	{"rewind","Check an earlier position","Use saved records from before the latest update. This is off by default and needs a timing rule supplied by your server.","Your approved timing rule may allow checking 0.08 seconds earlier."},
	{"lag compensation","Use earlier data to account for delay","A game policy that can let an input use an earlier position because messages took time to travel. Chrono does not choose a fair time automatically.","Decide how much delay your game allows before rejecting an old request."},
	{"latency","Message travel delay","The time a message takes to travel. Ping usually measures a round trip, not one direction.","50 ms each way adds about 100 ms to a round trip."},
	{"epoch","Position-record version","A number that changes when tracking is reset. Older records cannot silently be used after that reset.","A respawn starts a new version of the player's position records."},
	{"discontinuity","Approved tracking reset","A real change where earlier positions must no longer connect to later ones. Your game reports it with Discontinuity after approving the change.","Teleport, respawn, or a change in who simulates an object."},
	{"quarantine","Pause one object's recording","Chrono stops using an object's records after its data function fails or returns bad data. Fix the cause, report the approved reset, then record again.","Do not reset tracking repeatedly just to hide a faulty data function."},
	{"network ownership","Who calculates Roblox physics","Roblox can let a player's client calculate an object's physics. Reading that result on the server alone does not prove it was a legal move.","Your server still needs to check player movement used to decide competitive hits."},
	{"stud","Roblox distance unit","A unit for size and distance in Roblox Studio.","A default Part is 4 studs wide along its X axis."},
	{"hz","Updates per second (Hz)","How often something is updated each second. Chrono's rate setting sizes its storage; your script still calls Capture.","60 Hz means 60 updates in one second."},
	{"handle","Move reference returned by Chrono","The value BeginAction returns after it accepts a move. Keep it and pass it to Query and EndAction. Do not create your own table as a replacement.","local move, reason = chrono:BeginAction(playerId, profile)"},
	{"capture","Save one update","Capture asks each registered object's data function for a position record. Your game calls it after all participating objects finish the same server update.","chrono:Capture()"},
	{"query","Check a move","Query checks the move reference you kept from BeginAction. It returns allowed contacts or a reason explaining why the check could not complete.","local result = chrono:Query(move)"},
	{"profile","Settings for one move","A plain Luau table describing the shape, target types, timing, target limit and rules for a move.","The generated Actions.Contact table is one profile."},
	{"contact","One returned target","A tracked object whose saved hitbox touched the move's shape and passed the supplied rules. Your game still decides whether to apply its current result.","result.contacts[1].id is the first returned object id."},
	{"active window","Time when the move may hit","The time from opens to closes, counted after your server starts the move.","opens=0.12 and closes=0.35 allow checks from 120 to 350 ms after the start."},
	{"id","One object's name in your code","A stable short text label for a particular registered object. Keep it unique while that object is tracked.","player-12 is an id; player is its kind."},
	{"kind","Group name for similar objects","A short text label for an object type. A move's targets list uses these labels to choose which groups to check.","Register a ball with kind='ball'; use targets={'ball'} to check that group."},
	{"unverified","Data not approved for hits","The default label for positions whose server-side calculation or validation has not been established. Chrono refuses gameplay checks that need them.","Selecting a Part in Studio creates only an unverified reference."},
	{"serverSimulated","Data calculated by your server","Use this trust label only when your own server code actually calculates the positions used for hit checks.","A server-owned ball simulation supplies its position."},
	{"serverValidated","Data checked by your server","Use this trust label only after your server actually verifies the supplied positions and hitboxes against the rules your game requires.","Your existing movement checks reject impossible client moves before their data reaches Chrono."},
	{"ModuleScript","A reusable code file","A Roblox code file that returns a value when another script calls require on it. Installing the generated main module does not automatically connect it to your game.","local startChrono = require(game.ServerScriptService.ChronoV3Integration)"},
	{"boolean","True or false","A value with only two choices. Useful for saved rules such as whether a player is active or invulnerable.","state = {active=true, invulnerable=false}"},
	{"hitscan","Instant line check","Check a straight line immediately. There is no simulated bullet flying along that path over later frames.","The Instant line check preset creates a ray-shaped query."},
	{"source","Object doing the move","The registered object whose saved position and facing direction place the move's hitbox.","The tackling player is the source; the player or ball being checked is a target."},
	{"target","Object the move may touch","A registered object of a kind listed in the move's targets. Its saved hitbox is checked against the move.","A kick can target the ball kind."},
	{"jitter","Changing message delay","Messages do not all take the same time to arrive. This makes updates arrive at uneven intervals.","Studio's Network Simulator can add different jitter in each direction."},
	{"packet loss","Dropped network packets","Some small pieces of network data do not arrive. Reliable messages can be resent, which adds delay; unreliable updates may stay missing.","0.5% means half of one percent, not 50%."},
}
for _,entry in terms do table.freeze(entry) end
Help.Terms=table.freeze(terms)
local messages={
	captured={"Positions saved","The supplied positions passed the recording checks.","Continue updating the game, then call Capture again after the next update."},
	covered={"Hitbox check completed","There was enough saved data for this check. Zero returned contacts means nothing was touched.","Use the returned contacts only after checking your game's current rules."},
	capture_required={"No positions saved yet","Chrono needs a recorded starting position before it can start a move.","Register your objects with Track. Call Capture once before accepting move requests, then after each game update."},
	capture_stale={"Positions are not recent enough","The game has not saved a recent enough update for this check.","Call Capture after every required server update. Check for stopped loops or functions that wait."},
	clock_fault={"The time function failed","The clock did not return a usable number.","Use the default clock, or return time in seconds from one consistent server clock."},
	clock_reversed={"Time moved backwards","The clock is earlier than the latest saved update.","Use the same server clock for saving positions and checking moves. Do not mix different clocks."},
	invalid_capture_time={"Cannot record this time","The supplied time is too far behind the clock, in the future, or not a valid number.","Use Capture() with its default time first. For a fixed-step simulation, pass a recent server time in the same clock system."},
	non_monotonic={"This update is not newer","Chrono already saved this time or a later time.","Record once per simulation step, in increasing time order. Do not record the same step twice."},
	actor_missing={"Object is not registered","The move's source id was not found.","Call Track for this id before starting the move. Keep the same id spelling in both calls."},
	unverified_source={"The move's position is not approved","The object's data is marked unverified, so it cannot be used to decide gameplay.","Connect data your server actually calculates or validates. Only then choose the matching trust label. Changing the label alone does not validate movement."},
	unverified_target={"A target's position is not approved","One object of a target kind is marked unverified. Chrono refuses a partial result.","Supply checked data for that target kind, or correct which kinds the move should check. Selected Studio references stay unverified."},
	invalid_profile={"Move settings are not usable","A shape, distance limit, active time, target count or rule function is invalid.","Check the Actions module. Times must be ordered, dimensions positive, and maxReach large enough for the full shape."},
	target_kinds_required={"Choose which object types to check","The move needs at least one target kind.","Set targets to a list such as {\"player\", \"ball\"}. Use the kind names passed to Track."},
	invalid_target_kind={"An object type name is invalid","A target kind must be a short nonempty string.","Use the same short kind names in Track and the move's targets list."},
	world_provider_or_shape={"The obstacle check is not connected","world=true needs an obstacle-data function and a ray or moving-ball query.","Connect the world function for a sweep. For an overlap move, implement your game's obstruction rule. Do not disable an obstacle rule just to make a failed check pass."},
	rewind_rejected={"The earlier check time was refused","Your server timing function failed or requested more time than allowed.","Return a delay between zero and maxRewind from your server timing rule. Check request age and never trust a client's time without validation."},
	action_capacity={"Too many moves are still open","This object or service has reached its limit for open move references.","Call EndAction when a move ends or is cancelled. Continue Capture so old moves are removed."},
	invalid_action={"The move reference is no longer valid","It was ended, removed, expired, or was not created by this Chrono instance.","Keep the value BeginAction returns. Start a new move only after your server accepts a new move request."},
	roster_changed={"The tracked object list changed","An object was added or removed after this move started. This version cancels older move references for safety.","End the old move. Let your game decide whether a new move can start after the next saved update."},
	source_epoch_changed={"The moving object was reset","A teleport, respawn or data error changed its position-record version.","End the old move. Fix data errors if present, save the new position, then let your server authorize another move."},
	not_active={"It is too early for this move to hit","The move's hit period has not started yet.","Keep saving positions. Query again during opens to closes, or correct those times in Actions."},
	action_expired={"The move's hit period has ended","This move can no longer return a contact.","Call EndAction. Start a new move only when your game authorizes one."},
	duplicate_query={"This update was already checked","This move already completed a check using the latest saved update.","Wait for your game's next update and Capture before querying this move again. Do not apply the same result twice."},
	action_spent={"The move reached its contact limit","It already returned the total number of targets allowed for this move.","End this move or wait for its normal cancellation. Change maxTargets only if your game is meant to allow more contacts."},
	shape_out_of_bounds={"The hitbox is outside the supported range","The shape could not be placed safely at the recorded root position.","Check its position, size and distance from the root. Very large map coordinates also need a precision review."},
	world_unknown={"Obstacle data is missing or uncertain","The optional obstacle function could not prove what was clear or blocked at this time.","Check your world function and its saved obstacle data. It must report covered, blocked and fraction. Include a check for starting inside an obstacle."},
	rules_fault={"The target rule function failed","eligible must finish immediately and return exactly true or false.","Check the function in Actions. Remove waiting calls and fix its errors. Save needed rule values in the snapshot state."},
	capture_fault={"Some positions were not saved","One or more object functions failed or returned unusable data. See the faults list for object ids and reasons.","Explain each item in result.faults. Fix its cause, then report an approved tracking reset for that object."},
	provider_fault={"The position function failed","The function given to Track threw an error or tried to wait.","Check that function for errors. Return root, zones and state immediately. Do not use task.wait or wait for events inside it."},
	quarantined={"Recording for this object is paused","An earlier position function failed. Chrono keeps refusing it until you deliberately reset tracking.","Find and fix the first error. Then call Discontinuity for that object and Capture again. Do not reset every frame."},
	invalid_snapshot={"The position record is not usable","The supplied table or a value it contains could not be read safely.","Return a plain table with root=CFrame, zones={...}, and optional flat state={...}. Check the data function for errors."},
	invalid_state={"Saved game values are not usable","State must contain only true/false values, finite numbers or short text, with string keys.","Save values such as team=2 and active=true. Do not save Instances, nested tables or NaN numbers in state."},
	invalid_zones={"The hitbox list is not usable","There are too many zones or a zone name is invalid.","Return 1 to 32 named shapes. Zone names must be strings up to 64 bytes."},
	invalid_zone={"One hitbox is not usable","A target zone must be a valid box, sphere or capsule.","Build it with Core.Shapes.Box, Sphere or Capsule. Check frame, size, radius and height."},
	empty_zones={"The object has no hitbox","At least one target shape is required in each saved record.","Return a named hitbox in zones, such as zones={Body=S.Sphere(frame,1)}."},
	zone_out_of_bounds={"A hitbox is too far from its object","Its root-to-shape distance plus full outside extent exceeds maxRadius.","Check the world-space hitbox position. Increase maxRadius only to match the real maximum extent your game allows."},
	speed_bound={"The object moved farther than allowed","The root travelled farther than maxSpeed allows between saved updates.","Check your movement data and speed setting. For a game-approved teleport, explicitly reset tracking. Do not raise the limit to accept unexplained movement."},
	empty={"No position records are available","There is no usable record for this object yet.","Track it, supply a valid position function and call Capture before querying it."},
	too_old={"The requested position was not kept","The requested time is before the oldest stored record.","Use a more recent approved time. Check seconds, rate, capture frequency and how long messages are delayed."},
	not_recorded={"That time has not been recorded","The requested time is later than this object's latest saved position.","Check provider faults and simulation order. Capture the shared game update before querying it."},
	expired={"The requested time is too old","The requested time exceeds the configured age limit.","Reject or retry according to your game rules. Only increase the age limit after choosing a fair delay policy."},
	future={"The requested time is in the future","The requested position is later than the server's current clock.","Use a consistent server clock and validate any client-reported times."},
	invalid_time={"The time value is not usable","A time is not a finite number.","Pass time in seconds from the same server clock used by Capture."},
	epoch_changed={"Earlier position records were reset","The requested exact record belongs to an older tracking version.","Do not use records from before a teleport, respawn or approved reset. Capture the new state before a new move."},
	discontinuity={"The requested time crosses a reset","Chrono cannot connect records across a teleport, respawn or tracking failure.","Use a time wholly within the current tracking version. Do not guess a path through the reset."},
	sample_gap={"Saved positions are too far apart","There is too much missing time between the two records needed for this check.","Check capture frequency and stalled updates. Refuse the uncertain check rather than treating it as a miss or a hit."},
	state_boundary={"A game value changed between records","For example, invulnerability changed between the two saved times. Chrono cannot prove its value at the requested time.","Record transitions at their actual server time. Expect uncertain in-between requests to be refused."},
	geometry_boundary={"A hitbox changed between records","A zone was added, removed, resized or changed shape between those times.","Record shape changes at their actual time. Do not interpolate a different shape through the change."},
}
for _,entry in messages do table.freeze(entry) end
Help.Messages=table.freeze(messages)
function Help.Explain(value)
	local code=if type(value)=="table" then value.reason else value
	if type(code)~="string" then code="unknown" end
	local key,subject=code,nil
	if code:sub(1,7)=="source_" and messages[code]==nil then key=code:sub(8) subject="Object doing the move"
	elseif code:sub(1,7)=="target_" and messages[code]==nil then key=code:sub(8) subject="Possible target" end
	local entry=messages[key]
	return table.freeze({code=code,known=entry~=nil,subject=subject,
		title=if entry then entry[1] else "More information is needed",
		meaning=if entry then entry[2] else "This message is not in the built-in help list. Keep the original code when reporting it.",
		fix=if entry then entry[3] else "Check Studio Output and the documentation. Include the original message and a small example when asking for help."})
end
function Help.FindTerms(query)
	local result={} local q=string.lower(if type(query)=="string" then query else "")
	for _,entry in terms do if q=="" or (string.lower(table.concat(entry," "))):find(q,1,true) then table.insert(result,entry) end end
	return result
end
return table.freeze(Help)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF7"><Properties><string name="Name">History</string><ProtectedString name="Source">--!strict
local Guard=require(script.Parent.Guard)
local Contract=require(script.Parent.Contract)
local Shapes=require(script.Parent.Shapes)
local H={} H.__index=H
function H.new(options)
	return setmetatable({rows=table.create(options.capacity),head=1,count=0,capacity=options.capacity,
		epoch=1,maxAge=options.seconds,maxGap=options.maxGap,maxSpeed=options.maxSpeed,
		maxRadius=options.maxRadius,boundary=-math.huge},H)
end
function H:_at(i) return self.rows[(self.head+i-2)%self.capacity+1] end
function H:Latest() return if self.count&gt;0 then self:_at(self.count) else nil end
function H:Break(time)
	self.epoch+=1 self.boundary=time
end
function H:Push(time,snapshot)
	if type(snapshot)~="table" or not Guard.Frame(snapshot.root) or type(snapshot.zones)~="table" then return false,"invalid_snapshot" end
	local state=Contract.State(snapshot.state or {})
	if not state then return false,"invalid_state" end
	local zones,count={},0
	for name,shape in snapshot.zones do
		count+=1
		if count&gt;32 or type(name)~="string" or #name&gt;64 then return false,"invalid_zones" end
		local zone=Shapes.Copy(shape,true)
		if not zone then return false,"invalid_zone" end
		if (zone.frame.Position-snapshot.root.Position).Magnitude+Shapes.Radius(zone)&gt;self.maxRadius+1e-5 then return false,"zone_out_of_bounds" end
		zones[name]=zone
	end
	if count==0 then return false,"empty_zones" end
	local latest=self:Latest()
	if time&lt;self.boundary or (latest and time&lt;=latest.time) then return false,"non_monotonic" end
	if latest and latest.epoch==self.epoch and (snapshot.root.Position-latest.root.Position).Magnitude&gt;self.maxSpeed*(time-latest.time)+1e-4 then return false,"speed_bound" end
	local row=table.freeze({time=time,root=snapshot.root,zones=table.freeze(zones),state=state,epoch=self.epoch})
	if self.count&lt;self.capacity then self.count+=1 self.rows[(self.head+self.count-2)%self.capacity+1]=row
	else self.rows[self.head]=row self.head=self.head%self.capacity+1 end
	return true
end
function H:Sample(time,now)
	if not Guard.Number(time) or not Guard.Number(now) then return nil,"invalid_time" end
	if time&gt;now+1e-6 then return nil,"future" end
	if now-time&gt;self.maxAge then return nil,"expired" end
	if self.count==0 then return nil,"empty" end
	if time&lt;self:_at(1).time then return nil,"too_old" end
	if time&gt;self:Latest().time then return nil,"not_recorded" end
	local low,high=1,self.count
	while low&lt;=high do local mid=(low+high)//2 if self:_at(mid).time&lt;time then low=mid+1 else high=mid-1 end end
	local after=self:_at(low)
	if after.time==time then
		if after.epoch~=self.epoch then return nil,"epoch_changed" end
		return after
	end
	local before=self:_at(low-1)
	if before.epoch~=after.epoch or after.epoch~=self.epoch then return nil,"discontinuity" end
	if after.time-before.time&gt;self.maxGap then return nil,"sample_gap" end
	if not Contract.SameState(before.state,after.state) then return nil,"state_boundary" end
	local alpha=(time-before.time)/(after.time-before.time)
	local zones={}
	for name,zone in before.zones do
		local nextZone=after.zones[name]
		if not nextZone or not Shapes.SameDimensions(zone,nextZone) then return nil,"geometry_boundary" end
		zones[name]=Shapes.Lerp(zone,nextZone,alpha)
	end
	for name in after.zones do if not before.zones[name] then return nil,"geometry_boundary" end end
	return table.freeze({time=time,root=before.root:Lerp(after.root,alpha),state=before.state,
		zones=table.freeze(zones),epoch=before.epoch})
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF8"><Properties><string name="Name">Shapes</string><ProtectedString name="Source">--!strict
-- Geometry uses studs, seconds, world CFrames, and closed volumes (tangency counts).
local Guard = require(script.Parent.Guard)
local G = require(script.Parent.Geometry)
local S = {}
local EPS = 1e-7
local function positive(v, maximum)
	return Guard.Number(v) and v &gt; 0 and v &lt;= maximum
end
function S.Copy(s, targetOnly)
	if type(s) ~= "table" then return nil end
	if s.kind == "box" and Guard.Frame(s.frame) and Guard.Size(s.size, 512) then
		return table.freeze({kind="box", frame=s.frame, size=s.size})
	elseif s.kind == "sphere" and Guard.Frame(s.frame) and positive(s.radius,32) then
		return table.freeze({kind="sphere", frame=s.frame, radius=s.radius})
	elseif s.kind == "capsule" and Guard.Frame(s.frame) and positive(s.radius,32)
		and positive(s.height,512) and s.height &gt;= s.radius*2 then
		return table.freeze({kind="capsule", frame=s.frame, radius=s.radius, height=s.height})
	elseif not targetOnly and s.kind == "sweep" and Guard.Vector(s.start) and Guard.Vector(s.finish)
		and Guard.Number(s.radius) and s.radius &gt;= 0 and s.radius &lt;= 32
		and (s.finish-s.start).Magnitude &lt;= 4096 then
		return table.freeze({kind="sweep", start=s.start, finish=s.finish, radius=s.radius})
	end
	return nil
end
local function checked(s) return assert(S.Copy(s), "invalid Chrono shape") end
function S.Box(frame, size) return checked({kind="box",frame=frame,size=size}) end
function S.Sphere(frame, radius) return checked({kind="sphere",frame=frame,radius=radius}) end
function S.Capsule(frame, radius, height) return checked({kind="capsule",frame=frame,radius=radius,height=height}) end
function S.Sweep(start, finish, radius) return checked({kind="sweep",start=start,finish=finish,radius=radius}) end
function S.Ray(start, finish) return S.Sweep(start,finish,0) end
function S.At(shape, frame)
	assert(Guard.Frame(frame), "invalid reference frame")
	local out = table.clone(shape)
	if out.kind == "sweep" then
		out.start, out.finish = frame:PointToWorldSpace(out.start), frame:PointToWorldSpace(out.finish)
	else out.frame = frame*out.frame end
	return checked(out)
end
function S.Radius(s)
	if s.kind == "box" then return s.size.Magnitude*0.5 end
	if s.kind == "capsule" then return s.height*0.5 end
	return s.radius
end
function S.Reach(s)
	if s.kind == "sweep" then return math.max(s.start.Magnitude,s.finish.Magnitude)+s.radius end
	return s.frame.Position.Magnitude+S.Radius(s)
end
function S.SameDimensions(a,b)
	return a.kind==b.kind and a.size==b.size and a.radius==b.radius and a.height==b.height
end
function S.Lerp(a,b,alpha)
	local out=table.clone(a) out.frame=a.frame:Lerp(b.frame,alpha)
	return table.freeze(out)
end
local function ends(c)
	local offset=c.frame.UpVector*(c.height*0.5-c.radius)
	return c.frame.Position-offset,c.frame.Position+offset
end
-- Closest distance between two closed segments, including zero length segments.
local function segmentPair(p1,q1,p2,q2)
	local d1,d2,r=q1-p1,q2-p2,p1-p2
	local a,e,f=d1:Dot(d1),d2:Dot(d2),d2:Dot(r)
	local s,t=0,0
	if a&lt;=1e-12 and e&lt;=1e-12 then return r:Dot(r) end
	if a&lt;=1e-12 then t=math.clamp(f/e,0,1)
	else
		local c=d1:Dot(r)
		if e&lt;=1e-12 then s=math.clamp(-c/a,0,1)
		else
			local b=d1:Dot(d2) local denominator=a*e-b*b
			if denominator&gt;1e-12 then s=math.clamp((b*f-c*e)/denominator,0,1) end
			t=(b*s+f)/e
			if t&lt;0 then t=0 s=math.clamp(-c/a,0,1)
			elseif t&gt;1 then t=1 s=math.clamp((b-c)/a,0,1) end
		end
	end
	local delta=r+d1*s-d2*t
	return delta:Dot(delta)
end
local function raySphere(p,q,center,radius)
	local d,m=q-p,p-center
	local a,c=d:Dot(d),m:Dot(m)-radius*radius
	if c&lt;=EPS then return 0 end
	if a&lt;1e-12 then return nil end
	local b=m:Dot(d) local h=b*b-a*c
	if h&lt;0 then return nil end
	local t=(-b-math.sqrt(h))/a
	if t&gt;=0 and t&lt;=1 then return t end
	return nil
end
-- Point swept against a capsule. Split where projection onto its axis clamps.
-- On each piece, squared distance to the segment is a quadratic in t.
local function rayCapsule(p,q,a,b,radius)
	local axis,d,m=b-a,q-p,p-a
	local length2=axis:Dot(axis)
	if length2&lt;1e-12 then return raySphere(p,q,a,radius) end
	local u0,du=m:Dot(axis)/length2,d:Dot(axis)/length2
	local cuts={0,1}
	if math.abs(du)&gt;1e-12 then
		for _,u in {0,1} do local t=(u-u0)/du if t&gt;0 and t&lt;1 then table.insert(cuts,t) end end
	end
	table.sort(cuts)
	for i=1,#cuts-1 do
		local lower,upper=cuts[i],cuts[i+1]
		local u=u0+du*(lower+upper)*0.5
		local v,w
		if u&lt;0 then v,w=m,d elseif u&gt;1 then v,w=p-b,d
		else v,w=m-axis*u0,d-axis*du end
		local aa,bb,cc=w:Dot(w),2*v:Dot(w),v:Dot(v)-radius*radius
		if (aa*lower+bb)*lower+cc&lt;=EPS then return lower end
		if aa&gt;1e-12 then
			local discriminant=bb*bb-4*aa*cc
			if discriminant&gt;=0 then
				local t=(-bb-math.sqrt(discriminant))/(2*aa)
				if t&gt;=lower-EPS and t&lt;=upper+EPS then return math.clamp(t,lower,upper) end
			end
		end
	end
	return nil
end
local function boxBox(a,b)
	local aa={a.frame.RightVector,a.frame.UpVector,a.frame.ZVector}
	local ba={b.frame.RightVector,b.frame.UpVector,b.frame.ZVector}
	local axes={aa[1],aa[2],aa[3],ba[1],ba[2],ba[3]}
	for _,u in aa do for _,v in ba do table.insert(axes,u:Cross(v)) end end
	local halfA,halfB=a.size*0.5,b.size*0.5
	local dimsA,dimsB={halfA.X,halfA.Y,halfA.Z},{halfB.X,halfB.Y,halfB.Z}
	local delta=b.frame.Position-a.frame.Position
	for _,axis in axes do
		if axis.Magnitude&gt;1e-7 then
			axis=axis.Unit local ra,rb=0,0
			for i=1,3 do ra+=dimsA[i]*math.abs(axis:Dot(aa[i])) rb+=dimsB[i]*math.abs(axis:Dot(ba[i])) end
			if math.abs(delta:Dot(axis))&gt;ra+rb+EPS then return false end
		end
	end
	return true
end
-- Returns the first travel fraction for a sweep, or zero for volume overlap.
-- This is exact for supplied primitives at one time; it is not continuous actor motion.
function S.Intersect(a,b)
	if a.kind=="sweep" then
		if b.kind=="box" then return G.SphereSweepOBB(a.start,a.finish,a.radius,b.frame,b.size) end
		if b.kind=="sphere" then return raySphere(a.start,a.finish,b.frame.Position,a.radius+b.radius) end
		local p,q=ends(b) return rayCapsule(a.start,a.finish,p,q,a.radius+b.radius)
	end
	local hit=false
	if a.kind=="box" and b.kind=="box" then hit=boxBox(a,b)
	elseif a.kind=="sphere" and b.kind=="sphere" then
		hit=(a.frame.Position-b.frame.Position).Magnitude&lt;=a.radius+b.radius+EPS
	elseif a.kind=="capsule" and b.kind=="capsule" then
		local p,q=ends(a) local r,s=ends(b)
		hit=segmentPair(p,q,r,s)&lt;=(a.radius+b.radius)^2+EPS
	elseif a.kind=="box" or b.kind=="box" then
		local box,other=if a.kind=="box" then a else b,if a.kind=="box" then b else a
		local p,q=other.frame.Position,other.frame.Position
		if other.kind=="capsule" then p,q=ends(other) end
		hit=G.SphereSweepOBB(p,q,other.radius,box.frame,box.size)~=nil
	else
		local sphere,cap=if a.kind=="sphere" then a else b,if a.kind=="sphere" then b else a
		local p,q=ends(cap)
		hit=G.SegmentDistanceSquared(p,q,sphere.frame.Position)&lt;=(sphere.radius+cap.radius)^2+EPS
	end
	return if hit then 0 else nil
end
return table.freeze(S)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF9"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Editor help and autocomplete. Runtime checks still validate every supplied value.
export type State = {[string]: boolean | number | string}
export type Volume = {kind: "box", frame: CFrame, size: Vector3}
	| {kind: "sphere", frame: CFrame, radius: number}
	| {kind: "capsule", frame: CFrame, radius: number, height: number}
export type Sweep = {kind: "sweep", start: Vector3, finish: Vector3, radius: number}
export type Snapshot = {root: CFrame, zones: {[string]: Volume}, state: State?}
export type Binding = {
	kind: string,
	capture: (serverTime: number) -&gt; Snapshot,
	trust: ("unverified" | "serverSimulated" | "serverValidated")?,
	maxSpeed: number,
	maxRadius: number,
}
export type Profile = {
	shape: Volume | Sweep,
	targets: {string},
	opens: number?,
	closes: number?,
	maxTargets: number?,
	maxReach: number?,
	eligible: ((source: State, target: State, targetId: string, targetKind: string) -&gt; boolean)?,
	world: boolean?,
}
-- Keep the value BeginAction returns; do not make your own table for a move reference.
export type Move = {}
export type Contact = {id: string, kind: string, zone: string, time: number, epoch: number,
	state: State, root: CFrame, distance: number, fraction: number}
export type Result = {ok: boolean, reason: string, contacts: {Contact}, time: number?,
	capturedAt: number?, rewind: number?, source: any?, shape: (Volume | Sweep)?, actor: string?}
export type CaptureResult = {ok: boolean, reason: string, time: number?,
	faults: {{id: string, reason: string}}?, contacts: {Contact}}
export type Options = {
	seconds: number?, rate: number?, maxGap: number?, maxRewind: number?,
	clock: (() -&gt; number)?,
	resolveRewind: ((actorId: string, approvedServerContext: any, captureTime: number) -&gt; number)?,
	world: ((queryTime: number, now: number, shape: Sweep) -&gt; {covered: boolean, blocked: boolean?, fraction: number?})?,
}
export type Explanation = {code: string, known: boolean, subject: string?, title: string, meaning: string, fix: string}
export type Service = {
	Track: (self: Service, id: string, binding: Binding) -&gt; (),
	Untrack: (self: Service, id: string) -&gt; boolean,
	Discontinuity: (self: Service, id: string, reason: string?) -&gt; (),
	Capture: (self: Service, serverTime: number?) -&gt; CaptureResult,
	BeginAction: (self: Service, actorId: string, profile: Profile, approvedServerContext: any?) -&gt; (Move?, string?),
	Query: (self: Service, move: Move) -&gt; Result,
	EndAction: (self: Service, move: Move) -&gt; boolean,
	Inspect: (self: Service) -&gt; any,
	Destroy: (self: Service) -&gt; (),
}
return table.freeze({})
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="CF10"><Properties><string name="Name">Replication</string><ProtectedString name="Source">const RunService = game:GetService("RunService")

const IS_SERVER = RunService:IsServer()
const Config = require(script.Shared.Config)
const HTTPS = game:GetService("HttpService")
const Stats = require(script.Shared.Stats)
const Player = require(script.Server.Player)
const Receiver = require(script.Server.Receiver)
const ServerClock = require(script.Server.ServerClock)
const Entity = require(script.Shared.Entity)
const Events = require(script.Shared.Events)
const Holder = require(script.Shared.Holder)
const ReplicationRules = require(script.Shared.ReplicationRules)
const Snapshots = require(script.Shared.Snapshots)
const Types = require(script.Shared.Types)
const EntityGrid = require(script.Server.EntityGrid)

export type SnapshotData&lt;Value, Velocity&gt; = Types.SnapshotData&lt;Value, Velocity&gt;
export type Signal&lt;fx, T...&gt; = Types.Signal&lt;fx, T...&gt;
export type ClientEntitiesStats = Types.ClientEntitiesStats
export type ServerEntitiesStats = Types.ServerEntitiesStats
export type Connection = Types.Connection
export type Event&lt;fx, T...&gt; = Types.Event&lt;fx, T...&gt;
export type Snapshot&lt;Value, Velocity&gt; = Types.Snapshot&lt;Value, Velocity&gt;
export type MODEL_REPLICATION_MODE = Types.MODEL_REPLICATION_MODE
export type EntityConfig = Types.EntityConfig
export type EntityConfigInput = Types.EntityConfigInput
export type Ticker = Types.Ticker
export type InterpolationBuffer = Types.InterpolationBuffer
export type ClientClock = Types.ClientClock
export type ReplicationRule = Types.ReplicationRule
export type EntityReceivePacket = Types.EntityReceivePacket
export type Entity = Types.Entity
export type PlayerEntityHolder = Types.PlayerEntityHolder

const function CheckVersion()
	task.spawn(function()
		pcall(function()
			const url = "https://api.github.com/repos/VertimaXx/ChronoFork-V3.1/releases/latest"
			const success, result = pcall(function()
				return HTTPS:GetAsync(url)
			end)
			if not success then
				return
			end
			const data = HTTPS:JSONDecode(result) :: { tag_name: string? }
			const latestVersion = data.tag_name
			const currentVersion = Config._GetConfig("__VERSION")
			if latestVersion and latestVersion ~= currentVersion then
				warn(
					("Chrono: A new version is available! You are using version %s, but the latest version is %s."):format(
						currentVersion,
						latestVersion
					)
				)
			end
		end)
	end)
end
local STARTED = false
local startupState="idle"
return {
	Start = function(config: ModuleScript?)
		if STARTED then
			warn("Chrono: Already Started. Ignoring subsequent calls.")
			return
		end
		assert(startupState=="idle","ChronoFork startup is "..startupState..". Stop Play before retrying a failed startup.")
		startupState="starting"
		local ok,reason=xpcall(function()
		if config then
			(require)(config)
		end
		if IS_SERVER then
			require(script.Server.Replicate)
		else
			require(script.Client.Replicate)
		end
		Config._Lock()
		end,debug.traceback)
		if not ok then startupState="failed" error(reason,2) end
		STARTED = true
		startupState="running"
		if IS_SERVER and Config._GetConfig("CHECK_NEW_VERSION") then
			CheckVersion()
		end
		const currentVersion = Config._GetConfig("__VERSION")
		print(`Chrono {currentVersion} Started.`)
	end,

	IsStarted = function() return STARTED end,
	GetStartupState = function()return startupState end,
	Holder = Holder,
	Entity = Entity,
	Stats = Stats,
	Config = Config,
	ReplicationRules = ReplicationRules,
	Events = Events,
	Snapshots = Snapshots,
	ExperimentalPrediction = require(script.Shared.ExperimentalPrediction),

	ServerClock = ServerClock,
	Player = Player,
	ServerReceiver = Receiver,
	EntityGrid = EntityGrid,
}
</ProtectedString></Properties><Item class="Folder" referent="CF11"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="CF12"><Properties><string name="Name">AlignDriver</string><ProtectedString name="Source">export type AlignDriver = {
	part: BasePart,
	container: Camera,
	driverPart: BasePart,
	alignPosition: AlignPosition,
	alignOrientation: AlignOrientation,
	velocity: Vector3?,
	lastPosition: Vector3?,
	lastTime: number?,
}

const Types = require(script.Parent.Parent.Shared.Types)

const CONTAINER_NAME = "__CHRONO_ALIGN"
const DRIVER_PART_NAME = "__CHRONO_ALIGN_PART"

const ROOT_PRIORITY = 127

const MAX_RESPONSIVENESS = 200

const MAX_SPEED = 1000

local velocityUpdates: { AlignDriver } = {}
const AlignDriver = {}

const function Create(part: BasePart): AlignDriver
	const previous = part:FindFirstChild(CONTAINER_NAME)
	if previous then
		previous:Destroy()
	end

	const initCF = part.CFrame

	const container = Instance.new("Camera")
	container.Archivable = false
	container.Name = CONTAINER_NAME
	container.Parent = part

	const driverPart = Instance.new("Part")
	driverPart.Name = DRIVER_PART_NAME

	driverPart.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0, 0, 0)
	driverPart.Massless = false
	driverPart.RootPriority = ROOT_PRIORITY
	driverPart.Size = Vector3.zero
	driverPart.CanCollide = false
	driverPart.CanQuery = false
	driverPart.CanTouch = false
	driverPart.Transparency = 1
	driverPart.Color = Color3.new(0, 1, 0)

	driverPart.CFrame = initCF
	driverPart.Parent = container

	const weld = Instance.new("Weld")
	weld.Name = "__CHRONO_ALIGN_WELD"
	weld.Part0 = driverPart
	weld.Part1 = part
	weld.Parent = container

	const attachment = Instance.new("Attachment")
	attachment.Name = "__CHRONO_ALIGN_ATTACHMENT"
	attachment.Parent = driverPart

	const alignPosition = Instance.new("AlignPosition")
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment

	alignPosition.ApplyAtCenterOfMass = false
	alignPosition.ReactionForceEnabled = false

	alignPosition.ForceRelativeTo = Enum.ActuatorRelativeTo.World
	alignPosition.ForceLimitMode = Enum.ForceLimitMode.Magnitude

	alignPosition.MaxForce = math.huge
	alignPosition.MaxVelocity = math.huge
	alignPosition.Responsiveness = MAX_RESPONSIVENESS

	alignPosition.RigidityEnabled = true
	alignPosition.Position = initCF.Position
	alignPosition.Parent = driverPart

	const alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment

	alignOrientation.AlignType = Enum.AlignType.AllAxes
	alignOrientation.PrimaryAxisOnly = false
	alignOrientation.ReactionTorqueEnabled = false
	alignOrientation.MaxTorque = math.huge
	alignOrientation.MaxAngularVelocity = math.huge
	alignOrientation.Responsiveness = MAX_RESPONSIVENESS
	alignOrientation.RigidityEnabled = true
	alignOrientation.CFrame = initCF.Rotation
	alignOrientation.Parent = driverPart

	part.CFrame = initCF

	return {
		part = part,
		container = container,
		driverPart = driverPart,
		alignPosition = alignPosition,
		alignOrientation = alignOrientation,
	}
end

const function Update(driver: AlignDriver, cframe: CFrame)
	driver.alignPosition.Position = cframe.Position
	driver.alignOrientation.CFrame = cframe.Rotation
end

const function Destroy(driver: AlignDriver)
	if driver.container then
		driver.container:Destroy()
	end

	driver.part.AssemblyLinearVelocity = Vector3.zero
end

-- Mimics roblox's replication for velocity
const function UpdateVelocity(driver: AlignDriver, position: Vector3, renderTime: number)
	const lastTime = driver.lastTime
	const lastPosition = driver.lastPosition
	if lastTime and lastPosition and renderTime &gt; lastTime and renderTime - lastTime &lt; 0.5 then
		const velocity = (position - lastPosition) / (renderTime - lastTime)
		if vector.magnitude(velocity :: any) &lt; MAX_SPEED then
			driver.velocity = velocity
			table.insert(velocityUpdates, driver)
		end
	end
	driver.lastPosition = position
	driver.lastTime = renderTime
end

const function Step(entity: Types.Entity, part: BasePart, cframe: CFrame, renderTime: number)
	local existing = entity._alignDriver
	if existing and existing.part ~= part then
		Destroy(existing)
		existing = nil
	end
	if not existing then
		part.CFrame = cframe
	end
	const driver = existing or Create(part)
	entity._alignDriver = driver
	Update(driver, cframe)
	UpdateVelocity(driver, cframe.Position, renderTime)
end

const function Clear(entity: Types.Entity)
	const driver = entity._alignDriver
	if driver then
		Destroy(driver)
		entity._alignDriver = nil
	end
end

const function ApplyVelocities()
	for _, driver in velocityUpdates do
		if driver.velocity and driver.container.Parent then
			driver.part.AssemblyLinearVelocity = driver.velocity
		end
	end
	velocityUpdates = {}
end

AlignDriver.Create = Create
AlignDriver.Update = Update
AlignDriver.Destroy = Destroy
AlignDriver.Step = Step
AlignDriver.Clear = Clear
AlignDriver.ApplyVelocities = ApplyVelocities

return AlignDriver
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF13"><Properties><string name="Name">ClientClock</string><ProtectedString name="Source">const RunService = game:GetService("RunService")

const Warn = require(script.Parent.Parent.Shared.Warn)
const Config = require(script.Parent.Parent.Shared.Config)
const Types = require(script.Parent.Parent.Shared.Types)
const BufferTracker = require(script.Parent.InterpolationBuffer)

const ClientClocks: { [Types.ClientClock]: boolean } = {}
const _ServerOwnedClocks: { [Types.ClientClock]: boolean } = {}

const function GetBuffer(clientClock: Types.ClientClock): number
	if clientClock.buffer then
		return BufferTracker.GetBuffer(clientClock.buffer, clientClock.tickRate)
	else
		return clientClock.bufferConst or 0
	end
end

const function Clear(clientClock: Types.ClientClock)
	clientClock.lastClockAt = nil
	clientClock.lastClockDuration = 0
	clientClock.renderAt = nil

	if clientClock.buffer then
		BufferTracker.Reset(clientClock.buffer)
	end
end

const function GetEstimatedServerTime(clientClock: Types.ClientClock): number
	if not clientClock.lastClockAt then
		Warn.low("ClientClock: Estimated server time not yet established for", clientClock.name)
		return 0
	end

	return clientClock.lastClockAt + (os.clock() - clientClock.lastClockDuration)
end

const function GetTargetRenderTime(clientClock: Types.ClientClock): number
	if not clientClock.renderAt then
		if clientClock.lastClockAt then
			return GetEstimatedServerTime(clientClock) - GetBuffer(clientClock)
		end
		Warn.low("ClientClock: Render time not yet established for", clientClock.name)
		return 0
	end

	return clientClock.renderAt
end

const function CheckHasLastClockAt(clientClock: Types.ClientClock, sendTime: number)
	if not clientClock.lastClockAt then
		clientClock.lastClockAt = sendTime
		clientClock.lastClockDuration = os.clock()
		clientClock.renderAt = nil
	end
end

const function Refresh(clientClock: Types.ClientClock, currentSendTime: number): boolean
	if not clientClock.lastClockAt then
		CheckHasLastClockAt(clientClock, currentSendTime)
		return false
	end

	if currentSendTime &gt; clientClock.lastClockAt then
		clientClock.lastClockAt = currentSendTime
		clientClock.lastClockDuration = os.clock()
		return true
	end

	return false
end

const function OnSnapShot(clientClock: Types.ClientClock, currentSendTime: number)
	if not clientClock.lastClockAt then
		CheckHasLastClockAt(clientClock, currentSendTime)
		return
	end

	if clientClock.buffer then
		BufferTracker.Register(clientClock.buffer, currentSendTime)
	end

	if Refresh(clientClock, currentSendTime) and not clientClock.renderAt then
		clientClock.renderAt = currentSendTime - GetBuffer(clientClock)
	end
end

const function OnStop(clientClock: Types.ClientClock, stopTime: number)
	if clientClock.buffer then
		BufferTracker.MarkIdle(clientClock.buffer, stopTime)
	end
end

const function SetTickRate(clientClock: Types.ClientClock, tickRate: number)
	if clientClock.tickRate == tickRate then
		return
	end
	clientClock.tickRate = tickRate
end

const function Destroy(clientClock: Types.ClientClock)
	ClientClocks[clientClock] = nil
	if _ServerOwnedClocks[clientClock] then
		_ServerOwnedClocks[clientClock] = nil
	end
end

const function Update(clientClock: Types.ClientClock, dt: number)
	const now = os.clock()
	const delay = GetBuffer(clientClock)
	if not clientClock.lastClockAt then
		return
	end
	const estimatedServerTime = clientClock.lastClockAt + (now - clientClock.lastClockDuration)
	local renderAt = (clientClock.renderAt or (estimatedServerTime - delay)) + dt

	const renderTimeError = delay - (estimatedServerTime - renderAt)

	if math.abs(renderTimeError) &gt; 0.1 then
		renderAt = estimatedServerTime - delay
	elseif renderTimeError &gt; 0.01 then
		renderAt = math.max(estimatedServerTime - delay, renderAt - 0.1 * dt)
	elseif renderTimeError &lt; -0.01 then
		renderAt = math.min(estimatedServerTime - delay, renderAt + 0.1 * dt)
	end

	clientClock.renderAt = renderAt
end

const function UpdateBuffer(clientClock: Types.ClientClock, buffer: number?)
	buffer = if buffer and buffer &lt;= 0 then nil else buffer
	const currentBuffer = clientClock.bufferConst
	if currentBuffer == buffer then
		return
	end
	if not buffer then
		if not clientClock.buffer then
			clientClock.buffer = BufferTracker.new(clientClock)
		end
	else
		clientClock.buffer = nil
	end
	clientClock.bufferConst = buffer
	clientClock.renderAt = nil
end

const function new(tickRate: number, name: string, bufferNumber: number?, networkOwner: Player?): Types.ClientClock
	bufferNumber = if bufferNumber and bufferNumber &lt;= 0 then nil else bufferNumber
	const self: Types.ClientClock = {
		name = name,
		lastClockAt = nil,
		lastClockDuration = 0,
		renderAt = nil,
		tickRate = tickRate,
		_baseTickRate = tickRate,
		_owner = networkOwner,
		buffer = nil,
		bufferConst = bufferNumber,

		OnSnapShot = OnSnapShot,
		OnStop = OnStop,
		Refresh = Refresh,
		GetEstimatedServerTime = GetEstimatedServerTime,
		GetTargetRenderTime = GetTargetRenderTime,
		Clear = Clear,
		SetTickRate = SetTickRate,
		UpdateBuffer = UpdateBuffer,
		Destroy = Destroy,
	}
	if not bufferNumber then
		self.buffer = BufferTracker.new(self)
	end

	if not networkOwner then
		_ServerOwnedClocks[self] = true
	end

	ClientClocks[self] = true
	return self
end

const function UpdateAll(dt: number)
	for clientClock, _ in ClientClocks do
		Update(clientClock, dt)
	end
end

Config._WaitForLock(function()
	if RunService:IsServer() then
		return
	end
	for name, config in Config._EntityConfigs do
		const clientClocks = config.CLIENT_CLOCK
		if not clientClocks then
			Warn.high("Entity Config", name, "is missing client clocks")
			return
		end
		clientClocks.NORMAL = new(config.TICK_RATE, name .. "_NORMAL", config.BUFFER)
		if (config.HALF_TICK_DISTANCE or math.huge) &lt; math.huge then
			clientClocks.HALF = new(config.TICK_RATE * 2, name .. "_HALF", config.BUFFER)
		end
	end
end)

return {
	_getBuffer = GetBuffer,
	new = new,
	clientClocks = ClientClocks,
	serverOwnedClocks = _ServerOwnedClocks,
	UpdateAll = UpdateAll,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF14"><Properties><string name="Name">EntityStats</string><ProtectedString name="Source">const Shared = script.Parent.Parent.Shared

const ClientClock = require(script.Parent.ClientClock)
const StatsALL = require(Shared.Stats)
const Entity = require(Shared.Entity)
const Holder = require(Shared.Holder)
const Types = require(Shared.Types)
const Stats = StatsALL.CLIENT

type SnapshotData = Types.SnapshotData&lt;CFrame, Vector3&gt;

const idMap = Holder.idMap

const function UpdateEntityStats()
	if not StatsALL.SERVER._SHOULD_REPLICATE or Stats._PAUSE then
		return
	end
	const entities = {}
	for _, entity in idMap do
		const id = entity.id
		const config = entity.entityConfig
		const configName = config and config.NAME or "DEFAULT"
		const networkOwner = entity.networkOwner
		const isCharacter = entity._player ~= nil

		const lastRecvTime = entity.latestTime or 0
		const lastReplicatedTime = entity.lastReplicatedTime or 0

		local renderCache = entity._clientClock

		if not renderCache then
			const RenderCaches = entity.entityConfig.CLIENT_CLOCK
			if RenderCaches then
				renderCache = entity.isHalfTicked and RenderCaches.HALF or RenderCaches.NORMAL
			end
		end

		local targetRender = 0
		local averageLatency = 0
		local deviation = 0
		local bufferedTime = 0

		if renderCache then
			targetRender = renderCache:GetTargetRenderTime()
			const interpolationBuff = renderCache.buffer
			if interpolationBuff then
				averageLatency = interpolationBuff.averageLatency
				deviation = interpolationBuff.deviation
			end
			bufferedTime = ClientClock._getBuffer(renderCache)
		end
		const primaryPart = Entity.GetPrimaryPart(entity)
		const snapshot = entity.snapshot
		const currentPosition = primaryPart and primaryPart.Position
		const snapshots: { SnapshotData } = {}
		if snapshot then
			for _, snap in snapshot.cache do
				table.insert(snapshots, { t = snap.t, value = snap.value, velocity = snap.velocity })
			end
			table.sort(snapshots, function(a: SnapshotData, b: SnapshotData)
				return a.t &gt; b.t
			end)
		end
		const data = {
			id = id,
			entity = entity,
			networkOwner = networkOwner,
			isCharacter = isCharacter,
			config = configName,
			lastReceivedTime = lastRecvTime,
			lastReplicatedTime = lastReplicatedTime,
			targetTime = targetRender,
			averageLatency = averageLatency,
			deviation = deviation,
			bufferedTime = bufferedTime,
			currentPosition = currentPosition,
			snapshots = snapshots,
		}
		table.insert(entities, data)
	end
	Stats.CLIENT_ENTITIES = entities :: any
end

return UpdateEntityStats
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF15"><Properties><string name="Name">Frustum</string><ProtectedString name="Source">const Shared = script.Parent.Parent.Shared

const Types = require(Shared.Types)
const Stats = require(Shared.Stats).CLIENT

const TICKS = 4

local FrustumLookVector = vector.create(0, 0, -1)
local FrustumRightVector = vector.create(1, 0, 0)
local FrustumUpVector = vector.create(0, 1, 0)
local FrustumPosition = vector.create(0, 0, 0)
local TanHorizontal = 0
local TanVertical = 0

local CurrentTick = 0
local OutOfBroadPhaseTick = 0
local TotalCulled = 0

const Frustum = {}

const function Prepare()
	const cam = workspace.CurrentCamera
	if not cam then return end
	const cframe: CFrame = cam.CFrame
	FrustumLookVector = cframe.LookVector :: any
	FrustumRightVector = cframe.RightVector :: any
	FrustumUpVector = cframe.UpVector :: any

	FrustumPosition = cframe.Position :: any

	const halfFov = math.rad(cam.FieldOfView / 2)
	const aspectRatio = math.max(1,cam.ViewportSize.X) / math.max(1,cam.ViewportSize.Y)
	TanHorizontal = math.tan(halfFov) * aspectRatio
	TanVertical = math.tan(halfFov)
end

const function CheckPoint(pos: vector)
	const diff = pos - FrustumPosition

	const magnitude = vector.magnitude(diff)

	if magnitude == 0 then
		return true
	end

	const forwardDis = vector.dot(diff, FrustumLookVector)

	const forwardDot = forwardDis / magnitude
	if forwardDot &lt; 0 then
		return false
	end
	if forwardDis &lt; 1 then
		return true
	end
	const unit = diff / magnitude
	const rightDot = vector.dot(unit, FrustumRightVector)

	if math.abs(rightDot) &gt; forwardDot * TanHorizontal then
		return false
	end

	const upDot = vector.dot(unit, FrustumUpVector)
	if math.abs(upDot) &gt; forwardDot * TanVertical then
		return false
	end
	return true
end

const function CheckBroadPhase(center: vector, size: vector, rotation: CFrame?)
	-- Conservative plane/support-radius test. An intersecting box need not have
	-- any corner inside the camera, particularly when the camera is inside it.
	const delta = center - FrustumPosition
	const half = size * 0.5
	const axes = if rotation then {rotation.RightVector, rotation.UpVector, rotation.ZVector}
		else {Vector3.xAxis, Vector3.yAxis, Vector3.zAxis}
	const dimensions = {half.x, half.y, half.z}
	const planes = {
		FrustumLookVector,
		FrustumRightVector + FrustumLookVector * TanHorizontal,
		-FrustumRightVector + FrustumLookVector * TanHorizontal,
		FrustumUpVector + FrustumLookVector * TanVertical,
		-FrustumUpVector + FrustumLookVector * TanVertical,
	}
	for _, plane in planes do
		local radius = 0
		for index, axis in axes do radius += dimensions[index] * math.abs(vector.dot(axis :: any, plane)) end
		if vector.dot(delta, plane) + radius &lt; -1e-5 then return false end
	end
	return true
end

-- Runs every 4 frames at 60hz so this runs at ~15hz
const function Update()
	CurrentTick += 1
	if CurrentTick % TICKS == 0 then
		Stats.TOTAL_ENTITIES_CULLED = TotalCulled
		TotalCulled = 0
		CurrentTick = 0
	end
end

const function IsThrottled(entity: Types.Entity): boolean
	const slot = entity._outofBroadPhaseTick
	return slot ~= nil and slot ~= CurrentTick
end

const function IsCulled(entity: Types.Entity, targetCFrame: CFrame): boolean
	const broadPhase = entity.broadPhase :: vector
	const toCheck = targetCFrame :: any
	const lastCheckedCFrame = entity.lastCheckedCFrame
	debug.profilebegin("Prepare Frustum")
	const passed = CheckBroadPhase(toCheck.Position, broadPhase, targetCFrame)
	debug.profileend()
	if not passed then
		if lastCheckedCFrame and lastCheckedCFrame.Position ~= toCheck.Position then
			debug.profilebegin("Check Last CFrame")
			const passLast = CheckBroadPhase(lastCheckedCFrame.Position :: any, broadPhase,lastCheckedCFrame)
			debug.profileend()
			if not passLast then
				TotalCulled += 1
				return true
			end
		else
			if not lastCheckedCFrame then
				entity.lastCheckedCFrame = toCheck
			end
			if not entity._outofBroadPhaseTick then
				entity._outofBroadPhaseTick = OutOfBroadPhaseTick
				OutOfBroadPhaseTick += 1
				if OutOfBroadPhaseTick % TICKS == 0 then
					OutOfBroadPhaseTick = 0
				end
			end
			TotalCulled += 1
			return true
		end
	end
	entity.lastCheckedCFrame = nil
	entity._outofBroadPhaseTick = nil
	return false
end

Frustum.Prepare = Prepare
Frustum.CheckPoint = CheckPoint
Frustum.CheckBroadPhase = CheckBroadPhase
Frustum.Update = Update
Frustum.IsThrottled = IsThrottled
Frustum.IsCulled = IsCulled

return Frustum
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF16"><Properties><string name="Name">InterpolationBuffer</string><ProtectedString name="Source">const Warn = require(script.Parent.Parent.Shared.Warn)
const Config = require(script.Parent.Parent.Shared.Config)
const Types = require(script.Parent.Parent.Shared.Types)

local MIN_BUFFER: number
local MAX_BUFFER: number

Config._WaitForLock(function()
	MIN_BUFFER = Config._GetConfig("MIN_BUFFER")
	MAX_BUFFER = Config._GetConfig("MAX_BUFFER")
end)
const Buffer = {}

function Buffer.new(clientClock: Types.ClientClock): Types.InterpolationBuffer
	return {
		init = false,
		averageLatency = 0,
		deviation = 0,
		lastLatency = 0,
		lastSendTime = nil,
		maxSendGap = 0,
		idle = false,
		arrival = nil,
		intervals = {},
		intervalHead = 1,
		interval95 = 0,

		clientClock = clientClock,
	}
end

function Buffer.Register(data: Types.InterpolationBuffer, time: number)
	const clientClock = data.clientClock
	local arrival = os.clock()
	local elapsed = if data.arrival then math.max(0, arrival-data.arrival) else clientClock.tickRate
	local wasIdle = data.idle
	if data.lastSendTime and time &lt;= data.lastSendTime then return end
	if data.arrival and not wasIdle then
		data.intervals[data.intervalHead] = elapsed
		data.intervalHead = data.intervalHead % 64 + 1
		local sorted=table.clone(data.intervals) table.sort(sorted)
		data.interval95=sorted[math.max(1,math.ceil(#sorted*0.95))]
	end
	data.arrival = arrival
	local alpha = 1-math.exp(-elapsed/0.5)
	const clientNow = clientClock:GetEstimatedServerTime()
	const latency = clientNow - time

	if math.abs(latency) &gt; 1 then
		clientClock:Clear()
		Warn.low(data.clientClock.name, ` latency too high, cleared cache to repredict in case of error:! {latency}`)
	end

	const lastSendTime = data.lastSendTime
	if lastSendTime and time &gt; lastSendTime and not data.idle then
		const gap = time - lastSendTime
		if gap &lt;= clientClock.tickRate * 3 then
			data.maxSendGap = if gap &gt; data.maxSendGap
				then gap
				else gap + (data.maxSendGap-gap)*math.exp(-elapsed/3)
		end
	end
	if not lastSendTime or time &gt; lastSendTime then
		data.lastSendTime = time
		data.idle = false
	end

	if not data.init then
		--using the difference between current and last latency, i could smooth out the deviation (the variation in latency, which correlates to packet loss)
		--this is using statistics https://en.wikipedia.org/wiki/Moving_average
		data.averageLatency = latency
		data.deviation = 0
		data.lastLatency = latency
		data.init = true
		return
	end

	if data.lastLatency then
		const delta = math.abs(latency - data.lastLatency)
		--deviation is essentially jitter, and we calculate that using RFC 3550 jitter estimation
		--see: https://tech.ebu.ch/docs/tech/tech3337.pdf
		data.deviation = data.deviation + (delta - data.deviation) * alpha
	end

	data.averageLatency = data.averageLatency + (latency - data.averageLatency) * alpha
	data.lastLatency = latency
end

function Buffer.MarkIdle(data: Types.InterpolationBuffer, time: number)
	const lastSendTime = data.lastSendTime
	if lastSendTime and time &lt; lastSendTime then
		return
	end
	data.lastSendTime = time
	data.idle = true
end

function Buffer.GetBuffer(data: Types.InterpolationBuffer, tickRate: number)
	if not data then
		return MIN_BUFFER
	end

	const deviationMargin = data.deviation * 2
	local interval = data.interval95 or tickRate
	const rawBuffer = math.max(tickRate, data.maxSendGap, interval) + deviationMargin

	local buffer = if rawBuffer &lt; MIN_BUFFER then MIN_BUFFER + (MIN_BUFFER - rawBuffer) * 0.2 else rawBuffer
	if buffer &gt; MAX_BUFFER then
		Warn.low(`Interpolation buffer exceeded max! Was {buffer}, clamped to {MAX_BUFFER} for`, data.clientClock.name)
		buffer = MAX_BUFFER
	end

	return buffer
end

function Buffer.Reset(data)
	data.init=false data.averageLatency=0 data.deviation=0 data.lastLatency=0
	data.lastSendTime=nil data.maxSendGap=0 data.idle=false data.arrival=nil
	data.intervals={} data.intervalHead=1 data.interval95=0
end
return Buffer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF17"><Properties><string name="Name">ModelResolver</string><ProtectedString name="Source">const Warn = require(script.Parent.Parent.Shared.Warn)
const Types = require(script.Parent.Parent.Shared.Types)
const Entity = require(script.Parent.Parent.Shared.Entity)

-- checks if models have been resolved for entities and sets them if they have
return function(entity: Types.Entity)
	const handle = entity._modelHandle
	const model = entity.model
	if not handle or (model and model.Parent) then
		return
	end

	const instance: (Model | BasePart)? = handle:Get() :: any
	if instance and instance.Parent and (instance :: Instance) ~= (model :: Instance?) then
		Entity.SetModel(entity, instance)
		Warn.low(`Model {instance:GetFullName()} was resolved for entity {entity.id}.`)
	end
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF18"><Properties><string name="Name">Player</string><ProtectedString name="Source">const Warn = require(script.Parent.Parent.Shared.Warn)
const Events = require(script.Parent.Parent.Shared.Events)
const Entity = require(script.Parent.Parent.Shared.Entity)
const Holder = require(script.Parent.Parent.Shared.Holder)
const Types = require(script.Parent.Parent.Shared.Types)
const Config = require(script.Parent.Parent.Shared.Config)
const Bin = require(script.Parent.Parent.Shared.Bin)

const LocalPlayer = game:GetService("Players").LocalPlayer
const DeathRemote = script.Parent.Parent.Shared.Remotes.Death

const binClears: { [Types.Entity]: () -&gt; () } = {}

const function IsAutomatic(): boolean
	return Config._GetConfig("PLAYER_REPLICATION") == "AUTOMATIC"
end

const function SetLocalCharacter(model: Model | BasePart?)
	if not model then
		return
	end
	if not model:IsA("Model") then
		Warn.high(`Model for {LocalPlayer} is not a Model instance.`)
		return
	end
	LocalPlayer.Character = model
	const cf = workspace.CurrentCamera.CFrame
	workspace.CurrentCamera.CameraSubject = model:FindFirstChildWhichIsA("Humanoid") or model.PrimaryPart
	workspace.CurrentCamera.CFrame = cf
	-- This was to a fix to resolve custom mode
	for _, v in model:QueryDescendants("LocalScript") do
		if v:IsA("LocalScript") and v.Disabled == false then
			v.Disabled = true
			v.Disabled = false
		end
	end
end

const function OnCharacterRegistered(player: Player, entity: Types.Entity)
	if not IsAutomatic() or Entity.GetModelReplicationType(entity) ~= "CUSTOM" then
		return
	end
	const model = entity.model
	if not model then
		return Warn.high(`No model found for {player}`)
	end
	if not model:IsA("Model") then
		return Warn.high(`Model for {player} is not a Model instance.`)
	end
	player.Character = model

	if player == LocalPlayer then
		Entity.GetEvent(entity, "ModelChanged"):Connect(function(_, newModel)
			SetLocalCharacter(newModel)
		end)
		SetLocalCharacter(model)
	end
end

const function StopWatch(entity: Types.Entity)
	const clear = binClears[entity]
	if clear then
		binClears[entity] = nil
		clear()
	end
end

const function WatchDeath(player: Player, entity: Types.Entity)
	if player ~= LocalPlayer or binClears[entity] then
		return
	end
	const add, clear = Bin()
	const addDied, clearDied = Bin()

	const function CheckHumanoid(_, model: Model | BasePart?)
		clearDied()
		if not model or not entity.isContextOwner or not model:IsA("Model") then
			return
		end
		const humanoid = model:FindFirstChildWhichIsA("Humanoid")
		if humanoid then
			addDied(humanoid.Died:Connect(function()
				if entity.isContextOwner then
					DeathRemote:FireServer(entity.id)
				end
			end))
		end
	end

	add(Entity.GetEvent(entity, "ModelChanged"):Connect(CheckHumanoid))
	add(Entity.GetEvent(entity, "Destroying"):Connect(function()
		StopWatch(entity)
	end))
	add(clearDied)
	binClears[entity] = clear
	CheckHumanoid(entity, entity.model)
end

const function Die(id: number)
	const entity = Holder.GetEntityFromId(id)
	if not entity or entity.isContextOwner then
		return
	end
	const model = entity.model
	if not model then
		return
	end
	task.wait()
	const humanoid = model:FindFirstChildWhichIsA("Humanoid")
	if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
		humanoid.Health = 0
		humanoid.Health = 10
		humanoid.Health = 0
	end
end

Events.PlayerCharacterRegistered:Connect(OnCharacterRegistered)

Config._WaitForLock(function()
	if not IsAutomatic() then
		return
	end
	Events.PlayerOwnedAdded:Connect(WatchDeath)
	Events.PlayerOwnedRemoved:Connect(function(_, entity)
		StopWatch(entity)
	end)
end)

DeathRemote.OnClientEvent:Connect(Die)

return nil
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF19"><Properties><string name="Name">Receiver</string><ProtectedString name="Source">--!native
const RunService = game:GetService("RunService")
const Players = game:GetService("Players")
const Shared = script.Parent.Parent.Shared

const Warn = require(Shared.Warn)
const Entity = require(Shared.Entity)
const Events = require(Shared.Events)
const Holder = require(Shared.Holder)
const ModelHelper = require(Shared.ModelHelper)
const Types = require(Shared.Types)
const ClockUnwrap = require(Shared.ClockUnwrap)
const Stats = require(Shared.Stats).CLIENT
const ClientClock = require(script.Parent.ClientClock)
const Protocol = require(Shared.Protocol)
const StateGate = require(Shared.StateGate)
const ExperimentalPrediction = require(Shared.ExperimentalPrediction)

local BytesReceived = 0
local NewPerSec = 0
local RemovedPerSec = 0
local ChangesPerSec = 0

const SetTickMode = Entity._SetTickMode

const UnreliableEvent = Shared.Remotes.Replicate
const ReliableEvent = Shared.Remotes.ReplicateFull
const HeartbeatRemote = Shared.Remotes.Heartbeat
const ClientClockRelayRemote = Shared.Remotes.ClientClockRelay

const ServerWrap = ClockUnwrap.new()
const ClientOwnedWrap: ClockUnwrap.Store = {}

const function HandleRemoved(id: number, generation: number?, preserveModel: boolean?, anchored: boolean?)
	const entity = Holder.GetEntityFromId(id)
	if entity then
		if generation and entity.generation~=generation then return end
		Entity.Destroy(entity,preserveModel,anchored)
		return
	end
	Warn.high("Tried to remove non existent entity with id", id)
end

const function SetMountId(entity: Types.Entity, mountParentId: number?)
	entity.mountParentId = mountParentId
	Events._Signals.EntityMountChanged:Fire(entity, mountParentId)
end

const function SetMountOffset(entity: Types.Entity, mountOffset: CFrame?)
	entity.mountOffset = mountOffset or CFrame.identity
end

-- This maps SetValue keys to their functions
const ChangedLookUp = {
	networkOwner = Entity._SetEntityNetworkOwner,
	ownershipRevision = function(entity, revision)
		entity.ownershipRevision = revision entity._receivedSequence = nil entity._sendSequence = 0
	end,
	isHalfTicked = SetTickMode,
	_data = Entity.SetData,
	entityConfig = Entity.SetConfig,
	autoUpdatePosition = Entity.SetAutoUpdatePos,
	mountParentId = SetMountId,
	mountOffset = SetMountOffset,
	broadPhase = Entity.SetBroadPhase,
	_interpolationMode = Entity.SetInterpolationMode,
	_humanoidDisabledStates = Entity._SetHumanoidDisabledStates,
	_humanoidState = Entity._SetHumanoidState,
}

const function HandleChanges(changes: { id: number, data: { { any } } })
	const entity = Holder.GetEntityFromId(changes.id)
	if not entity then
		return
	end
	local modelData
	local modelChanged = false
	for _, pair in changes.data do
		const key = pair[1]
		const value = pair[2]

		const handler = ChangedLookUp[key]
		if handler then
			handler(entity, value)
		elseif key == "latestCFrame" then
			Entity.SetCFrame(entity, value)
		elseif key == "model" then
			modelData = value
			modelChanged = true -- value is nil when the model was cleared
		elseif key == "_player" then
			if value then
				Holder.SetAsCharacter(value, entity)
			else
				Holder.RemovePlayerCharacter(entity)
			end
		elseif key == "paused" then
			if value then
				Entity.PauseReplication(entity)
			else
				Entity.ResumeReplication(entity)
			end
		elseif key == "_lockedCFReplication" then
			entity._lockedCFReplication = value
			if not value then
				const part = Entity._GetPart(entity)
				if part then
					Entity._UnlockPartPhysicsReplication(part)
				end
			else
				Entity.SyncOwnerShip(entity)
			end
		else
			Warn.high("Unhandled entity change key:", key)
		end
	end

	if modelChanged then
		const model, modelType, handle = ModelHelper.CreateModelFromData(modelData)
		Entity.SetModel(entity, model, modelType :: any)
		entity._modelHandle = handle
	end
end

const function HandleNewEntity(data: Types.EntityReceivePacket)
	const model, modelType, handle = ModelHelper.CreateModelFromData(data.model)
	local cframe = data.cframe
	const localPlayer = Players.LocalPlayer
	-- initializes cframe for local character just in case client loads in a different spot
	if data.networkOwner == localPlayer and model and model == localPlayer.Character then
		const root = (model :: Model).PrimaryPart
		if root then
			cframe = root.CFrame
		end
	end
	const entity = Entity._new(data.config, model, modelType :: any, cframe)

	entity.id = data.id
	entity.generation = data.generation
	entity.ownershipRevision = data.ownershipRevision or 0
	entity._sendSequence = 0
	entity._receivedSequence = data.sequence
	entity._player = data._player
	entity._modelHandle = handle
	entity.paused = data.paused or false
	entity.autoUpdatePosition = data.autoUpdatePosition or false
	entity.isHalfTicked = data.isHalfTicked
	entity._data = data._data
	entity.mountParentId = data.mountParentId
	entity.mountOffset = data.mountOffset or CFrame.identity
	entity.broadPhase = data.broadPhase or entity.broadPhase
	entity._lockedCFReplication = data._lockedCFReplication or false
	entity._interpolationMode = data._interpolationMode

	Entity._Push(entity, data.time, cframe)

	Entity._SetEntityNetworkOwner(entity, data.networkOwner)
	entity._receivedSequence=data.sequence -- ownership setup may reset the stream

	Entity._SetHumanoidDisabledStates(entity, data._humanoidDisabledStates)
	Entity._SetHumanoidState(entity, data._humanoidState)
	SetTickMode(entity, data.isHalfTicked)
	Holder.RegisterEntity(entity)
end

const function PushCFrameFor(
	id: number,
	clientOwned: boolean,
	cframe: CFrame,
	time: number,
	isHalfTick: boolean,
	teleport: boolean?,
	isStop: boolean?,
	generation: number, ownershipRevision: number, sequence: number
): boolean
	const entity = Holder.GetEntityFromId(id)
	if not entity then
		Warn.high("Received update for non existent entity with id", id)
		return false
	end
	
	if entity.isContextOwner or clientOwned ~= (entity.networkOwner ~= nil)
		or not StateGate.Check(entity,{generation=generation,ownershipRevision=ownershipRevision,sequence=sequence}) then
		return false
	end

	const withinTeleportThreshold = entity._teleport and os.clock() - entity._teleport &lt; 0.5
	if withinTeleportThreshold then
		if teleport then
			entity._teleport = nil
		else
			return false
		end
	end
	if teleport then
		entity._ownerChangedAt = nil
		entity._ownerSmoothing = nil
	end

	if clientOwned then
		const renderCache = entity._clientClock
		if renderCache then
			if isHalfTick then
				renderCache:SetTickRate(renderCache._baseTickRate * 2)
			else
				renderCache:SetTickRate(renderCache._baseTickRate)
			end
			if isStop then
				renderCache:OnStop(time)
			else
				renderCache:OnSnapShot(time)
			end
		end
	else
		const renderCaches = entity.entityConfig.CLIENT_CLOCK
		if renderCaches then
			const renderCache = isHalfTick and renderCaches.HALF or renderCaches.NORMAL
			if renderCache and isStop then
				renderCache:OnStop(time)
			elseif renderCache then
				renderCache:OnSnapShot(time)
			end
		end
	end

	if entity.isHalfTicked ~= isHalfTick then
		SetTickMode(entity, isHalfTick)
	end
	entity.isHalfTicked = isHalfTick

	entity._receivedSequence = sequence
	if isStop then
		Entity._PushStopped(entity, time, cframe)
	else
		Entity._Push(entity, time, cframe)
	end
	ExperimentalPrediction.Observe(entity,time,cframe,if isStop then Vector3.zero else nil,
		if clientOwned then "owner-clock" else "server-clock",teleport)
	return true
end

const function HandlePacket(b, clientOwned, forceStop)
	local rows, reason = Protocol.Decode(b)
	if not rows then Stats.REJECTED_PACKETS = (Stats.REJECTED_PACKETS or 0)+1 Stats.LAST_PACKET_REJECTION = reason return end
	BytesReceived += buffer.len(b)
	for _, row in rows do
		PushCFrameFor(row.id, clientOwned, row.frame, row.time, row.half, row.teleport,
			forceStop or row.stop, row.generation, row.ownershipRevision, row.sequence)
	end
end
const function HandleClientOwned(b) HandlePacket(b, true, false) end
const function HandleServerOwned(b, isStop) HandlePacket(b, false, isStop) end

const function HandleUnreliable(id: string, data: buffer)
	if id == "X" then -- Server Owned
		HandleServerOwned(data)
	elseif id == "O" then -- Client Owned
		HandleClientOwned(data)
	else
		Warn.high("Unknown unreliable replicate id", id)
	end
end

const function HandleReliable(newEntities: { any }, removedEntities: { number }, entityChanges: { any })
	if removedEntities then
		for _, data in removedEntities do
			if type(data)=="table" then HandleRemoved(data.id,data.generation,data.preserveModel,data.anchored)
			else HandleRemoved(data) end
		end
		RemovedPerSec += #removedEntities
	end

	if newEntities then
		for _, data: any in newEntities do
			HandleNewEntity(data)
		end
		NewPerSec += #newEntities
	end

	if entityChanges then
		for _, changeData in entityChanges do
			HandleChanges(changeData)
		end
		ChangesPerSec += #entityChanges
	end
end

UnreliableEvent.OnClientEvent:Connect(HandleUnreliable)
ReliableEvent.OnClientEvent:Connect(HandleReliable)
Shared.Remotes.SafeReplicate.OnClientEvent:Connect(function(id: string, data: buffer)
	if id == "X" then
		HandleServerOwned(data, true)
	elseif id == "O" then
		HandleClientOwned(data)
	else
		Warn.high("Unknown replicate id", id)
	end
end)

HeartbeatRemote.OnClientEvent:Connect(function(time: number)
	const unwrapped = ClockUnwrap.seatFull(ServerWrap, time)
	for clock in ClientClock.serverOwnedClocks do
		clock:Refresh(unwrapped)
	end
end)

-- Syncs each player's clock offset from the server
ClientClockRelayRemote.OnClientEvent:Connect(function(list: { { player: Player, raw: number, offset: number } })
	if type(list) ~= "table" then
		return
	end
	for _, entry in list do
		const player = entry.player
		const raw = entry.raw
		const offset = entry.offset
		if player and player.Parent and type(raw) == "number" and type(offset) == "number" then
			local state = ClientOwnedWrap[player]
			if not state then
				state = ClockUnwrap.new()
				ClientOwnedWrap[player] = state
			end
			state.lastRaw = raw
			state.offset = math.max(state.offset, offset)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	ClientOwnedWrap[player] = nil
end)

local lastByteCheckTime = 0
RunService.Heartbeat:Connect(function()
	if os.clock() - lastByteCheckTime &gt; 1 then
		if not Stats._PAUSE then
			Stats.BYTES_RECEIVED_PER_SEC = BytesReceived
			Stats.NEW_ENTITIES_PER_SEC = NewPerSec
			Stats.ENTITY_CHANGES_PER_SEC = ChangesPerSec
			Stats.ENTITY_REMOVALS_PER_SEC = RemovedPerSec
		end
		NewPerSec = 0
		RemovedPerSec = 0
		ChangesPerSec = 0
		BytesReceived = 0
		lastByteCheckTime = os.clock()
	end
end)

return nil
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF20"><Properties><string name="Name">Replicate</string><ProtectedString name="Source">const Shared = script.Parent.Parent.Shared

const RunService = game:GetService("RunService")

const Ticker = require(Shared.Ticker)
const Warn = require(Shared.Warn)
const ApplyMounts = require(script.Parent.Parent.Shared.ApplyMounts)
const AlignDriver = require(script.Parent.AlignDriver)
const RenderCache = require(script.Parent.ClientClock)
const ModelResolver = require(script.Parent.ModelResolver)
const Entity = require(Shared.Entity)
const Holder = require(Shared.Holder)
const Config = require(Shared.Config)
const Types = require(Shared.Types)
const Sender = require(script.Parent.Sender)
const Frustum = require(script.Parent.Frustum)
const UpdateEntityStats = require(script.Parent.EntityStats)
const Stats = require(Shared.Stats).CLIENT
const VisualSampling = require(Shared.VisualSampling)
const ExperimentalPrediction = require(Shared.ExperimentalPrediction)

const CLIENT_CLOCK_SYNC_RATE = 15 -- should be fine having lower then server
const MAX_OWNER_SMOOTH_DELAY = 2 -- seconds after an ownership change 
require(script.Parent.Player)
require(script.Parent.Receiver)

const idMap = Holder.idMap

local TotalInterpolationTime = 0
local AmtInterpolations = 0

local CheckedThisFrame = 0
local MovedThisFrame = 0

local LastClockUpdate = os.clock()

const function GetMode(entity: Types.Entity): Types.INTERPOLATION_MODE?
	const config = entity.entityConfig
	const mode: Types.INTERPOLATION_MODE? = entity._interpolationMode or config.INTERPOLATION_MODE

	if not mode or not entity.interpolation or config.CUSTOM_INTERPOLATION or mode == "NONE" then
		return nil
	end
	return mode
end

const function CanInterpolate(entity: Types.Entity, primaryPart: BasePart): boolean
	if entity.isContextOwner then
		return false
	end

	if entity.entityConfig.ASSEMBLY_ROOT_PART_CHECK and not entity._alignDriver then
		if primaryPart.AssemblyRootPart ~= primaryPart then
			Warn.low(
				"Primary part for entity "
					.. entity.id
					.. " is not the assembly root part. Skipping interpolation for this entity."
			)
			return false
		end
	end

	if Frustum.IsThrottled(entity) then
		return false
	end

	if not entity.snapshot then
		Warn.medium("No snapshot for entity", entity)
		return false
	end
	return true
end

const function SmoothOwnerChange(entity: Types.Entity, primaryPart: BasePart, targetCFrame: CFrame): CFrame
	const changedAt = entity._ownerChangedAt
	if changedAt then
		entity._ownerChangedAt = nil
		if os.clock() - changedAt &lt; MAX_OWNER_SMOOTH_DELAY then
			const drawn = primaryPart.CFrame
			entity._ownerSmoothing = {
				offset = drawn.Position - targetCFrame.Position,
				rotation = drawn.Rotation * targetCFrame.Rotation:Inverse(),
				start = os.clock(),
			}
		end
	end
	return Entity._ApplyOwnerSmoothing(entity, targetCFrame)
end

const function Interpolate(entity: Types.Entity, mode: Types.INTERPOLATION_MODE)
	const primaryPart = Entity.GetPrimaryPart(entity)
	if not primaryPart or not CanInterpolate(entity, primaryPart) then
		return
	end
	const snapshot = entity.snapshot :: Types.Snapshot&lt;CFrame, Vector3&gt;
	CheckedThisFrame += 1
	debug.profilebegin("Get Render CFrame")
	local targetTime = Entity.GetTargetRenderTime(entity)
	if mode == "ALIGN" then
		targetTime += os.clock() - LastClockUpdate
	end
	local targetCFrame, renderInfo
	local experimental=Config._GetConfig("EXPERIMENTAL_PREDICTION") and Config._GetConfig("EXPERIMENTAL_PREDICTION_DRAW")
	if experimental then
		targetTime+=Config._GetConfig("EXPERIMENTAL_PREDICTION_LEAD")
		targetCFrame,renderInfo=ExperimentalPrediction.Estimate(entity,targetTime)
	end
	if not targetCFrame then
		local refusal=if renderInfo then renderInfo.status else nil
		targetCFrame,renderInfo=VisualSampling.Sample(snapshot, targetTime, Config._GetConfig("VISUAL_CURVE"),
			if experimental then 0 else Config._GetConfig("VISUAL_PREDICTION_SECONDS"), Config._GetConfig("VISUAL_PREDICTION_DISTANCE"), Config._GetConfig("VISUAL_PREDICTION_SPEED"))
		if experimental then renderInfo.experimental=true renderInfo.predictionRefusal=refusal end
	end
	entity.renderInfo = renderInfo
	debug.profileend()
	if not targetCFrame then
		return
	end
	targetCFrame = SmoothOwnerChange(entity, primaryPart, targetCFrame)
	if entity.broadPhase and Frustum.IsCulled(entity, targetCFrame) then
		return
	end
	debug.profilebegin("Set CFrame")
	if targetCFrame == targetCFrame then
		if mode == "ALIGN" then
			AlignDriver.Step(entity, primaryPart, targetCFrame, targetTime)
		else
			AlignDriver.Clear(entity)
			-- Using cframe here instead of bulkmoveto as there were some issues relating to moving the character via bmt.
			-- SEE in ROSS https://discord.com/channels/385151591524597761/1406041519747764374/1408085390618919104
			primaryPart.CFrame = targetCFrame
		end
	end
	MovedThisFrame += 1
	debug.profileend()
end

Config._WaitForLock(function()
	local steppedEntities: { Types.Entity } = {}
	RunService.Heartbeat:Connect(function(deltaTime: number)
		steppedEntities = {}
		Frustum.Update()
		RenderCache.UpdateAll(deltaTime)
		LastClockUpdate = os.clock()
		debug.profilebegin("Prepare Frustum Check")
		Frustum.Prepare()
		debug.profileend()
		local total = 0
		const startTime = os.clock()
		debug.profilebegin("Interpolate Entities")
		for _, entity in idMap do
			ModelResolver(entity)
			if entity.destroyed then
				continue
			end
			if entity.mountParentId then

				AlignDriver.Clear(entity)
				continue
			end
			if entity.paused then
				continue
			end
			total += 1
			const mode: Types.INTERPOLATION_MODE? = GetMode(entity)
			if mode == "ALIGN" then
				if not entity._alignDriver then
					Interpolate(entity, mode)
				end
				table.insert(steppedEntities, entity)
			elseif mode then
				Interpolate(entity, mode)
			elseif entity._alignDriver then
				AlignDriver.Clear(entity)
			end
		end
		debug.profileend()
		const endTime = os.clock()
		debug.profilebegin("Update Entity Stats")
		UpdateEntityStats()
		debug.profileend()
		debug.profilebegin("Apply Velocities")
		AlignDriver.ApplyVelocities()
		debug.profileend()
		TotalInterpolationTime += (endTime - startTime)
		AmtInterpolations += 1

		ApplyMounts()
		if not Stats._PAUSE then
			Stats.TOTAL_CLIENT_ENTITIES_CHECKED_THIS_FRAME = total
			Stats.ENTITIES_MOVED_THIS_FRAME = MovedThisFrame
			Stats.TOTAL_CLIENT_ENTITIES = total
			Stats.AVG_INTERPOLATION_TIME_MS = (TotalInterpolationTime / AmtInterpolations) * 1000
		end
		MovedThisFrame = 0
		CheckedThisFrame = 0
		if AmtInterpolations &gt; 60 then
			TotalInterpolationTime = 0
			AmtInterpolations = 0
		end
		Sender.Update()
		Ticker._IncrementGlobalTick()
	end)

	RunService.PreSimulation:Connect(function()
		-- for align pos
		debug.profilebegin("Interpolate Align Entities")
		Frustum.Prepare()
		for _, entity in steppedEntities do
			if entity.destroyed or entity.paused or entity.mountParentId then
				continue
			end
			if GetMode(entity) == "ALIGN" then
				Interpolate(entity, "ALIGN")
			end
		end
		debug.profileend()
	end)

	const ClientHeartbeatRemote = Shared.Remotes.ClientHeartbeat
	ClientHeartbeatRemote:FireServer(os.clock()) -- seed on join
	local clientHeartbeatAcc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		clientHeartbeatAcc += dt
		if clientHeartbeatAcc &gt;= CLIENT_CLOCK_SYNC_RATE then
			clientHeartbeatAcc = 0
			ClientHeartbeatRemote:FireServer(os.clock())
		end
	end)

	Shared.Remotes.ClientLoaded:FireServer()
end)

return nil
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF21"><Properties><string name="Name">Sender</string><ProtectedString name="Source">const Players = game:GetService("Players")
const LocalPlayer = Players.LocalPlayer

const Shared = script.Parent.Parent.Shared
const Holder = require(Shared.Holder)
const Types = require(Shared.Types)
const Entity = require(Shared.Entity)
const Protocol = require(Shared.Protocol)
const Sequence = require(Shared.Sequence)
local records = {}
const ServerReplicate = require(script.Parent.Parent.Server.Replicate)
const UnreliableEvent = Shared.Remotes.Replicate
const SafeReplicateEvent = Shared.Remotes.SafeReplicate

const ClientOwned = Holder._clientOwned
if not ClientOwned[LocalPlayer] then
	ClientOwned[LocalPlayer] = {}
end
const PlayerEntities = ClientOwned[LocalPlayer]

local clock = 0
local hasTeleport = false
local hasStop = false

const function FireEvent(entity: Types.Entity, eventName: string, ...: any)
	const events = entity._events
	if not events then
		return
	end
	const signal = events[eventName]
	if signal then
		signal:Fire(entity, ...)
	end
end

const function Flush()
	for _, packet in Protocol.Pack(records) do
		if hasTeleport or hasStop then SafeReplicateEvent:FireServer(packet) else UnreliableEvent:FireServer(packet) end
	end
	table.clear(records)
end
const function WriteEntity(id, cf, fullCFrame, halfTicked, teleport, stop)
	local entity = Holder.GetEntityFromId(id)
	if not entity or not entity.generation then return end
	entity._sendSequence = Sequence.Next(entity._sendSequence)
	table.insert(records, Protocol.Record(entity, clock, cf, fullCFrame, halfTicked, teleport, stop))
end
--//This is to catch an edge case where the primarypart hasn't been replicated
const function CheckLocker(entity: Types.Entity)
	if entity._cfLockFailed then
		if entity._lockedCFReplication and entity.isContextOwner and not entity._player then
			const part = Entity._GetPart(entity)
			if part then
				Entity._LockPartPhysicsReplication(part)
				entity._cfLockFailed = nil
			end
		else
			entity._cfLockFailed = nil
		end
	end
end

const function CheckEntity(entity: Types.Entity)
	if entity.destroyed or entity.paused then
		return
	end

	const config = entity.entityConfig
	local tickRate = config.TICK_RATE

	if entity.isHalfTicked then
		tickRate = tickRate * 2
	elseif entity.isHalfTicked == nil then
		return
	end

	const now = clock
	const lastTime = entity.lastReplicatedTime or 0
	const difference = now - lastTime

	if difference &lt; tickRate then
		return
	end
	CheckLocker(entity)
	FireEvent(entity, "Ticked", difference)
	const primaryPart = Entity.GetPrimaryPart(entity)

	if entity.autoUpdatePosition and primaryPart then
		Entity._Push(entity, now, primaryPart.CFrame)
	end

	const currentCFrame = entity.latestCFrame
	const lastCFrame = entity.lastCheckedCFrame
	if currentCFrame and ServerReplicate.HasCFrameChanged(lastCFrame, currentCFrame) then
		entity.lastReplicatedTime = now
		const fullCFrame = config.FULL_ROTATION
		entity.lastCheckedCFrame = currentCFrame
		const teleport = entity._teleport ~= nil
		hasTeleport = hasTeleport or teleport
		WriteEntity(entity.id, currentCFrame, fullCFrame, entity.isHalfTicked, teleport)
		entity._teleport = nil
		const step = if lastCFrame then currentCFrame.Position - lastCFrame.Position else Vector3.zero
		const paused = (entity._idleTicks or 0) &gt; 0
		Entity._RecordMove(entity, step, if paused then math.max(math.round(difference / tickRate), 2) else 1)
	elseif currentCFrame then
		const idleTicks = difference // tickRate
		const stopAfter = entity._stopAfter or 1
		if idleTicks &gt;= stopAfter and (entity._idleTicks or 0) &lt; stopAfter then
			hasStop = true
			WriteEntity(entity.id, currentCFrame, config.FULL_ROTATION, entity.isHalfTicked, false, true)
		end
		entity._idleTicks = idleTicks
	end
end

const function Update()
	clock = os.clock()
	for entity in PlayerEntities do
		CheckEntity(entity)
	end

	Flush()
	hasTeleport = false
	hasStop = false
end

return {
	Update = Update,
}
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="CF22"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="CF23"><Properties><string name="Name">EntityGrid</string><ProtectedString name="Source">--!native
const Players = game:GetService("Players")

const RunService = game:GetService("RunService")

const Events = require(script.Parent.Parent.Shared.Events)
const Config = require(script.Parent.Parent.Shared.Config)
const ReplicationRules = require(script.Parent.Parent.Shared.ReplicationRules)
const RuleAllows = ReplicationRules.Allows
const Stats = require(script.Parent.Parent.Shared.Stats)
const Warn = require(script.Parent.Parent.Shared.Warn)

const Shared = script.Parent.Parent.Shared
const Types = require(Shared.Types)
const Holder = require(Shared.Holder)
const Ticker = require(Shared.Ticker)
const Entity = require(Shared.Entity)
const Signal = require(Shared.Signal)

const SetTickMode = Entity._SetTickMode

type Entity = Types.Entity

local UPDATE_INTERVAL = 0.1
local MAX_TIME_PER_UPDATE = 0.0005

local lastUpdate = 0

Config._WaitForLock(function()
	UPDATE_INTERVAL = Config._GetConfig("GRID_UPDATE_INTERVAL") or UPDATE_INTERVAL
	MAX_TIME_PER_UPDATE = Config._GetConfig("GRID_MAX_UPDATE_TIME") or MAX_TIME_PER_UPDATE
end)

local FULL_TICKED = 0
local HALF_TICKED = 0
local UN_TICKED = 0

type PlayerEntityHolder = Types.PlayerEntityHolder

const entities = Holder.idMap
const playerTablePositionPair: { [PlayerEntityHolder]: vector } = {}
const playerToHolder: { [Player]: PlayerEntityHolder } = {}
const viewerIndex=require(Shared.ViewerIndex).new(64)

const function Check(entity: Entity)
	const part = Entity.GetPrimaryPart(entity)
	const cframe = part and part.CFrame or entity.latestCFrame
	if not cframe or entity.destroyed then
		return
	end
	if entity.id &lt; 1 then
		Warn.high(entity, " has invalid id, cannot check for proximity")
		return
	end
	const position: vector = cframe.Position :: any
	const entityConfig = entity.entityConfig
	local hasNormalTickers = false
	local hasHalfTickers = false
	const halfTickDistance = entityConfig.HALF_TICK_DISTANCE or math.huge
	const normalTickDistance = entityConfig.NORMAL_TICK_DISTANCE or math.huge
	const networkOwner = entity.networkOwner
	const ownedHolder = networkOwner and playerToHolder[networkOwner]

	const isLocked = entity._lockedCFReplication
	const isNotNative = isLocked or entity.modelReplicationMode ~= "NATIVE"
	local candidates=viewerIndex.all
	if isNotNative and halfTickDistance&lt;math.huge then
		candidates=viewerIndex:Query(position,halfTickDistance)
		if ownedHolder and viewerIndex.all[ownedHolder] then candidates[ownedHolder]=viewerIndex.all[ownedHolder] end
	end
	for holder, playerPos in candidates do
		const viewer = holder.PLAYER
		const allowed = RuleAllows(entity, viewer)
		if not allowed then
			continue
		end

		const distance = vector.magnitude(position - playerPos)

		-- if entity is native then we keep it half ticked else remove it
		if distance &gt; halfTickDistance and isNotNative then
			if holder == ownedHolder then -- always replicate to the owner
				hasNormalTickers = true
				table.insert(holder._TEMP_NORMAL, entity)
			end
			continue
		end

		if distance &lt;= normalTickDistance then
			hasNormalTickers = true
			table.insert(holder._TEMP_NORMAL, entity)
		else
			hasHalfTickers = true
			table.insert(holder._TEMP_HALF, entity)
		end
	end

	const configTicker = entityConfig.TICKER
	if not configTicker then
		return
	end

	const currentTicker = entity._ticker
	if hasHalfTickers and not hasNormalTickers then
		SetTickMode(entity, true)
		HALF_TICKED += 1
	elseif hasNormalTickers then
		SetTickMode(entity, false)
		FULL_TICKED += 1
	else
		UN_TICKED += 1
	end
	if (hasNormalTickers or hasHalfTickers) and entity._ticker ~= configTicker then
		Ticker.move(entity, configTicker)
	elseif not (hasNormalTickers or hasHalfTickers) and currentTicker then
		SetTickMode(entity, nil)
		Ticker.Remove(currentTicker, entity)
	end
end

local yielded: thread? = nil
local totalTime = 0
const function DoLoop()
	viewerIndex:Rebuild(playerTablePositionPair)
	totalTime = 0
	FULL_TICKED = 0
	HALF_TICKED = 0
	UN_TICKED = 0
	for holder, _ in playerTablePositionPair do
		table.clear(holder._TEMP_HALF)
		table.clear(holder._TEMP_NORMAL)
	end
	debug.profilebegin("EntityGrid.Update")
	local count = 0
	local start = os.clock()
	local sections = 1
	-- clone as the table could be mutated
	for _, entity in table.clone(entities) do
		debug.profilebegin(`Check One`)
		Check(entity)
		count += 1
		debug.profileend()
		if os.clock() - start &gt; MAX_TIME_PER_UPDATE then
			sections += 1
			debug.profileend()
			totalTime += os.clock() - start
			yielded = coroutine.running()
			coroutine.yield()
			yielded = nil
			start = os.clock()
			debug.profilebegin("EntityGrid.ResumeUpdate")
		end
	end
	debug.profileend()
	totalTime += os.clock() - start
	Stats.SERVER.GRID_UPDATE_SECTIONS = sections
	Stats.SERVER.ENTITY_GRID_UPDATE_TIME_MS = totalTime * 1000
	Stats.SERVER.NUMBER_OF_ENTITIES = count
	Stats.SERVER.ENTITIES_FULL_TICKED = FULL_TICKED
	Stats.SERVER.ENTITIES_HALF_TICKED = HALF_TICKED
	Stats.SERVER.NON_TICKED = UN_TICKED

	for _, holder in playerToHolder do
		table.clear(holder.HALF)
		table.clear(holder.NORMAL)
		for _, entity in holder._TEMP_NORMAL do
			table.insert(holder.NORMAL, entity)
		end
		for _, entity in holder._TEMP_HALF do
			table.insert(holder.HALF, entity)
		end
	end

	if Stats.SERVER._SHOULD_REPLICATE then
		const gridStats = {}
		for _, holder in playerToHolder do
			const entry = { HALF = {}, NORMAL = {} }
			for _, entity in holder.NORMAL do
				table.insert(entry.NORMAL, entity.id)
			end
			for _, entity in holder.HALF do
				table.insert(entry.HALF, entity.id)
			end
			gridStats[holder.PLAYER.Name] = entry
		end
		Stats.SERVER.GRID_STATS = gridStats
	end
end

-- this might be able to be optimized more later
const function Update()
	if yielded then
		task.spawn(yielded)
		return
	end
	if os.clock() - lastUpdate &lt; UPDATE_INTERVAL then
		return
	end
	lastUpdate = os.clock()
	task.spawn(DoLoop)
end

const function UpdatePlayerPosition(player: Player, position: vector)
	const holder = playerToHolder[player]
	if not holder then
		return
	end
	playerTablePositionPair[holder] = position
end

const function GetEntityHolder(Player: Player): PlayerEntityHolder?
	return playerToHolder[Player]
end

const function PlayerAdded(player: Player)
	if playerToHolder[player] then
		return
	end
	const t: PlayerEntityHolder = {
		PLAYER = player,
		HALF = {},
		NORMAL = {},
		REPLICATED = {},
		_TEMP_HALF = {},
		_TEMP_NORMAL = {},
		EntityAdded = Signal.new(),
		EntityRemoving = Signal.new(),
	}
	playerToHolder[player] = t
	playerTablePositionPair[t] = vector.zero

	Events._Signals.PlayerLoaded:Fire(player)
end
if RunService:IsServer() then
	Shared.Remotes.ClientLoaded.OnServerEvent:Connect(PlayerAdded)

	Players.PlayerRemoving:Connect(function(player: Player)
		const holder = playerToHolder[player]
		if not holder then
			return
		end
		holder.EntityAdded:DisconnectAll()
		holder.EntityRemoving:DisconnectAll()
		playerTablePositionPair[holder] = nil
		playerToHolder[player] = nil
	end)
end

return {
	Update = Update,
	UpdatePlayerPosition = UpdatePlayerPosition,
	GetEntityHolder = GetEntityHolder,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF24"><Properties><string name="Name">EntityStats</string><ProtectedString name="Source">const Shared = script.Parent.Parent.Shared

const Types = require(Shared.Types)
const Entity = require(Shared.Entity)
const Holder = require(Shared.Holder)
const Stats = require(Shared.Stats).SERVER

const idMap = Holder.idMap

const function UpdateEntityStats()
	const hasOwned = Stats._SHOULD_REPLICATE
	if not hasOwned then
		Stats.SERVER_ENTITIES = {}
		return
	end
	const entities: { Types.ServerEntitiesStats } = {}

	for _, entity in idMap do
		const networkOwner = entity.networkOwner
		const isCharacter = entity._player ~= nil
		const config = entity.entityConfig
		const configName = config and config.NAME or "DEFAULT"
		const configTickRate = 1 / config.TICK_RATE
		const isHalfTicked = entity.isHalfTicked
		local tickRate = configTickRate
		const lastPosition = entity.latestCFrame and entity.latestCFrame.Position or nil
		if isHalfTicked == true then
			tickRate = tickRate / 2
		elseif isHalfTicked == nil then
			tickRate = 0
		end
		tickRate //= 1
		if tickRate ~= tickRate or tickRate == math.huge then
			tickRate = 0
		end
		const lastTicked = entity.latestTime
		const interpolationMode: Types.INTERPOLATION_MODE = entity._interpolationMode
			or entity.entityConfig.INTERPOLATION_MODE
			or "CFRAME"
		const data: Types.ServerEntitiesStats = {
			isPaused = entity.paused,
			id = entity.id,
			networkOwner = networkOwner,
			isCharacter = isCharacter,
			config = configName,
			tickRate = tickRate,
			lastTicked = lastTicked,
			lastPosition = lastPosition,
			modelType = Entity.GetModelReplicationType(entity),
			interpolationMode = interpolationMode,
		}
		table.insert(entities, data)
	end
	Stats.SERVER_ENTITIES = entities
end

return UpdateEntityStats
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF25"><Properties><string name="Name">Player</string><ProtectedString name="Source">--!native
const Players = game:GetService("Players")

const RunService = game:GetService("RunService")

const Warn = require(script.Parent.Parent.Shared.Warn)
const Config = require(script.Parent.Parent.Shared.Config)
const Entity = require(script.Parent.Parent.Shared.Entity)
const Holder = require(script.Parent.Parent.Shared.Holder)
const Types = require(script.Parent.Parent.Shared.Types)

const playerEntities = Holder._playerChars

const APPEARANCE_TIMEOUT = 3
const loadedAppearance: { [Player]: Model } = {}

const function RegisterPlayer(
	player: Player,
	character: Model,
	configuration: {
		config: string?,
		modelRepMode: Types.MODEL_REPLICATION_MODE?,
	}
): Types.Entity
	const entity = playerEntities[player]

	if entity then
		Entity.Destroy(entity)
	end

	const config = configuration.config or "PLAYER"
	local modelRepMode: Types.MODEL_REPLICATION_MODE? = configuration.modelRepMode
	const configData = Config._EntityConfigs[config] or {} :: any
	modelRepMode = modelRepMode or configData.MODEL_REPLICATION_MODE
	character.Archivable = true

	const humanoid = character:FindFirstChildWhichIsA("Humanoid")
	const hrp = character:FindFirstChild("HumanoidRootPart")
	if humanoid and hrp then
		const rigType = humanoid.RigType
		if rigType == Enum.HumanoidRigType.R6 and character.PrimaryPart == character:FindFirstChild("Head") then
			Config.SetModelPrimaryForChrono(character, "HumanoidRootPart")
		end
	end

	const newEntity = Entity.new(config, character, modelRepMode :: any)

	Holder.SetAsCharacter(player, newEntity)
	Entity.SetNetworkOwner(newEntity, player)

	return newEntity
end

const function UnregisterPlayer(player: Player)
	const entity = playerEntities[player]
	if entity then
		Entity.Destroy(entity)
	end
end

const function OnCharacterAdded(character: Model, player: Player)
	if Config.FLAGS.CHARACTER_WAIT_DELAY then
		const start = os.clock()
		while
			loadedAppearance[player] ~= character
			and player.Character == character
			and os.clock() - start &lt; APPEARANCE_TIMEOUT
		do
			task.wait()
		end
	end
	if player.Character ~= character or not player.Parent then
		return
	end -- edge case
	const existing = playerEntities[player]
	if existing and existing.model == character then
		return 
	end
	RegisterPlayer(player, character, {
		config = "PLAYER",
	})
end

const function OnPlayerAdded(player: Player)
	const appearanceConnection = player.CharacterAppearanceLoaded:Connect(function(character: Model)
		loadedAppearance[player] = character
	end)
	const connection = player.CharacterAdded:Connect(function(character: Model)
		OnCharacterAdded(character, player)
	end)
	if player.Character then
		if player:HasAppearanceLoaded() then
			loadedAppearance[player] = player.Character
		end
		task.spawn(OnCharacterAdded, player.Character, player)
	end
	local connection2: RBXScriptConnection? = nil
	connection2 = player.AncestryChanged:Connect(function()
		if not player:IsDescendantOf(game) then
			loadedAppearance[player] = nil
			appearanceConnection:Disconnect()
			connection:Disconnect()
			if connection2 then
				connection2:Disconnect()
			end
		end
	end)
end

Config._WaitForLock(function()
	if not RunService:IsServer() then
		return
	end
	if Config._GetConfig("PLAYER_REPLICATION") ~= "AUTOMATIC" then
		Warn.low("automatic player replication is disabled")
		return
	end
	const deathRemote = script.Parent.Parent.Shared.Remotes.Death
	const ReplicateMode: "NONE" | "PLAYER_ENTITIES" | "PLAYER_CHARACTERS" = Config._GetConfig("REPLICATE_DEATHS")
	if ReplicateMode ~= "NONE" then
		deathRemote.OnServerEvent:Connect(function(plr, id)
			const entity = Holder.GetEntityFromId(id)
			if not entity then
				return
			end

			if entity.networkOwner ~= plr then
				return
			end
			if ReplicateMode == "PLAYER_CHARACTERS" and not entity._player then
				return
			end

			const model = entity.model
			if model then
				const humanoid: Humanoid? = model:FindFirstChildWhichIsA("Humanoid")
				task.wait()
				if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
					humanoid.Health = 0
					task.delay(0, function()
						if humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
							-- this trick helps force the humanoid to die
							-- since there were some issues we encountered where
							-- the humanoid stayed alive
							humanoid.Health = 0
							humanoid.Health = 10
							humanoid.Health = 0
						end
					end)
				end
			end
			deathRemote:FireAllClients(id)
		end)
	end

	Players.PlayerAdded:Connect(OnPlayerAdded)
	Players.PlayerRemoving:Connect(UnregisterPlayer)

	for _, player in Players:GetPlayers() do
		OnPlayerAdded(player)
	end
end)

return {
	RegisterPlayer = RegisterPlayer,
	UnregisterPlayer = UnregisterPlayer,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF26"><Properties><string name="Name">Receiver</string><ProtectedString name="Source">--!native
const RunService = game:GetService("RunService")
const Players = game:GetService("Players")
const Receiver = {}

const Shared = script.Parent.Parent.Shared
const Types = require(Shared.Types)

type MiddleMan = {
	priority: number,
	func: (player: Player, entity: Types.Entity, cframe: CFrame, arriveTime: number) -&gt; boolean,
}
const MiddleMans: { [string]: MiddleMan } = {}
local SortedMiddleMans: { MiddleMan } = {}
const Ticker = require(Shared.Ticker)
const InterpolationMath = require(Shared.InterpolationMath)
const Warn = require(Shared.Warn)
const ServerClock = require(script.Parent.ServerClock)
const Holder = require(Shared.Holder)
const Entity = require(Shared.Entity)
const Config = require(Shared.Config)
const ClockUnwrap = require(Shared.ClockUnwrap)
const Stats = require(Shared.Stats).SERVER
const Protocol = require(Shared.Protocol)
const StateGate = require(Shared.StateGate)
const RateBudget = require(Shared.RateBudget)
const ExperimentalPrediction = require(Shared.ExperimentalPrediction)
local budgets, heartbeats = {}, {}
local function refused(reason) Stats.REJECTED_PACKETS = (Stats.REJECTED_PACKETS or 0) + 1 Stats.LAST_PACKET_REJECTION = reason end

const ClientClockWrap: ClockUnwrap.Store = {}
local BASE_MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER = 300

Config._WaitForLock(function()
	BASE_MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER = Config._GetConfig("MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER")
end)

local BytesReceived = 0

const UnreliableEvent = Shared.Remotes.Replicate
const SafeReplicateEvent = Shared.Remotes.SafeReplicate

const BASE_TELEPORT_TIME_THRESHOLD = 0.5

const function FireMiddleMans(player: Player, entity: Types.Entity, cframe: CFrame, arriveTime: number): boolean
	if #SortedMiddleMans == 0 then
		return false
	end
	debug.profilebegin("FireMiddleMans")
	for _, mmData in SortedMiddleMans do
		const block = mmData.func(player, entity, cframe, arriveTime)
		if block then
			debug.profileend()
			return true
		end
	end
	debug.profileend()
	return false
end
const function CalculateMaxThroughputForPlayer(player: Player): number
	local numberOfEntities = 0
	for _ in (Holder._clientOwned[player] or {}) :: any do
		numberOfEntities += 1
	end
	return BASE_MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER + numberOfEntities * Protocol.FullBytes
end

const function HandleEntity(
	player: Player,
	id: number,
	serverClock: number,
	clientClock: number,
	cframe: CFrame,
	copyB: buffer,
	isTeleport: boolean,
	isStop: boolean,
	generation: number, ownershipRevision: number, sequence: number
)
	const entity = Holder.GetEntityFromId(id)
	if not StateGate.Check(entity,{generation=generation,ownershipRevision=ownershipRevision,sequence=sequence},player) then
		return
	end

	const position = cframe.Position
	const sum = position.X + position.Y + position.Z
	if sum ~= sum or math.abs(sum) == math.huge then -- NaN or inf
		return
	end

	const teleportTime = entity._teleport
	const ping = math.max(player:GetNetworkPing(), 0) + 0.05

	const withinTeleportThreshold = teleportTime and os.clock() - teleportTime &lt; (BASE_TELEPORT_TIME_THRESHOLD + ping)
	if isTeleport then
		if withinTeleportThreshold then
			entity._teleport = nil
		else
			const packed = buffer.readu8(copyB, 2)
			buffer.writeu8(copyB, 2, bit32.band(packed, bit32.bnot(4)))
		end
	elseif withinTeleportThreshold then
		return
	end

	if entity.lastClientClock and clientClock &lt; entity.lastClientClock then
		return
	end

	if isStop and entity.snapshot and entity.snapshot.stoppedAt then
		isStop = false
		const packed = buffer.readu8(copyB, 2)
		buffer.writeu8(copyB, 2, bit32.band(packed, bit32.bnot(8)))
	end

	debug.profilebegin("HandleEntity.FireMiddleMans")
	if FireMiddleMans(player, entity, cframe, serverClock) then
		debug.profileend()
		return
	end
	debug.profileend()
	local velocity = nil
	if Config.FLAGS.SERVER_VELOCITY_FIX and entity.snapshot and entity.lastClientClock then
		const latest = entity.snapshot:GetLatest()
		const lastClientClock = entity.lastClientClock
		const baseTickRate = entity.entityConfig.TICK_RATE
		const tickrate = if entity.isHalfTicked then baseTickRate * 2 else baseTickRate
		if latest then
			velocity = InterpolationMath.CalculateVelocity(
				latest.value.Position,
				lastClientClock,
				cframe.Position,
				clientClock,
				tickrate
			)
		end
	end
	entity._receivedSequence = sequence
	entity.sourceTime = clientClock
	entity.receivedAt = serverClock
	entity.sourceGrade = "observed"
	const pushed = if isStop
		then Entity._PushStopped(entity, serverClock, cframe)
		else Entity._Push(entity, serverClock, cframe, velocity)
	if pushed then
		ExperimentalPrediction.Observe(entity,clientClock,cframe,if isStop then Vector3.zero else nil,"owner-clock",isTeleport)
		entity.arriveFrame = Ticker.GetGlobalTick()

		entity.lastClientClock = clientClock
		entity.cframeBuffer = copyB
		-- If we update the model on native this will cause the client to also update the model
		if entity.modelReplicationMode == "NATIVE" and not entity._lockedCFReplication then
			return true
		end
		Entity._SetPartCFrame(entity, cframe)
	end
	return pushed
end

const function OnReceive(player: Player, data: buffer)
	if typeof(data) ~= "buffer" or player.Parent == nil then return end
	local now = os.clock()
	local budget = budgets[player]
	if not budget then budget = RateBudget.New(CalculateMaxThroughputForPlayer(player)*60, Protocol.MaxPayload*4, now) budgets[player] = budget end
	budget.rate=CalculateMaxThroughputForPlayer(player)*60
	if not RateBudget.Allow(budget, buffer.len(data), now) then refused("packet_rate") return end
	local rows, reason = Protocol.Decode(data)
	if not rows then refused(reason) return end
	BytesReceived += buffer.len(data)
	-- No clock/history/model is touched until the complete packet decoded successfully.
	local acceptedTime
	for _, row in rows do
		local thread=coroutine.create(HandleEntity)
		local ok, accepted = coroutine.resume(thread, player, row.id, now, row.time, row.frame, row.record,
			row.teleport, row.stop, row.generation, row.ownershipRevision, row.sequence)
		if not ok then refused("packet_handler")
		elseif coroutine.status(thread)~="dead" then coroutine.close(thread) refused("packet_handler_yielded")
		elseif accepted then acceptedTime=if acceptedTime then math.max(acceptedTime,row.time) else row.time end
	end
	if acceptedTime then ServerClock.Store(player, acceptedTime) end
end

const function SortMiddleMans()
	SortedMiddleMans = {}
	for _, data in MiddleMans do
		table.insert(SortedMiddleMans, data)
	end
	table.sort(SortedMiddleMans, function(a: MiddleMan, b: MiddleMan)
		return a.priority &gt; b.priority
	end)
end

--[=[
	Registers a middle man function that can intercept incoming entity updates.

	@param name The unique name of the middle man
	@param priority The priority of the middle man ( higher priority runs first )
	@param func The function to call. Should return true to block the update, else allow it.
]=]
function Receiver.RegisterMiddleMan(
	name: string,
	priority: number,
	func: (
		player: Player,
		entity: Types.Entity,
		cframe: CFrame,
		arriveTime: number
	) -&gt; boolean
)
	MiddleMans[name] = { priority = priority, func = func }
	SortMiddleMans()
end

--[=[
	Unregisters a middle man function.
	@param name The unique name of the middle man
]=]
function Receiver.UnregisterMiddleMan(name: string)
	MiddleMans[name] = nil
	SortMiddleMans()
end

if RunService:IsServer() then
	local lastByteCheckTime = 0
	RunService.Heartbeat:Connect(function()

		if os.clock() - lastByteCheckTime &gt; 1 then
			Stats.BYTES_RECEIVED_PER_SEC = BytesReceived
			BytesReceived = 0
			lastByteCheckTime = os.clock()
		end
	end)
	UnreliableEvent.OnServerEvent:Connect(OnReceive)
	SafeReplicateEvent.OnServerEvent:Connect(OnReceive)

	Shared.Remotes.ClientHeartbeat.OnServerEvent:Connect(function(player: Player, seconds: number)
		if type(seconds) ~= "number" or seconds ~= seconds or seconds &lt; 0 or seconds &gt; 1e12 or player.Parent == nil then
			return
		end
		local b = heartbeats[player] if not b then b = RateBudget.New(1, 4, os.clock()) heartbeats[player] = b end
		if not RateBudget.Allow(b, 1, os.clock()) then return end
		const clientClock = ClockUnwrap.seatFullFor(ClientClockWrap, player, seconds)
		ServerClock.Store(player, clientClock)
	end)

	Players.PlayerRemoving:Connect(function(player)
		ClientClockWrap[player] = nil
		budgets[player], heartbeats[player] = nil, nil
	end)
end

function Receiver._GetClientClockRaws(): { { player: Player, raw: number, offset: number } }
	const out = {}
	for player, state in ClientClockWrap do
		if state.lastRaw then
			table.insert(out, { player = player, raw = state.lastRaw, offset = state.offset })
		end
	end
	return out
end

return Receiver
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF27"><Properties><string name="Name">Replicate</string><ProtectedString name="Source">--!native
const Players = game:GetService("Players")

const RunService = game:GetService("RunService")

const Shared = script.Parent.Parent.Shared

const ApplyMounts = require(Shared.ApplyMounts)
const Warn = require(Shared.Warn)
const Bin = require(Shared.Bin)
const Holder = require(Shared.Holder)
const Events = require(Shared.Events)
const Ticker = require(Shared.Ticker)
const Config = require(Shared.Config)
const Types = require(Shared.Types)
const Entity = require(Shared.Entity)
const Protocol = require(Shared.Protocol)
const Sequence = require(Shared.Sequence)
const ExperimentalPrediction = require(Shared.ExperimentalPrediction)
const EntityGrid = require(script.Parent.EntityGrid)
const UpdateEntityStats = require(script.Parent.EntityStats)
const _Player = require(script.Parent.Player)
const Sender = require(script.Parent.Sender)
const _Receiver = require(script.Parent.Receiver)
const Stats = require(Shared.Stats).SERVER

const HeartbeatRemote = Shared.Remotes.Heartbeat
const ClientClockRelayRemote = Shared.Remotes.ClientClockRelay

const HEARTBEAT_RATE = 1 / 10
local lastHeartbeat = 0

const CLIENT_CLOCK_SYNC_RATE = 60
local lastClientClockRelay = 0

const POSITION_EPSILON = 0.001
const ROTATION_EPSILON = 0.001

const tickers: { Types.Ticker } = {}

Config._WaitForLock(function()
	if not RunService:IsServer() then
		return
	end
	for _, entityConfig in Config._EntityConfigs do
		if entityConfig.TICKER then
			table.insert(tickers, entityConfig.TICKER)
		else
			Warn.high(entityConfig, "TICKERS not found on server config load")
		end
	end
end)

const function HasCFrameChanged(cframe1: CFrame?, cframe2: CFrame?): boolean
	if cframe1 == cframe2 then
		return false
	end
	if cframe1 == nil or cframe2 == nil then
		return true
	end
	return vector.magnitude((cframe1.Position - cframe2.Position) :: any) &gt; POSITION_EPSILON
		or vector.magnitude((cframe1.LookVector - cframe2.LookVector) :: any) &gt; ROTATION_EPSILON
		or vector.magnitude((cframe1.UpVector - cframe2.UpVector) :: any) &gt; ROTATION_EPSILON
end

const function FireEvent(entity: Types.Entity, eventName: string, ...: any)
	const events = entity._events
	if not events then
		return
	end
	const signal = events[eventName]
	if signal then
		signal:Fire(entity, ...)
	end
end

const function SerializeEntityCFrame(entity, time: number, cframe: CFrame, useFull: boolean, stop: boolean?): buffer
	entity._sendSequence = Sequence.Next(entity._sendSequence)
	return Protocol.Record(entity, time, cframe, useFull, entity.isHalfTicked, false, stop)
end

const function PushLatest(entity: Types.Entity, time: number)
	if entity.autoUpdatePosition and entity.isContextOwner and entity.model then
		const primaryPart = Entity.GetPrimaryPart(entity)
		if not primaryPart then
			Warn.low("Entity", entity, "has no primary part")
			return
		end
		const cframe = primaryPart.CFrame
		Entity._Push(entity, time, cframe)
		-- Derive from captured poses. Lock helpers/constraints can have unrelated
		-- physics velocities even when the game's authored transform is well behaved.
		ExperimentalPrediction.Observe(entity,time,cframe,nil,"server-clock")
	end
end

const function CheckForChanges(entity: Types.Entity): CFrame?
	const lastCFrame = entity.lastCheckedCFrame
	const currentCFrame = entity.latestCFrame

	if HasCFrameChanged(lastCFrame, currentCFrame) then
		entity.lastCheckedCFrame = currentCFrame
		return currentCFrame
	end
	return nil
end

const function CheckEntity(entity: Types.Entity, ticker: Types.Ticker, useFull: boolean, isHalfTick: boolean)
	if entity.destroyed then
		Ticker.Remove(ticker, entity)
		return
	end

	if not entity.isContextOwner then
		return
	end

	const entityIsHalf = entity.isHalfTicked
	entity._halfBuffer = nil
	if (entityIsHalf and not isHalfTick) or entity.paused then
		entity.cframeBuffer = nil
		return
	end
	if entityIsHalf then
		FireEvent(entity, "Ticked", ticker.halfdt)
	else
		FireEvent(entity, "Ticked", ticker.dt)
	end

	PushLatest(entity, ticker.lastTicked)
	const previous = entity.lastCheckedCFrame
	const changes = CheckForChanges(entity)

	if changes then
		if entity.id == 0 then
			Warn.high(entity, "has an id of 0, skipping replication")
			entity.cframeBuffer = nil
			return
		end
		entity.cframeBuffer = SerializeEntityCFrame(entity, ticker.lastTicked, changes, useFull)
		const step = if previous then changes.Position - previous.Position else Vector3.zero
		Entity._RecordMove(entity, step, (entity._idleTicks or 0) + 1)
	else
		entity.cframeBuffer = nil
		const idleTicks = (entity._idleTicks or 0) + 1
		entity._idleTicks = idleTicks
		const resting = entity.lastCheckedCFrame
		if resting and idleTicks == (entity._stopAfter or 1) then
			entity.cframeBuffer = SerializeEntityCFrame(entity, ticker.lastTicked, resting, useFull, true)
		elseif resting and isHalfTick and idleTicks == 1 and not entityIsHalf then
			entity._halfBuffer = SerializeEntityCFrame(entity, ticker.lastTicked, resting, useFull, true)
		end
	end
end

const Changes: { Types.Entity } = {}

--In the future we can optimize this so it uses buffers if really needed
const function CheckEntityChanges()
	for entity, changes in Holder._entityChangedFields do
		const newChanges = { id = entity.id, data = {} }
		for key, data in changes do
			data = data or (entity :: any)[key]
			table.insert(newChanges.data, { key, data })
		end
		Holder._entityChangedFields[entity] = nil
		entity._changes = newChanges
		table.insert(Changes, entity)
	end
end

local TotalTickerTime = 0
local CountTicker = 0

const function UpdateTickers()
	debug.profilebegin("UpdateTickers")
	const starts = os.clock()
	for _, ticker in tickers do
		if not next(ticker.objects) then
			continue
		end
		debug.profilebegin(`{ticker.config.NAME}`)
		if Ticker.CheckUpdate(ticker) then
			const useFull = ticker.config.FULL_ROTATION == true
			const isHalfTick = ticker.tickedHalf
			for _, object in ticker.objects do
				CheckEntity(object, ticker, useFull, isHalfTick)
			end
		end
		debug.profileend()
	end
	debug.profileend()
	const diff = os.clock() - starts
	TotalTickerTime += diff
	CountTicker += 1
	Stats.AVG_TICKER_TIME_MS = (TotalTickerTime / CountTicker) * 1000
	if CountTicker &gt;= 60 then
		TotalTickerTime = 0
		CountTicker = 0
	end
end

const function UpdatePlayerPositions()
	for _, entity: Types.Entity in Holder._playerChars do
		const player = entity.networkOwner
		const primaryPart = Entity.GetPrimaryPart(entity)
		const cframe = primaryPart and primaryPart.CFrame or entity.latestCFrame

		if player and cframe then
			EntityGrid.UpdatePlayerPosition(player, cframe.Position :: any)
		end
	end
end

const function UpdateHeartbeat()
	const now = os.clock()
	if now - lastHeartbeat &gt;= HEARTBEAT_RATE then
		lastHeartbeat = now
		for _, player in Players:GetPlayers() do
			if not EntityGrid.GetEntityHolder(player) then
				continue
			end
			HeartbeatRemote:FireClient(player, now)
		end
	end
end

const function UpdateClientClockRelay()
	const now = os.clock()
	if now - lastClientClockRelay &lt; CLIENT_CLOCK_SYNC_RATE then
		return
	end
	lastClientClockRelay = now

	const raws = _Receiver._GetClientClockRaws()
	if #raws == 0 then
		return
	end

	ClientClockRelayRemote:FireAllClients(raws)
end

const function Update()
	EntityGrid.Update()
	UpdatePlayerPositions()
	ApplyMounts()
	UpdateTickers()
	CheckEntityChanges()
	UpdateHeartbeat()
	UpdateClientClockRelay()

	for _, player in Players:GetPlayers() do
		Sender.ReplicatePlayer(player)
	end
	for _, entity in Changes do
		entity._changes = nil
	end
	table.clear(Changes)
	UpdateEntityStats()
	Ticker._IncrementGlobalTick()
end

const function HandleEntity(plr: Player, entity: Types.Entity)
	if entity.destroyed or entity.networkOwner ~= plr then
		return
	end
	const addModel, clearModel = Bin()

	const function HandleModel()
		if not entity.model then
			return
		end

		const partToUse = Entity._GetRootPart(entity)

		if not partToUse then
			return
		end

		const function CFrameChanged()
			const cframe = partToUse.CFrame
			if entity.mountParentId then
				entity.latestCFrame = cframe
				return
			end
			if cframe == entity.latestCFrame then
				return
			end

			Entity.SetCFrame(entity, cframe)
		end

		addModel(partToUse:GetPropertyChangedSignal("CFrame"):Connect(CFrameChanged))
	end
	const function Rebind()
		clearModel()
		HandleModel()
	end
	const addEntity, clearEntity = Bin()
	const function Cleanup()
		clearModel()
		clearEntity()
	end
	addEntity(Entity.GetEvent(entity, "ModelChanged"):Connect(Rebind))
	addEntity(Entity.GetEvent(entity, "LockChanged"):Connect(Rebind))
	addEntity(Entity.GetEvent(entity, "NetworkOwnerChanged"):Once(Cleanup))
	addEntity(Entity.GetEvent(entity, "Destroying"):Once(Cleanup))

	HandleModel()
end

const function HandleCFrameSetters()
	const mode: "NONE" | "PLAYER_ENTITIES" | "PLAYER_CHARACTERS" = Config._GetConfig("REPLICATE_CFRAME_SETTERS")
	if mode == "NONE" then
		return
	end
	if mode == "PLAYER_ENTITIES" then
		Events.PlayerOwnedAdded:Connect(HandleEntity, true)
	else
		Events.PlayerCharacterRegistered:Connect(HandleEntity, true)
	end

	for _, entity in Holder.idMap do
		if mode == "PLAYER_ENTITIES" and entity.networkOwner then
			HandleEntity(entity.networkOwner, entity)
		elseif mode == "PLAYER_CHARACTERS" and entity._player then
			HandleEntity(entity._player, entity)
		end
	end
end

const function PlayerAdded(plr: Player)
	const raws = _Receiver._GetClientClockRaws()
	ClientClockRelayRemote:FireAllClients(raws)
end

Config._WaitForLock(function()
	if not RunService:IsServer() then
		return
	end
	HandleCFrameSetters()
	Events._Signals.PlayerLoaded.Event:Connect(PlayerAdded)
	RunService.PostSimulation:Connect(Update)
end)

return {
	HasCFrameChanged = HasCFrameChanged,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF28"><Properties><string name="Name">Sender</string><ProtectedString name="Source">--!native
const RunService = game:GetService("RunService")

const Ticker = require(script.Parent.Parent.Shared.Ticker)
const Entity = require(script.Parent.Parent.Shared.Entity)
const EntityGrid = require(script.Parent.EntityGrid)
const Types = require(script.Parent.Parent.Shared.Types)
const Shared = script.Parent.Parent.Shared
const ModelHelper = require(Shared.ModelHelper)
const Stats = require(Shared.Stats).SERVER
const Protocol = require(Shared.Protocol)

local BytesSentPerSec = 0
local PacketsSentPerSec = 0


type BufferHolder = { [Types.Ticker]: { buffer } }
const UnreliableEvent = Shared.Remotes.Replicate
const ReliableEvent = Shared.Remotes.ReplicateFull
const SafeReplicateEvent = Shared.Remotes.SafeReplicate

const function SendRecords(player, rows, kind, event)
	for _, packet in Protocol.Pack(rows) do
		(event or UnreliableEvent):FireClient(player, kind, packet)
		BytesSentPerSec += buffer.len(packet)
		PacketsSentPerSec += 1
	end
end
const function FlushClientOwned(player, groups, event)
	local rows = {}
	for _, records in groups do for _, record in records do table.insert(rows, record) end end
	SendRecords(player, rows, "O", event)
end
const function FlushEntities(player, groups, isHalf, event)
	local rows = {}
	for _, records in groups do for _, record in records do table.insert(rows, Protocol.WithHalf(record, isHalf == true)) end end
	SendRecords(player, rows, "X", event)
end

const function AddBuffer(holder: BufferHolder, ticker: Types.Ticker, b: buffer)
	local bufferTable = holder[ticker]
	if not bufferTable then
		bufferTable = {}
		holder[ticker] = bufferTable
	end
	table.insert(bufferTable, b)
end

--//honestly tables should beeeee fine for nowww, could buffer it later if reallllly needed
const function GetEntityFullData(player: Player, entity: Types.Entity): Types.EntityReceivePacket?
	if entity.destroyed then
		return nil
	end
	const modelData = ModelHelper.ReadyModelFromRep(entity, player)

	local configName: string? = entity.entityConfig.NAME
	if configName == "DEFAULT" then
		configName = nil
	end

	local cframe = entity.latestCFrame or CFrame.identity
	local time = entity.lastClientClock or 0

	if entity.isContextOwner then
		const primaryPart = Entity.GetPrimaryPart(entity)
		if primaryPart then
			cframe = primaryPart.CFrame
		end

		time = os.clock()
	end

	return {
		id = entity.id,
		generation = entity.generation, ownershipRevision = entity.ownershipRevision or 0,
		sequence = entity._receivedSequence or entity._sendSequence or 0,
		_player = entity._player,
		networkOwner = entity.networkOwner,
		cframe = cframe,
		time = time,
		config = configName,

		model = modelData,

		paused = entity.paused,
		autoUpdatePosition = entity.autoUpdatePosition,
		isHalfTicked = entity.isHalfTicked,
		_data = entity._data,
		_lockedCFReplication = entity._lockedCFReplication,
		_interpolationMode = entity._interpolationMode,
		_humanoidState = entity._humanoidState,
		_humanoidDisabledStates = entity._humanoidDisabledStates,

		mountParentId = entity.mountParentId,
		mountOffset = entity.mountOffset,
		broadPhase = entity.broadPhase :: any,
	}
end

local playerReplicateTotal = 0
local playerReplicateCount = 0
const function ReplicatePlayer(player: Player)
	const holder = EntityGrid.GetEntityHolder(player)
	if not holder then
		return
	end
	debug.profilebegin("ReplicatePlayer")
	const replicatedOLD = holder.REPLICATED -- Leftovers will be removed
	const replicated = table.clone(replicatedOLD)
	holder.REPLICATED = replicated

	const holderEntityAdded = holder.EntityAdded
	const holderEntityRemoving = holder.EntityRemoving
	const normal = holder.NORMAL
	const half = holder.HALF

	const toSendFull = {}
	const toRemove = {}
	const clientOwned = {}
	const clientReliable = {}
	const entityChanges = {}

	const normalBuffers: BufferHolder = {}
	const halfBuffers: BufferHolder = {}
	const normalStops: BufferHolder = {}
	const halfStops: BufferHolder = {}
	const frameTimeNow = Ticker.GetGlobalTick()

	const function HandleClientEntities(entity: Types.Entity)
		if entity.arriveFrame ~= frameTimeNow then -- (time will be the same during the same frame)
			return
		end
		if entity.networkOwner == player then
			return
		end
		const clientTime = entity.lastClientClock or 0
		const cframeBuffer = entity.cframeBuffer :: buffer
		const reliable = bit32.band(buffer.readu8(cframeBuffer, 2), 12) ~= 0 -- teleport or stop
		const target = if reliable then clientReliable else clientOwned
		if not target[clientTime] then
			target[clientTime] = {}
		end

		table.insert(target[clientTime], cframeBuffer)
	end

	const function Handle(entity: Types.Entity, isNormal: boolean)
		if entity.destroyed then
			return
		end
		replicated[entity] = true
		if not replicatedOLD[entity] then
			holderEntityAdded:Fire(entity)
			table.insert(toSendFull, GetEntityFullData(player, entity))
			return
		end
		if entity._changes then
			table.insert(entityChanges, entity._changes)
		end
		replicatedOLD[entity] = nil
		if entity.paused then
			return
		end

		const isServerOwned = entity.isContextOwner
		if not isServerOwned then
			HandleClientEntities(entity)
			return
		end

		const ticker = entity._ticker
		if not (ticker and ticker.tickedFrame == frameTimeNow) then
			return
		end

		const isHalf = entity.isHalfTicked or not isNormal
		const cframeBuffer = entity.cframeBuffer

		if cframeBuffer and (entity._idleTicks or 0) &gt; 0 then
			AddBuffer(isHalf and halfStops or normalStops, ticker, cframeBuffer)
			return
		end

		if isHalf and not ticker.tickedHalf then
			return
		end

		const toSend = if isHalf then cframeBuffer or entity._halfBuffer else cframeBuffer
		if toSend then
			AddBuffer(isHalf and halfBuffers or normalBuffers, ticker, toSend)
		end
	end
	const startTime = os.clock()
	for _, entity in normal do
		Handle(entity, true)
	end
	for _, entity in half do
		Handle(entity, false)
	end

	for entity, _ in replicatedOLD do
		replicated[entity] = nil
		holderEntityRemoving:Fire(entity)
		table.insert(toRemove,{id=entity._lastId or entity.id,generation=entity.generation,
			preserveModel=entity._preserveModelOnRemoval==true,anchored=entity._removalAnchor})
	end

	FlushClientOwned(player, clientOwned)
	FlushEntities(player, normalBuffers)
	FlushEntities(player, halfBuffers, true)

	FlushClientOwned(player, clientReliable, SafeReplicateEvent)
	FlushEntities(player, normalStops, false, SafeReplicateEvent)
	FlushEntities(player, halfStops, true, SafeReplicateEvent)

	if #toRemove &gt; 0 or #toSendFull &gt; 0 or #entityChanges &gt; 0 then
		ReliableEvent:FireClient(player, toSendFull, toRemove, entityChanges)
	end
	debug.profileend()
	const endTime = os.clock()
	playerReplicateTotal += endTime - startTime
	playerReplicateCount += 1
end

local lastStatTime = os.clock()

if RunService:IsServer() then
	RunService.Heartbeat:Connect(function()
		Stats.REPLICATE_PLAYER_TIME_MS = playerReplicateTotal / math.max(playerReplicateCount, 1) * 1000
		if os.clock() - lastStatTime &gt; 1 then
			Stats.BYTES_SENT_PER_SEC = BytesSentPerSec
			Stats.PACKETS_SENT_PER_SEC = PacketsSentPerSec
			BytesSentPerSec = 0
			PacketsSentPerSec = 0
			lastStatTime = os.clock()
			playerReplicateTotal = 0
			playerReplicateCount = 0
		end
	end)
end

return {
	ReplicatePlayer = ReplicatePlayer,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF29"><Properties><string name="Name">ServerClock</string><ProtectedString name="Source">const Players = game:GetService("Players")
const Types = require(script.Parent.Parent.Shared.Types)


const ServerClockData = {} :: { [Player]: {
	arrivalOffset: number,
} }

const SMOOTHING = 0.2
const DEFAULT_MAX_REWIND = 1

const function Store(player: Player, clientClockTime: number)
	const measured = os.clock() - clientClockTime
	const data = ServerClockData[player]
	if not data then
		ServerClockData[player] = { arrivalOffset = measured }
		return
	end
	data.arrivalOffset += SMOOTHING * (measured - data.arrivalOffset)
end

const function ConvertTo(player: Player, clock: number, environment: "Server" | "Client")
	const data = ServerClockData[player]
	if not data then
		return clock
	end

	if environment == "Server" then
		return clock + data.arrivalOffset
	else
		return clock - data.arrivalOffset
	end
end

--[=[
	Converts a client's render time for an entity 
	into the server's timeline, ready for Entity.GetAt. Clamped to the last maxRewind seconds.

	@param maxRewind How far back to allow, in seconds. Defaults to 1.
]=]
const function ToServerTime(entity: Types.Entity?, renderTime: number, maxRewind: number?): number?
	if not entity or type(renderTime) ~= "number" or renderTime ~= renderTime then
		return nil
	end
	local serverTime = renderTime
	const owner = entity.networkOwner
	if owner then
		const data = ServerClockData[owner]
		if not data then
			return nil
		end
		serverTime += data.arrivalOffset
	end
	local window = maxRewind or DEFAULT_MAX_REWIND
	if not (window &gt;= 0) then -- negative or NaN
		window = DEFAULT_MAX_REWIND
	end
	const now = os.clock()
	return math.clamp(serverTime, now - window, now)
end

const function Remove(player: Player)
	ServerClockData[player] = nil
end

Players.PlayerRemoving:Connect(Remove)

return {
	Store = Store,
	ConvertTo = ConvertTo,
	ToServerTime = ToServerTime,
	Remove = Remove,
}
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="CF30"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="CF31"><Properties><string name="Name">ApplyMounts</string><ProtectedString name="Source">--!native

const IS_SERVER = game:GetService("RunService"):IsServer()

const Entity = require(script.Parent.Entity)
const Events = require(script.Parent.Events)
const Holder = require(script.Parent.Holder)
const Types = require(script.Parent.Types)

local timestamp = 0
const visited = {} :: { [Types.Entity]: number }
const dp = {} :: { [Types.Entity]: number }
const world = {} :: { [Types.Entity]: CFrame }

const path = {} :: { Types.Entity }
const mountedEntities = {} :: { [Types.Entity]: true }

const function SetCFrame(entity: Types.Entity, cframe: CFrame)
	const root = Entity._GetRootPart(entity)
	if root then
		root.CFrame = cframe
		if entity.isContextOwner then
			root.AssemblyAngularVelocity = Vector3.zero
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end
const function ResolveWorldCFrame(entity: Types.Entity): CFrame
	const currentTime = timestamp
	if dp[entity] == currentTime then
		return world[entity]
	end

	local n = 0
	local current = entity
	local rootCFrame = CFrame.identity

	while true do
		if dp[current] == currentTime then
			rootCFrame = world[current]
			break
		end

		if visited[current] == currentTime then
			--cycle detected
			rootCFrame = Entity.GetAt(current, Entity.GetTargetRenderTime(current))
				or current.latestCFrame
				or CFrame.identity
			dp[current] = currentTime
			world[current] = rootCFrame
			SetCFrame(current, rootCFrame)
			break
		end

		visited[current] = currentTime

		const parentId = current.mountParentId
		if not parentId then
			if current.isContextOwner then
				const part = Entity.GetPrimaryPart(current)
				rootCFrame = if part then part.CFrame else (current.latestCFrame or CFrame.identity)
			else
				const at = Entity.GetAt(current, Entity.GetTargetRenderTime(current))
				const part = if at then nil else Entity.GetPrimaryPart(current)
				rootCFrame = if at
					then Entity._ApplyOwnerSmoothing(current, at)
					elseif part then part.CFrame
					else (current.latestCFrame or CFrame.identity)
			end
			dp[current] = currentTime
			world[current] = rootCFrame
			break
		end

		const parent = Holder.GetEntityFromId(parentId)
		if not parent or parent.destroyed then
			rootCFrame = Entity.GetAt(current, Entity.GetTargetRenderTime(current))
				or current.latestCFrame
				or CFrame.identity
			dp[current] = currentTime
			world[current] = rootCFrame
			SetCFrame(current, rootCFrame)
			break
		end

		n += 1
		path[n] = current
		current = parent
	end

	local out = rootCFrame or CFrame.identity
	for i = n, 1, -1 do
		const child = path[i]
		out = out * (child.mountOffset or CFrame.identity)
		dp[child] = currentTime
		world[child] = out
		SetCFrame(child, out)
		path[i] = nil
	end

	if dp[entity] ~= currentTime then
		dp[entity] = currentTime
		world[entity] = out
		SetCFrame(entity, out)
	end

	return world[entity]
end

Events.EntityAdded:Connect(function(entity: Types.Entity)
	if entity.mountParentId then
		mountedEntities[entity] = true
	end
end, true)

Events.EntityMountChanged:Connect(function(entity: Types.Entity, mountParentId: number?)
	if mountParentId then
		mountedEntities[entity] = true
	else
		mountedEntities[entity] = nil
	end
end, true)

Events.EntityRemoved:Connect(function(entity: Types.Entity)
	visited[entity] = nil
	dp[entity] = nil
	world[entity] = nil
	mountedEntities[entity] = nil

	if IS_SERVER then
		const id = entity._lastId or entity.id
		const children = {}
		for child in mountedEntities do
			if child.mountParentId == id and not child.destroyed then
				table.insert(children, child)
			end
		end
		for _, child in children do
			Entity.ClearMount(child)
		end
	end
end, true)

const function ApplyMounts()
	debug.profilebegin("ApplyMounts")
	for entity in mountedEntities do
		if entity.destroyed or dp[entity] == timestamp then
			continue
		end
		ResolveWorldCFrame(entity)
	end
	timestamp += 1
	debug.profileend()
end

return ApplyMounts
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF32"><Properties><string name="Name">Bin</string><ProtectedString name="Source">const Types = require(script.Parent.Types)

type BinItem =
	Instance
	| RBXScriptConnection
	| thread
	| (() -&gt; ...any)
	| Types.Connection
	| Types.Signal&lt;any, ...any&gt;
	| { _binCleanup: (...any) -&gt; () }

export type Add = &lt;T&gt;(Item: T &amp; BinItem) -&gt; T
export type Clear = () -&gt; ()

return function(): (Add, Clear)
	const Bin: { BinItem } = {}

	return function&lt;T&gt;(Item: T &amp; BinItem)
		table.insert(Bin, Item :: any)

		return Item
	end :: any,
		function()
			for _, Item in Bin do
				if typeof(Item) == "Instance" then
					Item:Destroy()
				elseif typeof(Item) == "RBXScriptConnection" then
					Item:Disconnect()
				elseif typeof(Item) == "function" then
					task.spawn(Item)
				elseif typeof(Item) == "thread" then
					pcall(task.cancel, Item) -- must pcall or could error when passing its own thread in
				elseif typeof(Item) == "table" and Item._binCleanup and type(Item._binCleanup) == "function" then
					(Item :: any):_binCleanup()
				end
			end

			table.clear(Bin)
		end
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF33"><Properties><string name="Name">CFrameLock</string><ProtectedString name="Source">const RunService = game:GetService("RunService")

const IS_SERVER = RunService:IsServer()
const LOCKER_NAME = "__CHRONO_LOCKER"

const function SafeSetNetworkOwner(part: BasePart, player: Player?)
	if part:CanSetNetworkOwnership() then
		part:SetNetworkOwner(player)
	end
end

const function GetLockedRoot(part: BasePart): BasePart?
	const locker = part:FindFirstChild(LOCKER_NAME)
	if not locker then
		return nil
	end
	return locker:FindFirstChildWhichIsA("BasePart") or part
end

const function LockCFReplication(part: BasePart?): BasePart?
	if not part then
		return nil
	end
	const initCF = part.CFrame
	const previousLocker = part:FindFirstChild(LOCKER_NAME)
	if previousLocker then
		const weld = previousLocker:FindFirstChild("__CHRONO_WELD") :: Motor6D
		if weld then
			weld.Part1 = part
			part.CFrame = initCF
			return weld.Part0
		else
			pcall(previousLocker.Destroy, previousLocker)
		end
	end
	--[[
		This trick helps disable roblox's cf replication by create a part that
		take priority and acts like the root part which we call the locker.
		The locker part will be hidden on the server in a camera which will
		cause roblox to not replicate the locker to the client which will
		disable roblox's cf replication.
	]]
	const camera = Instance.new("Camera", part)
	camera.Archivable = false
	camera.Name = LOCKER_NAME
	const weld = Instance.new("Weld", camera)
	weld.Name = "__CHRONO_WELD"
	const locker = Instance.new("Part")
	locker.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0, 0, 0)
	locker.Name = "__CHRONO_LOCKER_PART"
	locker.Parent = camera
	locker.CanCollide = false
	locker.CanQuery = false
	locker.CanTouch = false
	locker.Transparency = if IS_SERVER then 0 else 1
	locker.Color = Color3.new(1, 0, 0)
	locker.Massless = false
	locker.RootPriority = 126
	locker.Size = Vector3.zero
	weld.Part0 = locker
	weld.Part1 = part
	part.CFrame = initCF
	return locker
end

const function UnlockCFReplication(part: BasePart?)
	if not part then
		return
	end
	const cf = part.CFrame
	const locker = part:FindFirstChild(LOCKER_NAME)
	if locker then
		-- Safer to destroy and recreate than to reuse the weld
		locker:Destroy()
		part.CFrame = cf
	end
end

return {
	Lock = LockCFReplication,
	Unlock = UnlockCFReplication,
	GetLockedRoot = GetLockedRoot,
	SafeSetNetworkOwner = SafeSetNetworkOwner,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF34"><Properties><string name="Name">ClockUnwrap</string><ProtectedString name="Source">--!native

const CLOCK_SCALE = 10000
const TWO32 = 2 ^ 32
const TWO31 = 2 ^ 31
const CLOCK_WRAP = TWO32 / CLOCK_SCALE

export type State = { lastRaw: number?, offset: number }
export type Store = { [any]: State }

const ClockUnwrap = {}
ClockUnwrap.SCALE = CLOCK_SCALE
ClockUnwrap.WRAP = CLOCK_WRAP

function ClockUnwrap.quantize(seconds: number): number
	return math.floor(seconds * CLOCK_SCALE) % TWO32
end

function ClockUnwrap.new(): State
	return { lastRaw = nil, offset = 0 }
end

-- for u32
function ClockUnwrap.unwrap(state: State, raw: number): number
	raw %= TWO32
	const lastRaw = state.lastRaw
	if lastRaw then
		const diff = (raw - lastRaw) % TWO32
		if diff &lt; TWO31 then
			if raw &lt; lastRaw then
				state.offset += CLOCK_WRAP
			end
			state.lastRaw = raw
		else
			return (lastRaw + state.offset * CLOCK_SCALE - (TWO32 - diff)) / CLOCK_SCALE
		end
	else
		state.lastRaw = raw
	end
	return raw / CLOCK_SCALE + state.offset
end

function ClockUnwrap.unwrapFor(store: Store, key: any, raw: number): number
	local state = store[key]
	if not state then
		state = ClockUnwrap.new()
		store[key] = state
	end
	return ClockUnwrap.unwrap(state, raw)
end

-- for f64 syncing
function ClockUnwrap.seatFull(state: State, seconds: number): number
	const scaled = math.floor(seconds * CLOCK_SCALE)
	const raw = scaled % TWO32
	state.lastRaw = raw
	state.offset = (scaled - raw) / CLOCK_SCALE
	return scaled / CLOCK_SCALE
end

function ClockUnwrap.seatFullFor(store: Store, key: any, seconds: number): number
	local state = store[key]
	if not state then
		state = ClockUnwrap.new()
		store[key] = state
	end
	return ClockUnwrap.seatFull(state, seconds)
end

return ClockUnwrap
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF35"><Properties><string name="Name">Config</string><ProtectedString name="Source">const Types = require(script.Parent.Types)

const IS_SERVER = game:GetService("RunService"):IsServer()
const CHRONO_PRIMARY = "__CHRONO_PRIMARY"

export type WarningLevels = "NONE" | "LOW" | "MEDIUM" | "HIGH"

export type Configs =
	"EXPERIMENTAL_PREDICTION" |
	"EXPERIMENTAL_PREDICTION_DRAW" |
	"EXPERIMENTAL_PREDICTION_SECONDS" |
	"EXPERIMENTAL_PREDICTION_DISTANCE" |
	"EXPERIMENTAL_PREDICTION_SPEED" |
	"EXPERIMENTAL_PREDICTION_ACCELERATION" |
	"EXPERIMENTAL_PREDICTION_TURN" |
	"EXPERIMENTAL_PREDICTION_ANGULAR" |
	"EXPERIMENTAL_PREDICTION_GAP" |
	"EXPERIMENTAL_PREDICTION_TELEPORT" |
	"EXPERIMENTAL_PREDICTION_LEARNING" |
	"EXPERIMENTAL_PREDICTION_DELAY" |
	"EXPERIMENTAL_PREDICTION_LEAD" |

	"MIN_BUFFER"
	| "MAX_BUFFER"
	| "MAX_SNAPSHOT_COUNT"
	| "CHECK_NEW_VERSION"
	| "DEFAULT_NORMAL_TICK_DISTANCE"
	| "DEFAULT_HALF_TICK_DISTANCE"
	| "DEFAULT_MODEL_REPLICATION_MODE"
	| "DEFAULT_INTERPOLATION_MODE"
	| "PLAYER_REPLICATION"
	| "REPLICATE_DEATHS"
	| "REPLICATE_CFRAME_SETTERS"
	| "__VERSION"
	| "MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER"
	| "WARNING_SEVERITY"
	| "GRID_UPDATE_INTERVAL"
	| "GRID_MAX_UPDATE_TIME"
	| "VISUAL_CURVE" | "VISUAL_PREDICTION_SECONDS" | "VISUAL_PREDICTION_DISTANCE" | "VISUAL_PREDICTION_SPEED"

export type SetConfig =
	("EXPERIMENTAL_PREDICTION", boolean) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_DRAW", boolean) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_SECONDS", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_DISTANCE", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_SPEED", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_ACCELERATION", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_TURN", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_ANGULAR", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_GAP", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_TELEPORT", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_LEARNING", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_DELAY", number) -&gt; () &amp;
	("EXPERIMENTAL_PREDICTION_LEAD", number) -&gt; () &amp;

	("MIN_BUFFER", number) -&gt; ()
	&amp; ("MAX_BUFFER", number) -&gt; ()
	&amp; ("DEFAULT_NORMAL_TICK_DISTANCE", number) -&gt; ()
	&amp; ("DEFAULT_HALF_TICK_DISTANCE", number) -&gt; ()
	&amp; ("MAX_SNAPSHOT_COUNT", number) -&gt; ()
	&amp; ("CHECK_NEW_VERSION", boolean) -&gt; ()
	&amp; ("DEFAULT_MODEL_REPLICATION_MODE", Types.MODEL_REPLICATION_MODE) -&gt; ()
	&amp; ("DEFAULT_INTERPOLATION_MODE", Types.INTERPOLATION_MODE) -&gt; ()
	&amp; ("PLAYER_REPLICATION", "AUTOMATIC" | "CUSTOM") -&gt; ()
	&amp; ("REPLICATE_DEATHS", "NONE" | "PLAYER_ENTITIES" | "PLAYER_CHARACTERS") -&gt; ()
	&amp; ("REPLICATE_CFRAME_SETTERS", "NONE" | "PLAYER_ENTITIES" | "PLAYER_CHARACTERS") -&gt; ()
	&amp; ("MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER", number) -&gt; ()
	&amp; ("WARNING_SEVERITY", WarningLevels) -&gt; ()
	&amp; ("GRID_UPDATE_INTERVAL", number) -&gt; ()
	&amp; ("GRID_MAX_UPDATE_TIME", number) -&gt; ()
	&amp; ("VISUAL_CURVE", "HERMITE" | "LINEAR" | "SEGMENT") -&gt; ()
	&amp; ("VISUAL_PREDICTION_SECONDS", number) -&gt; ()
	&amp; ("VISUAL_PREDICTION_DISTANCE", number) -&gt; ()
	&amp; ("VISUAL_PREDICTION_SPEED", number) -&gt; ()
local LOCKED = false
const BASE_CONFIG = {
	EXPERIMENTAL_PREDICTION = false,
	EXPERIMENTAL_PREDICTION_DRAW = false,
	EXPERIMENTAL_PREDICTION_SECONDS = 0.25,
	EXPERIMENTAL_PREDICTION_DISTANCE = 8,
	EXPERIMENTAL_PREDICTION_SPEED = 120,
	EXPERIMENTAL_PREDICTION_ACCELERATION = 250,
	EXPERIMENTAL_PREDICTION_TURN = 8,
	EXPERIMENTAL_PREDICTION_ANGULAR = 12,
	EXPERIMENTAL_PREDICTION_GAP = 0.75,
	EXPERIMENTAL_PREDICTION_TELEPORT = 8,
	EXPERIMENTAL_PREDICTION_LEARNING = 0.6,
	EXPERIMENTAL_PREDICTION_DELAY = 0,
	EXPERIMENTAL_PREDICTION_LEAD = 0,

	__VERSION = "3.3.0-dev",
	CHECK_NEW_VERSION = false, -- A fork must not report upstream tags as its own updates.
	MAX_TOTAL_BYTES_PER_FRAME_PER_PLAYER = 300, -- Base line value
	MIN_BUFFER = 0.09,
	MAX_BUFFER = 0.5,

	GRID_UPDATE_INTERVAL = 0.1,
	GRID_MAX_UPDATE_TIME = 0.0005,

	WARNING_SEVERITY = "MEDIUM", -- "NONE", "LOW", "MEDIUM", "HIGH"
	DEFAULT_NORMAL_TICK_DISTANCE = 50,
	DEFAULT_HALF_TICK_DISTANCE = 100, -- Anything beyond this distance will not be replicated for non-owned entities. 

	REPLICATE_DEATHS = "PLAYER_CHARACTERS",
	--[[
		- This requires PLAYER_REPLICATION to be set to AUTOMATIC
		-NONE = No deaths are replicated
		-PLAYER_ENTITIES = Only deaths where player has entity ownership are replicated to players
		-PLAYER_CHARACTERS= Only replicate deaths for player characters
	]]
	REPLICATE_CFRAME_SETTERS = "PLAYER_ENTITIES",
	--[[
		- This requires PLAYER_REPLICATION to be set to AUTOMATIC
		-NONE = No deaths are replicated
		-PLAYER_ENTITIES = Only deaths where player has entity ownership are replicated to players
		-PLAYER_CHARACTERS= Only replicate deaths for player characters
	]]

	PLAYER_REPLICATION = "AUTOMATIC",

	--[[
		- Custom
			+ More control over how replication is handled
			- More work to set up
		- Automatic Will automatically register player models as entities
			+ Easy to use
			- Less control over replication

	]]
	DEFAULT_INTERPOLATION_MODE = "CFRAME",
	--[[
		How the client applies an interpolated transform to a non-owned entity.
		-CFRAME = Assign primaryPart.CFrame directly.
			+ Exact, cheapest, and what you want for anything not simulated locally.
			- Teleports the assembly each frame
		-ALIGN = Drive an AlignPosition/AlignOrientation toward the target instead.
			+ Physics keeps resolving joints and collisions while still tracking the target.
			- More expensive, and has unknown interactions with other constraints.
		-NONE = Do not apply the transform at all. 
	]]
	DEFAULT_MODEL_REPLICATION_MODE = "NATIVE",
	--[[
		-NATIVE = Use Roblox's built in model replication.
			+ Easy to use
			- More bandwidth
		-NATIVE_WITH_LOCK = Use Roblox's built in model replication, but disable server CFrame replication.
			+ Less bandwidth than NATIVE as roblox's cframe replication is disabled.
			- Server side roblox physics is disabled acting as if it was anchored.
			+ Good for characters or client owned entities as physics will be client sided
		-CUSTOM = Client and Server have separate cloned models.
			+ Less bandwidth
			- Have to write custom code to replicate stuff like animations
	]]
	MAX_SNAPSHOT_COUNT = 30,
	VISUAL_CURVE = "HERMITE", -- HERMITE preserves upstream presentation; LINEAR/SEGMENT are opt-in.
	VISUAL_PREDICTION_SECONDS = 0, -- Display-only estimate; never gameplay evidence.
	VISUAL_PREDICTION_DISTANCE = 1,
	VISUAL_PREDICTION_SPEED = 100,
}
const ENTITY_TYPES: { [string]: Types.EntityConfig } = {
	DEFAULT = {
		NAME = "DEFAULT",
		TICK_RATE = 1 / 20,
		BUFFER = 0.1, --if buffer is 0 or nil for server side entities then it will use an dynamic buffer
	},
	WITH_ROT = {
		NAME = "WITH_ROT",
		MODEL_REPLICATION_MODE = "NATIVE",
		BUFFER = 0,
		HALF_TICK_DISTANCE = math.huge,
		TICK_RATE = 1 / 20,
		ASSEMBLY_ROOT_PART_CHECK = true,
		FULL_ROTATION = true,
	},
	PLAYER = {
		NAME = "PLAYER",
		MODEL_REPLICATION_MODE = "NATIVE",
		BUFFER = 0, -- handled dynamically for players
		HALF_TICK_DISTANCE = math.huge, -- Keep players replicated at all distances to mimic roblox's default behavior
		TICK_RATE = 1 / 20,
		ASSEMBLY_ROOT_PART_CHECK = true,
	},
}
const ENTITY_MODELS = {}
const MODEL_BROAD_PHASES = {}

const MODEL_MODES = { "NATIVE", "NATIVE_WITH_LOCK", "CUSTOM" }
const INTERPOLATION_MODES = { "CFRAME", "ALIGN", "NONE" }
const PLAYER_FILTERS = { "NONE", "PLAYER_ENTITIES", "PLAYER_CHARACTERS" }
const CONFIG_OPTIONS = {
	VISUAL_CURVE = { "HERMITE", "LINEAR", "SEGMENT" },
	DEFAULT_MODEL_REPLICATION_MODE = MODEL_MODES,
	DEFAULT_INTERPOLATION_MODE = INTERPOLATION_MODES,
	PLAYER_REPLICATION = { "AUTOMATIC", "CUSTOM" },
	REPLICATE_DEATHS = PLAYER_FILTERS,
	REPLICATE_CFRAME_SETTERS = PLAYER_FILTERS,
	WARNING_SEVERITY = { "NONE", "LOW", "MEDIUM", "HIGH" },
}

const function CheckOption(name: string, value: any, options: { string })
	assert(table.find(options, value), `Chrono: {name} must be {table.concat(options, ", ")}, got {tostring(value)}`)
end

const function CheckEntityType(name: string, config: Types.EntityConfigInput)
	assert(type(name) == "string" and name ~= "", "Chrono: entity type name must be a non-empty string")
	assert(type(config) == "table", `Chrono: entity type "{name}" must be a table`)
	assert(
		type(config.TICK_RATE) == "number" and config.TICK_RATE &gt; 0 and config.TICK_RATE &lt; math.huge,
		`Chrono: entity type "{name}" needs a finite TICK_RATE greater than 0, such as 1 / 20`
	)
	if config.BUFFER ~= nil then
		assert(
			type(config.BUFFER) == "number" and math.abs(config.BUFFER) &lt; math.huge,
			`Chrono: entity type "{name}" BUFFER must be a finite number`
		)
	end
	for _, field in { "NORMAL_TICK_DISTANCE", "HALF_TICK_DISTANCE" } do
		const value = (config :: any)[field]
		assert(
			value == nil or (type(value) == "number" and value &gt;= 0),
			`Chrono: entity type "{name}" {field} must be a non-negative number`
		)
	end
	for _, field in {
		"FULL_ROTATION",
		"AUTO_UPDATE_POSITION",
		"STORE_SNAPSHOTS",
		"ASSEMBLY_ROOT_PART_CHECK",
		"CUSTOM_INTERPOLATION",
	} do
		const value = (config :: any)[field]
		assert(value == nil or type(value) == "boolean", `Chrono: entity type "{name}" {field} must be a boolean`)
	end
	if config.MODEL_REPLICATION_MODE ~= nil then
		CheckOption(`entity type "{name}" MODEL_REPLICATION_MODE`, config.MODEL_REPLICATION_MODE, MODEL_MODES)
	end
	if config.INTERPOLATION_MODE ~= nil then
		CheckOption(`entity type "{name}" INTERPOLATION_MODE`, config.INTERPOLATION_MODE, INTERPOLATION_MODES)
	end
end

--[=[
	Registers an entity type configuration.
	Can only be called before the config is locked.

	@param name The name of the entity type.
	@param config The configuration for the entity type.
]=]
const function RegisterEntityType(name: string, config: Types.EntityConfigInput)
	if LOCKED then
		error("Chrono: Config.RegisterEntityType must be called before Chrono.Start()", 2)
	end
	CheckEntityType(name, config)
	ENTITY_TYPES[name] = config :: any
end

--[=[
	Registers an entity model. This can be registered after the config is locked.
	Server and client may have different models registered under the same name.

	@param name The name of the entity model.
	@param model The model or part to use for the entity.
	@param broadPhase Optional broad phase vector or size for frustum culling on the client. If vector is zero then only do 1 check in the center instead of a box check.
]=]
const function RegisterEntityModel(name: string, model: Model | BasePart | false, broadPhase: vector | Vector3?)
	if model ~= false and model:IsA("Model") and not model.PrimaryPart then
		error(`Chrono: Config.RegisterEntityModel model "{name}" must have a PrimaryPart`, 2)
	end
	ENTITY_MODELS[name] = model
	MODEL_BROAD_PHASES[name] = broadPhase
end

local EXPERIMENT_BOUNDS = {
	EXPERIMENTAL_PREDICTION_SECONDS = {0.001,0.25},
	EXPERIMENTAL_PREDICTION_DISTANCE = {0.01,32},
	EXPERIMENTAL_PREDICTION_SPEED = {1,4096},
	EXPERIMENTAL_PREDICTION_ACCELERATION = {1,10000},
	EXPERIMENTAL_PREDICTION_TURN = {0.01,50},
	EXPERIMENTAL_PREDICTION_ANGULAR = {0.01,50},
	EXPERIMENTAL_PREDICTION_GAP = {0.05,5},
	EXPERIMENTAL_PREDICTION_TELEPORT = {1,1000},
	EXPERIMENTAL_PREDICTION_LEARNING = {0.05,10},
	EXPERIMENTAL_PREDICTION_DELAY = {0,0.5},
	EXPERIMENTAL_PREDICTION_LEAD = {0,0.25},
}
const SetConfig = function(name, value)
	if LOCKED then
		error("Chrono: Config.SetConfig must be called before Chrono.Start()", 2)
	end
	if BASE_CONFIG[name] == nil or name == "__VERSION" then
		error(`Chrono: Config.SetConfig got unknown config "{name}"`, 2)
	end
	assert(type(value) == type(BASE_CONFIG[name]), `Chrono: Config.{name} must be a {type(BASE_CONFIG[name])}`)
	if type(value) == "number" then
		if name == "DEFAULT_NORMAL_TICK_DISTANCE" or name == "DEFAULT_HALF_TICK_DISTANCE" then
			assert(value &gt;= 0, `Chrono: Config.{name} must be 0 or greater (math.huge is allowed)`)
		else
			assert(value &gt;= 0 and value &lt; math.huge, `Chrono: Config.{name} must be a finite number, 0 or greater`)
		end
		local bounds=EXPERIMENT_BOUNDS[name]
		if bounds then assert(value&gt;=bounds[1] and value&lt;=bounds[2], "Experimental prediction setting outside bounds: "..name) end
		if name == "MAX_SNAPSHOT_COUNT" then
			assert(value &gt;= 1 and value % 1 == 0, "Chrono: Config.MAX_SNAPSHOT_COUNT must be a positive integer")
		elseif name == "GRID_MAX_UPDATE_TIME" then
			assert(value &gt; 0, "Chrono: Config.GRID_MAX_UPDATE_TIME must be greater than 0")
		elseif name == "VISUAL_PREDICTION_SECONDS" then
			assert(value&lt;=0.25,"Display prediction is limited to 250 ms")
		elseif name == "VISUAL_PREDICTION_DISTANCE" then
			assert(value&lt;=32,"Display prediction is limited to 32 studs")
		elseif name == "VISUAL_PREDICTION_SPEED" then
			assert(value&lt;=4096,"Display prediction speed must be at most 4096 studs/s")
		end
	elseif CONFIG_OPTIONS[name] then
		CheckOption(`Config.{name}`, value, CONFIG_OPTIONS[name])
	end
	BASE_CONFIG[name] = value
end :: SetConfig

const function GetEntityType(name: string?): Types.EntityConfig
	return name and ENTITY_TYPES[name] or ENTITY_TYPES["DEFAULT"]
end

const function GetEntityModel(name: string): Model | BasePart | false?
	if ENTITY_MODELS[name] == nil then
		warn(`Entity model {name} not found in Config.`)
		return nil
	end
	return ENTITY_MODELS[name] :: any
end

const function GetBroadPhase(name: string): vector?
	return MODEL_BROAD_PHASES[name] :: any
end

const function GetConfig(name: Configs): any
	return BASE_CONFIG[name]
end

const waiting: { () -&gt; () } = {}
const function WaitForLock(fx: () -&gt; ())
	if LOCKED then
		fx()
	else
		table.insert(waiting, fx)
	end
end

const function SetWarningSeverity(level: WarningLevels)
	if level ~= "NONE" and level ~= "LOW" and level ~= "MEDIUM" and level ~= "HIGH" then
		error(`Chrono: Config.SetWarningSeverity expected "NONE", "LOW", "MEDIUM" or "HIGH", got {level}`, 2)
	end
	BASE_CONFIG.WARNING_SEVERITY = level
end

const function Lock()
	assert(BASE_CONFIG.MIN_BUFFER &lt;= BASE_CONFIG.MAX_BUFFER, "Chrono: Config.MIN_BUFFER must not exceed MAX_BUFFER")
	for name, config in ENTITY_TYPES do
		CheckEntityType(name, config)
	end
	(require)(script.Parent.Warn).low("Config is now locked")

	LOCKED = true
	const DEFAULT_NORMAL_TICK_DISTANCE = BASE_CONFIG.DEFAULT_NORMAL_TICK_DISTANCE
	const DEFAULT_HALF_TICK_DISTANCE = BASE_CONFIG.DEFAULT_HALF_TICK_DISTANCE
	for i, v in ENTITY_TYPES do
		const cloned = table.clone(v)
		cloned.NAME = i
		cloned.AUTO_UPDATE_POSITION = cloned.AUTO_UPDATE_POSITION ~= false
		cloned.FULL_ROTATION = cloned.FULL_ROTATION or false
		cloned.NORMAL_TICK_DISTANCE = cloned.NORMAL_TICK_DISTANCE or DEFAULT_NORMAL_TICK_DISTANCE
		cloned.HALF_TICK_DISTANCE = cloned.HALF_TICK_DISTANCE or DEFAULT_HALF_TICK_DISTANCE
		cloned.MODEL_REPLICATION_MODE = cloned.MODEL_REPLICATION_MODE
			or BASE_CONFIG.DEFAULT_MODEL_REPLICATION_MODE :: any
		cloned.INTERPOLATION_MODE = cloned.INTERPOLATION_MODE or BASE_CONFIG.DEFAULT_INTERPOLATION_MODE :: any
		if IS_SERVER then
			cloned.TICKER = (require)(script.Parent.Ticker).new(cloned)
		else
			cloned.CLIENT_CLOCK = {} :: any
			cloned.UpdateBuffer = function(self: Types.EntityConfig, buffer: number)
				if not self.CLIENT_CLOCK or not next(self.CLIENT_CLOCK :: any) then
					error("Config not initialized yet, cannot update buffer for entity type: " .. self.NAME)
				end
				self.BUFFER = buffer
				if self.CLIENT_CLOCK.NORMAL then
					self.CLIENT_CLOCK.NORMAL:UpdateBuffer(buffer)
				end
				if self.CLIENT_CLOCK.HALF then
					self.CLIENT_CLOCK.HALF:UpdateBuffer(buffer)
				end

				const Holder = (require)(script.Parent.Holder)
				const Entity = (require)(script.Parent.Entity)
				for _, entity in Holder.idMap do
					if entity.entityConfig == self then
						Entity._UpdateClockBuffer(entity)
					end
				end
			end
		end

		ENTITY_TYPES[i] = cloned
	end
	for _, fx in waiting do
		fx()
	end
end

return {
	SetConfig = SetConfig,
	RegisterEntityType = RegisterEntityType,
	RegisterEntityModel = RegisterEntityModel,
	FLAGS = {
		["CHARACTER_WAIT_DELAY"] = true, -- Waits for CharacterAppearanceLoaded before loading
		["SERVER_VELOCITY_FIX"] = true, -- Fixes velocity calculation on the server when two packets are received next to each other
		["VELOCITY_CALC_FIX"] = true, -- Fixes velocity calculation when dt is less then tickrate
		["SNAPSHOT_INTERPOLATION_FIX"] = true, -- Fixes interpolation of snapshots when replication is stopped briefly and resumed rapidly which can cause slight jitter due to velocity.
		["SET_CFRAME_FIX"] = true, -- Adds a teleport flag to packets
		["FIX_TELEPORT_JITTER"] = true, -- Resolves jitter issue when clearing snapshots then settings cframe/teleporting can cause a bouncing effect. Uses a locking mechanism when getting the snapshot buffer to prevent old snapshots from being retrieved.
	},

	_EntityConfigs = ENTITY_TYPES,
	_GetEntityType = GetEntityType, --// For internal use only
	GetEntityType = GetEntityType,
	_GetEntityModel = GetEntityModel,
	_GetConfig = GetConfig,
	_Lock = Lock,
	_WaitForLock = WaitForLock,
	_GetBroadPhase = GetBroadPhase,
	_Base_Config = BASE_CONFIG, --//Modifying this after locking may not change behaviors of some config options.
	SetModelPrimaryForChrono = function(model: Model, primaryName: string)
		model:SetAttribute(CHRONO_PRIMARY, primaryName)
	end,
	SetWarningSeverity = SetWarningSeverity,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF36"><Properties><string name="Name">Entity</string><ProtectedString name="Source">const Entity = {}

const Players = game:GetService("Players")
const RunService = game:GetService("RunService")
const Types = require(script.Parent.Types)
const Config = require(script.Parent.Config)
const Snapshot = require(script.Parent.Snapshots)
const InterpolationMath = require(script.Parent.InterpolationMath)
const ClientClock = require(script.Parent.Parent.Client.ClientClock)
const Holder = require(script.Parent.Holder)
const Signal = require(script.Parent.Signal)
const Events = require(script.Parent.Events)
const ModelHelper = require(script.Parent.ModelHelper)
const AlignDriver = require(script.Parent.Parent.Client.AlignDriver)
const Warn = require(script.Parent.Warn)
const HumanoidState = require(script.Parent.HumanoidState)
const CFrameLock = require(script.Parent.CFrameLock)
const ExperimentalPrediction = require(script.Parent.ExperimentalPrediction)

const clientOwned = Holder._clientOwned
const IS_SERVER = RunService:IsServer()
const LOCAL_PLAYER = if IS_SERVER then nil else Players.LocalPlayer

const CHRONO_PRIMARY = "__CHRONO_PRIMARY"
const OWNER_SMOOTH_TIME = 0.3
const INTERPOLATION_MODES = { CFRAME = true, ALIGN = true, NONE = true }
const EVENT_NAMES = {
	Destroying = true,
	NetworkOwnerChanged = true,
	PushedSnapShot = true,
	TickChanged = true,
	DataChanged = true,
	Ticked = true,
	ModelChanged = true,
	LockChanged = true,
}

type Entity = Types.Entity

local READY = false

Config._WaitForLock(function()
	READY = true
end)

const RegisterChange = Holder.RegisterChange

--// Part helpers
const function SafeDestroy(instance: Instance?)
	if instance then
		pcall(instance.Destroy, instance)
	end
end

const function GetPart(self: Types.Entity): BasePart?
	const model = self.model
	if not model then
		return nil
	end
	if model:IsA("BasePart") then
		return model
	end
	if model:IsA("Model") then
		const chronoPrimary = self._chronoPrimary
		if chronoPrimary then
			const primary = model:FindFirstChild(chronoPrimary)
			if primary and primary:IsA("BasePart") then
				return primary
			else
				Warn.low(
					`Chrono primary part {chronoPrimary} not found or not a BasePart in model {model:GetFullName()} for entity id {self.id}. Falling back to default PrimaryPart.`
				)
			end
		end
		const primaryPart = model.PrimaryPart
		if primaryPart then
			return primaryPart
		end
	end
	return nil
end

const function GetRootPart(entity: Entity): BasePart?
	const primaryPart = Entity.GetPrimaryPart(entity)
	if primaryPart and IS_SERVER and entity._lockedCFReplication then
		return CFrameLock.GetLockedRoot(primaryPart)
	end
	return primaryPart
end

const function SetPartCFrame(entity, cframe: CFrame)
	const part = GetRootPart(entity)
	if part then
		part.CFrame = cframe
	end
end

--anchors depending on interpolation mode,config type and ownership
const function UpdateClientAnchor(self: Entity)
	if IS_SERVER or not (self.modelReplicationMode == "CUSTOM" or self._lockedCFReplication) then
		return
	end
	const part = GetPart(self)
	if not part then
		return
	end
	const mode = self._interpolationMode or self.entityConfig.INTERPOLATION_MODE
	const anchored = not self.isContextOwner and mode ~= "ALIGN"
	if anchored and not part.Anchored then
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
	part.Anchored = anchored
end

--// Events
const function FireEvent(entity: Entity, eventName: string, ...: any)
	const events = entity._events
	if not events then
		return
	end
	const signal = events[eventName]
	if signal then
		signal:Fire(entity, ...)
	end
end

const function GetEvent(self: Entity, eventName: string): Types.Event&lt;any&gt;
	if not EVENT_NAMES[eventName] then
		error(`Chrono: Entity.GetEvent got unknown event "{eventName}"`, 2)
	end
	if not self._events then
		self._events = {}
	end
	const events = self._events :: { [string]: Types.Signal&lt;any, any&gt; }
	if not events[eventName] then
		events[eventName] = Signal.new()
	end
	return events[eventName].Event
end

--// Ownership &amp; clock
-- If buffer is given then it will create a client clock for the entity as well.
const function SetClock(self: Entity, buffer: number | false?)
	if self._clientClock then
		self._clientClock:Destroy()
		self._clientClock = nil
	end
	if buffer == false then
		self._clockBuffer = nil
		buffer = nil
	end
	buffer = buffer or self._clockBuffer
	self._clockBuffer = buffer :: any
	const entityBuffer = buffer or self.entityConfig.BUFFER or 0
	if self.networkOwner or buffer then
		const networkOwner = self.networkOwner
		self._clientClock = ClientClock.new(
			self.entityConfig.TICK_RATE,
			`Entity id: {self.id} plr: {networkOwner and networkOwner.Name or "SERVER"}`,
			entityBuffer,
			networkOwner
		)
	end
end

const function CheckNetworkOwner(self: Entity, prev: Player?)
	self.isContextOwner = self.networkOwner == LOCAL_PLAYER
	const isSameOwner = self.networkOwner == prev
	if not isSameOwner then
		if IS_SERVER then
			self.lastClientClock = nil
		else
			self.latestTime = 0
			self.lastClientClock = 0
			self._ownerChangedAt = if self.isContextOwner or not self.registered then nil else os.clock()
			self._ownerSmoothing = nil
		end
	end
	if IS_SERVER then
		const part = GetPart(self)
		if part then
			const locked = self._lockedCFReplication

			if locked then
				CFrameLock.Unlock(part)
			end
			-- this is done to ensure the network owner is set correctly
			CFrameLock.SafeSetNetworkOwner(part, self.networkOwner)
			if locked then
				-- if it was locked again it could mess up ownership
				CFrameLock.Lock(part)
				const root = GetRootPart(self)
				if root then
					CFrameLock.SafeSetNetworkOwner(root, self.networkOwner)
					-- Anchors the player on the server,
					-- if the player was unanchored then it could cause weird issues
					-- where roblox takes back ownership and sets it to auto.
					root.Anchored = not isSameOwner
				end
			end
		end

		if self.isContextOwner and not self.entityConfig.STORE_SNAPSHOTS then
			self.snapshot = nil
		elseif not self.snapshot then
			self.snapshot = Snapshot(InterpolationMath.Hermite)
		end
	else
		if self.isContextOwner then
			AlignDriver.Clear(self)
		end
		const locked = self._lockedCFReplication

		if locked and self.isContextOwner then
			const part = GetPart(self)
			if part then
				CFrameLock.Lock(part)
				self._cfLockFailed = nil
			else
				-- delay the lock this is checked in client/sender::CheckLocker
				self._cfLockFailed = true
			end
			if self._player then
				CFrameLock.Unlock(part)
			end
		end
		UpdateClientAnchor(self)
	end

	if isSameOwner then
		return
	elseif self.snapshot and not IS_SERVER then
		self.snapshot:Clear()
	end

	if not IS_SERVER then
		SetClock(self)
	end

	FireEvent(self, "NetworkOwnerChanged", self.networkOwner, prev)

	if prev then
		const ownedEntities = clientOwned[prev]

		if ownedEntities then
			ownedEntities[self] = nil

			Events._Signals.PlayerOwnedRemoved:Fire(prev, self)
		end
	end
	if self.networkOwner then
		const ownedEntities = clientOwned[self.networkOwner]

		if not ownedEntities then
			return
		end
		ownedEntities[self] = true

		Events._Signals.PlayerOwnedAdded:Fire(self.networkOwner, self)
	end
end

const function SetEntityNetworkOwner(self: Entity, player: Player?)
	if player ~= self.networkOwner then
		ExperimentalPrediction.Reset(self)
		if IS_SERVER then
			local revision = (self.ownershipRevision or 0) + 1
			assert(revision &lt; 4294967296, "Ownership counter exhausted")
			RegisterChange(self, "ownershipRevision", revision)
		end
		self._receivedSequence = nil
		self._sendSequence = 0
		const prev = self.networkOwner
		RegisterChange(self, "networkOwner", player)
		CheckNetworkOwner(self, prev)
		if not IS_SERVER then
			Entity.Clear(self)
		end
	end
	self.lastCheckedCFrame = nil
	UpdateClientAnchor(self)
end

--// Model
const function CheckModelReplicationMode(entity: Entity, mode: Types.MODEL_REPLICATION_MODE?): "NATIVE" | "CUSTOM"
	if not mode then
		mode = entity.modelReplicationMode
	end
	if not mode then
		const config = entity.entityConfig
		mode = config.MODEL_REPLICATION_MODE
	end
	mode = (mode :: any):upper()
	if mode ~= "NATIVE" and mode ~= "CUSTOM" and mode ~= "NATIVE_WITH_LOCK" then
		Warn.medium(`Invalid model replication mode {mode} for entity id {entity.id}, defaulting to NATIVE`)
		mode = "NATIVE"
	end
	entity._lockedCFReplication = false
	if mode == "NATIVE_WITH_LOCK" then
		mode = "NATIVE"
		entity._lockedCFReplication = true
	end
	return mode :: any
end

const function SetModel(
	self: Entity,
	model: Model | BasePart | string?,
	modelReplicationMode: Types.MODEL_REPLICATION_MODE?,
	noDestroy: boolean?
): ()
	const wasCustom = self.modelReplicationMode == "CUSTOM"

	if IS_SERVER then
		if self.modelReplicationMode == "NATIVE" and self._lockedCFReplication then
			const part = GetPart(self)
			self._lockedCFReplication = false
			CFrameLock.Unlock(part)
		end
		if not noDestroy then
			SafeDestroy(self.model)
		end
		self.model = nil
	elseif not IS_SERVER and wasCustom then
		SafeDestroy(self.model)
		self.model = nil
	elseif not IS_SERVER and self._lockedCFReplication then
		const part = GetPart(self)
		self._lockedCFReplication = false
		CFrameLock.Unlock(part)
	end
	local modelString
	if type(model) == "string" then
		modelString = model
		model = Config._GetEntityModel(model :: string) :: any
		if model then
			model = (model :: any):Clone()
		end

		if model then
			(model :: any).Parent = workspace
		end
	end
	const _model: Model? = model :: any
	const broadPhase = Config._GetBroadPhase(modelString :: string)

	const replicationMode: "NATIVE" | "CUSTOM" = CheckModelReplicationMode(self, modelReplicationMode)
	self.modelString = modelString
	self.model = _model

	if IS_SERVER or not self.broadPhase then
		self.broadPhase = broadPhase
	end

	if _model then
		if replicationMode == "CUSTOM" then
			_model.Parent = Holder.GetEntityStorageInstance()
		end

		const chronoPrimary = _model:GetAttribute(CHRONO_PRIMARY)
		if chronoPrimary and type(chronoPrimary) == "string" then
			self._chronoPrimary = chronoPrimary
		end
	end

	self.modelReplicationMode = replicationMode

	const primaryPart = GetPart(self)
	if _model and not primaryPart then
		const warn = IS_SERVER and Warn.high or Warn.low
		warn(`{_model:GetFullName()} must have a PrimaryPart set for things like autoReplication and movement.`)
	elseif _model and not _model.Archivable then
		Warn.low(
			`{_model:GetFullName()} is not Archivable. It is recommended to set Archivable to true for entity models to prevent potential issues when cloning. Archivable has been set to true automatically.`
		)
		_model.Archivable = true
	end

	if not primaryPart then
		return
	end

	if not self.latestCFrame then
		Entity.SetCFrame(self, primaryPart.CFrame)
	end
	if self.latestCFrame then
		primaryPart.CFrame = self.latestCFrame
	end

	self.modelReplicationMode = Entity.GetModelReplicationType(self) :: any
	if self.modelReplicationMode :: any == "NATIVE_WITH_LOCK" then
		self._lockedCFReplication = true
		self.modelReplicationMode = "NATIVE"
	end
	UpdateClientAnchor(self)
end

--// Construction
function Entity._new(
	entityConfig: string?,
	model: Model | BasePart | string?,
	modelReplicationMode: Types.MODEL_REPLICATION_MODE?,
	initCFrame: CFrame?
): Entity
	local config = Config._GetEntityType(entityConfig)
	if not config then
		Warn.medium(`Entity config {entityConfig} not found. Using DEFAULT config.`)
		config = Config._GetEntityType("DEFAULT")
	end

	-- If the model doesn't exist and there's no init cframe then it won't be able to find a starting cframe
	if initCFrame == nil and typeof(model) == "string" then
		const _model = Config._GetEntityModel(model :: string)
		if _model == false then
			Warn.medium(`Entity's model doesn't exist, initCFrame is required. DEFAULTING to CFrame.new(0, 0, 0)`)
			initCFrame = CFrame.new(0, 0, 0)
		end
	end

	const self: Entity = {
		id = -1,

		registered = false,
		autoUpdatePosition = config.AUTO_UPDATE_POSITION ~= false,
		isContextOwner = false,
		networkOwner = nil,
		latestCFrame = initCFrame,
		paused = false,

		entityConfig = config,
		destroyed = false,

		interpolation = not IS_SERVER and true,
	}

	if LOCAL_PLAYER then
		self.snapshot = Snapshot(InterpolationMath.Hermite)
	end
	SetModel(self, model, modelReplicationMode)
	HumanoidState.Refresh(self, true)
	CheckNetworkOwner(self, nil)

	return self
end

--[=[
	Creates a new Entity instance and registers.

	@param entityConfig The entity configuration name to use. Defaults to "DEFAULT" if not provided or invalid.
	@param model The model to use for the entity. Can be a Model, BasePart, or a string representing a registered model name.
	@param modelReplicationMode The model replication mode to use. Will default of the entity config if not provided.
	@param initCFrame The initial CFrame for the entity. Optional.

	@return The newly created Entity instance.
]=]
function Entity.new(
	entityConfig: string?,
	model: Model | BasePart | string?,
	modelReplicationMode: Types.MODEL_REPLICATION_MODE?,
	initCFrame: CFrame?
): Entity
	if not READY then
		error("Chrono: Entity.new cannot be called until Chrono.Start() is called", 2)
	end
	const self = Entity._new(entityConfig, model, modelReplicationMode, initCFrame)
	Holder.RegisterEntity(self)
	return self
end

--[=[
	Destroys the entity, unregistering it and cleaning up resources. Does nothing if already destroyed.
]=]
function Entity.Destroy(self: Entity, preserveModel: boolean?, preserveAnchor: boolean?)
	if self.destroyed then
		return
	end
	self.destroyed = true
	ExperimentalPrediction.Reset(self)
	if IS_SERVER and preserveModel then
		self._preserveModelOnRemoval=true
		local part=GetPart(self) self._removalAnchor=if part then part.Anchored else nil
	end
	FireEvent(self, "Destroying")
	Holder.UnregisterEntity(self)
	if self._clientClock then
		self._clientClock:Destroy()
	end

	const owner = self.networkOwner
	if owner then
		const ownedEntities = clientOwned[owner]
		if ownedEntities and ownedEntities[self] then
			ownedEntities[self] = nil
			Events._Signals.PlayerOwnedRemoved:Fire(owner, self)
		end
	end

	HumanoidState.Stop(self)

	AlignDriver.Clear(self)

	if not IS_SERVER then
		const modeType = self.modelReplicationMode
		const primaryPart = GetPart(self)
		if modeType == "CUSTOM" then
			-- destroys the model on the client
			SafeDestroy(self.model)
		elseif primaryPart then
			if self._lockedCFReplication then
				CFrameLock.Unlock(primaryPart)
			end
			if preserveModel then
				if type(preserveAnchor)=="boolean" then primaryPart.Anchored=preserveAnchor end
			else
				-- Ordinary despawns retain original Chrono's hide behavior.
				primaryPart.CFrame = CFrame.new(0, 1000000, 0)
			end
		end
	else
		if preserveModel then
			local part=GetPart(self) if part and self._lockedCFReplication then CFrameLock.Unlock(part) end
		else SafeDestroy(self.model) end
	end

	for _, signal: Types.Signal&lt;any&gt; in (self._events or {}) :: any do
		signal:DisconnectAll()
	end
	self.model = nil
end

--// Model API
--[=[
	Sets the model for the entity.

	@param model The model to set for the entity. Can be a Model, BasePart, or a string representing a registered model name.
	@param modelReplicationMode The model replication mode to use. Will default to the last used mode or the entity config if not provided.
	@param noDestroy If true, will not destroy the previous model. Defaults to false.
]=]
function Entity.SetModel(
	self: Entity,
	model: Model | BasePart | string?,
	modelReplicationMode: Types.MODEL_REPLICATION_MODE?,
	noDestroy: boolean?
)
	const old = self.model
	SetModel(self, model, modelReplicationMode, noDestroy)
	Holder._UpdateModel(self, old)
	if IS_SERVER then
		const toReplicate = ModelHelper.ReadyModelFromRep(self, nil)
		RegisterChange(self, "model", self.model, true, toReplicate or false)
		CheckNetworkOwner(self, self.networkOwner)
	end
	HumanoidState.Refresh(self, true)
	FireEvent(self, "ModelChanged", self.model, old)
end

--[=[
	Gets the model associated with the entity.

	@return The model associated with the entity.
]=]
function Entity.GetModel(self: Entity): Model | BasePart?
	return self.model
end

--[=[
	Gets the primary part of the entity's model. If the model is a BasePart, returns the model itself.

	@return The primary part of the entity's model, or nil if no model or primary part exists.
]=]
function Entity.GetPrimaryPart(self: Entity): BasePart?
	if self.model then
		return GetPart(self)
	end
	return nil
end

--[=[
	Returns the current model replication type of the entity, which can be "NATIVE", "CUSTOM", or "NATIVE_WITH_LOCK".

]=]
function Entity.GetModelReplicationType(self: Entity): "NATIVE" | "CUSTOM" | "NATIVE_WITH_LOCK"
	local mode = self.modelReplicationMode

	if not mode then
		mode = self.entityConfig.MODEL_REPLICATION_MODE
	end
	if mode == "CUSTOM" then
		return "CUSTOM"
	end
	if self._lockedCFReplication then
		return "NATIVE_WITH_LOCK"
	end
	return "NATIVE"
end

--[=[
	Locks the native server CFrame replication for the entity.

	Only works if the entity's model replication mode is "NATIVE".

	Throws an error if called on the client or if the model replication mode is not "NATIVE".
]=]
function Entity.LockNativeServerCFrameReplication(self: Entity)
	if IS_SERVER then
		if self.modelReplicationMode ~= "NATIVE" then
			error(
				"Chrono: Entity.LockNativeServerCFrameReplication can only be called on NATIVE model replication mode entities",
				2
			)
		end
		if self._lockedCFReplication then
			return
		end
		RegisterChange(self, "_lockedCFReplication", true)

		CheckNetworkOwner(self, self.networkOwner)

		FireEvent(self, "LockChanged", true)
	else
		error("Chrono: Entity.LockNativeServerCFrameReplication can only be called on the server", 2)
	end
end

--[=[
	Unlocks the native server CFrame replication for the entity.

	Only works if the entity's model replication mode is "NATIVE".

	Throws an error if called on the client or if the model replication mode is not "NATIVE".
]=]
function Entity.UnlockNativeServerCFrameReplication(self: Entity)
	if IS_SERVER then
		if self.modelReplicationMode ~= "NATIVE" then
			error(
				"Chrono: Entity.UnlockNativeServerCFrameReplication can only be called on NATIVE model replication mode entities",
				2
			)
		end
		if not self._lockedCFReplication then
			return
		end
		RegisterChange(self, "_lockedCFReplication", false)
		const part = GetPart(self)
		CFrameLock.Unlock(part)
		CheckNetworkOwner(self, self.networkOwner)
		FireEvent(self, "LockChanged", false)
	else
		error("Chrono: Entity.UnlockNativeServerCFrameReplication can only be called on the server", 2)
	end
end

--// CFrame &amp; snapshots
@native
const function PushSnapshot(self: Entity, time: number, value: CFrame, velocity: Vector3?, stopped: boolean?): boolean
	const snapshot = self.snapshot
	const newer = not self.latestTime or time &gt; self.latestTime
	if newer then
		self.latestTime = time
		self.latestCFrame = value
	end
	if snapshot then
		const latest = snapshot:GetLatest()
		if not IS_SERVER and newer and latest and time - latest.t &lt; 5 and not self.isContextOwner then
			const targetTime = Entity.GetTargetRenderTime(self)
			if math.abs(targetTime - latest.t) &gt; 5 then
				snapshot:Clear()
				Warn.low(`Clearing Snapshot due to large time difference`)
			end
		end
		const baseTickRate = self.entityConfig.TICK_RATE
		const tickrate = if self.isHalfTicked then baseTickRate * 2 else baseTickRate
		-- for 2.2.4+ velocity calculation is done in the snapshot rather here
		snapshot:PushWithCheck(time, value, velocity, tickrate, stopped)
	end
	FireEvent(self, "PushedSnapShot", time, value, newer)
	return newer
end

--[=[
	Pushes a new CFrame value into the entity's snapshot.

	@param time The time associated with the CFrame value.
	@param value The CFrame value to push.
	@param velocity Optional velocity to push with the snapshot. If not provided, will be calculated based on the latest snapshot value.

	@return Whether the pushed value is the newest.
]=]
function Entity.Push(self: Entity, time: number, value: CFrame, velocity: Vector3?): boolean
	if type(time) ~= "number" or time ~= time then
		error(`Chrono: Entity.Push expected time to be a number, got {if time ~= time then "NaN" else typeof(time)}`, 2)
	end
	if typeof(value) ~= "CFrame" then
		error(`Chrono: Entity.Push expected value to be a CFrame, got {typeof(value)}`, 2)
	end
	local newest=PushSnapshot(self, time, value, velocity)
	if newest then ExperimentalPrediction.Observe(self,time,value,velocity,if IS_SERVER then "server-clock" else "owner-clock") end
	return newest
end

-- pushes a stopped snapshot
function Entity._PushStopped(self: Entity, time: number, value: CFrame): boolean
	return PushSnapshot(self, time, value, nil, true)
end

-- Records a replicated change for stop events
function Entity._RecordMove(self: Entity, step: Vector3, gap: number)
	if gap &gt; 1 then
		const lastStep = self._lastStep
		const repeats = lastStep ~= nil
			and vector.magnitude((step - lastStep) :: any) &lt; vector.magnitude(lastStep :: any) * 0.25
		self._pausedSteps = if repeats then (self._pausedSteps or 0) + 1 else 0
	end
	self._stopAfter = if (self._pausedSteps or 0) &gt;= 2 then gap + 1 else nil
	self._lastStep = step
	self._idleTicks = 0
end

--[=[
	Gets the CFrame value at a specific time from the entity's snapshot.

	@param time The time to get the CFrame value for.

	@return The CFrame value at the specified time, or the latest CFrame if no snapshot exists.
]=]
function Entity.GetAt(self: Entity, time: number): CFrame?
	const snapshot = self.snapshot
	if snapshot then
		return snapshot:GetAt(time)
	else
		return self.latestCFrame
	end
end

function Entity._ApplyOwnerSmoothing(self: Entity, cframe: CFrame): CFrame
	const smoothing = self._ownerSmoothing
	if not smoothing then
		return cframe
	end
	const left = 1 - (os.clock() - smoothing.start) / OWNER_SMOOTH_TIME
	if left &lt;= 0 then
		self._ownerSmoothing = nil
		return cframe
	end
	return CFrame.new(cframe.Position + smoothing.offset * left)
		* CFrame.identity:Lerp(smoothing.rotation, left)
		* cframe.Rotation
end

--[=[
	Gets the entity's client clock. First checks _clientClock then falls back to entity config

	@return The client clock, or nil if no clock is available
]=]
function Entity.GetClock(self: Entity): Types.ClientClock?
	if self._clientClock then
		return self._clientClock
	end
	const clocks = self.entityConfig.CLIENT_CLOCK
	if not clocks then
		return nil
	end
	return self.isHalfTicked and clocks.HALF or clocks.NORMAL
end

--[=[
	Gets the target render time from the entity's client clock.

	@return The target render time, or -1 if no clock is available.
]=]
function Entity.GetTargetRenderTime(self: Entity): number
	const clock = Entity.GetClock(self)
	if not clock then
		return -1
	end
	return clock:GetTargetRenderTime()
end

--[=[
	Gets the current CFrame of the entity.

	@return The current CFrame of the entity.
]=]
function Entity.GetCFrame(self: Entity): CFrame?
	const part = GetPart(self)
	return self.latestCFrame or (part and part.CFrame)
end

--[=[
	Sets the current CFrame of the entity and locks the snapshot to the new time.

	@param cframe The CFrame to set for the entity.
]=]
function Entity.SetCFrame(self: Entity, cframe: CFrame)
	if typeof(cframe) ~= "CFrame" then
		error(`Chrono: Entity.SetCFrame expected a CFrame, got {typeof(cframe)}`, 2)
	end
	ExperimentalPrediction.Reset(self)
	-- A teleport is also a new state stream. Delayed pre-teleport packets must fail
	-- the revision check even after the visual lock's timeout has expired.
	if IS_SERVER and self.registered then
		local revision=(self.ownershipRevision or 0)+1
		assert(revision&lt;4294967296,"State revision exhausted")
		RegisterChange(self,"ownershipRevision",revision)
		self._receivedSequence=nil self._sendSequence=0 self.cframeBuffer=nil
	end
	const latestTime = (self.latestTime or 0) + 0.00002
	if Config.FLAGS.SET_CFRAME_FIX then
		if IS_SERVER or self.networkOwner then
			self._teleport = os.clock()
		end
		if not IS_SERVER and not self.isContextOwner then
			Entity.Clear(self)
		end
	end

	self._ownerChangedAt = nil
	self._ownerSmoothing = nil
	if self.snapshot and Config.FLAGS.FIX_TELEPORT_JITTER then
		self.snapshot.lockedTime = latestTime
	end
	PushSnapshot(self, latestTime, cframe)
	RegisterChange(self, "latestCFrame", cframe, true)

	if self.isContextOwner or not IS_SERVER then
		SetPartCFrame(self, cframe)
	end
end

--[=[
	Clears the entity's snapshot and latest CFrame/time.
]=]
function Entity.Clear(self: Entity)
	ExperimentalPrediction.Reset(self)
	const snapshot = self.snapshot
	self.latestTime = nil
	self.lastClientClock = nil
	if snapshot then
		snapshot:Clear()
	end
end

--[=[
	Sets whether the entity should auto update its position to the model's primary part CFrame.

	@param autoUpdate Whether to auto update the entity's position.
]=]
function Entity.SetAutoUpdatePos(self: Entity, autoUpdate: boolean)
	RegisterChange(self, "autoUpdatePosition", autoUpdate)
end

--// Ownership API
--[=[
	Sets the network owner of the entity. Can only be called on the server.

	@param player The player to set as the network owner. If nil, will clear the network owner.
]=]
function Entity.SetNetworkOwner(self: Entity, player: Player?)
	if IS_SERVER and player ~= self.networkOwner then
		SetEntityNetworkOwner(self, player)
		RegisterChange(self, "isHalfTicked", self.isHalfTicked, true)
	elseif not IS_SERVER then
		error("Chrono: Entity.SetNetworkOwner can only be called on the server", 2)
	end
end

function Entity.SyncOwnerShip(self: Entity)
	CheckNetworkOwner(self, self.networkOwner)
end

--// Config, clock &amp; interpolation
--[=[
	Sets the entity configuration for the entity.

	@param entityConfig The entity configuration name to set.
]=]
function Entity.SetConfig(self: Entity, entityConfig: string)
	local config = Config._GetEntityType(entityConfig)
	if not config then
		Warn.medium(`Entity config {entityConfig} not found. Using Default config.`)
		config = Config._GetEntityType("DEFAULT")
	end
	RegisterChange(self, "entityConfig", config, false, config.NAME)
	HumanoidState.Refresh(self)
	if IS_SERVER then
		if self.isContextOwner then
			if not config.STORE_SNAPSHOTS then
				self.snapshot = nil
			elseif not self.snapshot then
				self.snapshot = Snapshot(InterpolationMath.Hermite)
			end
		end
		return
	end
	UpdateClientAnchor(self)
	const clientClock = self._clientClock
	if clientClock then
		const tickRate = config.TICK_RATE
		clientClock._baseTickRate = tickRate
		clientClock:SetTickRate(if self.isHalfTicked then tickRate * 2 else tickRate)
		clientClock:UpdateBuffer(self._clockBuffer or config.BUFFER or 0)
	else
		SetClock(self)
	end
end

--[=[
	Sets the client clock buffer for the entity. 

	@param buffer? The buffer to set for the client clock. If nil, will use the entity config's buffer. 
]=]
function Entity.SetClockBuffer(self: Entity, buffer: number?)
	if IS_SERVER then
		error("Chrono: Entity.SetClockBuffer can only be called on the client", 2)
	end
	const clientClock = self._clientClock
	if clientClock and (self.networkOwner or buffer ~= nil) then
		self._clockBuffer = buffer
		clientClock:UpdateBuffer(buffer or self.entityConfig.BUFFER or 0)
		return
	end

	const sharedClocks = self.entityConfig.CLIENT_CLOCK
	const sharedClock = sharedClocks and (self.isHalfTicked and sharedClocks.HALF or sharedClocks.NORMAL)
	SetClock(self, buffer ~= nil and buffer or false)

	const newClock = self._clientClock
	if newClock and not self.networkOwner and sharedClock and sharedClock.lastClockAt then
		newClock.lastClockAt = sharedClock.lastClockAt
		newClock.lastClockDuration = sharedClock.lastClockDuration
		newClock.renderAt = sharedClock.renderAt
	end
end

--[=[
	Switches how the client applies interpolated transforms to this entity.

	@param mode "CFRAME", "ALIGN" or "NONE".
]=]
function Entity.SetInterpolationMode(self: Entity, mode: Types.INTERPOLATION_MODE)
	if mode and not INTERPOLATION_MODES[mode] then
		error(`Chrono: Entity.SetInterpolationMode expected "CFRAME", "ALIGN" or "NONE", got {mode}`, 2)
	end
	RegisterChange(self, "_interpolationMode", mode)

	if mode == "ALIGN" then
		HumanoidState.Refresh(self, true)
	else
		HumanoidState.Stop(self)
		AlignDriver.Clear(self)
	end
	UpdateClientAnchor(self)
end

--[=[
	Sets the broad phase vector for the entity.

	@param broadPhase The broad phase vector to set.
]=]
function Entity.SetBroadPhase(self: Entity, broadPhase: vector?)
	RegisterChange(self, "broadPhase", broadPhase)
end

function Entity._SetTickMode(self: Entity, isHalfTicked: boolean?)
	if self.isHalfTicked == isHalfTicked then
		return
	end
	if not self.isContextOwner then
		RegisterChange(self, "isHalfTicked", isHalfTicked)
	else
		self.isHalfTicked = isHalfTicked
	end
	FireEvent(self, "TickChanged", isHalfTicked == nil and "NONE" or if isHalfTicked then "HALF" else "NORMAL")
end

--// Data &amp; replication state
--[=[
	Gets the user associated data with the entity.

	@return The data associated with the entity.
]=]
function Entity.GetData(self: Entity): any
	return self._data
end

--[=[
	Sets the user associated data with the entity.

	@param data The data to associate with the entity.
]=]
function Entity.SetData(self: Entity, data: any)
	RegisterChange(self, "_data", data, true)
	FireEvent(self, "DataChanged", data)
end

--[=[
	Pauses replication for the entity.
]=]
function Entity.PauseReplication(self: Entity)
	ExperimentalPrediction.Reset(self)
	RegisterChange(self, "paused", true)
end

--[=[
	Resumes replication for the entity.
]=]
function Entity.ResumeReplication(self: Entity)
	RegisterChange(self, "paused", false)
end

--// Mounting
--[=[
	Sets the mount of the entity.

	@param parent The parent entity to mount to. If nil, will clear the mount.
	@param offset The CFrame offset from the parent entity.
]=]
function Entity.SetMount(self: Entity, parent: Entity?, offset: CFrame?)
	if not IS_SERVER then
		error("Chrono: Entity.SetMount can only be called on the server", 2)
	end

	if parent == nil then
		return Entity.ClearMount(self)
	end

	if self == parent then
		error("Chrono: Entity.SetMount cannot mount an entity to itself", 2)
	end

	if not parent.registered then
		error("Chrono: Entity.SetMount parent entity must be registered before mounting", 2)
	end

	RegisterChange(self, "mountParentId", parent.id)
	RegisterChange(self, "mountOffset", offset)
	Events._Signals.EntityMountChanged:Fire(self, parent.id)
end

--[=[
	Clears the mount of the entity.
]=]
function Entity.ClearMount(self: Entity)
	if not IS_SERVER then
		error("Chrono: Entity.ClearMount can only be called on the server", 2)
	end
	if not self.mountParentId then
		return
	end

	RegisterChange(self, "mountParentId", nil)
	RegisterChange(self, "mountOffset", nil)
	Events._Signals.EntityMountChanged:Fire(self, nil)
end

--// Events API
--[=[
	Gets the event signal for the specified event name.

	@param eventName The name of the event to get.

	@return The event signal associated with the specified event name.
]=]
Entity.GetEvent = (GetEvent :: any) :: ((
	self: Entity,
	eventName: "Destroying"
) -&gt; Types.Event&lt;(entity: Entity) -&gt; (), Entity&gt;) &amp; ((
	self: Entity,
	eventName: "NetworkOwnerChanged"
) -&gt; Types.Event&lt;(entity: Entity, newOwner: Player?, prevOwner: Player?) -&gt; (), Entity, Player?, Player?&gt;) &amp; ((
	self: Entity,
	eventName: "PushedSnapShot"
) -&gt; Types.Event&lt;
	(entity: Entity, time: number, value: CFrame, isNewest: boolean) -&gt; (),
	Entity,
	number,
	CFrame,
	boolean
&gt;) &amp; ((
	self: Entity,
	eventName: "TickChanged"
) -&gt; Types.Event&lt;(entity: Entity, newTickType: "NONE" | "HALF" | "NORMAL") -&gt; (), Entity, string&gt;) &amp; ((
	self: Entity,
	eventName: "DataChanged"
) -&gt; Types.Event&lt;(entity: Entity, data: any) -&gt; (), Entity, any&gt;) &amp; ((
	self: Entity,
	eventName: "Ticked"
) -&gt; Types.Event&lt;(entity: Entity, dt: number) -&gt; (), Entity, number&gt;) &amp; ((
	self: Entity,
	eventName: "ModelChanged"
) -&gt; Types.Event&lt;
	(entity: Entity, newModel: Model | BasePart?, oldModel: Model | BasePart?) -&gt; (),
	Entity,
	Model | BasePart?,
	Model | BasePart?
&gt;) &amp; ((
	self: Entity,
	eventName: "LockChanged"
) -&gt; Types.Event&lt;(entity: Entity, isLocked: boolean) -&gt; (), Entity, boolean&gt;)

--// Internal
local function register(player: Player)
	if not clientOwned[player] then
		clientOwned[player] = {}
	end
end
Players.PlayerAdded:Connect(register)

for _, player in Players:GetPlayers() do
	register(player)
end

if Players.LocalPlayer then
	register(Players.LocalPlayer)
end

Players.PlayerRemoving:Connect(function(player)
	clientOwned[player] = nil
end)

Entity._FireEvent = FireEvent
Entity._Push = PushSnapshot

Entity._GetPart = GetPart
Entity._SetPartCFrame = SetPartCFrame
Entity._GetRootPart = GetRootPart
Entity._LockPartPhysicsReplication = CFrameLock.Lock
Entity._UnlockPartPhysicsReplication = CFrameLock.Unlock
Entity._UpdateClockBuffer = SetClock
Entity._SetHumanoidState = HumanoidState.SetState
Entity._SetHumanoidDisabledStates = HumanoidState.SetDisabledStates
Entity._SetEntityNetworkOwner = SetEntityNetworkOwner

return Entity
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF37"><Properties><string name="Name">Events</string><ProtectedString name="Source">const Types = require(script.Parent.Types)
const Signal = require(script.Parent.Signal)
type Signal&lt;fx, T...&gt; = Types.Signal&lt;fx, T...&gt;

const Signals = {}
const Events = {}

Signals.EntityAdded = Signal.new() :: Signal&lt;(entity: Types.Entity) -&gt; (), Types.Entity&gt;
Events.EntityAdded = Signals.EntityAdded.Event

Signals.EntityRemoved = Signal.new() :: Signal&lt;(entity: Types.Entity) -&gt; (), Types.Entity&gt;
Events.EntityRemoved = Signals.EntityRemoved.Event

Signals.PlayerCharacterRegistered =
	Signal.new() :: Signal&lt;(player: Player, entity: Types.Entity) -&gt; (), Player, Types.Entity&gt; 
Events.PlayerCharacterRegistered = Signals.PlayerCharacterRegistered.Event

Signals.PlayerCharacterUnregistered =
	Signal.new() :: Signal&lt;(player: Player, entity: Types.Entity) -&gt; (), Player, Types.Entity&gt;
Events.PlayerCharacterUnregistered = Signals.PlayerCharacterUnregistered.Event

Signals.PlayerOwnedAdded = Signal.new() :: Signal&lt;(player: Player, entity: Types.Entity) -&gt; (), Player, Types.Entity&gt;
Events.PlayerOwnedAdded = Signals.PlayerOwnedAdded.Event

Signals.PlayerOwnedRemoved =
	Signal.new() :: Signal&lt;(PrevOwner: Player, entity: Types.Entity) -&gt; (), Player, Types.Entity&gt;
Events.PlayerOwnedRemoved = Signals.PlayerOwnedRemoved.Event

Signals.EntityMountChanged =
	Signal.new() :: Signal&lt;(entity: Types.Entity, mountParentId: number?) -&gt; (), Types.Entity, number?&gt;
Events.EntityMountChanged = Signals.EntityMountChanged.Event

Signals.PlayerLoaded = Signal.new() :: Signal&lt;(player: Player) -&gt; (), Player&gt;

Events._Signals = Signals
return Events
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF38"><Properties><string name="Name">ExperimentalPrediction</string><ProtectedString name="Source">-- VERY EXPERIMENTAL. Estimates are separate from entity/history CFrames.
-- No predicted frame is inserted into snapshots, serialized, or trusted for hits.
local Config=require(script.Parent.Config)
local Motion=require(script.Parent.MotionPredictor)
local P={}
local states=setmetatable({}, {__mode="k"})
local function enabled() return Config._GetConfig("EXPERIMENTAL_PREDICTION") end
local function options()
	local out={}
	for key,suffix in {maxHorizon="SECONDS",maxDistance="DISTANCE",maxSpeed="SPEED",maxAcceleration="ACCELERATION",
		maxTurnRate="TURN",maxAngularSpeed="ANGULAR",maxGap="GAP",teleportDistance="TELEPORT",learningSeconds="LEARNING"} do
		out[key]=Config._GetConfig("EXPERIMENTAL_PREDICTION_"..suffix)
	end
	return out
end
local function current(entity)
	local state=states[entity]
	if state and (state.generation~=entity.generation or state.revision~=entity.ownershipRevision
		or state.owner~=entity.networkOwner or state.modelObject~=entity.model) then
		states[entity]=nil state=nil
	end
	return state
end
function P.Reset(entity) states[entity]=nil end
function P.Observe(entity,time,frame,velocity,domain,discontinuity)
	if not enabled() then return false,"experimental_disabled" end
	if type(entity)~="table" or entity.destroyed or entity.paused then return false,"inactive_entity" end
	if not Motion.IsFinite(time) or not Motion.IsFrame(frame) or (velocity~=nil and not Motion.IsVector(velocity)) then return false,"invalid_sample" end
	domain=domain or "entity-time"
	if type(domain)~="string" or #domain&gt;64 then return false,"invalid_clock_domain" end
	local state=current(entity)
	if state and state.domain~=domain then P.Reset(entity) state=nil end
	if not state then
		state={model=Motion.New(options()),domain=domain,generation=entity.generation,
			revision=entity.ownershipRevision,owner=entity.networkOwner,modelObject=entity.model,
			accepted=0,rejected=0}
		states[entity]=state
	end
	local ok,reason=state.model:Observe(time,frame,velocity,discontinuity)
	state.lastReason=reason
	if ok then state.sourceTime=time state.receivedAt=os.clock() state.accepted+=1 else state.rejected+=1 end
	return ok,reason
end
function P.Estimate(entity,targetSourceTime)
	if not enabled() then return nil,{status="experimental_disabled",experimental=true,trust="estimate"} end
	if type(entity)~="table" or entity.destroyed or entity.paused or entity.mountParentId then return nil,{status="inactive_entity",experimental=true,trust="estimate"} end
	local state=current(entity)
	if not state then return nil,{status="empty",experimental=true,trust="estimate"} end
	local frame,info=state.model:Predict(targetSourceTime)
	info.experimental=true info.trust="estimate" info.clockDomain=state.domain
	info.sourceGrade="observed-or-game-supplied; not upgraded by prediction"
	return frame,info
end
function P.EstimateCurrent(entity,sourceDelaySeconds)
	if not enabled() then return P.Estimate(entity,0) end
	if type(entity)~="table" then return nil,{status="inactive_entity",experimental=true,trust="estimate"} end
	local state=current(entity)
	if not state or not state.sourceTime then return P.Estimate(entity,0) end
	local delay=if sourceDelaySeconds==nil then Config._GetConfig("EXPERIMENTAL_PREDICTION_DELAY") else sourceDelaySeconds
	if not Motion.IsFinite(delay) or delay&lt;0 or delay&gt;0.5 then return nil,{status="invalid_delay",experimental=true,trust="estimate"} end
	local elapsed=math.max(0,os.clock()-state.receivedAt)
	local frame,info=P.Estimate(entity,state.sourceTime+elapsed+delay)
	info.timing="elapsed since receipt + explicit source-delay assumption"
	info.assumedSourceDelay=delay info.elapsedSinceReceipt=elapsed
	return frame,info
end
function P.Inspect(entity)
	local state=if type(entity)=="table" then current(entity) else nil
	return {experimental=true,enabled=enabled(),drawing=Config._GetConfig("EXPERIMENTAL_PREDICTION_DRAW"),
		active=state~=nil,accepted=if state then state.accepted else 0,rejected=if state then state.rejected else 0,
		lastReason=if state then state.lastReason else nil,
		clockDomain=if state then state.domain else nil,sourceTime=if state then state.sourceTime else nil,
		limits=options(),assumedSourceDelay=Config._GetConfig("EXPERIMENTAL_PREDICTION_DELAY"),trust="estimate"}
end
return table.freeze(P)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF39"><Properties><string name="Name">Holder</string><ProtectedString name="Source">const Types = require(script.Parent.Types)
const Warn = require(script.Parent.Warn)
const Signals = require(script.Parent.Events)._Signals
const IS_SERVER = game:GetService("RunService"):IsServer()

local currentId = 0 -- First Id will start at 1
const idStack: { number } = {}
local lifetime = 0
local modelMap = setmetatable({}, {__mode="k"})
const playerChars: { [Player]: Types.Entity } = {}
const idMap: { [number]: Types.Entity } = {}
const clientOwned: { [Player]: { [Types.Entity]: true } } = {}
const entityChangedFields = {}

const function RegisterChange(entity: Types.Entity, key: string, value: any, bypass: boolean?, specialValue: any)
	if not bypass and (entity :: any)[key] == value then
		return
	end
	(entity :: any)[key] = value
	if not IS_SERVER then
		return
	end
	if not entityChangedFields[entity] then
		entityChangedFields[entity] = {}
	end
	-- any nil with replace with false so it can be serialized and sent to the client
	entityChangedFields[entity][key] = specialValue or value or false
end

const MAX_ID = 2 ^ 16 - 1

const function GetNextId(): number
	const reusedId = table.remove(idStack)
	if reusedId then
		return reusedId
	else
		if currentId &gt;= MAX_ID then
			error("Max ID reached, please investigate.")
		end
		currentId += 1
		return currentId
	end
end

const RandomOffset = Random.new()
const function ReleaseId(id: number)
	-- Delay the reuse of the id to avoid immediate collisions
	task.delay(RandomOffset:NextNumber(5, 10), table.insert, idStack, id)
end

--[=[
	Removes the player character mapping from an entity.

	@param entity The entity to remove the player character mapping from.
]=]
const function RemovePlayerCharacter(entity: Types.Entity)
	const player: Player? = entity._player
	entity._player = nil
	if player and playerChars[player] == entity then
		playerChars[player] = nil
		RegisterChange(entity, "_player", nil)
		Signals.PlayerCharacterUnregistered:Fire(player, entity)
	end
end

--[=[
	Sets an entity as the character entity for a player.

	@param player The player to set the character for.
	@param entity The entity to set as the character.
]=]
const function SetAsCharacter(player: Player, entity: Types.Entity)
	if not idMap[entity.id] or entity.id &lt; 1 then
		error("Chrono: Holder.SetAsCharacter entity must be registered first", 2)
	end
	const old: Types.Entity? = playerChars[player]
	if old then
		RemovePlayerCharacter(old)
	end
	playerChars[player] = entity
	RegisterChange(entity, "_player", player)
	Signals.PlayerCharacterRegistered:Fire(player, entity)
end

--[=[
	Registers an entity in the global entity map. Already registered entities will be ignored.
	Destroyed entities cannot be registered.

	@param entity The entity to register.
]=]
const function RegisterEntity(entity: Types.Entity)
	if entity.destroyed then
		error("Chrono: Holder.RegisterEntity cannot register a destroyed entity", 2)
	end
	if idMap[entity.id] then
		Warn.medium("Entity is already registered", entity)
		return
	end
	if IS_SERVER then
		const id = GetNextId()
		if idMap[id] then
			error(`Entity Collision {id}`)
		end
		entity.id = id
		lifetime += 1
		assert(lifetime &lt; 4294967296, "Entity lifetime counter exhausted")
		entity.generation = lifetime
		entity.ownershipRevision = entity.ownershipRevision or 0
		entity._sendSequence = entity._sendSequence or 0
		idMap[id] = entity
	else
		const id = entity.id
		if idMap[id] then
			Warn.high("Entity ID collision detected for ID:", id)
		end
		idMap[id] = entity
	end
	entity.registered = true
	if entity.model then modelMap[entity.model] = entity end

	if entity._player then
		if playerChars[entity._player] then
			Warn.medium("Player already has an entity registered", entity, "overwriting")
		end
		SetAsCharacter(entity._player, entity)
	end
	Signals.EntityAdded:Fire(entity)
end

--[=[
	Unregisters an entity from the global entity map. Non-registered entities will be ignored.

	@param entity The entity to unregister.
]=]
const function UnregisterEntity(entity: Types.Entity)
	if not idMap[entity.id] then
		return
	end
	Signals.EntityRemoved:Fire(entity)
	if entity.model and modelMap[entity.model] == entity then modelMap[entity.model] = nil end
	const playerObject = entity._player
	if playerObject then
		if playerChars[playerObject] == entity then
			RemovePlayerCharacter(entity)
		else
			Warn.medium("Entity being unregistered does not match player mapping", entity, "ignoring")
		end
	end
	const id = entity.id
	if IS_SERVER then
		idMap[id] = nil
		ReleaseId(id)
		entity.id = -1
	else
		idMap[id] = nil
	end
	entity._lastId = id
	entity.registered = false
end

--[=[
	Gets the entity associated with a given model. Warning this is an O(n) operation.

	@param model The model to look up.

	@return The entity associated with the model, or nil if none exists.
]=]
const function GetEntityFromModel(model: Model): Types.Entity?
	return modelMap[model]
end
const function UpdateModel(entity, previous)
	if previous and modelMap[previous] == entity then modelMap[previous] = nil end
	if entity.registered and entity.model then modelMap[entity.model] = entity end
end

--[=[
	Gets the entity associated with a given player.
	@param player The player to look up.
	@return The entity associated with the player, or nil if none exists.
]=]
const function GetEntityFromPlayer(player: Player): Types.Entity?
	const plrCharacter = playerChars[player]
	return plrCharacter
end

--[=[
	Gets the entity associated with a given id.

	@param id The id to look up.

	@return The entity associated with the id, or nil if none exists.
]=]
const function GetEntityFromId(id: number): Types.Entity?
	return idMap[id]
end

--[=[
	Gets or creates the instance used for storing entities in the workspace.

	@return The Camera instance used for entity storage.
]=]
const function getEntityStorageInstance(): Camera
	if workspace:FindFirstChild("Chrono_EntityStorage") then
		return workspace:FindFirstChild("Chrono_EntityStorage") :: Camera
	else
		const folder = Instance.new("Camera")
		folder.Name = "Chrono_EntityStorage"
		folder.Parent = workspace
		return folder
	end
end

return {
	idMap = idMap,
	_clientOwned = clientOwned,
	_playerChars = playerChars,
	_entityChangedFields = entityChangedFields,

	RegisterChange = RegisterChange,
	_UpdateModel = UpdateModel,
	RegisterEntity = RegisterEntity,
	UnregisterEntity = UnregisterEntity,
	GetEntityStorageInstance = getEntityStorageInstance,
	SetAsCharacter = SetAsCharacter,
	RemovePlayerCharacter = RemovePlayerCharacter,
	GetEntityFromPlayer = GetEntityFromPlayer,
	GetEntityFromId = GetEntityFromId,
	GetEntityFromModel = GetEntityFromModel,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF40"><Properties><string name="Name">HumanoidState</string><ProtectedString name="Source">const RunService = game:GetService("RunService")

const Types = require(script.Parent.Types)
const Holder = require(script.Parent.Holder)

const IS_SERVER = RunService:IsServer()
const RegisterChange = Holder.RegisterChange

const HUMANOID_STATES: { [number]: Enum.HumanoidStateType } = {}
for _, item in Enum.HumanoidStateType:GetEnumItems() do
	HUMANOID_STATES[item.Value] = item
end

type Entity = Types.Entity

const function GetHumanoid(self: Entity): Humanoid?
	const model = self.model
	if model and model:IsA("Model") then
		return model:FindFirstChildWhichIsA("Humanoid", true)
	end
	return nil
end

const function GetDisabledStateMask(humanoid: Humanoid): number
	local mask = 0
	for value, state in HUMANOID_STATES do
		if state == Enum.HumanoidStateType.None then
			continue
		end
		if not humanoid:GetStateEnabled(state) then
			mask = bit32.bor(mask, bit32.lshift(1, value))
		end
	end
	return mask
end

const function StopHumanoidStateWatch(self: Entity)
	const connection = self._humanoidStateConn
	if connection then
		connection:Disconnect()
		self._humanoidStateConn = nil
	end
	const enabledConnection = self._humanoidStateEnabledConn
	if enabledConnection then
		enabledConnection:Disconnect()
		self._humanoidStateEnabledConn = nil
	end

	if IS_SERVER then
		RegisterChange(self, "_humanoidState", nil)
		RegisterChange(self, "_humanoidDisabledStates", nil)
	end
end

const function StartHumanoidStateWatch(self: Entity)
	if not IS_SERVER then
		return
	end
	StopHumanoidStateWatch(self)

	const humanoid = GetHumanoid(self)
	if not humanoid then
		return
	end

	RegisterChange(self, "_humanoidState", humanoid:GetState().Value, true)
	self._humanoidStateConn = humanoid.StateChanged:Connect(function(_old, new)
		RegisterChange(self, "_humanoidState", new.Value)
	end)

	RegisterChange(self, "_humanoidDisabledStates", GetDisabledStateMask(humanoid), true)
	self._humanoidStateEnabledConn = humanoid.StateEnabledChanged:Connect(function()
		RegisterChange(self, "_humanoidDisabledStates", GetDisabledStateMask(humanoid))
	end)
end

const function RefreshHumanoidStateWatch(self: Entity, force: boolean?)
	if not IS_SERVER then
		return
	end

	const config = self.entityConfig
	const mode = self._interpolationMode or (config and config.INTERPOLATION_MODE)

	if mode ~= "ALIGN" then
		StopHumanoidStateWatch(self)
		return
	end

	if self._humanoidStateConn and not force then
		return
	end
	StartHumanoidStateWatch(self)
end

const function SetHumanoidState(self: Entity, stateValue: number?)
	RegisterChange(self, "_humanoidState", stateValue)

	if IS_SERVER or self.isContextOwner or type(stateValue) ~= "number" then
		return
	end

	const humanoid = GetHumanoid(self)
	if not humanoid then
		return
	end
	local state = HUMANOID_STATES[stateValue]
	if not state then
		return
	end

	if state == Enum.HumanoidStateType.Ragdoll then
		state = Enum.HumanoidStateType.Physics
	end

	humanoid:ChangeState(state)
end

const function SetHumanoidDisabledStates(self: Entity, mask: number?)
	RegisterChange(self, "_humanoidDisabledStates", mask)
	if IS_SERVER or self.isContextOwner or type(mask) ~= "number" then
		return
	end

	const humanoid = GetHumanoid(self)
	if not humanoid then
		return
	end

	for value, state in HUMANOID_STATES do
		if state == Enum.HumanoidStateType.None then
			continue
		end
		humanoid:SetStateEnabled(state, bit32.band(mask, bit32.lshift(1, value)) == 0)
	end
end

return {
	Refresh = RefreshHumanoidStateWatch,
	Stop = StopHumanoidStateWatch,
	SetState = SetHumanoidState,
	SetDisabledStates = SetHumanoidDisabledStates,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF41"><Properties><string name="Name">InterpolationMath</string><ProtectedString name="Source">--!native

const Types = require(script.Parent.Types)
const Config = require(script.Parent.Config)

const function Hermite(p0: Vector3, p1: Vector3, v0: Vector3, v1: Vector3, t: number, dt: number): Vector3
	v0 = v0 or Vector3.zero
	v1 = v1 or Vector3.zero
	if not dt or dt == 0 then
		return p0 + (p1 - p0) * t
	end

	-- Cap tangent at 3x the segment length to reduce overshoot.
	-- https://en.wikipedia.org/wiki/Monotone_cubic_interpolation

	const maxTangent = vector.magnitude((p1 - p0) :: any) * 3
	const t0Length = vector.magnitude(v0 :: any) * dt
	if t0Length &gt; maxTangent then
		v0 *= maxTangent / t0Length
	end
	const t1Length = vector.magnitude(v1 :: any) * dt
	if t1Length &gt; maxTangent then
		v1 *= maxTangent / t1Length
	end

	const t2 = t * t
	const t3 = t2 * t
	const h00 = 2 * t3 - 3 * t2 + 1
	const h10 = t3 - 2 * t2 + t
	const h01 = -2 * t3 + 3 * t2
	const h11 = t3 - t2

	return p0 * h00 + v0 * dt * h10 + p1 * h01 + v1 * dt * h11
end

const function CalculateVelocity(lP: Vector3, lT: number, cP: Vector3, cT: number, tickrate: number?): Vector3
	local rate = tickrate or 1 / 20
	local dt = cT - lT
	if dt &lt;= 1e-6 then
		return Vector3.zero
	elseif dt &gt; rate * 3 and Config.FLAGS.SNAPSHOT_INTERPOLATION_FIX then
		dt = rate
	end
	if Config.FLAGS.VELOCITY_CALC_FIX then
		dt = math.max(dt, rate) -- ensures that velocity is not calculated with a dt that is too small
	end
	return (cP - lP) / dt
end

const function CheckIdle(
	latest: Types.SnapshotData&lt;CFrame, Vector3&gt;,
	t: number,
	position: Vector3,
	tickrate: number,
	peakSpeed: number?
): boolean
	const gap = t - latest.t
	if gap &lt;= tickrate * 3 or not Config.FLAGS.SNAPSHOT_INTERPOLATION_FIX then
		return false
	end
	const velocity = latest.velocity
	const latestSpeed = if velocity then vector.magnitude(velocity :: any) else 0
	const moved = position - latest.value.Position
	const speed = math.max(latestSpeed, peakSpeed or 0)

	const predictedTravel = latestSpeed * gap
	if
		predictedTravel &gt; speed * tickrate * 1.5
		and vector.magnitude((moved - velocity * gap) :: any) &lt; predictedTravel * 0.15
	then
		return false
	end
	if speed &lt; 1e-3 then
		return true
	end

	return vector.magnitude(moved :: any) &lt; speed * (gap + tickrate) * 0.5
end

const function VelocityAt(
	latest: Types.SnapshotData&lt;CFrame, Vector3&gt;?,
	t: number,
	cframe: CFrame,
	tickrate: number?,
	peakSpeed: number?
): Vector3
	if not latest then
		return Vector3.zero
	end
	const rate = tickrate or 1 / 20
	const position = cframe.Position
	if t - latest.t &gt; rate * 3 and not CheckIdle(latest, t, position, rate, peakSpeed) then
		return (position - latest.value.Position) / (t - latest.t)
	end
	return CalculateVelocity(latest.value.Position, latest.t, position, t, rate)
end

return {
	Hermite = Hermite,
	VelocityAt = VelocityAt,
	CheckIdle = CheckIdle,
	CalculateVelocity = CalculateVelocity,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF42"><Properties><string name="Name">ModelHelper</string><ProtectedString name="Source">const Shared = script.Parent
const Warn = require(script.Parent.Warn)
const Holder = require(Shared.Holder)
const Types = require(Shared.Types)

const function ReadyModelFromRep(
	entity: Types.Entity,
	playerSpecific: Player?
): Model | string | BasePart | InstanceHandle?
	const model = entity.model
	const modelString = entity.modelString
	const replicationMode: "NATIVE" | "CUSTOM" = (entity.modelReplicationMode or "NATIVE") :: any

	if replicationMode == "NATIVE" and model then
		return InstanceHandle.new(model)
	elseif replicationMode == "CUSTOM" then
		if modelString then
			return modelString
		end
		local ModelReplicator: Instance = Shared._CUSTOM_MODEL_REP

		-- This will replicate the model to the player as player guis is not replicated to other players
		const PlayerGui = playerSpecific and playerSpecific:FindFirstChildOfClass("PlayerGui")
		if PlayerGui then
			local clientModels = PlayerGui:FindFirstChild("_ChronoClientModels")
			if not clientModels then
				const screenGui = Instance.new("ScreenGui")
				screenGui.ResetOnSpawn = false
				screenGui.Name = "_ChronoClientModels"
				screenGui.Parent = PlayerGui
				clientModels = screenGui
			end
			ModelReplicator = clientModels :: Instance
		end
		if model then
			const source: Instance = model
			source.Archivable = true
			const modelClone = source:Clone()
			modelClone.Parent = ModelReplicator

			task.delay(2, function()
				modelClone:Destroy()
			end)
			return modelClone :: any
		end
	elseif modelString then
		Warn.medium(`{modelString} is not a valid model string for entity {entity.id}`)
	end
	return nil
end

const function CreateTempModel(): (Model, string)
	const model = Instance.new("Model")
	model.Name = "TempModel"

	const part = Instance.new("Part")
	part.Name = "Failed To Get Model"
	part.Size = Vector3.new(3, 5, 3)
	part.Anchored = true
	part.Parent = model

	model.PrimaryPart = part
	model.Parent = workspace

	return model, "CUSTOM"
end

const function CreateModelFromData(
	model: Model | string | BasePart | InstanceHandle?
): (Model | string | BasePart?, string?, InstanceHandle?)
	if not model then
		return nil, nil, nil
	end

	if type(model) == "string" then
		return model, "CUSTOM", nil
	end

	if typeof(model) == "InstanceHandle" then
		return model:Get() :: any, "NATIVE", model
	end

	if
		model.Parent == Shared._CUSTOM_MODEL_REP
		or (
			model.Parent
			and model.Parent.Name == "_ChronoClientModels"
			and model.Parent.Parent
			and model.Parent.Parent:IsA("PlayerGui")
		)
	then
		const clone = model:Clone()
		if clone then
			(clone :: any).Parent = Holder.GetEntityStorageInstance()
			return clone, "CUSTOM", nil
		end
		const tempModel, tempType = CreateTempModel()
		return tempModel, tempType, nil
	end

	return model, "NATIVE", nil
end

return {
	ReadyModelFromRep = ReadyModelFromRep,
	CreateModelFromData = CreateModelFromData,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF43"><Properties><string name="Name">MotionPredictor</string><ProtectedString name="Source">-- Estimates only, on either peer. A forecast never upgrades a sample's trust.
-- Source times must describe capture time, not packet receipt time.
local Motion = {}
local Model = {}
Model.__index = Model
local HORIZONS = {0.033, 0.067, 0.1, 0.15, 0.25}
local NAMES = {"hold", "straight", "acceleration", "turn", "braking"}
local DEFAULTS = {maxHorizon=0.25,maxDistance=8,maxSpeed=120,maxAcceleration=250,
	maxTurnRate=8,maxAngularSpeed=12,maxGap=0.75,teleportDistance=8,learningSeconds=0.6}
local function finite(n) return type(n)=="number" and n==n and math.abs(n)&lt;math.huge end
local function vectorOK(v)
	return typeof(v)=="Vector3" and finite(v.X) and finite(v.Y) and finite(v.Z)
end
local function frameOK(cf)
	if typeof(cf)~="CFrame" then return false end
	for _,v in {cf:GetComponents()} do if not finite(v) then return false end end
	return true
end
local function limit(v, cap)
	local length=v.Magnitude
	return if length&gt;cap then v*(cap/length) else v
end
local function newScores()
	local scores={}
	for i=1,#HORIZONS do scores[i]={loss={0,0,0,0,0},seen=0} end
	return scores
end
local function bin(age)
	local best=1
	for i=2,#HORIZONS do
		if math.abs(age-HORIZONS[i])&lt;math.abs(age-HORIZONS[best]) then best=i end
	end
	return best
end
local function displacement(state, h, index, config)
	local v=state.velocity
	local d
	if index==1 then d=Vector3.zero
	elseif index==2 then d=v*h
	elseif index==3 then
		local a=state.acceleration
		local speed=v.Magnitude
		-- Measured braking must not become an invented backwards launch.
		if speed&lt;0.1 then d=Vector3.zero else
			local along=a:Dot(v/speed)
			local stop=if along&lt;0 then math.min(h,-speed/along) else h
			d=v*stop+a*(0.5*stop*stop)
		end
	elseif index==4 then
		local w=state.turn
		if math.abs(w)&lt;1e-4 then d=v*h else
			local a,b=math.sin(w*h)/w,(1-math.cos(w*h))/w
			d=Vector3.new(v.X*a-v.Z*b,v.Y*h,v.X*b+v.Z*a)
		end
	else d=v*(0.08*(1-math.exp(-h/0.08))) end
	return limit(d,config.maxDistance)
end
function Motion.New(options)
	local config=table.clone(DEFAULTS)
	for key,value in options or {} do
		assert(config[key]~=nil and finite(value) and value&gt;0,"invalid motion option: "..tostring(key))
		config[key]=value
	end
	return setmetatable({config=table.freeze(config),history={},scores=newScores(),epoch=0},Model)
end
function Model:Reset()
	table.clear(self.history) self.scores=newScores() self.epoch+=1
end
function Model:Observe(t, frame, velocity, discontinuity)
	if not finite(t) or not frameOK(frame) or (velocity~=nil and not vectorOK(velocity)) then return false,"invalid_sample" end
	local previous=self.history[#self.history]
	if previous and t&lt;=previous.t then return false,"out_of_order" end
	local dt=if previous then t-previous.t else 0
	local reset=discontinuity==true or (previous and (dt&gt;self.config.maxGap or
		(frame.Position-previous.frame.Position).Magnitude&gt;math.max(self.config.teleportDistance,self.config.maxSpeed*dt*1.5)))
	velocity=velocity or (if previous and not reset then (frame.Position-previous.frame.Position)/dt else Vector3.zero)
	if velocity.Magnitude&gt;self.config.maxSpeed then return false,"speed_limit" end
	if reset then self:Reset() previous=nil end
	local acceleration,turn,angular=Vector3.zero,0,Vector3.zero
	if previous and dt&lt;=0.25 then
		acceleration=limit((velocity-previous.velocity)/dt,self.config.maxAcceleration)
		local p,v=previous.velocity,velocity
		if Vector3.new(p.X,0,p.Z).Magnitude&gt;1 and Vector3.new(v.X,0,v.Z).Magnitude&gt;1 then
			turn=math.clamp(math.atan2(p.X*v.Z-p.Z*v.X,p.X*v.X+p.Z*v.Z)/dt,-self.config.maxTurnRate,self.config.maxTurnRate)
		end
		-- A reversal is a new movement choice, not evidence of a continuing orbit.
		if p.Magnitude&gt;1 and v.Magnitude&gt;1 and p:Dot(v)/(p.Magnitude*v.Magnitude)&lt;0.5 then
			acceleration,turn=Vector3.zero,0
		end
		if v.Magnitude&lt;0.1 then acceleration=Vector3.zero end
		local axis,angle=previous.frame.Rotation:ToObjectSpace(frame.Rotation):ToAxisAngle()
		angular=limit(previous.frame:VectorToWorldSpace(axis)*(angle/dt),self.config.maxAngularSpeed)
	end
	-- Retrospective scoring: each old state was built with information available THEN.
	-- Never use the newly calculated acceleration to score an earlier forecast.
	if previous then
		local alpha=1-math.exp(-dt/self.config.learningSeconds)
		for b,horizon in HORIZONS do
			local old,nearest
			for i=#self.history,1,-1 do
				local s=self.history[i] local distance=math.abs(t-s.t-horizon)
				if not nearest or distance&lt;nearest then old,nearest=s,distance end
			end
			if old and nearest&lt;=math.max(0.025,horizon*0.4) and t-old.t&gt;0 then
				local bucket=self.scores[b]
				for k=1,#NAMES do
					local error=(old.frame.Position+displacement(old,math.min(t-old.t,self.config.maxHorizon),k,self.config)-frame.Position).Magnitude
					bucket.loss[k]+=alpha*(math.min(error*error,400)-bucket.loss[k])
				end
				bucket.seen+=dt
			end
		end
	end
	local state={t=t,frame=frame,velocity=velocity,acceleration=acceleration,turn=turn,angular=angular}
	table.insert(self.history,state)
	while #self.history&gt;64 or (#self.history&gt;1 and t-self.history[1].t&gt;0.6) do table.remove(self.history,1) end
	return true,if reset then "reset" else "accepted"
end
function Model:Predict(t)
	if not finite(t) then return nil,{status="invalid_time"} end
	local state=self.history[#self.history]
	if not state then return nil,{status="empty"} end
	local age=t-state.t
	if age&lt;0 then return nil,{status="before_source"} end
	local h=math.min(age,self.config.maxHorizon)
	local bucket=self.scores[bin(h)]
	local best=2
	-- Prefer straight motion until evidence distinguishes another model.
	-- A small cost prevents switching because of float noise alone.
	if bucket.seen&gt;=0.15 then
		for k=1,#NAMES do
			-- History can suggest a stop is likely, but stable current velocity is
			-- not evidence that a player has chosen to stop. Require measured braking.
			local eligible=(k~=1 or state.velocity.Magnitude&lt;0.1)
				and (k~=5 or state.acceleration:Dot(state.velocity)&lt;-2*state.velocity.Magnitude)
			if eligible and bucket.loss[k]+0.0025&lt;bucket.loss[best] then best=k end
		end
	end
	local travel=displacement(state,h,best,self.config)
	local angular=state.angular local speed=angular.Magnitude
	local rotation=state.frame.Rotation
	if speed&gt;1e-5 then rotation=CFrame.fromAxisAngle(angular/speed,speed*h)*rotation end
	local candidates={}
	for k=1,#NAMES do candidates[k]=displacement(state,h,k,self.config) end
	local spread=0
	for _,d in candidates do spread=math.max(spread,(d-travel).Magnitude) end
	return CFrame.new(state.frame.Position+travel)*rotation,{
		status=if age&gt;h+1e-6 then "capped" else "predicted",model=NAMES[best],
		sourceTime=state.t,targetTime=t,predictedTime=state.t+h,age=age,horizon=h,
		-- A heuristic warning, NOT a confidence interval or collision volume.
		uncertainty=math.sqrt(bucket.loss[best])+spread+math.max(0,age-h)*self.config.maxSpeed,
		epoch=self.epoch,trust="estimate",
	}
end
Motion.IsFinite=finite Motion.IsVector=vectorOK Motion.IsFrame=frameOK
return table.freeze(Motion)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF44"><Properties><string name="Name">Protocol</string><ProtectedString name="Source">-- Wire v2: validate the WHOLE packet before returning any decoded state.
-- API-compatible with Chrono; wire v2 peers must use the same package.
-- Full f64 source clocks remove the five-day u32 wrap ambiguity from state packets.
local P = {Version = 2, MaxPayload = 900, Header = 5, FullBytes = 41, YawBytes = 37}
local MAGIC = 0xCF32
local TAU = 2 * math.pi
local function finite(n) return type(n) == "number" and n == n and math.abs(n) &lt; math.huge end
local function integer(n, lo, hi) return finite(n) and n % 1 == 0 and n &gt;= lo and n &lt;= hi end
local function frame(cf)
	if typeof(cf) ~= "CFrame" then return false end
	for _, n in {cf:GetComponents()} do if not finite(n) then return false end end
	local p = cf.Position
	local x,y,z=cf.RightVector,cf.UpVector,cf.ZVector
	return math.max(math.abs(p.X), math.abs(p.Y), math.abs(p.Z)) &lt;= 1e7
		and math.abs(x.Magnitude-1)&lt;1e-4 and math.abs(y.Magnitude-1)&lt;1e-4 and math.abs(z.Magnitude-1)&lt;1e-4
		and math.abs(x:Dot(y))&lt;1e-4 and math.abs(y:Dot(z))&lt;1e-4 and math.abs(z:Dot(x))&lt;1e-4 and x:Cross(y):Dot(z)&gt;0.9999
end
function P.Record(entity, time, cf, full, half, teleport, stop)
	assert(integer(entity.id, 1, 65535) and integer(entity.generation, 1, 4294967295), "invalid entity lifetime")
	assert(integer(entity.ownershipRevision or 0, 0, 4294967295), "invalid ownership revision")
	assert(integer(entity._sendSequence, 0, 4294967295), "invalid state sequence")
	assert(finite(time) and time &gt;= 0 and time &lt;= 1e12 and frame(cf), "invalid position or source time")
	local b = buffer.create(if full then P.FullBytes else P.YawBytes)
	buffer.writeu16(b, 0, entity.id)
	local flags = (if full then 1 else 0) + (if half then 2 else 0) + (if teleport then 4 else 0) + (if stop then 8 else 0)
	buffer.writeu8(b, 2, flags)
	buffer.writeu32(b, 3, entity.generation)
	buffer.writeu32(b, 7, entity.ownershipRevision or 0)
	buffer.writeu32(b, 11, entity._sendSequence)
	buffer.writef64(b, 15, time)
	buffer.writef32(b, 23, cf.X) buffer.writef32(b, 27, cf.Y) buffer.writef32(b, 31, cf.Z)
	local rx, ry, rz = cf:ToOrientation()
	local function angle(offset, value) buffer.writeu16(b, offset, math.round((value + math.pi) / TAU * 65535)) end
	if full then angle(35, rx) angle(37, ry) angle(39, rz) else angle(35, ry) end
	return b
end
function P.WithHalf(record, half)
	local out = buffer.create(buffer.len(record)) buffer.copy(out, 0, record)
	local flags = buffer.readu8(out, 2)
	buffer.writeu8(out, 2, if half then bit32.bor(flags, 2) else bit32.band(flags, bit32.bnot(2)))
	return out
end
function P.Pack(records)
	local packets, group, bytes,seen = {}, {}, P.Header,{}
	local function flush()
		if #group == 0 then return end
		local b = buffer.create(bytes)
		buffer.writeu16(b, 0, MAGIC) buffer.writeu8(b, 2, P.Version) buffer.writeu16(b, 3, #group)
		local offset = P.Header
		for _, row in group do buffer.copy(b, offset, row) offset += buffer.len(row) end
		table.insert(packets, b) group, bytes,seen = {}, P.Header,{}
	end
	for _, row in records do
		local length = buffer.len(row)
		assert(length == P.FullBytes or length == P.YawBytes, "invalid state record size")
		local id=buffer.readu16(row,0)
		if bytes + length &gt; P.MaxPayload or seen[id] then flush() end
		seen[id]=true
		table.insert(group, row) bytes += length
	end
	flush()
	return packets
end
function P.Decode(b)
	if typeof(b) ~= "buffer" then return nil, "packet_type" end
	local length = buffer.len(b)
	if length &lt; P.Header or length &gt; P.MaxPayload then return nil, "packet_size" end
	if buffer.readu16(b, 0) ~= MAGIC or buffer.readu8(b, 2) ~= P.Version then return nil, "packet_version" end
	local count = buffer.readu16(b, 3)
	if count == 0 or count &gt; 32 then return nil, "packet_count" end
	local rows, seen, offset = {}, {}, P.Header
	for _ = 1, count do
		if length - offset &lt; 3 then return nil, "packet_truncated" end
		local flags = buffer.readu8(b, offset + 2)
		if flags &gt; 15 then return nil, "packet_flags" end
		local full = bit32.band(flags, 1) ~= 0
		local size = if full then P.FullBytes else P.YawBytes
		if length - offset &lt; size then return nil, "packet_truncated" end
		local id = buffer.readu16(b, offset)
		local generation = buffer.readu32(b, offset + 3)
		if id == 0 or generation == 0 or seen[id] then return nil, "packet_entity" end
		seen[id] = true
		local time = buffer.readf64(b, offset + 15)
		local x, y, z = buffer.readf32(b, offset + 23), buffer.readf32(b, offset + 27), buffer.readf32(b, offset + 31)
		if not finite(time) or time &lt; 0 or time &gt; 1e12 or not finite(x) or not finite(y) or not finite(z)
			or math.max(math.abs(x), math.abs(y), math.abs(z)) &gt; 1e7 then return nil, "packet_numeric" end
		local function angle(at) return buffer.readu16(b, offset + at) / 65535 * TAU - math.pi end
		local cf = CFrame.new(x, y, z) * (if full then CFrame.fromOrientation(angle(35), angle(37), angle(39)) else CFrame.fromOrientation(0, angle(35), 0))
		local copy = buffer.create(size) buffer.copy(copy, 0, b, offset, size)
		table.insert(rows, {id = id, generation = generation,
			ownershipRevision = buffer.readu32(b, offset + 7), sequence = buffer.readu32(b, offset + 11),
			time = time, frame = cf, full = full, half = bit32.band(flags, 2) ~= 0,
			teleport = bit32.band(flags, 4) ~= 0, stop = bit32.band(flags, 8) ~= 0, record = copy})
		offset += size
	end
	if offset ~= length then return nil, "packet_trailing_bytes" end
	return rows
end
return table.freeze(P)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF45"><Properties><string name="Name">RateBudget</string><ProtectedString name="Source">-- Elapsed-time budgets do not give a low-FPS sender a different allowance.
local B = {}
function B.New(rate, burst, now)
	assert(type(rate)=="number" and rate &gt; 0 and rate &lt; math.huge and type(burst)=="number" and burst &gt; 0 and burst &lt; math.huge
		and type(now)=="number" and now==now and math.abs(now)&lt;math.huge)
	return {rate = rate, burst = burst, credit = burst, time = now}
end
function B.Allow(b, cost, now)
	if type(cost) ~= "number" or cost ~= cost or cost &lt; 0 or cost == math.huge then return false end
	if type(now) ~= "number" or now ~= now or math.abs(now) == math.huge or now &lt; b.time then return false end
	b.credit = math.min(b.burst, b.credit + (now - b.time) * b.rate)
	b.time = now
	if b.credit &lt; cost then return false end
	b.credit -= cost
	return true
end
return table.freeze(B)
</ProtectedString></Properties></Item><Item class="Folder" referent="CF46"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteEvent" referent="CF47"><Properties><string name="Name">ClientClockRelay</string></Properties></Item><Item class="RemoteEvent" referent="CF48"><Properties><string name="Name">ClientHeartbeat</string></Properties></Item><Item class="RemoteEvent" referent="CF49"><Properties><string name="Name">ClientLoaded</string></Properties></Item><Item class="UnreliableRemoteEvent" referent="CF50"><Properties><string name="Name">Death</string></Properties></Item><Item class="UnreliableRemoteEvent" referent="CF51"><Properties><string name="Name">Heartbeat</string></Properties></Item><Item class="UnreliableRemoteEvent" referent="CF52"><Properties><string name="Name">Replicate</string></Properties></Item><Item class="RemoteEvent" referent="CF53"><Properties><string name="Name">ReplicateFull</string></Properties></Item><Item class="RemoteEvent" referent="CF54"><Properties><string name="Name">SafeReplicate</string></Properties></Item></Item><Item class="ModuleScript" referent="CF55"><Properties><string name="Name">ReplicationRules</string><ProtectedString name="Source">const Shared = script.Parent.Parent.Shared
const Warn = require(script.Parent.Warn)
const Types = require(Shared.Types)
const Holder = require(Shared.Holder)
const Events = require(Shared.Events)

export type RuleFn = (entity: Types.Entity, viewer: Player, viewerEntityId: number?) -&gt; boolean

export type ReplicationRule = {
	filterType: "include" | "exclude",
	filterPlayers: { Player }?,
}

const ruleById = {} :: { [number]: RuleFn }

const function GetIdFrom(input: Player | Model | number | Types.Entity): number?
	if typeof(input) == "number" then
		return input
	end

	if typeof(input) == "table" then
		return (input :: Types.Entity).id
	end

	if typeof(input) ~= "Instance" then
		return nil
	end

	if input:IsA("Player") then
		const entity = Holder.GetEntityFromPlayer(input)
		return entity and entity.id or nil
	end

	if input:IsA("Model") then
		const entity = Holder.GetEntityFromModel(input)
		return entity and entity.id or nil
	end

	return nil
end

const function CompileRule(rule: ReplicationRule): RuleFn
	const filterType = rule.filterType
	const list: { Player } = rule.filterPlayers or {}
	const set = {} :: { [Player]: true }

	for _, player in list do
		set[player] = true
	end

	if filterType == "exclude" then
		if next(set) == nil then
			return function()
				return true
			end
		end

		return function(_, viewer: Player)
			return set[viewer] ~= true
		end
	else
		if next(set) == nil then
			return function()
				return false
			end
		end

		return function(_, viewer: Player)
			return set[viewer] == true
		end
	end
end

const function SetReplicationRule(
	target: Player | Model | number | Types.Entity,
	rule: ReplicationRule | RuleFn | nil
): ()
	const id = GetIdFrom(target)
	if not id then
		Warn.low("no id", target)
		return
	end

	if rule == nil then
		ruleById[id] = nil
		return
	end

	if typeof(rule) == "function" then
		ruleById[id] = rule :: any
		return
	end

	ruleById[id] = CompileRule(rule :: ReplicationRule)
end

const function Allows(entity: Types.Entity, viewer: Player): boolean
	const fn = ruleById[entity.id]
	if not fn then
		return true
	end

	const viewerEntity = Holder.GetEntityFromPlayer(viewer)
	const viewerEntityId = viewerEntity and viewerEntity.id or nil

	return fn(entity, viewer, viewerEntityId)
end

Events.EntityRemoved:Connect(function(entity: Types.Entity)
	ruleById[entity._lastId or entity.id] = nil
end)

const function Include(players: { Player }): RuleFn
	return CompileRule({ filterType = "include", filterPlayers = players })
end

const function Exclude(players: { Player }): RuleFn
	return CompileRule({ filterType = "exclude", filterPlayers = players })
end

return {
	SetReplicationRule = SetReplicationRule,
	Allows = Allows,

	Include = Include,
	Exclude = Exclude,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF56"><Properties><string name="Name">Sequence</string><ProtectedString name="Source">-- Modular counters for state packets; lifetimes and owners are separate counters.
local S = {MOD = 4294967296, HALF = 2147483648}
function S.Newer(value, previous)
	if type(value) ~= "number" or value % 1 ~= 0 or value &lt; 0 or value &gt;= S.MOD then return false end
	if previous == nil then return true end
	local delta = (value - previous) % S.MOD
	return delta &gt; 0 and delta &lt; S.HALF
end
function S.Next(value) return ((value or 0) + 1) % S.MOD end
return table.freeze(S)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF57"><Properties><string name="Name">Signal</string><ProtectedString name="Source">--!nocheck
--------------------------------------------------------------------------------
--               Batched Yield-Safe Signal Implementation                     --
-- This is a Signal class which has effectively identical behavior to a       --
-- normal RBXScriptSignal, with the only difference being a couple extra      --
-- stack frames at the bottom of the stack trace when an error is thrown.     --
-- This implementation caches runner coroutines, so the ability to yield in   --
-- the signal handlers comes at minimal extra cost over a naive signal        --
-- implementation that either always or never spawns a thread.                --
--                                                                            --
-- API:                                                                       --
--   local Signal = require(THIS MODULE)                                      --
--   local sig = Signal.new()                                                 --
--   local connection = sig:Connect(function(arg1, arg2, ...) ... end)        --
--   sig:Fire(arg1, arg2, ...)                                                --
--   connection:Disconnect()                                                  --
--   sig:DisconnectAll()                                                      --
--   local arg1, arg2, ... = sig:Wait()                                       --
--                                                                            --
-- Licence:                                                                   --
--   Licenced under the MIT licence.                                          --
--                                                                            --
-- Authors:                                                                   --
--   stravant - July 31st, 2021 - Created the file.                           --
--------------------------------------------------------------------------------

export type Signal&lt;fx, T...&gt; = {
	Fire: (self: any, T...) -&gt; (),
	DisconnectAll: (self: any) -&gt; (),
	Event: Event&lt;fx, T...&gt;,
}

export type Connection = {
	Disconnect: (self: any) -&gt; (),
	Connected: boolean,
}

export type Event&lt;fx, T...&gt; = {
	Connect: (self: any, FN: fx) -&gt; Connection,
	Once: (self: any, FN: fx) -&gt; Connection,
	Wait: (self: any) -&gt; T...,
}

-- The currently idle thread to run the next handler on
local freeRunnerThread = nil

-- Function which acquires the currently idle handler runner thread, runs the
-- function fn on it, and then releases the thread, returning it to being the
-- currently idle one.
-- If there was a currently idle runner thread already, that's okay, that old
-- one will just get thrown and eventually GCed.
const function acquireRunnerThreadAndCallEventHandler(fn, ...)
	const acquiredRunnerThread = freeRunnerThread
	freeRunnerThread = nil
	fn(...)
	-- The handler finished running, this runner thread is free again.
	freeRunnerThread = acquiredRunnerThread
end

-- Coroutine runner that we create coroutines of. The coroutine can be
-- repeatedly resumed with functions to run followed by the argument to run
-- them with.
const function runEventHandlerInFreeThread()
	-- Note: We cannot use the initial set of arguments passed to
	-- runEventHandlerInFreeThread for a call to the handler, because those
	-- arguments would stay on the stack for the duration of the thread's
	-- existence, temporarily leaking references. Without access to raw bytecode
	-- there's no way for us to clear the "..." references from the stack.
	while true do
		acquireRunnerThreadAndCallEventHandler(coroutine.yield())
	end
end

-- Connection class
const Connection = {}
Connection.__index = Connection

function Connection.new(signal, fn, defer)
	return setmetatable({
		_type_ = "Connection",
		Connected = true,
		_signal = signal,
		_fn = fn,
		_next = false,
		_defer = defer or false,
		_binCleanup = Connection.Disconnect,
	}, Connection)
end

function Connection:Disconnect()
	self.Connected = false

	-- Unhook the node, but DON'T clear it. That way any fire calls that are
	-- currently sitting on this node will be able to iterate forwards off of
	-- it, but any subsequent fire calls will not hit it, and it will be GCed
	-- when no more fire calls are sitting on it.
	if self._signal._handlerListHead == self then
		self._signal._handlerListHead = self._next
	else
		local prev = self._signal._handlerListHead
		while prev and prev._next ~= self do
			prev = prev._next
		end
		if prev then
			prev._next = self._next
		end
	end
end

-- Make Connection strict
setmetatable(Connection, {
	__index = function(tb, key)
		error(("Attempt to get Connection::%s (not a valid member)"):format(tostring(key)), 2)
	end,
	__newindex = function(tb, key, value)
		error(("Attempt to set Connection::%s (not a valid member)"):format(tostring(key)), 2)
	end,
})

const Event = {}
Event.__index = Event

function Event.new()
	return setmetatable({
		_type_ = "Event",
		_handlerListHead = false,
	}, Event)
end

function Event:Connect(fn, defer)
	const connection = Connection.new(self, fn, defer)
	if self._handlerListHead then
		connection._next = self._handlerListHead
		self._handlerListHead = connection
	else
		self._handlerListHead = connection
	end
	return connection
end

-- Implement Signal:Wait() in terms of a temporary connection using
-- a Signal:Connect() which disconnects itself.
function Event:Wait(defer)
	const waitingCoroutine = coroutine.running()
	local cn
	cn = self:Connect(function(...)
		cn:Disconnect()
		task.spawn(waitingCoroutine, ...)
	end, defer)
	return coroutine.yield()
end

-- Implement Signal:Once() in terms of a connection which disconnects
-- itself before running the handler.
function Event:Once(fn, defer)
	local cn
	cn = self:Connect(function(...)
		if cn.Connected then
			cn:Disconnect()
		end
		fn(...)
	end, defer)
	return cn
end

-- Signal class
const Types = require(script.Parent.Types)
const Signal = {}
Signal.__index = Signal

function Signal.new(): Types.Signal&lt;any...&gt;
	return setmetatable({
		_type_ = "Signal",
		Event = Event.new(),
		_binCleanup = Signal.DisconnectAll,
	}, Signal)
end

-- Disconnect all handlers. Since we use a linked list it suffices to clear the
-- reference to the head handler.
function Signal:DisconnectAll()
	self.Event._handlerListHead = false
end

-- Signal:Fire(...) implemented by running the handler functions on the
-- coRunnerThread, and any time the resulting thread yielded without returning
-- to us, that means that it yielded to the Roblox scheduler and has been taken
-- over by Roblox scheduling, meaning we have to make a new coroutine runner.
function Signal:Fire(...)
	local item = self.Event._handlerListHead
	debug.profilebegin("Signal.Fire")
	while item do
		if item.Connected then
			if item._defer then
				task.defer(item._fn, ...)
			else
				if not freeRunnerThread then
					freeRunnerThread = coroutine.create(runEventHandlerInFreeThread)
					-- Get the freeRunnerThread to the first yield
					coroutine.resume(freeRunnerThread)
				end
				task.spawn(freeRunnerThread, item._fn, ...)
			end
		end
		item = item._next
	end
	debug.profileend()
end

-- Make signal strict
setmetatable(Signal, {
	__index = function(tb, key)
		error(("Attempt to get Signal::%s (not a valid member)"):format(tostring(key)), 2)
	end,
	__newindex = function(tb, key, value)
		error(("Attempt to set Signal::%s (not a valid member)"):format(tostring(key)), 2)
	end,
})

return Signal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF58"><Properties><string name="Name">Snapshots</string><ProtectedString name="Source">--!native

const Types = require(script.Parent.Types)

type SnapshotData&lt;Value, Velocity&gt; = Types.SnapshotData&lt;Value, Velocity&gt;

type Snapshot&lt;Value, Velocity&gt; = Types.Snapshot&lt;Value, Velocity&gt;

const Config = require(script.Parent.Config)
const InterpolationMath = require(script.Parent.InterpolationMath)
const Warn = require(script.Parent.Warn)

local MAX_LENGTH: number
const PEAK_SPEED_DECAY = 0.98

Config._WaitForLock(function()
	MAX_LENGTH = Config._GetConfig("MAX_SNAPSHOT_COUNT")
end)

const function GetBufferIndex(head: number, relativeIndex: number): number
	return (head + relativeIndex - 2) % MAX_LENGTH + 1
end

const function BinarySearchInsertionPoint&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;, timeStamp: number): number
	const count = self.count
	if count == 0 then
		return 1
	end

	local left = 1
	local right = count
	const cache = self.cache
	const head = self.head

	while left &lt;= right do
		const mid = (left + right) // 2
		const bufferIndex = GetBufferIndex(head, mid)
		const midTime = cache[bufferIndex].t

		if midTime &lt; timeStamp then
			left = mid + 1
		else
			right = mid - 1
		end
	end

	return left
end

const function ShiftElementsRight&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;, startPos: number, endPos: number)
	const cache = self.cache
	const head = self.head

	for i = endPos, startPos, -1 do
		const fromIndex = GetBufferIndex(head, i)
		const toIndex = GetBufferIndex(head, i + 1)
		cache[toIndex] = cache[fromIndex]
	end
end

const function GetLatest&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;): SnapshotData&lt;Value, Velocity&gt;?
	if self.count == 0 then
		return nil
	end

	const lastIndex = GetBufferIndex(self.head, self.count)
	return self.cache[lastIndex]
end

const function Push&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;, timeStamp: number, value: Value, velocity: Velocity)
	const newData = { t = timeStamp, value = value, velocity = velocity }

	if self.count == 0 then
		self.cache[self.head] = newData
		self.count = 1
		return
	end

	const insertionPos = BinarySearchInsertionPoint(self, timeStamp)

	if insertionPos &gt; self.count then
		if self.count &lt; MAX_LENGTH then
			const newIndex = GetBufferIndex(self.head, self.count + 1)
			self.cache[newIndex] = newData
			self.count += 1
		else
			const newIndex = self.head
			self.cache[newIndex] = newData
			self.head = self.head % MAX_LENGTH + 1
		end
	else
		if self.count &lt; MAX_LENGTH then
			ShiftElementsRight(self, insertionPos, self.count)
			const insertIndex = GetBufferIndex(self.head, insertionPos)
			self.cache[insertIndex] = newData
			self.count += 1
		else
			if insertionPos == 1 then
				return
			end
			for i = 1, insertionPos - 2 do
				const fromIndex = GetBufferIndex(self.head, i + 1)
				const toIndex = GetBufferIndex(self.head, i)
				self.cache[toIndex] = self.cache[fromIndex]
			end
			const insertIndex = GetBufferIndex(self.head, insertionPos - 1)
			self.cache[insertIndex] = newData
		end
	end
end

const function PushWithCheck&lt;Value, Velocity&gt;(
	self: Snapshot&lt;Value, Velocity&gt;,
	timeStamp: number,
	value: Value,
	velocity: Velocity?,
	tickrate: number,
	stopped: boolean?
)
	const latestData = GetLatest(self)
	const isNewest = not latestData or timeStamp &gt; latestData.t
	if stopped then
		Push(self, timeStamp, value, vector.zero :: any)
		if isNewest then
			self.stoppedAt = timeStamp
		end
		return
	end

	const position = (value :: any).Position
	local teleported = false
	if latestData and isNewest and latestData.t == self.stoppedAt then
		const moved = vector.magnitude(position - (latestData.value :: any).Position)
		const gap = timeStamp - latestData.t
		const travelTime = if self.peakSpeed &gt; 1e-3 then moved / self.peakSpeed else 0

		teleported = travelTime &gt; tickrate * 5
		const startAt = timeStamp - (if teleported then tickrate else math.max(tickrate, travelTime))
		if startAt &gt; latestData.t and gap &gt; tickrate * 1.5 then
			Push(self, startAt, latestData.value, vector.zero :: any)
		end
	elseif
		latestData and InterpolationMath.CheckIdle(latestData :: any, timeStamp, position, tickrate, self.peakSpeed)
	then
		latestData.velocity = vector.zero :: any
		Push(self, timeStamp - tickrate, latestData.value, vector.zero :: any)
	end
	if isNewest then
		self.stoppedAt = nil
	end

	const pushVelocity: Velocity = velocity
		or InterpolationMath.VelocityAt(GetLatest(self) :: any, timeStamp, value :: any, tickrate, self.peakSpeed) :: any

	Push(self, timeStamp, value, pushVelocity)
	if not teleported then
		self.peakSpeed = math.max(vector.magnitude(pushVelocity :: any), self.peakSpeed * PEAK_SPEED_DECAY)
	end
end

const function GetAt&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;, at: number, bypassLock: boolean?): Value?
	const count = self.count
	if count == 0 then
		return nil
	end

	if count == 1 then
		const index = GetBufferIndex(self.head, 1)
		return self.cache[index].value
	end

	if at &lt; 0 then
		const latest = GetLatest(self)
		return latest and latest.value or nil
	end

	const cache = self.cache
	const head = self.head
	const lerpFunction = self.Lerp
	const lockedTime = self.lockedTime

	if at &lt; lockedTime and not bypassLock then
		at = lockedTime
	end

	const insertionPos = BinarySearchInsertionPoint(self, at)

	const beforePos = insertionPos - 1
	const afterPos = insertionPos

	local beforeData: SnapshotData&lt;Value, Velocity&gt;?
	local afterData: SnapshotData&lt;Value, Velocity&gt;?

	if beforePos &gt;= 1 and beforePos &lt;= count then
		const beforeIndex = GetBufferIndex(head, beforePos)
		beforeData = cache[beforeIndex]
	end

	if afterPos &gt;= 1 and afterPos &lt;= count then
		const afterIndex = GetBufferIndex(head, afterPos)
		afterData = cache[afterIndex]
	end

	if beforeData and afterData then
		const dt = afterData.t - beforeData.t
		if dt == 0 then
			return beforeData.value
		end
		const alpha = (at - beforeData.t) / dt

		const p0, p1 = (beforeData.value :: any).Position, (afterData.value :: any).Position
		const v0, v1 = beforeData.velocity, afterData.velocity

		const position = lerpFunction(p0, p1, v0, v1, alpha, dt)
		const cf = (beforeData.value :: any):Lerp(afterData.value, alpha)

		return CFrame.new(position) * cf.Rotation
	elseif beforeData then
		Warn.low("Tried to fetch a time that was ahead of snapshot storage!")
		return beforeData.value
	elseif afterData then
		Warn.low("Tried to fetch a time that was behind snapshot storage!")
		return afterData.value
	end

	return nil
end

const function Clear&lt;Value, Velocity&gt;(self: Snapshot&lt;Value, Velocity&gt;)
	self.head = 1
	self.count = 0
	self.lockedTime = 0
	self.peakSpeed = 0
	self.stoppedAt = nil
end

const function New&lt;Value, Velocity&gt;(
	lerpFunction: (Vector3, Vector3, Velocity, Velocity, number, number) -&gt; Vector3
): Snapshot&lt;Value, Velocity&gt;
	const cache: { SnapshotData&lt;Value, Velocity&gt; } = table.create(MAX_LENGTH) :: any
	for i = 1, MAX_LENGTH do
		cache[i] = { t = 0, value = (nil :: any) :: Value, velocity = (nil :: any) :: Velocity }
	end

	return {
		cache = cache,
		head = 1,
		count = 0,
		lockedTime = 0,
		peakSpeed = 0,
		Lerp = lerpFunction,

		Push = Push,
		PushWithCheck = PushWithCheck,
		GetLatest = GetLatest,
		GetAt = GetAt,
		Clear = Clear,
	}
end

return New
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF59"><Properties><string name="Name">StateGate</string><ProtectedString name="Source">-- A sequence is comparable only inside one object lifetime and state revision.
local Sequence=require(script.Parent.Sequence)
local G={}
function G.Check(entity,row,owner)
	if not entity or entity.destroyed then return false,"missing_entity" end
	if owner~=nil and entity.networkOwner~=owner then return false,"wrong_owner" end
	if entity.generation~=row.generation then return false,"old_lifetime" end
	if (entity.ownershipRevision or 0)~=row.ownershipRevision then return false,"old_revision" end
	if not Sequence.Newer(row.sequence,entity._receivedSequence) then return false,"old_sequence" end
	return true
end
return table.freeze(G)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF60"><Properties><string name="Name">Stats</string><ProtectedString name="Source">const Players = game:GetService("Players")
const RunService = game:GetService("RunService")

const Config = require(script.Parent.Config)
const Entity = require(script.Parent.Entity)
const Holder = require(script.Parent.Holder)
const Types = require(script.Parent.Types)
const RateBudget = require(script.Parent.RateBudget)
local debugBudgets={}

const HasDebuggerOpened = {}
const Stats = {
	REPLICATE_PERMISSIONS = {
		--[123456789] = true,
	} :: { [number]: boolean },

	--// Client
	CLIENT = {
		_PAUSE = false,
		TOTAL_ENTITIES_CULLED = 0,
		ENTITIES_MOVED_THIS_FRAME = 0,
		TOTAL_CLIENT_ENTITIES_CHECKED_THIS_FRAME = 0,
		TOTAL_CLIENT_ENTITIES = 0,
		AVG_INTERPOLATION_TIME_MS = 0,

		BYTES_RECEIVED_PER_SEC = 0,
		NEW_ENTITIES_PER_SEC = 0,
		ENTITY_CHANGES_PER_SEC = 0,
		ENTITY_REMOVALS_PER_SEC = 0,

		CLIENT_ENTITIES = {} :: { [number]: Types.ClientEntitiesStats },
	},
	--// Server
	SERVER = {
		_FORCE = false,
		_SHOULD_REPLICATE = false,
		AVG_TICKER_TIME_MS = 0,
		ENTITY_GRID_UPDATE_TIME_MS = 0,
		GRID_UPDATE_SECTIONS = 0,
		NUMBER_OF_ENTITIES = 0,
		NON_TICKED = 0,
		ENTITIES_FULL_TICKED = 0,
		ENTITIES_HALF_TICKED = 0,

		REPLICATE_PLAYER_TIME_MS = 0,
		BYTES_RECEIVED_PER_SEC = 0,
		BYTES_SENT_PER_SEC = 0,
		PACKETS_SENT_PER_SEC = 0,

		SERVER_ENTITIES = {} :: { [number]: Types.ServerEntitiesStats },
		GRID_STATS = {} :: { [string]: { HALF: { number }, NORMAL: { number } } },
	},
	
	
}

const function processID(id: number, replicate)
	script:SetAttribute(tostring(id), replicate)
end

const function ToUserId(user: number | Player): number
	return if typeof(user) == "Instance" then user.UserId else user
end

function Stats.HasPermissionToReplicate(user: number | Player)
	return script:GetAttribute(tostring(ToUserId(user))) == true
end

function Stats.ReplicateStatsForPlayer(user: number | Player)
	if RunService:IsClient() then
		warn("Stats.ReplicateStatsForPlayer should only be called on the server.")
		return
	end
	const userId = ToUserId(user)
	Stats.REPLICATE_PERMISSIONS[userId] = true
	processID(userId, true)
end

function Stats.StopReplicatingStatsForPlayer(user: number | Player)
	if RunService:IsClient() then
		warn("Stats.StopReplicatingStatsForPlayer should only be called on the server.")
		return
	end
	const userId = ToUserId(user)
	Stats.REPLICATE_PERMISSIONS[userId] = nil
	processID(userId, false)
end

for i, v in Stats.REPLICATE_PERMISSIONS do
	processID(i, v)
end

const function updateStat(type: string, name: string, value: any)
	if name == "WARNING_SEVERITY" then
		Config.SetWarningSeverity(value)
	end
	if type == "FFLAG" then
		(Config.FLAGS :: any)[name] = value
	end
end

const StatsRemoteHeaders = {
	REPLICATE_SERVER_STATS = "REPLICATE_SERVER_STATS",
	UPDATE_STAT = "UPDATE_STAT",
	DEBUGGER_OPENED = "DEBUGGER_OPENED",
	CLIENT_STATS_ACTION = "CLIENT_STATS_ACTION",
}

function Stats.SetForced(value: boolean)
	Stats.SERVER._FORCE = value
	Stats.SERVER._SHOULD_REPLICATE = value
end

if RunService:IsServer() then
	const statsRemote = Instance.new("RemoteEvent", script)
	statsRemote.Name = "Stats"
	local nextReport=0
	RunService.Heartbeat:Connect(function()
		if os.clock()&lt;nextReport then return end nextReport=os.clock()+0.25
		local should = false
		if next(Stats.REPLICATE_PERMISSIONS) then
			for i, v in Players:GetPlayers() do
				if Stats.REPLICATE_PERMISSIONS[v.UserId] and HasDebuggerOpened[v.UserId] then
					should = true
					statsRemote:FireClient(v, StatsRemoteHeaders.REPLICATE_SERVER_STATS, Stats.SERVER)
				end
			end
		end

		Stats.SERVER._SHOULD_REPLICATE = Stats.SERVER._FORCE or should
	end)

	Players.PlayerRemoving:Connect(function(player)
		HasDebuggerOpened[player.UserId] = nil
		debugBudgets[player]=nil
	end)

	statsRemote.OnServerEvent:Connect(function(plr: Player, header: string, ...)
		if type(header)~="string" or not Stats.REPLICATE_PERMISSIONS[plr.UserId] then return end
		local budget=debugBudgets[plr] if not budget then budget=RateBudget.New(8,16,os.clock()) debugBudgets[plr]=budget end
		if not RateBudget.Allow(budget,1,os.clock()) then return end
		if header == StatsRemoteHeaders.DEBUGGER_OPENED then
			const opened = ...
			if type(opened)~="boolean" then return end
			HasDebuggerOpened[plr.UserId] = opened
			return
		end

		if Stats.REPLICATE_PERMISSIONS and not Stats.REPLICATE_PERMISSIONS[plr.UserId] then
			return
		end

		if header == StatsRemoteHeaders.UPDATE_STAT then
			const type, name, value = ...
			if typeof(name)~="string" then return end
			if type=="FFLAG" then
				if Config.FLAGS[name]==nil or typeof(value)~="boolean" then return end
			elseif name=="WARNING_SEVERITY" then
				if not table.find({"NONE","LOW","MEDIUM","HIGH"},value) then return end
			else return end
			updateStat(type, name, value)
			statsRemote:FireAllClients(StatsRemoteHeaders.UPDATE_STAT, type, name, value)
		elseif header == StatsRemoteHeaders.CLIENT_STATS_ACTION then
			const actionType, id = ...
			if type(id)~="number" or id%1~=0 or id&lt;1 or id&gt;65535 then return end
			const entity = Holder.GetEntityFromId(id)
			if not entity then
				return
			end
			if actionType == "CHANGE_NATIVE" then
				const mode = Entity.GetModelReplicationType(entity)
				if mode == "NATIVE" then
					Entity.LockNativeServerCFrameReplication(entity)
				elseif mode == "NATIVE_WITH_LOCK" then
					Entity.UnlockNativeServerCFrameReplication(entity)
				end
			elseif actionType == "TOGGLE_PAUSE" then
				if entity.paused then
					Entity.ResumeReplication(entity)
				else
					Entity.PauseReplication(entity)
				end
			elseif actionType == "CHANGE_CONFIG" then
				const configName = select(3, ...)
				if type(configName)~="string" or not Config._EntityConfigs[configName] then return end
				Entity.SetConfig(entity, configName)
			elseif actionType == "SET_INTERPOLATION_MODE" then
				const mode = select(3, ...)
				if not table.find({"CFRAME","ALIGN","NONE"},mode) then return end
				Entity.SetInterpolationMode(entity, mode)
			end
		end
	end)
else
	const statsRemote = script:WaitForChild("Stats") :: RemoteEvent

	const function handleServerEvent(header: string, ...)
		if header == StatsRemoteHeaders.REPLICATE_SERVER_STATS then
			const serverStats = ...
			if Stats.CLIENT._PAUSE then
				return
			end
			for statName, value in serverStats do
				Stats.SERVER[statName] = value
			end
		elseif header == StatsRemoteHeaders.UPDATE_STAT then
			const type, name, value = ...
			updateStat(type, name, value)
		end
	end

	statsRemote.OnClientEvent:Connect(handleServerEvent)

	Stats._openedDebugger = function()
		Stats.SERVER._SHOULD_REPLICATE = true
		statsRemote:FireServer(StatsRemoteHeaders.DEBUGGER_OPENED, true)
	end
	Stats._closedDebugger = function()
		Stats.SERVER._SHOULD_REPLICATE = false
		statsRemote:FireServer(StatsRemoteHeaders.DEBUGGER_OPENED, false)
	end

	Stats._updateStat = function(type: string, name: string, value: any)
		statsRemote:FireServer(StatsRemoteHeaders.UPDATE_STAT, type, name, value)
	end

	Stats._fireClientStatsEvent = function(...)
		statsRemote:FireServer(StatsRemoteHeaders.CLIENT_STATS_ACTION, ...)
	end
end

return Stats
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF61"><Properties><string name="Name">Ticker</string><ProtectedString name="Source">const Ticker = {}

const function popSwap(t, item, index)
	const lastIndex = #t
	if index ~= lastIndex then
		const lastItem = t[lastIndex]
		t[index] = lastItem
		lastItem._tickerIndex = index
	end
	t[lastIndex] = nil
end

const Types = require(script.Parent.Types)
const Warn = require(script.Parent.Warn)
type Entity = Types.Entity
type Ticker = Types.Ticker

local GlobalTick = 0

function Ticker._IncrementGlobalTick()
	GlobalTick += 1
end

function Ticker.GetGlobalTick()
	return GlobalTick
end

function Ticker.new(config: Types.EntityConfig): Ticker
	-- Tickers holds full and half tick rate so entities don't constantly swap 
	const ticker = {
		tickedHalf = false,
		tickHalfRate = config.TICK_RATE * 2,
		tickRate = config.TICK_RATE,
		lastTicked = 0,
		tickedFrame = 0,
		objects = {},
		callbacks = {},
		config = config,
		dt = 0,
		halfdt = 0,
	}
	return ticker
end

function Ticker.AddCallback(ticker: Ticker, callback: (ticker: Ticker, dt: number) -&gt; ())
	table.insert(ticker.callbacks, callback)
end

function Ticker.RemoveCallback(ticker: Ticker, callback: (ticker: Ticker, dt: number) -&gt; ())
	const index = table.find(ticker.callbacks, callback)
	if index then
		table.remove(ticker.callbacks, index)
	end
end

function Ticker.Add(ticker: Ticker, object: Entity)
	table.insert(ticker.objects, object)
	object._ticker = ticker
	object._tickerIndex = #ticker.objects
end

function Ticker.Remove(ticker: Ticker, object: Entity)
	const index = object._tickerIndex
	if not index then
		Warn.low("Ticker.remove called on object not in ticker", object.id)
		return
	end

	popSwap(ticker.objects :: any, object, index)

	object._ticker = nil
	object._tickerIndex = nil
end

function Ticker.move(object: Entity, newTicker: Ticker)
	const oldTicker = object._ticker
	if oldTicker then
		Ticker.Remove(oldTicker, object)
	end
	Ticker.Add(newTicker, object)
end

function Ticker.CheckUpdate(ticker: Ticker, at: number?): boolean
	const now=at or os.clock()
	const difference = now - ticker.lastTicked
	if ticker._scheduleRate~=ticker.tickRate then ticker._nextDue=ticker.lastTicked+ticker.tickRate ticker._scheduleRate=ticker.tickRate end
	if now+1e-8 &gt;= ticker._nextDue then
		const elapsed=math.max(1,math.floor((now-ticker._nextDue+1e-8)/ticker.tickRate)+1)
		ticker._nextDue+=elapsed*ticker.tickRate
		ticker.skippedDeadlines=(ticker.skippedDeadlines or 0)+elapsed-1
		-- Only ONE capture at the real time. Never invent catch-up world states.
		ticker.lastTicked = now
		ticker.tickedFrame = GlobalTick
		ticker.tickedHalf = not ticker.tickedHalf

		if ticker.tickedHalf then
			ticker.halfdt = difference + ticker.dt
		else
			ticker.halfdt = difference
		end

		ticker.dt = difference
		if #ticker.callbacks &gt; 0 then
			for _, callback in ticker.callbacks do
				callback(ticker, difference)
			end
		end

		return true
	end

	return false
end

return Ticker
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="CF62"><Properties><string name="Name">Types</string><ProtectedString name="Source">export type SnapshotData&lt;Value = CFrame, Velocity = Vector3&gt; = {
	t: number,
	value: Value,
	velocity: Velocity,
}

--// FX is the function template for the events.
export type Signal&lt;fx, T...&gt; = {
	Fire: (self: any, T...) -&gt; (),
	DisconnectAll: (self: any) -&gt; (),
	Event: Event&lt;fx, T...&gt;,
	_binCleanup: (self: any) -&gt; (),
}

export type ClientEntitiesStats = {
	id: number,
	entity: Entity,
	networkOwner: Player?,
	isCharacter: boolean,
	config: string,
	lastReceivedTime: number?,
	lastReplicatedTime: number?,

	averageLatency: number?,
	targetTime: number?,
	deviation: number?,
